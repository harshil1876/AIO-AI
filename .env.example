# ============================================================================
# AIO AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# SECURITY RULE (PRD Sec 35): NEVER prefix private API keys with PUBLIC_
# ============================================================================

# Canonical Site URL (Used for sitemaps, Open Graph tags, and OAuth callbacks)
PUBLIC_SITE_URL="https://aio-ai.vercel.app"

# Supabase PostgreSQL Database Connection (Session & Transaction Pooler)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# Supabase Public Client Credentials (Safe for browser client-side bundles)
PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (Server-side privileged execution only)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server-Only Admin Allowlist (Comma-separated)
ADMIN_EMAILS=""

# Server-Only External Intelligence API Keys (Proxied via /api/* routes)
GITHUB_TOKEN=""
YOUTUBE_API_KEY=""

# Optional Pluggable LLM Provider for AI Finder Reasoning Layer (PRD Sec 34)
AI_PROVIDER_API_KEY=""
AI_PROVIDER_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
AI_PROVIDER_MODEL="google/gemini-2.0-flash-001"

# Dual-Region Billing Providers (India Razorpay INR + Global Stripe USD)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Distributed Rate Limiting (Optional Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Scheduled Vercel Cron Secret (/api/cron/sync)
CRON_SECRET=""

# PostHog Analytics (Optional privacy-respecting telemetry)
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://app.posthog.com"
