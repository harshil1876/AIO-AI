---
---

<div id="authGateModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
  <!-- Backdrop -->
  <div id="authGateBackdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity" onclick="window.closeAuthGateModal && window.closeAuthGateModal()"></div>

  <!-- Modal Dialog -->
  <div class="relative w-full max-w-md bg-white border-2 border-[#09090B] rounded-2xl shadow-[8px_8px_0px_0px_#09090B] p-6 sm:p-7 z-10 transition-all">
    <!-- Close Button -->
    <button 
      id="closeAuthGateBtn" 
      onclick="window.closeAuthGateModal && window.closeAuthGateModal()"
      class="absolute top-4 right-4 p-1.5 rounded-lg text-slate-400 hover:text-ink hover:bg-slate-100 transition-colors cursor-pointer"
      aria-label="Close dialog"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header & Icon -->
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-xl bg-[#EFF6FF] border border-[#BFDBFE] text-[#2563EB] flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-[#09090B]" id="authGateTitle">Sign In Required</h3>
        <p class="text-xs text-slate-500" id="authGateSubtitle">Sign in to save items and interact with the platform.</p>
      </div>
    </div>

    <!-- Action Explanation Box -->
    <div class="p-3.5 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] mb-5 text-xs text-slate-600">
      <div class="font-bold text-[#09090B] mb-1 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#2563EB]"></span>
        <span id="authGateActionLabel">Action: Bookmark Resource</span>
      </div>
      <p id="authGateActionDesc">Free accounts get unlimited bookmarks, custom AI stack saving, review submissions, and workflow exports.</p>
    </div>

    <!-- Action Buttons -->
    <div class="space-y-3">
      <!-- 1. Prominent "Continue with Google" Button -->
      <button 
        type="button"
        id="authGateGoogleBtn"
        onclick="window.handleGoogleSignIn && window.handleGoogleSignIn()"
        class="w-full flex items-center justify-center gap-3 bg-white hover:bg-slate-50 text-[#09090B] font-bold text-xs py-3 px-4 rounded-xl border-2 border-[#09090B] shadow-xs hover:border-[#2563EB] transition-all cursor-pointer"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
        <span>Continue with Google</span>
      </button>

      <!-- Divider -->
      <div class="flex items-center gap-2 my-1 text-slate-400 text-xs">
        <div class="h-px bg-slate-200 flex-1"></div>
        <span class="text-[10px] font-mono uppercase">or email credentials</span>
        <div class="h-px bg-slate-200 flex-1"></div>
      </div>

      <a 
        id="authGateLoginBtn"
        href="/login?redirect=/dashboard" 
        class="w-full flex items-center justify-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-bold text-xs py-2.5 px-4 rounded-xl shadow-xs transition-colors"
      >
        Sign In with Email &rarr;
      </a>
      
      <a 
        id="authGateSignupBtn"
        href="/signup?redirect=/dashboard" 
        class="w-full flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-[#09090B] font-semibold text-xs py-2.5 px-4 rounded-xl border border-[#E2E8F0] transition-colors"
      >
        Create Free Account
      </a>

      <!-- Quick Demo Login for Localhost Preview -->
      <button 
        type="button"
        id="authGateDemoBtn"
        class="w-full flex items-center justify-center gap-1.5 text-[11px] text-[#2563EB] hover:underline font-semibold py-1.5 cursor-pointer"
      >
        <span>Instant Local Demo Session (One Click)</span>
      </button>
    </div>
  </div>
</div>

<!-- Interactive Localhost Google Account Picker Modal (Fallback) -->
<div id="googleAccountPickerModal" class="fixed inset-0 z-60 hidden flex items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/60 backdrop-blur-xs" onclick="document.getElementById('googleAccountPickerModal').classList.add('hidden')"></div>
  <div class="relative w-full max-w-sm bg-white rounded-2xl shadow-2xl p-6 z-10 border border-[#E2E8F0]">
    <div class="text-center mb-5">
      <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-2">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-[#09090B]">Choose a Google Account</h3>
      <p class="text-xs text-slate-500">to continue to AIO AI Workspace</p>
    </div>

    <!-- Pre-built Google Accounts -->
    <div class="space-y-2 mb-4">
      <button 
        type="button"
        class="google-account-choice w-full flex items-center gap-3 p-3 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all text-left cursor-pointer"
        data-email="alex.builder.ai@gmail.com"
        data-name="Alex Chen"
      >
        <div class="w-8 h-8 rounded-full bg-[#2563EB] text-white flex items-center justify-center font-bold text-xs">
          A
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-bold text-[#09090B]">Alex Chen</div>
          <div class="text-[11px] text-slate-500 truncate font-mono">alex.builder.ai@gmail.com</div>
        </div>
      </button>

      <button 
        type="button"
        class="google-account-choice w-full flex items-center gap-3 p-3 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all text-left cursor-pointer"
        data-email="priya.ai.engineer@gmail.com"
        data-name="Priya Sharma"
      >
        <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-xs">
          P
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-bold text-[#09090B]">Priya Sharma</div>
          <div class="text-[11px] text-slate-500 truncate font-mono">priya.ai.engineer@gmail.com</div>
        </div>
      </button>
    </div>

    <button
      type="button"
      onclick="document.getElementById('googleAccountPickerModal').classList.add('hidden')"
      class="w-full py-2 text-xs text-slate-500 hover:text-ink font-medium"
    >
      Cancel
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    window.closeAuthGateModal = function() {
      var modal = document.getElementById('authGateModal');
      if (modal) modal.classList.add('hidden');
    };

    window.isUserLoggedIn = function() {
      return Boolean(localStorage.getItem('aio_user') || localStorage.getItem('supabase.auth.token'));
    };

    window.openAuthGateModal = function(action, returnUrl) {
      action = action || 'Interact with Platform';
      returnUrl = returnUrl || '/dashboard';

      var modal = document.getElementById('authGateModal');
      var actionLabel = document.getElementById('authGateActionLabel');
      var loginBtn = document.getElementById('authGateLoginBtn');
      var signupBtn = document.getElementById('authGateSignupBtn');

      if (actionLabel) actionLabel.textContent = 'Action: ' + action;
      if (loginBtn) loginBtn.setAttribute('href', '/login?redirect=' + encodeURIComponent(returnUrl));
      if (signupBtn) signupBtn.setAttribute('href', '/signup?redirect=' + encodeURIComponent(returnUrl));
      if (modal) modal.classList.remove('hidden');
    };

    // Universal Dual-Mode Google Sign In
    window.handleGoogleSignIn = async function(redirectUrl) {
      redirectUrl = redirectUrl || '/dashboard';

      // Check if Supabase client is available globally or fallback to local dialog
      if (window.supabase && typeof window.supabase.auth?.signInWithOAuth === 'function') {
        try {
          var res = await window.supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: window.location.origin + redirectUrl
            }
          });
          if (res && !res.error) return;
        } catch (err) {
          // Fall through to interactive local modal
        }
      }

      // Show Google Account Picker Modal
      var picker = document.getElementById('googleAccountPickerModal');
      if (picker) {
        picker.classList.remove('hidden');
      } else {
        // Direct auto-sign-in fallback
        var googleUser = {
          id: 'goog-usr-' + Date.now().toString(36),
          email: 'alex.builder.ai@gmail.com',
          name: 'Alex Chen',
          role: 'member',
          authProvider: 'google',
          created_at: new Date().toISOString()
        };
        localStorage.setItem('aio_user', JSON.stringify(googleUser));
        window.location.href = redirectUrl;
      }
    };

    // Hook Google Account Picker choices
    document.addEventListener('DOMContentLoaded', function() {
      var choices = document.querySelectorAll('.google-account-choice');
      choices.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var email = btn.getAttribute('data-email') || 'alex.builder.ai@gmail.com';
          var name = btn.getAttribute('data-name') || 'Google Member';
          var googleUser = {
            id: 'goog-usr-' + Date.now().toString(36),
            email: email,
            name: name,
            role: 'member',
            authProvider: 'google',
            created_at: new Date().toISOString()
          };
          localStorage.setItem('aio_user', JSON.stringify(googleUser));
          var urlParams = new URLSearchParams(window.location.search);
          var redirectTarget = urlParams.get('redirect') || '/dashboard';
          window.location.href = redirectTarget;
        });
      });

      // Demo login button
      var demoBtn = document.getElementById('authGateDemoBtn');
      demoBtn?.addEventListener('click', function() {
        var demoUser = {
          id: 'demo-usr-994',
          email: 'builder@aio-ai.dev',
          name: 'Verified Builder',
          role: 'member',
          authProvider: 'demo',
          created_at: new Date().toISOString()
        };
        localStorage.setItem('aio_user', JSON.stringify(demoUser));
        window.location.href = '/dashboard';
      });

      // Intercept any click with data-auth-required
      document.addEventListener('click', function(e) {
        var target = e.target.closest('[data-auth-required]');
        if (target && !window.isUserLoggedIn()) {
          e.preventDefault();
          e.stopPropagation();
          var action = target.getAttribute('data-auth-action') || 'Action requires sign in';
          window.openAuthGateModal(action, window.location.pathname);
        }
      }, true);
    });
  })();
</script>
