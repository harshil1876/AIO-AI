---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[#E2E8F0] bg-white px-6 py-16 mt-auto">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12">
    <div class="max-w-sm">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center text-xs font-black tracking-tight">AI</span>
        <span class="text-[#09090B] font-black tracking-tight text-base">AIO AI</span>
      </div>
      <p class="text-xs text-slate-500 leading-relaxed mb-4">
        The trusted, intent-driven discovery platform for verified AI tools, workflows, open-source models, creator intelligence, and token economics.
      </p>
      <div class="text-[11px] text-slate-400 font-mono">
        © {currentYear} AIO AI Platform. Zero pay-for-placement editorial integrity.
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-xs">
      <div class="flex flex-col gap-2.5">
        <span class="font-bold text-[#09090B] uppercase tracking-wider font-mono text-[10px] text-slate-400">Account</span>
        <a href="/profile" data-auth-required="true" data-auth-action="User Profile" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Profile</a>
        <a href="/pricing" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Pricing &amp; Plans</a>
        <a href="/analytics" data-auth-required="true" data-auth-action="Workspace Analytics" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Analytics & Insights</a>
        <a href="/stack-builder" data-auth-required="true" data-auth-action="Stack Builder" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">My Stack Builder</a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="font-bold text-[#09090B] uppercase tracking-wider font-mono text-[10px] text-slate-400">Discover</span>
        <a href="/tools" data-auth-required="true" data-auth-action="AI Tools Directory" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">AI Tools Directory</a>
        <a href="/finder" data-auth-required="true" data-auth-action="AI Intent Finder" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">AI Intent Finder</a>
        <a href="/compare" data-auth-required="true" data-auth-action="Tool Compare Matrix" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Compare Matrix</a>
        <a href="/tools?category=india-first" data-auth-required="true" data-auth-action="India-First AI Directory" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">India-First AI</a>
        <a href="/categories" data-auth-required="true" data-auth-action="AI Categories Taxonomy" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Taxonomy</a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="font-bold text-[#09090B] uppercase tracking-wider font-mono text-[10px] text-slate-400">Intelligence</span>
        <a href="/news" data-auth-required="true" data-auth-action="AI News Today" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">AI News Today</a>
        <a href="/open-source" data-auth-required="true" data-auth-action="Open-Source AI Models" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Open-Source Hub</a>
        <a href="/workflows" data-auth-required="true" data-auth-action="Production AI Workflows" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">AI Workflows</a>
        <a href="/creators" data-auth-required="true" data-auth-action="Curated AI Creators" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Curated Creators</a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="font-bold text-[#09090B] uppercase tracking-wider font-mono text-[10px] text-slate-400">Platform</span>
        <a href="/docs" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Documentation</a>
        <a href="/utilities" data-auth-required="true" data-auth-action="Utilities Suite" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Utilities Suite</a>
        <a href="/token-calculator" data-auth-required="true" data-auth-action="Token Calculator" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Token Calculator</a>
        <a href="/community" data-auth-required="true" data-auth-action="Community Forum" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Community Forum</a>
        <a href="/submit" data-auth-required="true" data-auth-action="Submit Resource" class="text-slate-600 hover:text-[#2563EB] font-medium transition-colors">Submit Resource</a>
      </div>
    </div>
  </div>

  <!-- Bottom Legal, Trust & Compliance Strip -->
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-[#E2E8F0] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
    <div class="flex items-center gap-1 font-mono text-[11px]">
      <span>Built for engineers, creators & practitioners running AI in production.</span>
    </div>

    <div class="flex items-center gap-6 flex-wrap font-medium">
      <a href="/privacy" class="hover:text-[#2563EB] transition-colors">Privacy Policy</a>
      <a href="/terms" class="hover:text-[#2563EB] transition-colors">Terms of Service</a>
      <a href="/guidelines" class="hover:text-[#2563EB] transition-colors">Community Guidelines</a>
      <a href="/disclosure" class="hover:text-[#2563EB] transition-colors">Affiliate & Editorial Disclosure</a>
    </div>
  </div>
</footer>
