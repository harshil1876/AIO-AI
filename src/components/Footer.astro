---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-hairline bg-canvas px-6 py-16 mt-auto">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12">
    <div class="max-w-sm">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-6 h-6 rounded-md bg-ink text-on-primary flex items-center justify-center text-xs font-bold tracking-tighter">AI</span>
        <span class="text-ink font-semibold tracking-tight text-base">AI Discovery</span>
      </div>
      <p class="text-sm text-mute leading-relaxed mb-4">
        The trusted, intent-driven discovery platform for verified AI tools, workflows, open-source models, and creator intelligence.
      </p>
      <div class="text-xs text-faint">
        © {currentYear} AI Discovery Platform. All rights reserved.
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-10 text-sm">
      <div class="flex flex-col gap-2.5">
        <span class="font-medium text-ink text-xs uppercase tracking-wider">Explore</span>
        <a href="/tools" class="text-body hover:text-ink transition-colors">All AI Tools</a>
        <a href="/compare" class="text-body hover:text-ink transition-colors">Compare Tools</a>
        <a href="/finder" class="text-body hover:text-ink transition-colors">AI Finder</a>
        <a href="/stack-builder" class="text-body hover:text-ink transition-colors">Stack Builder</a>
        <a href="/categories" class="text-body hover:text-ink transition-colors">Taxonomy</a>
        <a href="/utilities/token-calculator" class="text-body hover:text-ink transition-colors">Cost Calculator</a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="font-medium text-ink text-xs uppercase tracking-wider">Ecosystem</span>
        <a href="/community" class="text-body hover:text-ink transition-colors">Community Forum</a>
        <a href="/open-source" class="text-body hover:text-ink transition-colors">Open Source</a>
        <a href="/workflows" class="text-body hover:text-ink transition-colors">AI Workflows</a>
        <a href="/news" class="text-body hover:text-ink transition-colors">AI News Today</a>
        <a href="/tools?category=india-first" class="text-body hover:text-ink transition-colors">India-First AI</a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="font-medium text-ink text-xs uppercase tracking-wider">Platform</span>
        <a href="/admin" class="text-body hover:text-ink transition-colors">Admin Console</a>
        <a href="https://github.com/harshil1876/AIO-AI" target="_blank" rel="noopener noreferrer" class="text-body hover:text-ink transition-colors">GitHub Repository ↗</a>
      </div>
    </div>
  </div>
</footer>
