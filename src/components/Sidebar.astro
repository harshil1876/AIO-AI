                title={item.label}
              >
                <!-- Centered Crisp Section Icon -->
                <div class="w-5 h-5 flex items-center justify-center shrink-0">
                  {item.icon === 'home' && (
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
