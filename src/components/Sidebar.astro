    ))}
  </div>

  <!-- Bottom Pro / Quick Help Box -->
  <div class="p-3 border-t border-[#E2E8F0] bg-white shrink-0">
    <div class="p-3 rounded-md bg-[#F8FAFF] border border-[#BFDBFE] text-xs">
      <div class="flex items-center gap-1.5 font-semibold text-ink mb-1">
        <span class="w-2 h-2 rounded-full bg-[#2563EB]"></span>
        <span>AIO AI Enterprise</span>
      </div>
      <p class="text-[11px] text-mute mb-2">Connect your company tools and custom workflows securely.</p>
      <a href="/docs" class="text-[11px] font-semibold text-[#2563EB] hover:text-[#1D4ED8] inline-flex items-center gap-1">
        Read Platform Docs &rarr;
      </a>
    </div>
  </div>
</aside>

<!-- Mobile Drawer Sidebar (Toggled via JavaScript) -->
<div id="mobileSidebarDrawer" class="fixed inset-0 z-50 hidden">
  <!-- Backdrop -->
  <div id="mobileSidebarBackdrop" class="fixed inset-0 bg-black/50 backdrop-blur-xs transition-opacity"></div>
  
  <!-- Slide-out Drawer -->
  <div class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-white border-r border-[#E2E8F0] shadow-2xl flex flex-col z-50">
    <div class="h-14 px-5 flex items-center justify-between border-b border-[#E2E8F0]">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-md bg-[#09090B] text-white flex items-center justify-center font-bold text-xs tracking-tight">
          AIO
        </div>
        <span class="font-bold text-ink text-base">AIO AI</span>
        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold border border-[#BFDBFE]">v2.0</span>
      </div>
      <button id="closeMobileSidebarBtn" class="p-1 rounded-md text-slate-500 hover:text-ink hover:bg-slate-100 cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-3 py-4 space-y-6">
      {navGroups.map((group) => (
        <div>
          <div class="px-2.5 mb-2 text-[11px] font-mono uppercase tracking-wider text-slate-600 font-semibold">
            {group.title}
          </div>
          <nav class="space-y-0.5">
            {group.items.map((item) => {
              const active = isItemActive(item.href, currentPath);
              return (
                <a
                  href={item.href}
                  class={`flex items-center justify-between px-2.5 py-2 rounded-md text-xs transition-colors ${
                    active
                      ? 'bg-[#EFF6FF] text-[#2563EB] font-semibold border-l-4 border-[#2563EB]'
                      : 'text-slate-600 hover:text-ink hover:bg-slate-50'
                  }`}
                >
                  <span class="truncate">{item.label}</span>
                  {item.badge && (
                    <span class={`text-[10px] font-mono px-1.5 py-0.2 rounded font-bold ${
                      item.badgeColor === 'blue'
                        ? 'bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]'
                        : item.badgeColor === 'emerald'
                        ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                        : 'bg-slate-100 text-slate-700'
                    }`}>
                      {item.badge}
                    </span>
                  )}
                </a>
              );
            })}
          </nav>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function setupMobileSidebar() {
    const drawer = document.getElementById('mobileSidebarDrawer');
    const backdrop = document.getElementById('mobileSidebarBackdrop');
    const closeBtn = document.getElementById('closeMobileSidebarBtn');

    function closeSidebar() {
      if (drawer) drawer.classList.add('hidden');
    }

    if (backdrop) backdrop.addEventListener('click', closeSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);

    window.toggleMobileSidebar = function() {
      if (drawer) {
        drawer.classList.toggle('hidden');
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileSidebar);
  } else {
    setupMobileSidebar();
  }
</script>
