---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  icon: string;
}

interface NavGroup {
  title: string;
  items: NavItem[];
}

// Clean SaaS 4-Pillar Taxonomy with Zero Badges & Zero Sub-arrows
const navGroups: NavGroup[] = [
  {
    title: 'Workspace',
    items: [
      { href: '/dashboard', label: 'Overview', icon: 'home' },
      { href: '/analytics', label: 'Market Intelligence', icon: 'bar-chart-2' },
      { href: '/stack-builder', label: 'Stack Architect', icon: 'layers' },
    ]
  },
  {
    title: 'Discover',
    items: [
      { href: '/tools', label: 'AI Directory', icon: 'grid' },
      { href: '/categories', label: 'Categories', icon: 'tag' },
      { href: '/india-ai', label: 'Sovereign India AI', icon: 'globe' },
      { href: '/compare', label: 'Comparison Matrix', icon: 'columns' },
      { href: '/finder', label: 'Solution Finder', icon: 'sparkles' },
      { href: '/open-source', label: 'Open-Source Hub', icon: 'code' },
    ]
  },
  {
    title: 'Build & Automate',
    items: [
      { href: '/workflows', label: 'Workflow Library', icon: 'zap' },
      { href: '/workflows/builder', label: 'Workflow Studio', icon: 'cpu' },
      { href: '/utilities', label: 'Utility Studio', icon: 'tool' },
      { href: '/token-calculator', label: 'Token Economics', icon: 'calculator' },
    ]
  },
  {
    title: 'Network & Pulse',
    items: [
      { href: '/news', label: 'AI Pulse', icon: 'newspaper' },
      { href: '/creators', label: 'Creator Network', icon: 'video' },
      { href: '/community', label: 'Community Spaces', icon: 'users' },
    ]
  }
];

function isItemActive(href: string, current: string): boolean {
  if (href === '/') return current === '/';
  if (href.includes('?')) {
    return current === href.split('?')[0];
  }
  if (current === href) return true;

  if (href === '/open-source') return current.startsWith('/open-source');
  if (href === '/workflows/builder') return current.startsWith('/workflows/builder');
  if (href === '/workflows') return current.startsWith('/workflows') && !current.startsWith('/workflows/builder');
  if (href === '/utilities') return current.startsWith('/utilities');
  if (href === '/token-calculator') return current.startsWith('/token-calculator');
  if (href === '/india-ai') return current.startsWith('/india-ai') || current.includes('category=india-first');
  if (href === '/tools') return current.startsWith('/tools') && !current.includes('category=india-first') && !current.startsWith('/categories') && !current.startsWith('/compare');
  if (href === '/categories') return current.startsWith('/categories');
  if (href === '/compare') return current.startsWith('/compare');
  if (href === '/finder') return current.startsWith('/finder');
  if (href === '/pricing') return current.startsWith('/pricing');
  if (href === '/docs') return current.startsWith('/docs');
  if (href === '/submit') return current.startsWith('/submit');
  if (href === '/creators') return current.startsWith('/creators');
  if (href === '/news') return current.startsWith('/news');
  if (href === '/community') return current.startsWith('/community');
  if (href === '/analytics') return current.startsWith('/analytics');
  if (href === '/stack-builder') return current.startsWith('/stack-builder');
  if (href === '/dashboard') return current === '/dashboard';

  return current.startsWith(`${href}/`);
}
---

<!-- Desktop Hover-Expanding & Pinnable Rail (68px -> 252px) -->
<aside 
  id="desktopSidebar" 
  class="group/sidebar hidden lg:flex flex-col w-[68px] shrink-0 bg-gradient-to-b from-slate-900 via-[#111827] to-[#1E1B4B] text-slate-100 border-r border-indigo-500/20 min-h-screen sticky top-0 h-screen select-none z-30 transition-all duration-200 ease-out overflow-x-hidden shadow-xl"
  data-pinned="false"
>
  <!-- Brand Header & Pin Lock Toggle -->
  <div class="h-14 px-3.5 flex items-center justify-between border-b border-indigo-500/20 bg-slate-900/60 backdrop-blur-md shrink-0">
    <a href="/dashboard" class="flex items-center gap-3 min-w-0" id="desktopBrandLink">
      <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-black text-xs tracking-tight shadow-md shrink-0 ring-1 ring-white/20">
        AI
      </div>
      <span class="font-black text-white text-base tracking-tight transition-opacity duration-150 truncate opacity-0 group-hover/sidebar:opacity-100 sidebar-label">
        AIO AI
      </span>
    </a>

    <!-- Pin Toggle Button (Desktop) -->
    <button
      type="button"
      id="pinSidebarToggleBtn"
      class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors cursor-pointer shrink-0 opacity-0 group-hover/sidebar:opacity-100 sidebar-label"
      title="Pin sidebar open"
      aria-label="Pin sidebar"
    >
      <svg id="pinIcon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
