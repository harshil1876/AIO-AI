  <!-- Pinned Clean Bottom Strip (Pricing • Documentation • Launch / Submit) -->
  <div class="px-2 py-2 border-t border-indigo-500/20 bg-slate-900/80 shrink-0">
    <div class="flex items-center justify-center group-hover/sidebar:justify-between px-2 py-1.5 rounded-xl bg-white/5 border border-white/10 text-[11px] font-medium text-slate-300">
      <a href="/pricing" class="hover:text-indigo-400 transition-colors shrink-0" title="Pricing & Plans">
        <span class="hidden group-hover/sidebar:inline sidebar-label">Pricing</span>
        <span class="group-hover/sidebar:hidden">💰</span>
      </a>
      <span class="text-slate-600 hidden group-hover/sidebar:inline sidebar-label">•</span>
