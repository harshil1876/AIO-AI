      </svg>
    </button>
  </div>

  <!-- Navigation Groups -->
  <div class="flex-1 overflow-y-auto px-2 py-4 space-y-5 scrollbar-thin scrollbar-thumb-slate-700">
    {navGroups.map((group) => (
      <div>
        <div class="px-2.5 mb-1.5 text-[10px] font-mono uppercase tracking-wider text-indigo-300/60 font-bold opacity-0 group-hover/sidebar:opacity-100 sidebar-label transition-opacity duration-150 truncate">
          {group.title}
