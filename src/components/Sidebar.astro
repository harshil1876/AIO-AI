---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  badge?: string;
  badgeColor?: 'blue' | 'black' | 'emerald';
  icon: string;
}

interface NavGroup {
  title: string;
  items: NavItem[];
}

const navGroups: NavGroup[] = [
  {
    title: 'Discover',
    items: [
      { href: '/', label: 'Home', icon: 'home' },
      { href: '/tools', label: 'AI Tools Directory', badge: '113', badgeColor: 'blue', icon: 'grid' },
      { href: '/finder', label: 'AI Intent Finder', icon: 'sparkles' },
      { href: '/categories', label: 'Categories', badge: '13', icon: 'tag' },
      { href: '/compare', label: 'Side-by-Side Compare', icon: 'scale' },
      { href: '/tools?category=india-first', label: 'India-First AI', badge: '16', badgeColor: 'emerald', icon: 'flag' },
    ]
  },
  {
    title: 'News & Intelligence',
    items: [
      { href: '/news', label: 'AI News Today', badge: 'NEW', badgeColor: 'blue', icon: 'newspaper' },
      { href: '/news/daily', label: 'Daily Newspaper', icon: 'document-text' },
      { href: '/open-source', label: 'Open-Source Hub', badge: '20+', icon: 'code' },
      { href: '/open-source/trending', label: 'Trending GitHub', icon: 'trending' },
    ]
  },
  {
    title: 'Build & Automate',
    items: [
      { href: '/workflows', label: 'AI Workflows', badge: '16+', badgeColor: 'blue', icon: 'arrows-split' },
      { href: '/stack-builder', label: 'AI Stack Builder', icon: 'layers' },
      { href: '/token-calculator', label: 'LLM Token Calculator', icon: 'calculator' },
      { href: '/utilities', label: 'Creator & Dev Utilities', badge: '8', icon: 'wrench' },
    ]
  },
  {
    title: 'Learn & Community',
    items: [
      { href: '/creators', label: 'AI & Tech Creators', badge: '18+', icon: 'video' },
      { href: '/community', label: 'Community Hub', icon: 'chat' },
    ]
  },
  {
    title: 'Platform & Docs',
    items: [
      { href: '/docs', label: 'Documentation', icon: 'book' },
      { href: '/submit', label: 'Submit Resource', icon: 'plus-circle' },
      { href: '/profile', label: 'My Profile & Saved', icon: 'user' },
      { href: '/admin', label: 'Admin Console', icon: 'shield' },
    ]
  }
];

function isItemActive(href: string, current: string): boolean {
  if (href === '/') return current === '/';
  if (href.includes('?')) {
    return current === href.split('?')[0];
  }
  return current === href || current.startsWith(`${href}/`);
}
---

<!-- Desktop Persistent Sidebar -->
<aside class="hidden lg:flex flex-col w-64 shrink-0 bg-[#F8FAFF] border-r border-[#E2E8F0] min-h-screen sticky top-0 h-screen select-none z-30">
  <!-- Brand Header -->
  <div class="h-14 px-5 flex items-center justify-between border-b border-[#E2E8F0] bg-white shrink-0">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 rounded-md bg-[#09090B] text-white flex items-center justify-center font-bold text-xs tracking-tight shadow-xs group-hover:bg-[#2563EB] transition-colors">
        AIO
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-ink text-base tracking-tight">AIO AI</span>
        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold border border-[#BFDBFE]">v2.0</span>
      </div>
    </a>
  </div>

  <!-- Navigation Groups -->
  <div class="flex-1 overflow-y-auto px-3 py-4 space-y-6">
    {navGroups.map((group) => (
      <div>
        <div class="px-2.5 mb-2 text-[11px] font-mono uppercase tracking-wider text-slate-600 font-semibold">
          {group.title}
        </div>
        <nav class="space-y-0.5">
          {group.items.map((item) => {
            const active = isItemActive(item.href, currentPath);
            return (
              <a
                href={item.href}
                class={`flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition-all ${
                  active
                    ? 'bg-[#EFF6FF] text-[#2563EB] font-semibold border-l-4 border-[#2563EB] shadow-xs'
                    : 'text-slate-600 hover:text-ink hover:bg-white hover:shadow-xs'
                }`}
              >
                <div class="flex items-center gap-2.5 truncate">
                  <!-- Icon -->
                  {item.icon === 'home' && (
                    <svg class="w-4 h-4 shrink-0 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                    </svg>
