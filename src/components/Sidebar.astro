---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  badge?: string;
  badgeColor?: 'blue' | 'black' | 'emerald';
  icon: string;
}

interface NavGroup {
  title: string;
  items: NavItem[];
}

// Complete, categorized platform pillars matching user architecture
const navGroups: NavGroup[] = [
  {
    title: 'Workspace',
    items: [
      { href: '/dashboard', label: 'Command Center', icon: 'home' },
      { href: '/analytics', label: 'Analytics & Insights', badge: 'LIVE', badgeColor: 'emerald', icon: 'bar-chart-2' },
      { href: '/stack-builder', label: 'My Stack Builder', badge: 'CUSTOM', badgeColor: 'blue', icon: 'layers' },
    ]
  },
  {
    title: 'Discover',
    items: [
      { href: '/tools', label: 'AI Tools Directory', badge: '113', badgeColor: 'blue', icon: 'grid' },
      { href: '/finder', label: 'AI Intent Finder', badge: 'PRO', badgeColor: 'emerald', icon: 'sparkles' },
      { href: '/categories', label: 'Categories Taxonomy', badge: '13', icon: 'tag' },
      { href: '/compare', label: 'Side-by-Side Compare', icon: 'scale' },
      { href: '/india-ai', label: 'India-First AI', badge: '16', badgeColor: 'emerald', icon: 'flag' },
      { href: '/open-source', label: 'Open-Source & VRAM', badge: '20+', icon: 'code' },
      { href: '/open-source/trending', label: 'Trending GitHub', icon: 'trending' },
    ]
  },
  {
    title: 'Build & Automate',
    items: [
      { href: '/workflows', label: 'AI Workflows', badge: '16', badgeColor: 'blue', icon: 'zap' },
      { href: '/workflows/builder', label: 'Workflow Studio', badge: 'NEW', badgeColor: 'emerald', icon: 'sparkles' },
      { href: '/token-calculator', label: 'Token Calculator', badge: '26', icon: 'calculator' },
      { href: '/utilities', label: 'Creator & Dev Utilities', badge: '9', icon: 'wrench' },
    ]
  },
  {
    title: 'Pulse & Learn',
    items: [
      { href: '/news', label: 'AI News Today', badge: 'LIVE', badgeColor: 'emerald', icon: 'newspaper' },
      { href: '/creators', label: 'Creators & Tutorials', badge: '62', icon: 'video' },
      { href: '/community', label: 'Community Forum', icon: 'chat' },
    ]
  },
  {
    title: 'Platform & Resources',
    items: [
      { href: '/pricing', label: 'Pricing & Plans', badge: 'PRO', badgeColor: 'blue', icon: 'credit-card' },
      { href: '/docs', label: 'Documentation', icon: 'book' },
      { href: '/submit', label: 'Submit Resource', icon: 'plus-circle' },
    ]
  }
];

function isItemActive(href: string, current: string): boolean {
  if (href === '/') return current === '/';
  if (href.includes('?')) {
    return current === href.split('?')[0];
  }
  // Exact match
  if (current === href) return true;

  // Specificity checks for nested routes
  if (href === '/open-source/trending') return current.startsWith('/open-source/trending');
  if (href === '/open-source') return current.startsWith('/open-source') && !current.startsWith('/open-source/trending');
  if (href === '/workflows/builder') return current.startsWith('/workflows/builder');
  if (href === '/workflows') return current.startsWith('/workflows') && !current.startsWith('/workflows/builder');
  if (href === '/token-calculator') return current.startsWith('/token-calculator');
  if (href === '/utilities') return current.startsWith('/utilities');
  if (href === '/india-ai') return current.startsWith('/india-ai') || current.includes('category=india-first');
  if (href === '/tools') return (current.startsWith('/tools') && !current.includes('category=india-first'));
  if (href === '/categories') return current.startsWith('/categories');
  if (href === '/compare') return current.startsWith('/compare');
  if (href === '/pricing') return current.startsWith('/pricing');
  if (href === '/docs') return current.startsWith('/docs');
  if (href === '/submit') return current.startsWith('/submit');
  if (href === '/creators') return current.startsWith('/creators');
  if (href === '/news') return current.startsWith('/news');
  if (href === '/community') return current.startsWith('/community');
  if (href === '/analytics') return current.startsWith('/analytics');
  if (href === '/stack-builder') return current.startsWith('/stack-builder');
  if (href === '/dashboard') return current === '/dashboard';

  return current === href || current.startsWith(`${href}/`);
}
---

<!-- Desktop Persistent Collapsible Sidebar -->
<aside 
  id="desktopSidebar" 
  class="hidden lg:flex flex-col w-64 shrink-0 bg-[#F8FAFF] border-r border-[#E2E8F0] min-h-screen sticky top-0 h-screen select-none z-30 transition-all duration-200"
>
  <!-- Brand Header with Close/Collapse Button -->
  <div class="h-14 px-4 flex items-center justify-between border-b border-[#E2E8F0] bg-white shrink-0">
    <a href="/dashboard" class="flex items-center gap-2.5 group" id="desktopBrandLink">
      <div class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-black text-xs tracking-tight shadow-xs group-hover:bg-[#2563EB] transition-colors">
        AI
      </div>
      <span class="font-black text-[#09090B] text-base tracking-tight group-hover:text-[#2563EB] transition-colors">AIO AI</span>
    </a>

    <!-- Desktop Close / Collapse Button -->
    <button
      type="button"
      id="closeDesktopSidebarBtn"
      onclick="window.closeSidebar && window.closeSidebar()"
      class="p-1.5 rounded-lg text-slate-400 hover:text-[#09090B] hover:bg-slate-100 transition-colors cursor-pointer"
      title="Collapse navigation (Esc)"
      aria-label="Collapse navigation"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
    </button>
  </div>

  <!-- Navigation Groups -->
  <div class="flex-1 overflow-y-auto px-3 py-4 space-y-6">
    {navGroups.map((group) => (
      <div>
        <div class="px-2.5 mb-1.5 text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold">
          {group.title}
        </div>
        <nav class="space-y-0.5">
          {group.items.map((item) => {
            const active = isItemActive(item.href, currentPath);
            return (
              <a
                href={item.href}
                class={`flex items-center justify-between px-2.5 py-2 rounded-xl text-xs transition-all ${
                  active
                    ? 'bg-[#EFF6FF] text-[#2563EB] font-bold border-l-4 border-[#2563EB] shadow-2xs'
                    : 'text-slate-600 hover:text-[#09090B] hover:bg-white font-medium hover:shadow-2xs'
                }`}
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  {item.icon === 'home' && (
                    <svg class="w-4 h-4 shrink-0 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                    </svg>
                  )}
                  {item.icon === 'bar-chart-2' && (
                    <svg class="w-4 h-4 shrink-0 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
