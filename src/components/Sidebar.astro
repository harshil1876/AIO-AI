    </div>
  </div>

  <!-- Bottom Workspace User Badge & Auth State -->
  <div class="p-2 border-t border-indigo-500/20 bg-slate-900/90 shrink-0" id="sidebarUserFooter">
    <div class="flex items-center justify-between p-1.5 rounded-xl hover:bg-white/5 transition-colors group">
      <a href="/profile" class="flex items-center gap-2.5 min-w-0 flex-1">
        <div class="w-8 h-8 rounded-full overflow-hidden bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shrink-0 ring-1 ring-white/20" id="sidebarAvatarContainer">
          <span id="sidebarAvatar">U</span>
          <img id="sidebarAvatarImg" class="w-full h-full object-cover hidden" alt="User avatar" />
        </div>
        <div class="min-w-0 flex-1 opacity-0 group-hover/sidebar:opacity-100 sidebar-label transition-opacity duration-150">
          <div class="text-xs font-bold text-white truncate" id="sidebarUserEmail">Guest Builder</div>
          <div class="text-[10px] font-mono text-indigo-300 font-medium truncate" id="sidebarUserTier">Builder Mode</div>
        </div>
      </a>
      
      <!-- Sign Out Button -->
      <button
        type="button"
        id="sidebarSignOutBtn"
        onclick="window.handleSignOut && window.handleSignOut()"
        class="hidden p-1.5 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer shrink-0 opacity-0 group-hover/sidebar:opacity-100 sidebar-label"
        title="Sign Out"
        aria-label="Sign Out"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
        </svg>
      </button>

      <a href="/login" id="sidebarSignInBtn" class="text-xs text-indigo-400 font-bold hover:underline shrink-0 opacity-0 group-hover/sidebar:opacity-100 sidebar-label">
        Sign In
      </a>
    </div>
  </div>
</aside>

<!-- Mobile Slide-Over Drawer Sidebar (<1024px) -->
<div id="mobileSidebarDrawer" class="fixed inset-0 z-50 hidden lg:hidden">
  <div 
    id="mobileSidebarBackdrop" 
    class="fixed inset-0 bg-black/70 backdrop-blur-xs transition-opacity"
    onclick="window.closeSidebar && window.closeSidebar()"
  ></div>

  <div class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-gradient-to-b from-slate-900 via-[#111827] to-[#1E1B4B] text-slate-100 border-r border-indigo-500/20 flex flex-col shadow-2xl z-10 transition-transform">
    <div class="h-14 px-4 flex items-center justify-between border-b border-indigo-500/20 bg-slate-900/70 shrink-0">
      <a href="/dashboard" class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-black text-xs tracking-tight shadow-md">
          AI
        </div>
        <span class="font-black text-white text-base tracking-tight">AIO AI</span>
      </a>

      <button
        type="button"
        id="closeMobileSidebarBtn"
        onclick="window.closeSidebar && window.closeSidebar()"
        class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Close navigation"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-3 py-4 space-y-5 scrollbar-thin">
      {navGroups.map((group) => (
        <div>
          <div class="px-2.5 mb-1.5 text-[10px] font-mono uppercase tracking-wider text-indigo-300/60 font-bold">
            {group.title}
          </div>
          <nav class="space-y-0.5">
            {group.items.map((item) => {
              const isActive = isItemActive(item.href, currentPath);
              return (
                <a
                  href={item.href}
                  class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                    isActive
                      ? 'bg-indigo-600/30 text-indigo-300 font-bold border-l-2 border-indigo-400'
                      : 'text-slate-400 hover:text-white hover:bg-white/5 font-medium'
                  }`}
                  onclick="window.closeSidebar && window.closeSidebar()"
                >
                  <span class="truncate">{item.label}</span>
                </a>
              );
            })}
          </nav>
        </div>
      ))}

      <!-- Mobile Admin Link -->
      <div id="mobileAdminGroup" class="hidden pt-2 border-t border-indigo-500/20">
        <a
          href="/admin"
          class="flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-bold text-purple-300 bg-purple-900/30 border border-purple-500/30"
          onclick="window.closeSidebar && window.closeSidebar()"
        >
          <span>Admin Console</span>
        </a>
      </div>
    </div>

    <!-- Mobile Platform Quick Strip -->
    <div class="px-3 py-2.5 border-t border-indigo-500/20 bg-slate-900/80 shrink-0">
      <div class="flex items-center justify-between px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs font-medium text-slate-300">
        <a href="/pricing" class="hover:text-indigo-400" onclick="window.closeSidebar && window.closeSidebar()">Pricing</a>
        <span class="text-slate-600">•</span>
        <a href="/docs" class="hover:text-indigo-400" onclick="window.closeSidebar && window.closeSidebar()">Documentation</a>
        <span class="text-slate-600">•</span>
        <a href="/submit" class="hover:text-indigo-400" onclick="window.closeSidebar && window.closeSidebar()">Launch / Submit</a>
      </div>
    </div>

    <!-- Mobile Drawer Footer -->
    <div class="p-3 border-t border-indigo-500/20 bg-slate-900/90 shrink-0">
      <a href="/profile" class="flex items-center gap-2.5 p-2 rounded-xl bg-white/5 border border-white/10">
        <div class="w-7 h-7 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-xs" id="mobileAvatar">
          U
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-bold text-white truncate" id="mobileUserEmail">Guest Builder</div>
          <div class="text-[10px] text-indigo-300 font-mono">My Workspace &rarr;</div>
        </div>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function getDesktopSidebar() { return document.getElementById('desktopSidebar'); }
    function getMobileDrawer() { return document.getElementById('mobileSidebarDrawer'); }
    function getPinBtn() { return document.getElementById('pinSidebarToggleBtn'); }
    function getPinIcon() { return document.getElementById('pinIcon'); }

    var isPinned = localStorage.getItem('aio_sidebar_pinned') === 'true';

    function applyPinnedState(pinned) {
      var sidebar = getDesktopSidebar();
      var pinBtn = getPinBtn();
      var pinIcon = getPinIcon();
      if (!sidebar) return;

      if (pinned) {
        sidebar.classList.remove('w-[68px]');
        sidebar.classList.add('w-[252px]', 'sidebar-pinned');
        sidebar.setAttribute('data-pinned', 'true');
        if (pinBtn) {
          pinBtn.classList.add('text-indigo-400');
          pinBtn.setAttribute('title', 'Unpin sidebar');
        }
        if (pinIcon) {
          pinIcon.classList.add('rotate-45');
        }
        // Reveal labels when pinned
        var labels = sidebar.querySelectorAll('.sidebar-label');
        labels.forEach(function(el) { el.classList.remove('opacity-0'); });
      } else {
        sidebar.classList.remove('w-[252px]', 'sidebar-pinned');
        sidebar.classList.add('w-[68px]');
        sidebar.setAttribute('data-pinned', 'false');
        if (pinBtn) {
          pinBtn.classList.remove('text-indigo-400');
          pinBtn.setAttribute('title', 'Pin sidebar open');
        }
        if (pinIcon) {
          pinIcon.classList.remove('rotate-45');
        }
        // Hide labels when collapsed
        var labels = sidebar.querySelectorAll('.sidebar-label');
        labels.forEach(function(el) { el.classList.add('opacity-0'); });
      }
    }

    // Toggle Pin state
    if (getPinBtn()) {
      getPinBtn().addEventListener('click', function(e) {
        e.stopPropagation();
        isPinned = !isPinned;
        localStorage.setItem('aio_sidebar_pinned', String(isPinned));
        applyPinnedState(isPinned);
      });
    }

    // Desktop hover expansion
    var sidebar = getDesktopSidebar();
    if (sidebar) {
      sidebar.addEventListener('mouseenter', function() {
        if (!isPinned && window.innerWidth >= 1024) {
          sidebar.classList.remove('w-[68px]');
          sidebar.classList.add('w-[252px]');
          var labels = sidebar.querySelectorAll('.sidebar-label');
          labels.forEach(function(el) { el.classList.remove('opacity-0'); });
        }
      });

      sidebar.addEventListener('mouseleave', function() {
        if (!isPinned && window.innerWidth >= 1024) {
          sidebar.classList.remove('w-[252px]');
          sidebar.classList.add('w-[68px]');
          var labels = sidebar.querySelectorAll('.sidebar-label');
          labels.forEach(function(el) { el.classList.add('opacity-0'); });
        }
      });
    }

    // Mobile drawer toggles
    window.closeSidebar = function() {
      var mobileDrawer = getMobileDrawer();
      if (mobileDrawer) mobileDrawer.classList.add('hidden');
    };

    window.openSidebar = function() {
      var mobileDrawer = getMobileDrawer();
      if (mobileDrawer) mobileDrawer.classList.remove('hidden');
    };

    window.toggleSidebar = function() {
      var mobileDrawer = getMobileDrawer();
      if (mobileDrawer) mobileDrawer.classList.toggle('hidden');
    };

    function initSidebar() {
      if (window.innerWidth >= 1024) {
        applyPinnedState(isPinned);
      }

      // Synchronize User in Sidebar Footer
      try {
        var user = null;
        var localUserStr = localStorage.getItem('aio_user');
        if (localUserStr) {
          user = JSON.parse(localUserStr);
        } else {
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && (k === 'supabase.auth.token' || (k.startsWith('sb-') && k.endsWith('-auth-token')))) {
              var parsed = JSON.parse(localStorage.getItem(k));
              var tokenUser = parsed.user || (parsed.currentSession && parsed.currentSession.user);
              if (tokenUser) {
                var meta = tokenUser.user_metadata || {};
                user = {
                  name: meta.full_name || meta.name || tokenUser.email?.split('@')[0] || 'Builder',
                  email: tokenUser.email || '',
                  avatarUrl: meta.avatar_url || meta.picture || ''
                };
              }
              break;
            }
          }
        }

        if (user && (user.name || user.email)) {
          var emailEl = document.getElementById('sidebarUserEmail');
          var tierEl = document.getElementById('sidebarUserTier');
          var avatarEl = document.getElementById('sidebarAvatar');
          var avatarImg = document.getElementById('sidebarAvatarImg');
          var signInBtn = document.getElementById('sidebarSignInBtn');
          var signOutBtn = document.getElementById('sidebarSignOutBtn');
          var mobileEmail = document.getElementById('mobileUserEmail');
          var mobileAvatar = document.getElementById('mobileAvatar');
          var desktopAdmin = document.getElementById('desktopAdminGroup');
          var mobileAdmin = document.getElementById('mobileAdminGroup');

          var fullName = user.name || (user.email ? user.email.split('@')[0] : 'Harshil Patel');
          if (emailEl) emailEl.textContent = fullName;
          if (mobileEmail) mobileEmail.textContent = fullName;
          if (tierEl) tierEl.textContent = user.email ? user.email : 'Verified Builder';

          var initial = fullName.charAt(0).toUpperCase();
          if (avatarEl) avatarEl.textContent = initial;
          if (mobileAvatar) mobileAvatar.textContent = initial;

          if (user.avatarUrl && avatarImg) {
            avatarImg.src = user.avatarUrl;
            avatarImg.classList.remove('hidden');
            if (avatarEl) avatarEl.classList.add('hidden');
          }

          if (signInBtn) signInBtn.classList.add('hidden');
          if (signOutBtn) signOutBtn.classList.remove('hidden');

          // Cryptographic verification check for admin
          if (window.supabase && window.supabase.auth) {
            window.supabase.auth.getUser().then(function(res) {
              var authUser = res && res.data && res.data.user;
              if (authUser && authUser.email && authUser.email.toLowerCase().trim() === 'harshilpival@gmail.com') {
                if (desktopAdmin) desktopAdmin.classList.remove('hidden');
                if (mobileAdmin) mobileAdmin.classList.remove('hidden');
              }
            }).catch(function() {});
          }
        }
      } catch (e) {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebar);
    } else {
      initSidebar();
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') window.closeSidebar();
    });
  })();
</script>
