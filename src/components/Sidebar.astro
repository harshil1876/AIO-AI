---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  badge?: string;
  badgeColor?: 'blue' | 'black' | 'emerald';
  icon: string;
}

interface NavGroup {
  title: string;
  items: NavItem[];
}

const navGroups: NavGroup[] = [
  {
    title: 'Discover',
    items: [
      { href: '/dashboard', label: 'Home', icon: 'home' },
      { href: '/analytics', label: 'Analytics & Insights', badge: 'LIVE', badgeColor: 'emerald', icon: 'bar-chart-2' },
      { href: '/stack-builder', label: 'My Stack Builder', icon: 'layers' },
      { href: '/tools', label: 'AI Tools Directory', badge: '113', badgeColor: 'blue', icon: 'grid' },
      { href: '/finder', label: 'AI Intent Finder', icon: 'sparkles' },
      { href: '/categories', label: 'Categories', badge: '13', icon: 'tag' },
      { href: '/compare', label: 'Side-by-Side Compare', icon: 'scale' },
      { href: '/tools?category=india-first', label: 'India-First AI', badge: '16', badgeColor: 'emerald', icon: 'flag' },
    ]
  },
  {
    title: 'News & Intelligence',
    items: [
      { href: '/news', label: 'AI News Today', badge: 'NEW', badgeColor: 'blue', icon: 'newspaper' },
      { href: '/open-source', label: 'Open-Source Hub', badge: '20+', icon: 'code' },
      { href: '/open-source/trending', label: 'Trending GitHub', icon: 'trending' },
    ]
  },
  {
    title: 'Build & Automate',
    items: [
      { href: '/workflows', label: 'AI Workflows', badge: '16+', badgeColor: 'blue', icon: 'arrows-split' },
      { href: '/workflows/builder', label: 'Workflow Studio', badge: 'NEW', badgeColor: 'emerald', icon: 'zap' },
      { href: '/token-calculator', label: 'LLM Token Calculator', icon: 'calculator' },
      { href: '/utilities', label: 'Creator & Dev Utilities', badge: '8', icon: 'wrench' },
    ]
  },
  {
    title: 'Learn & Community',
    items: [
      { href: '/creators', label: 'AI & Tech Creators', badge: '60+', icon: 'video' },
      { href: '/community', label: 'Community Hub', icon: 'chat' },
    ]
  },
  {
    title: 'Platform & Docs',
    items: [
      { href: '/pricing', label: 'Pricing & Plans', badge: 'PRO', badgeColor: 'blue', icon: 'credit-card' },
      { href: '/docs', label: 'Documentation', icon: 'book' },
      { href: '/submit', label: 'Submit Resource', icon: 'plus-circle' },
      { href: '/admin', label: 'Admin Console', icon: 'shield' },
    ]
  },
  {
    title: 'Account',
    items: [
      { href: '/profile', label: 'Profile', icon: 'user' },
    ]
  }
];

function isItemActive(href: string, current: string): boolean {
  if (href === '/') return current === '/';
  if (href.includes('?')) {
    return current === href.split('?')[0];
  }
  return current === href || current.startsWith(`${href}/`);
}
---

<!-- Desktop Persistent Collapsible Sidebar -->
<aside 
  id="desktopSidebar" 
  class="hidden lg:flex flex-col w-64 shrink-0 bg-[#F8FAFF] border-r border-[#E2E8F0] min-h-screen sticky top-0 h-screen select-none z-30 transition-all duration-200"
>
  <!-- Brand Header with Close/Collapse Button -->
  <div class="h-14 px-4 flex items-center justify-between border-b border-[#E2E8F0] bg-white shrink-0">
    <a href="/dashboard" class="flex items-center gap-2.5 group" id="desktopBrandLink">
      <div class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-black text-xs tracking-tight shadow-xs group-hover:bg-[#2563EB] transition-colors">
        AI
      </div>
      <span class="font-black text-[#09090B] text-base tracking-tight group-hover:text-[#2563EB] transition-colors">AIO AI</span>
    </a>

    <!-- Desktop Close / Collapse Button -->
    <button
      type="button"
      id="closeSidebarBtn"
      onclick="window.closeSidebar && window.closeSidebar()"
      class="p-1.5 rounded-lg text-slate-500 hover:text-[#09090B] hover:bg-slate-100 transition-colors cursor-pointer"
      title="Collapse Sidebar"
      aria-label="Collapse Sidebar"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5" />
      </svg>
    </button>
  </div>

  <!-- Navigation Groups -->
  <div class="flex-1 overflow-y-auto px-3 py-4 space-y-6">
    {navGroups.map((group) => (
      <div>
        <div class="px-2.5 mb-2 text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold">
          {group.title}
        </div>
        <nav class="space-y-0.5">
          {group.items.map((item) => {
            const active = isItemActive(item.href, currentPath);
            return (
              <a
                href={item.href}
                class={`flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs transition-all ${
                  active
                    ? 'bg-[#EFF6FF] text-[#2563EB] font-bold border-l-4 border-[#2563EB] shadow-xs'
                    : 'text-slate-600 hover:text-[#09090B] hover:bg-white hover:shadow-xs font-medium'
                }`}
              >
                <div class="flex items-center gap-2.5 truncate">
                  <!-- Icons -->
                  {item.icon === 'layout-dashboard' && (
                    <svg class="w-4 h-4 shrink-0 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                    </svg>
                  )}
                  {item.icon === 'bar-chart-2' && (
                    <svg class="w-4 h-4 shrink-0 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                    </svg>
                  )}
                  {item.icon === 'home' && (
                    <svg class="w-4 h-4 shrink-0 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
