                    <svg class="w-4 h-4 shrink-0 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                  )}
                  <span class="truncate">{item.label}</span>
                </div>

                {item.badge && (
                  <span
                    class={`text-[10px] font-mono px-1.5 py-0.5 rounded-full font-bold shrink-0 ml-1.5 ${
                      item.badgeColor === 'blue'
                        ? 'bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]'
                        : item.badgeColor === 'emerald'
                        ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                        : 'bg-slate-200 text-slate-800'
                    }`}
                  >
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })}
        </nav>
      </div>
    ))}
  </div>

  <!-- Bottom Workspace User Badge -->
  <div class="p-3 border-t border-[#E2E8F0] bg-white shrink-0" id="sidebarUserFooter">
    <a href="/profile" class="flex items-center justify-between p-2 rounded-lg hover:bg-[#F8FAFF] transition-colors group">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-7 h-7 rounded-lg bg-[#2563EB] text-white flex items-center justify-center font-bold text-xs font-mono" id="sidebarAvatar">
          U
        </div>
        <div class="min-w-0">
          <div class="text-xs font-bold text-[#09090B] truncate" id="sidebarUserEmail">Guest Builder</div>
          <div class="text-[10px] font-mono text-emerald-600 font-semibold" id="sidebarUserTier">Free Tier • Sign In</div>
        </div>
      </div>
      <svg class="w-4 h-4 text-slate-400 group-hover:text-[#2563EB] transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
    </a>
  </div>
</aside>

<!-- Mobile Drawer Sidebar (Flyout with Backdrop) -->
<div id="mobileSidebarDrawer" class="fixed inset-0 z-50 hidden lg:hidden">
  <!-- Backdrop -->
  <div 
    id="mobileSidebarBackdrop" 
    class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity"
    onclick="window.closeSidebar && window.closeSidebar()"
  ></div>

  <!-- Drawer Body -->
  <div class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-white border-r border-[#E2E8F0] flex flex-col shadow-2xl z-10 transition-transform">
    <!-- Brand Header -->
    <div class="h-14 px-4 flex items-center justify-between border-b border-[#E2E8F0] shrink-0">
      <a href="/dashboard" class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-black text-xs tracking-tight">
          AI
        </div>
        <span class="font-black text-[#09090B] text-base tracking-tight">AIO AI</span>
      </a>

      <button
        type="button"
        id="closeMobileSidebarBtn"
        onclick="window.closeSidebar && window.closeSidebar()"
        class="p-1.5 rounded-lg text-slate-500 hover:text-ink hover:bg-slate-100 transition-colors cursor-pointer"
        aria-label="Close navigation"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation List -->
    <div class="flex-1 overflow-y-auto px-3 py-4 space-y-6">
      {navGroups.map((group) => (
        <div>
          <div class="px-2.5 mb-2 text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold">
            {group.title}
          </div>
          <nav class="space-y-0.5">
            {group.items.map((item) => {
              const active = isItemActive(item.href, currentPath);
              return (
                <a
                  href={item.href}
                  class={`flex items-center justify-between px-2.5 py-2 rounded-lg text-xs transition-all ${
                    active
                      ? 'bg-[#EFF6FF] text-[#2563EB] font-bold border-l-4 border-[#2563EB]'
                      : 'text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium'
                  }`}
                  onclick="window.closeSidebar && window.closeSidebar()"
                >
                  <span class="truncate">{item.label}</span>
                  {item.badge && (
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-full font-bold bg-[#EFF6FF] text-[#2563EB]">
                      {item.badge}
                    </span>
                  )}
                </a>
              );
            })}
          </nav>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  // Universal Instant Sidebar Controller for Desktop & Mobile
  (function() {
    function getDesktopSidebar() {
      return document.getElementById('desktopSidebar');
    }
    function getMobileDrawer() {
      return document.getElementById('mobileSidebarDrawer');
    }

    window.closeSidebar = function() {
      // 1. Mobile Drawer
      var mobileDrawer = getMobileDrawer();
      if (mobileDrawer) {
        mobileDrawer.classList.add('hidden');
      }

      // 2. Desktop Sidebar (>= 1024px)
      if (window.innerWidth >= 1024) {
        var desktopSidebar = getDesktopSidebar();
        if (desktopSidebar) {
          desktopSidebar.classList.add('hidden');
          desktopSidebar.classList.remove('lg:flex');
          localStorage.setItem('aio_sidebar_closed', 'true');
        }
      }
    };

    window.openSidebar = function() {
      if (window.innerWidth < 1024) {
        var mobileDrawer = getMobileDrawer();
        if (mobileDrawer) {
          mobileDrawer.classList.remove('hidden');
        }
      } else {
        var desktopSidebar = getDesktopSidebar();
        if (desktopSidebar) {
          desktopSidebar.classList.remove('hidden');
          desktopSidebar.classList.add('lg:flex');
          localStorage.setItem('aio_sidebar_closed', 'false');
        }
      }
    };

    window.toggleSidebar = function() {
      if (window.innerWidth < 1024) {
        var mobileDrawer = getMobileDrawer();
        if (mobileDrawer) {
          mobileDrawer.classList.toggle('hidden');
        }
      } else {
        var desktopSidebar = getDesktopSidebar();
        if (desktopSidebar) {
          var isClosed = desktopSidebar.classList.contains('hidden');
          if (isClosed) {
            window.openSidebar();
          } else {
            window.closeSidebar();
          }
        }
      }
    };

    // Alias for mobile backwards compatibility
    window.toggleMobileSidebar = window.toggleSidebar;

    // Restore desktop preference on load
    function initSidebarState() {
      var isClosed = localStorage.getItem('aio_sidebar_closed') === 'true';
      if (window.innerWidth >= 1024 && isClosed) {
        var desktopSidebar = getDesktopSidebar();
        if (desktopSidebar) {
          desktopSidebar.classList.add('hidden');
          desktopSidebar.classList.remove('lg:flex');
        }
      }

      // Sync active user in sidebar
      try {
        var localUserStr = localStorage.getItem('aio_user');
        var user = null;
        if (localUserStr) {
          user = JSON.parse(localUserStr);
        } else {
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && (k === 'supabase.auth.token' || (k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1))) {
              try {
                var parsed = JSON.parse(localStorage.getItem(k));
                var tokenUser = parsed.user || (parsed.currentSession && parsed.currentSession.user);
                if (tokenUser) {
                  user = {
                    name: tokenUser.user_metadata?.full_name || tokenUser.email?.split('@')[0],
                    email: tokenUser.email,
                    authProvider: 'google'
                  };
                }
              } catch(e) {}
              break;
            }
          }
        }

        if (user) {
          var emailEl = document.getElementById('sidebarUserEmail');
          var tierEl = document.getElementById('sidebarUserTier');
          var avatarEl = document.getElementById('sidebarAvatar');
          var brandLink = document.getElementById('desktopBrandLink');
          if (emailEl) emailEl.textContent = user.name || (user.email ? user.email.split('@')[0] : 'Member');
          if (tierEl) tierEl.textContent = user.authProvider === 'google' ? 'Google Account' : 'Verified Member';
          if (avatarEl && (user.name || user.email)) {
            avatarEl.textContent = (user.name || user.email).charAt(0).toUpperCase();
          }
          if (brandLink) brandLink.setAttribute('href', '/dashboard');
        }
      } catch (e) {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebarState);
    } else {
      initSidebarState();
    }

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        window.closeSidebar();
      }
    });
  })();
</script>
