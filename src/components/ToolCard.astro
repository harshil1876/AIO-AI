---
import type { ToolData } from '../data/seedData';
import ToolLogo from './ToolLogo.astro';

interface Props {
  tool: ToolData;
}

const { tool } = Astro.props;

// Robust category normalization
const catSlugs = Array.isArray(tool.categorySlugs) 
  ? tool.categorySlugs 
  : (tool.categorySlug ? [tool.categorySlug] : []);
---

<div class="group relative bg-white border border-[#E2E8F0] rounded-xl p-5 flex flex-col justify-between hover:border-primary hover:shadow-md transition-all shadow-xs">
  <div>
    <!-- Top row: Tool Logo, Name & Badges -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3 min-w-0">
        <ToolLogo websiteUrl={tool.websiteUrl} name={tool.name} size="md" />
        <div class="min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <a 
              href={`/tools/${tool.slug}`} 
              data-auth-required="true" 
              data-auth-action={`Inspect ${tool.name} Details`}
              class="font-bold text-ink hover:text-primary transition-colors text-base tracking-tight truncate"
            >
              {tool.name}
            </a>
            {tool.isVerified && (
              <span class="inline-flex items-center text-[11px] text-emerald-600 font-normal" title="Verified official tool">
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                </svg>
              </span>
            )}
            {tool.isIndianAI && (
              <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded-md bg-orange-50 text-orange-700 border border-orange-200">
                India
              </span>
            )}
          </div>
          <div class="flex items-center gap-2 mt-1 text-xs text-neutral-500 font-mono">
            {tool.rating != null && tool.rating > 0 ? (
              <span class="flex items-center gap-1 text-ink font-bold">
                <svg class="w-3 h-3 text-amber-500 fill-amber-500" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                </svg>
                <span>{tool.rating.toFixed(1)}</span>
              </span>
            ) : (
              <span class="text-[10px] text-neutral-400">0 reviews</span>
            )}
            <span>•</span>
            <span class="text-ink font-semibold">Score: {tool.platformScore || 85}</span>
            <span>•</span>
            <span class="text-emerald-700 font-semibold">Value: {tool.valueScore || 88}</span>
          </div>
        </div>
      </div>

      <span class={`text-[11px] font-mono font-bold px-2 py-0.5 rounded-full border shrink-0 ${
        tool.pricingType === 'Free' 
          ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
          : tool.pricingType === 'Open Source'
          ? 'bg-purple-50 text-purple-700 border-purple-200'
          : tool.pricingType === 'Freemium'
          ? 'bg-blue-50 text-primary border-blue-200'
          : 'bg-neutral-100 text-neutral-700 border-neutral-200'
      }`}>
        {tool.pricingType}
      </span>
    </div>

    <!-- Tagline -->
    <p class="text-xs md:text-sm text-neutral-600 leading-relaxed mb-4 line-clamp-2">
      {tool.tagline}
    </p>
  </div>

  <!-- Footer Actions -->
  <div class="pt-3 border-t border-neutral-100 flex items-center justify-between gap-2 text-xs">
    <div class="flex items-center gap-1.5 flex-wrap">
      {catSlugs.slice(0, 2).map(cat => (
        <a 
          href={`/tools?category=${cat}`} 
          data-auth-required="true"
          data-auth-action={`Category: ${cat.replace('-', ' ')}`}
          class="text-neutral-500 hover:text-primary transition-colors capitalize font-mono text-[11px]"
        >
          #{cat.replace('-', ' ')}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a 
        href={`/tools/${tool.slug}`} 
        data-auth-required="true"
        data-auth-action={`View ${tool.name} Specifications & Benchmarks`}
        class="text-neutral-600 hover:text-ink font-semibold px-2 py-1 rounded-md hover:bg-surface transition-colors"
      >
        Details
      </a>
      <a 
        href={tool.websiteUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-primary hover:text-blue-700 font-bold inline-flex items-center gap-0.5 px-2 py-1 rounded-md hover:bg-blue-50 transition-colors"
        title="Visit official website"
      >
        Visit ↗
      </a>
    </div>
  </div>
</div>
