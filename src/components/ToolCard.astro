---
import type { ToolData } from '../data/seedData';
import ToolLogo from './ToolLogo.astro';
import { calculateAuthenticScore } from '../services/dataService';

interface Props {
  tool: ToolData;
}

const { tool } = Astro.props;

// Robust category normalization
const catSlugs = Array.isArray(tool.categorySlugs) 
  ? tool.categorySlugs 
  : (tool.categorySlug ? [tool.categorySlug] : []);

// Auditable 5-Factor Authenticity Score
const scorecard = calculateAuthenticScore(tool);
const score = scorecard.total;

// Momentum calculation
const momentumBadge = score >= 90 
  ? { label: 'Verified Leader', class: 'bg-emerald-50 text-emerald-700 border-emerald-200' }
  : score >= 82 
  ? { label: 'High Adoption', class: 'bg-blue-50 text-[#2563EB] border-blue-200' }
  : null;

const trafficEstimate = score >= 88 
  ? 'Production Ready'
  : 'Verified Tool';
---

<div class="group relative bg-white border border-[#E2E8F0] hover:border-[#2563EB] rounded-2xl p-5 flex flex-col justify-between hover:shadow-md hover:-translate-y-0.5 transition-all shadow-xs" data-tool-card-slug={tool.slug}>
  <div>
    <!-- Top row: Tool Logo, Name & Badges -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3 min-w-0">
        <ToolLogo websiteUrl={tool.websiteUrl} name={tool.name} size="md" />
        <div class="min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <a 
              href={`/tools/${tool.slug}`} 
              class="font-bold text-[#09090B] hover:text-[#2563EB] transition-colors text-base tracking-tight truncate"
            >
              {tool.name}
            </a>
            {tool.isVerified && (
              <span class="inline-flex items-center text-[11px] text-emerald-600 font-normal" title="Verified official tool">
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                </svg>
              </span>
            )}
            {tool.isIndianAI && (
              <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-orange-50 text-orange-700 border border-orange-200">
                India AI
              </span>
            )}
            {momentumBadge && (
              <span class={`text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border ${momentumBadge.class}`}>
                {momentumBadge.label}
              </span>
            )}
          </div>

          <div class="flex items-center gap-2 mt-1 text-xs text-slate-500 font-mono">
            {tool.rating != null && tool.rating > 0 ? (
              <span class="flex items-center gap-1 text-[#09090B] font-bold">
                <svg class="w-3 h-3 text-amber-500 fill-amber-500" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                </svg>
                <span>{tool.rating.toFixed(1)}</span>
              </span>
            ) : (
              <span class="text-[10px] text-slate-400">0 reviews</span>
            )}
            <span>&bull;</span>
            <div class="relative group/score inline-block">
              <span class="text-[#09090B] font-semibold cursor-help border-b border-dotted border-slate-400">Score: {scorecard.total}/100</span>
              <!-- Hover Popover Tooltip -->
              <div class="absolute bottom-full left-0 mb-2 w-56 p-3 bg-neutral-900 text-white text-[11px] rounded-xl shadow-xl opacity-0 invisible group-hover/score:opacity-100 group-hover/score:visible transition-all z-30 pointer-events-none font-sans">
                <div class="font-bold border-b border-neutral-700 pb-1 mb-2 text-white flex justify-between">
                  <span>5-Factor Audit</span>
                  <span class="text-blue-400 font-mono">{scorecard.total}/100</span>
                </div>
                <div class="space-y-1 font-mono text-[10px]">
                  <div class="flex justify-between"><span>Docs & API:</span> <span class="text-emerald-400">{scorecard.docsApi}/25</span></div>
                  <div class="flex justify-between"><span>Pricing & Tier:</span> <span class="text-emerald-400">{scorecard.pricing}/25</span></div>
                  <div class="flex justify-between"><span>Workflow Interop:</span> <span class="text-emerald-400">{scorecard.interop}/20</span></div>
                  <div class="flex justify-between"><span>Domain Health:</span> <span class="text-emerald-400">{scorecard.health}/15</span></div>
                  <div class="flex justify-between"><span>Community Signal:</span> <span class="text-emerald-400">{scorecard.community}/15</span></div>
                </div>
                <div class="mt-2 text-[10px] text-neutral-400 border-t border-neutral-800 pt-1 italic">
                  {scorecard.verdict}
                </div>
              </div>
            </div>
            <span>&bull;</span>
            <span class="text-slate-400 font-mono text-[10px]">{trafficEstimate}</span>
          </div>
        </div>
      </div>

      <span class={`text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full border shrink-0 ${
        tool.pricingType === 'Free' 
          ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
          : tool.pricingType === 'Open Source'
          ? 'bg-purple-50 text-purple-700 border-purple-200'
          : tool.pricingType === 'Freemium'
          ? 'bg-blue-50 text-[#2563EB] border-blue-200'
          : 'bg-slate-100 text-slate-700 border-slate-200'
      }`}>
        {tool.pricingType}
      </span>
    </div>

    <!-- Tagline -->
    <p class="text-xs md:text-sm text-slate-600 leading-relaxed mb-4 line-clamp-2">
      {tool.tagline}
    </p>
  </div>

  <!-- Footer Actions: Interactive Compare Dock Button, Bookmark, Upvote, and Details Link -->
  <div class="pt-3 border-t border-[#E2E8F0] flex items-center justify-between gap-2 text-xs">
    <div class="flex items-center gap-1.5 flex-wrap">
      <!-- Quick Upvote Button -->
      <button
        type="button"
        onclick={`window.toggleToolUpvote && window.toggleToolUpvote('${tool.slug}')`}
        class="tool-upvote-btn flex items-center gap-1 px-2 py-1 rounded-lg border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-blue-50 text-slate-600 hover:text-[#2563EB] transition-colors cursor-pointer"
        title="Upvote tool"
        data-tool-slug={tool.slug}
      >
        <span>▲</span>
        <span class="font-mono text-[11px] font-bold" id={`upvote-${tool.slug}`}>{tool.viewsCount ? Math.min(tool.viewsCount, 99) : 12}</span>
      </button>

      <!-- Bookmark Pin Button -->
      <button
        type="button"
        onclick={`window.toggleToolBookmark && window.toggleToolBookmark('${tool.slug}')`}
        class="tool-bookmark-btn p-1.5 rounded-lg border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-blue-50 text-slate-600 hover:text-[#2563EB] transition-colors cursor-pointer"
        title="Pin to Workspace"
        data-tool-slug={tool.slug}
      >
        <span id={`pin-icon-${tool.slug}`}>📌</span>
      </button>

      <!-- Compare Dock Add Button -->
      <button
        type="button"
        onclick={`window.addToCompare && window.addToCompare('${tool.slug}', '${tool.name.replace(/'/g, "\\'")}', '${tool.websiteUrl}')`}
        class="tool-compare-btn text-[11px] font-bold px-2 py-1 rounded-lg border border-[#E2E8F0] bg-white text-slate-700 hover:border-[#2563EB] hover:text-[#2563EB] transition-colors cursor-pointer shadow-2xs"
        data-tool-slug={tool.slug}
        title="Add to side-by-side comparison dock"
      >
        + Compare
      </button>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a 
        href={`/tools/${tool.slug}`} 
        class="text-slate-700 hover:text-[#09090B] font-semibold px-2.5 py-1 rounded-lg hover:bg-slate-100 transition-colors"
      >
        Details
      </a>
      <a 
        href={tool.websiteUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-[#2563EB] hover:text-[#1D4ED8] font-bold inline-flex items-center gap-0.5 px-2.5 py-1 rounded-lg hover:bg-blue-50 transition-colors"
        title="Visit official website"
      >
        Visit ↗
      </a>
    </div>
  </div>
</div>
