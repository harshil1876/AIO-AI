---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/tools', label: 'Explore Tools' },
  { href: '/finder', label: 'AI Finder' },
  { href: '/categories', label: 'Categories' },
  { href: '/open-source', label: 'Open Source' },
  { href: '/workflows', label: 'Workflows' },
  { href: '/news', label: 'AI News' },
];
---

<header class="bg-canvas/90 backdrop-blur-md border-b border-hairline px-6 py-3.5 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2 group">
        <span class="w-6 h-6 rounded-md bg-ink text-on-primary flex items-center justify-center text-xs font-bold tracking-tighter">AI</span>
        <span class="text-ink font-semibold tracking-tight text-base group-hover:opacity-80 transition-opacity">AI Discovery</span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-sm px-3 py-1.5 rounded-full transition-colors ${
                isActive
                  ? 'text-ink font-medium bg-hairline-soft'
                  : 'text-body hover:text-ink hover:bg-hairline-soft/60'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/finder"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs text-mute border border-hairline bg-canvas-elevated hover:text-ink hover:border-faint px-3 py-1.5 rounded-full transition-all shadow-xs"
      >
        <span>⚡ Try AI Finder</span>
      </a>
      <a
        href="/admin"
        class="text-xs text-body hover:text-ink px-2.5 py-1.5 rounded-md hover:bg-hairline-soft transition-colors"
      >
        Admin
      </a>
    </div>
  </div>
</header>
