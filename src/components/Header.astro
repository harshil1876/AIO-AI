---
interface Props {
  currentPath?: string;
  hideSidebarToggle?: boolean;
}

const { currentPath = Astro.url.pathname, hideSidebarToggle = false } = Astro.props;
---

<header class="bg-white/95 backdrop-blur-md border-b border-[#E2E8F0] px-4 md:px-6 py-2.5 sticky top-0 z-40 transition-colors">
  <div class="flex items-center justify-between gap-4 w-full">
    
    <!-- Left: Universal Sidebar Toggle + Brand Logo -->
    <div class="flex items-center gap-3 shrink-0">
      {!hideSidebarToggle && (
        <button
          type="button"
          id="openSidebarBtn"
          onclick="window.toggleSidebar && window.toggleSidebar()"
          class="p-2 rounded-lg text-slate-700 hover:text-[#09090B] hover:bg-slate-100 transition-colors cursor-pointer border border-[#E2E8F0]"
          title="Toggle Navigation Sidebar"
          aria-label="Toggle Navigation Sidebar"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      )}

      <a href="/dashboard" class="flex items-center gap-2.5 group" id="headerBrandLink">
        <div class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-black text-xs tracking-tight shadow-xs group-hover:bg-[#2563EB] transition-colors">
          AI
        </div>
        <span class="text-[#09090B] font-black tracking-tight text-base group-hover:text-[#2563EB] transition-colors">
          AIO AI
        </span>
      </a>
    </div>

    <!-- Center: Wide Command Palette Trigger (Cmd+K) -->
    <div class="flex-1 max-w-xl mx-auto">
      <button
        type="button"
        onclick="window.openCommandPalette && window.openCommandPalette()"
        class="w-full flex items-center justify-between gap-3 text-xs text-slate-500 bg-[#F8FAFF] hover:bg-white border border-[#E2E8F0] hover:border-[#BFDBFE] focus:border-[#2563EB] px-3.5 py-2 rounded-lg transition-all shadow-xs cursor-pointer group"
        title="Open Command Palette (Cmd+K / Ctrl+K)"
      >
        <div class="flex items-center gap-2.5 truncate">
          <svg class="w-4 h-4 text-slate-400 group-hover:text-[#2563EB] transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <span class="truncate text-left text-slate-500 group-hover:text-slate-700">Search 113+ tools, workflows, models, repos, creators...</span>
        </div>
        <kbd class="hidden sm:inline-flex items-center gap-0.5 text-[10px] font-mono font-medium text-slate-500 bg-white px-2 py-0.5 rounded border border-[#E2E8F0] shadow-2xs group-hover:border-[#BFDBFE]">
          ⌘K
        </kbd>
      </button>
    </div>

    <!-- Right: AI Finder CTA + Docs + Submit + Auth Controls -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Quick AI Finder Button -->
      <a
        href="/finder"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold bg-[#2563EB] text-white hover:bg-[#1D4ED8] px-3 py-1.5 rounded-lg shadow-xs transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
        </svg>
        <span>AI Finder</span>
      </a>

      <!-- Pricing Link -->
      <a
        href="/pricing"
        class={`hidden md:inline-flex text-xs font-semibold px-2.5 py-1.5 rounded-lg transition-colors ${
          currentPath.startsWith('/pricing')
            ? 'text-[#2563EB] bg-[#EFF6FF]'
            : 'text-slate-600 hover:text-ink hover:bg-slate-100'
        }`}
      >
        Pricing
      </a>

      <!-- Docs Link -->
      <a
        href="/docs"
        class={`hidden md:inline-flex text-xs font-semibold px-2.5 py-1.5 rounded-lg transition-colors ${
          currentPath.startsWith('/docs')
            ? 'text-[#2563EB] bg-[#EFF6FF]'
            : 'text-slate-600 hover:text-ink hover:bg-slate-100'
        }`}
      >
        Docs
      </a>

      <!-- Submit Resource Button -->
      <a
        href="/submit"
        class={`hidden lg:inline-flex text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-[#E2E8F0] transition-colors ${
          currentPath.startsWith('/submit')
            ? 'bg-[#EFF6FF] text-[#2563EB] border-[#BFDBFE]'
            : 'bg-white text-slate-700 hover:text-ink hover:border-slate-300'
        }`}
      >
        Submit Tool +
      </a>

      <!-- Auth State Control -->
      <div id="headerAuthNav" class="flex items-center gap-2 border-l border-[#E2E8F0] pl-2 sm:pl-3">
        <!-- Logged Out View -->
        <a
          href={`/login?redirect=${encodeURIComponent(currentPath === '/' ? '/dashboard' : currentPath)}`}
          id="headerLoginLink"
          class="text-xs text-slate-700 hover:text-ink font-semibold px-2.5 py-1.5 rounded-lg hover:bg-slate-100 transition-colors"
        >
          Sign In
        </a>
        <a
          href={`/signup?redirect=${encodeURIComponent(currentPath === '/' ? '/dashboard' : currentPath)}`}
          id="headerSignupLink"
          class="bg-[#09090B] text-white text-xs font-bold px-3 py-1.5 rounded-lg hover:bg-neutral-800 transition-colors shadow-xs"
        >
          Get Started Free
        </a>

        <!-- Logged In View -->
        <a
          href="/profile"
          id="headerProfileLink"
          class="hidden items-center gap-1.5 text-xs text-ink font-semibold px-2.5 py-1.5 rounded-lg border border-[#E2E8F0] bg-[#F8FAFF] hover:border-[#BFDBFE] transition-colors"
          title="Account Profile & Settings"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span id="headerProfileHandle">Profile</span>
        </a>
      </div>
    </div>

  </div>
</header>

<script is:inline>
  function checkHeaderAuth() {
    var loginLink = document.getElementById('headerLoginLink');
    var signupLink = document.getElementById('headerSignupLink');
    var dashboardLink = document.getElementById('headerDashboardLink');
    var profileLink = document.getElementById('headerProfileLink');
    var profileHandle = document.getElementById('headerProfileHandle');
    var brandLink = document.getElementById('headerBrandLink');

    var localUserStr = localStorage.getItem('aio_user');
    var isAuth = false;
    var user = null;
    if (localUserStr) {
      try {
        user = JSON.parse(localUserStr);
        isAuth = true;
      } catch (e) {}
    }
    if (!isAuth) {
      for (var i = 0; i < localStorage.length; i++) {
        var k = localStorage.key(i);
        if (k && (k === 'supabase.auth.token' || (k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1))) {
          isAuth = true;
          try {
            var parsedToken = JSON.parse(localStorage.getItem(k));
            var tokenUser = parsedToken.user || (parsedToken.currentSession && parsedToken.currentSession.user);
            if (tokenUser) {
              user = {
                name: tokenUser.user_metadata?.full_name || tokenUser.email?.split('@')[0],
                email: tokenUser.email
              };
            }
          } catch(e) {}
          break;
        }
      }
    }

    if (isAuth) {
      if (loginLink) loginLink.classList.add('hidden');
      if (signupLink) signupLink.classList.add('hidden');
      if (profileLink) {
        profileLink.classList.remove('hidden');
        profileLink.classList.add('inline-flex');
      }
      if (profileHandle && user && (user.name || user.email)) {
        var namePart = user.name || user.email.split('@')[0];
        profileHandle.textContent = namePart.substring(0, 10);
      }
      if (brandLink) brandLink.setAttribute('href', '/dashboard');
    } else {
      if (loginLink) loginLink.classList.remove('hidden');
      if (signupLink) signupLink.classList.remove('hidden');
      if (profileLink) profileLink.classList.add('hidden');
      if (brandLink) brandLink.setAttribute('href', '/');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkHeaderAuth);
  } else {
    checkHeaderAuth();
  }
</script>
