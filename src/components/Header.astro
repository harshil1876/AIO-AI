---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="bg-white/95 backdrop-blur-md border-b border-[#E2E8F0] px-4 md:px-6 py-2.5 sticky top-0 z-40 transition-colors">
  <div class="flex items-center justify-between gap-4 w-full">
    
    <!-- Left: Mobile Drawer Trigger + Brand Logo -->
    <div class="flex items-center gap-3 shrink-0">
      <button
        type="button"
        id="mobileMenuToggleBtn"
        onclick="window.toggleMobileSidebar && window.toggleMobileSidebar()"
        class="lg:hidden p-2 rounded-md text-slate-700 hover:text-ink hover:bg-slate-100 transition-colors cursor-pointer border border-[#E2E8F0]"
        aria-label="Open Navigation Sidebar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-7 h-7 rounded-md bg-[#09090B] text-white flex items-center justify-center font-bold text-xs tracking-tight shadow-xs group-hover:bg-[#2563EB] transition-colors">
          AIO
        </div>
        <div class="hidden sm:flex items-center gap-1.5">
          <span class="text-ink font-bold tracking-tight text-base group-hover:text-[#2563EB] transition-colors">AIO AI</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] font-semibold border border-[#BFDBFE]">v2.0</span>
        </div>
      </a>
    </div>

    <!-- Center: Wide Prominent Command Palette Trigger (Cmd+K) -->
    <div class="flex-1 max-w-xl mx-auto">
      <button
        type="button"
        onclick="window.openCommandPalette && window.openCommandPalette()"
        class="w-full flex items-center justify-between gap-3 text-xs text-slate-500 bg-[#F8FAFF] hover:bg-white border border-[#E2E8F0] hover:border-[#BFDBFE] focus:border-[#2563EB] px-3.5 py-2 rounded-lg transition-all shadow-xs cursor-pointer group"
        title="Open Command Palette (Cmd+K / Ctrl+K)"
      >
        <div class="flex items-center gap-2.5 truncate">
          <svg class="w-4 h-4 text-slate-400 group-hover:text-[#2563EB] transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <span class="truncate text-left text-slate-500 group-hover:text-slate-700">Search 113+ tools, workflows, models, repos, creators...</span>
        </div>
        <kbd class="hidden sm:inline-flex items-center gap-0.5 text-[10px] font-mono font-medium text-slate-500 bg-white px-2 py-0.5 rounded border border-[#E2E8F0] shadow-2xs group-hover:border-[#BFDBFE]">
          ⌘K
        </kbd>
      </button>
    </div>

    <!-- Right: AI Finder CTA + Docs + Submit + Auth Controls -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Quick AI Finder Button -->
      <a
        href="/finder"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold bg-[#2563EB] text-white hover:bg-[#1D4ED8] px-3 py-1.5 rounded-lg shadow-xs transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
        </svg>
        <span>AI Finder</span>
      </a>

      <!-- Docs Link -->
      <a
        href="/docs"
        class={`hidden md:inline-flex text-xs font-medium px-2.5 py-1.5 rounded-md transition-colors ${
          currentPath.startsWith('/docs')
            ? 'text-[#2563EB] bg-[#EFF6FF] font-semibold'
            : 'text-slate-600 hover:text-ink hover:bg-slate-100'
        }`}
      >
        Docs
      </a>

      <!-- Submit Resource Button -->
      <a
        href="/submit"
        class={`hidden lg:inline-flex text-xs font-medium px-2.5 py-1.5 rounded-md border border-[#E2E8F0] transition-colors ${
          currentPath.startsWith('/submit')
            ? 'bg-[#EFF6FF] text-[#2563EB] border-[#BFDBFE]'
            : 'bg-white text-slate-700 hover:text-ink hover:border-slate-300'
        }`}
      >
        Submit Tool +
      </a>

      <!-- Auth State Control -->
      <div id="headerAuthNav" class="flex items-center gap-2 border-l border-[#E2E8F0] pl-2 sm:pl-3">
        <a
          href="/login"
          id="headerLoginLink"
          class="text-xs text-slate-700 hover:text-ink font-medium px-2 py-1.5 rounded-md hover:bg-slate-100 transition-colors"
        >
          Sign In
        </a>
        <a
          href="/signup"
          id="headerSignupLink"
          class="bg-[#09090B] text-white text-xs font-semibold px-3 py-1.5 rounded-lg hover:bg-neutral-800 transition-colors shadow-xs"
        >
          Sign Up
        </a>
        <a
          href="/profile"
          id="headerProfileLink"
          class="hidden items-center gap-1.5 text-xs text-ink font-semibold px-2.5 py-1.5 rounded-lg border border-[#E2E8F0] bg-[#F8FAFF] hover:border-[#BFDBFE] transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Profile</span>
        </a>
      </div>
    </div>

  </div>
</header>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  async function checkHeaderAuth() {
    const loginLink = document.getElementById('headerLoginLink');
    const signupLink = document.getElementById('headerSignupLink');
    const profileLink = document.getElementById('headerProfileLink');

    let userLoggedIn = false;

    // 1. Check local session storage fallback
    const localUser = localStorage.getItem('aio_user');
    if (localUser) {
      userLoggedIn = true;
    }

    // 2. Check Supabase auth if configured
    if (isSupabaseConfigured) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session && session.user) {
          userLoggedIn = true;
        }
      } catch (e) {
        // Fallback to local
      }
    }

    if (userLoggedIn) {
      loginLink?.classList.add('hidden');
      signupLink?.classList.add('hidden');
      profileLink?.classList.remove('hidden');
      profileLink?.classList.add('inline-flex');
    } else {
      loginLink?.classList.remove('hidden');
      signupLink?.classList.remove('hidden');
      profileLink?.classList.add('hidden');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkHeaderAuth);
  } else {
    checkHeaderAuth();
  }
</script>
