---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/tools', label: 'Explore Tools' },
  { href: '/compare', label: 'Compare' },
  { href: '/finder', label: 'AI Finder' },
  { href: '/categories', label: 'Categories' },
  { href: '/workflows', label: 'Workflows' },
  { href: '/stack-builder', label: 'Stack Builder' },
  { href: '/community', label: 'Community' },
  { href: '/utilities/token-calculator', label: 'Cost Calculator' },
  { href: '/news', label: 'AI News' },
];
---

<header class="bg-canvas/90 backdrop-blur-md border-b border-hairline px-6 py-3.5 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2 group">
        <span class="w-6 h-6 rounded-md bg-ink text-on-primary flex items-center justify-center text-xs font-bold tracking-tighter">AI</span>
        <span class="text-ink font-semibold tracking-tight text-base group-hover:opacity-80 transition-opacity">AI Discovery</span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-sm px-3 py-1.5 rounded-full transition-colors ${
                isActive
                  ? 'text-ink font-medium bg-hairline-soft'
                  : 'text-body hover:text-ink hover:bg-hairline-soft/60'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/finder"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs text-mute border border-hairline bg-canvas-elevated hover:text-ink hover:border-faint px-3 py-1.5 rounded-full transition-all shadow-xs"
      >
        <svg class="w-3.5 h-3.5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
        </svg>
        <span>Try AI Finder</span>
      </a>

      <div id="headerAuthNav" class="flex items-center gap-2">
        <a
          href="/login"
          id="headerLoginLink"
          class="text-xs text-body hover:text-ink px-2.5 py-1.5 rounded-md hover:bg-hairline-soft transition-colors font-medium"
        >
          Log In
        </a>
        <a
          href="/signup"
          id="headerSignupLink"
          class="bg-ink text-on-primary text-xs font-medium px-3 py-1.5 rounded-pill hover:bg-black transition-colors"
        >
          Sign Up
        </a>
        <a
          href="/profile"
          id="headerProfileLink"
          class="hidden items-center gap-1.5 text-xs text-ink font-medium px-3 py-1.5 rounded-pill border border-hairline bg-canvas-elevated hover:border-faint transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Profile</span>
        </a>
      </div>

      <a
        href="/admin"
        class="text-xs text-mute hover:text-ink px-2 py-1.5 rounded-md hover:bg-hairline-soft transition-colors"
      >
        Admin
      </a>
    </div>
  </div>
</header>

<script>
  import { supabase } from '../lib/supabase';

  const loginLink = document.getElementById('headerLoginLink');
  const signupLink = document.getElementById('headerSignupLink');
  const profileLink = document.getElementById('headerProfileLink');

  async function checkUser() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session && session.user) {
      loginLink?.classList.add('hidden');
      signupLink?.classList.add('hidden');
      profileLink?.classList.remove('hidden');
      profileLink?.classList.add('inline-flex');
    } else {
      loginLink?.classList.remove('hidden');
      signupLink?.classList.remove('hidden');
      profileLink?.classList.add('hidden');
    }
  }

  checkUser();
</script>
