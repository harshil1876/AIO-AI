---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import CommandPalette from '../components/CommandPalette.astro';
import AuthGateModal from '../components/AuthGateModal.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
  hideSidebar?: boolean;
}

const { 
  title = "AIO AI — All-In-One AI Intelligence, Tools, Workflows & Creators", 
  description = "The unified, intent-driven AI discovery platform: 113+ verified tools, 16+ production workflows, 20+ open-source repos, 18+ YouTube creators, daily Neo-Brutalist tech news, and built-in creator utilities.",
  canonicalUrl = Astro.url.href,
  ogType = "website",
  jsonLd,
  hideSidebar = false
} = Astro.props;

const currentPath = Astro.url.pathname;

const defaultJsonLd = jsonLd || {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AIO AI Discovery Platform",
  "url": Astro.site ? Astro.site.toString() : "https://aio-ai.pages.dev",
  "description": description
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Structured JSON-LD Data -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultJsonLd)} />
  </head>
  <body class="bg-[#FFFFFF] text-[#334155] font-sans antialiased selection:bg-[#2563EB] selection:text-white min-h-screen">
    {hideSidebar ? (
      <slot />
    ) : (
      <div class="flex min-h-screen w-full relative" id="appShellWrapper">
        <Sidebar currentPath={currentPath} />
        <div class="flex-1 flex flex-col min-w-0 bg-[#FFFFFF] transition-all duration-200" id="mainContentContainer">
          <slot />
        </div>
      </div>
    )}
    <CommandPalette />
    <AuthGateModal />
  </body>
</html>
