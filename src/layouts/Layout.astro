---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import CommandPalette from '../components/CommandPalette.astro';
import AuthGateModal from '../components/AuthGateModal.astro';
import CompareDock from '../components/CompareDock.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
  hideSidebar?: boolean;
}

const { 
  title = "AIO AI — All-In-One AI Intelligence, Tools, Workflows & Creators", 
  description = "The unified, intent-driven AI discovery platform: 113+ verified tools, 16+ production workflows, 20+ open-source repos, 18+ YouTube creators, daily Neo-Brutalist tech news, and built-in creator utilities.",
  canonicalUrl = Astro.url.href,
  ogType = "website",
  jsonLd,
  hideSidebar = false
} = Astro.props;

const currentPath = Astro.url.pathname;

const defaultJsonLd = jsonLd || {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AIO AI Discovery Platform",
  "url": Astro.site ? Astro.site.toString() : "https://aio-ai.pages.dev",
  "description": description
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Structured JSON-LD Data -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultJsonLd)} />

    <!-- Universal Route Guard for Internal Workspace Routes -->
    <script is:inline>
      (function() {
        // 1. Detect if returning from Supabase OAuth with tokens in hash or code in query
        var hash = window.location.hash || '';
        var search = window.location.search || '';
        var hasOAuthToken = hash.indexOf('access_token=') !== -1 || 
                            hash.indexOf('error=') !== -1 ||
                            search.indexOf('code=') !== -1;

        var path = window.location.pathname.replace(/\/+$/, '') || '/';

        if (hasOAuthToken) {
          // If OAuth callback landed on the marketing home '/', immediately forward to '/dashboard' with the hash and search intact
          if (path === '' || path === '/') {
            window.location.replace('/dashboard' + search + hash);
            return;
          }
          // If already on /dashboard or another route with incoming tokens, do NOT bounce to /login!
          // Allow the page's Supabase auth script to process the session tokens.
          return;
        }

        // 2. Normal Route Guard for Unauthenticated Public Visitors
        var isPublic = path === '' || 
                       path === '/' || 
                       path === '/login' || 
                       path === '/signup' || 
                       path === '/pricing' || 
                       path === '/docs' || 
                       path.indexOf('/docs/') === 0 || 
                       path === '/privacy' || 
                       path === '/terms' || 
                       path === '/guidelines' || 
                       path === '/disclosure' || 
                       path === '/404';

        function checkAuth() {
          if (localStorage.getItem('aio_user')) return true;
          if (localStorage.getItem('supabase.auth.token')) return true;
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && (k === 'supabase.auth.token' || (k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1))) {
              return true;
            }
          }
          return false;
        }

        // Redirect unauthenticated visitors attempting to access internal features
        if (!isPublic && !checkAuth()) {
          var target = window.location.pathname + window.location.search;
          window.location.replace('/login?redirect=' + encodeURIComponent(target));
        }
      })();
    </script>
  </head>
  <body class="bg-[#FFFFFF] text-[#334155] font-sans antialiased selection:bg-[#2563EB] selection:text-white min-h-screen">
    {hideSidebar ? (
      <slot />
    ) : (
      <div class="flex min-h-screen w-full relative" id="appShellWrapper">
        <Sidebar currentPath={currentPath} />
        <div class="flex-1 flex flex-col min-w-0 bg-[#FFFFFF] transition-all duration-200" id="mainContentContainer">
          <slot />
        </div>
      </div>
    )}
    <CommandPalette />
    <AuthGateModal />
    <CompareDock />

    <script is:inline>
      (function() {
        // Global Tool Upvote Handler
        window.toggleToolUpvote = function(slug) {
          var key = 'aio_upvoted_' + slug;
          var hasUpvoted = localStorage.getItem(key) === 'true';
          var countEl = document.getElementById('upvote-' + slug);
          var cur = countEl ? parseInt(countEl.textContent || '0', 10) : 0;

          if (hasUpvoted) {
            localStorage.removeItem(key);
            if (countEl) countEl.textContent = String(Math.max(0, cur - 1));
          } else {
            localStorage.setItem(key, 'true');
            if (countEl) countEl.textContent = String(cur + 1);
          }
        };

        // Global Tool Bookmark Handler
        window.toggleToolBookmark = function(slug) {
          var bookmarks = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
          var isSaved = bookmarks.includes(slug);
          if (isSaved) {
            bookmarks = bookmarks.filter(function(s) { return s !== slug; });
          } else {
            bookmarks.push(slug);
          }
          localStorage.setItem('aio_bookmarks', JSON.stringify(bookmarks));
          window.dispatchEvent(new CustomEvent('aio:bookmarks-update', { detail: { bookmarks: bookmarks } }));

          // Update icon if present
          var iconEl = document.getElementById('pin-icon-' + slug);
          if (iconEl) iconEl.textContent = isSaved ? '📌' : '✓';
        };
      })();
    </script>
  </body>
</html>
