---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RepoQuickstartDrawer from '../components/RepoQuickstartDrawer.astro';
import { OPEN_SOURCE_REPOS } from '../data/openSourceData';
import { TOP_AI_DEVELOPERS_ORGS } from '../services/githubLiveService';

// Sort verified repos by stars descending
const trendingRepos = [...OPEN_SOURCE_REPOS].sort((a, b) => {
  const parseStars = (str: string) => {
    const num = parseFloat(str.replace(/[^0-9.]/g, ''));
    return str.includes('k') ? num * 1000 : num;
  };
  return parseStars(b.stars) - parseStars(a.stars);
});

const languages = ['All Languages', 'Python', 'TypeScript', 'Rust', 'C++', 'Jupyter Notebook', 'Go'];
---

<Layout 
  title="GitHub Trending AI Repositories & Organizations | AIO AI"
  description="Discover trending open-source AI projects, GitHub star velocity, top AI organizations, and local hardware VRAM requirements."
>
  <Header currentPath="/trending" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    
    <!-- Hero Header -->
    <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-96 h-96 bg-emerald-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-400/30 bg-blue-500/10 text-[11px] font-mono font-bold text-blue-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>GITHUB TRENDING & VELOCITY TELEMETRY • LIVE</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            Trending AI Repositories
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            Real-time star momentum across AI runtimes, agent frameworks, diffusion GUIs, and frontier open weights with multi-language and velocity filters.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a 
            href="/open-source" 
            class="bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-xs transition-colors"
          >
            All 88 Hub Repos &rarr;
          </a>
          <a 
            href="https://github.com/trending" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-sm transition-colors inline-flex items-center gap-1.5"
          >
            <span>Live GitHub Trending</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Mode Selector & Filter Toolbar -->
    <section class="card-aurora p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <!-- View Mode: Repositories vs Developers & Orgs -->
      <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-mono font-bold w-full sm:w-auto">
        <button 
          type="button" 
          id="tabRepos" 
          class="view-mode-btn px-4 py-1.5 rounded-lg bg-slate-900 text-white shadow-xs cursor-pointer transition-all"
        >
          Repositories ({trendingRepos.length})
        </button>
        <button 
          type="button" 
          id="tabDevs" 
          class="view-mode-btn px-4 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer transition-all"
        >
          Developers &amp; Orgs ({TOP_AI_DEVELOPERS_ORGS.length})
        </button>
      </div>

      <!-- Filter Controls: Language & Date Range -->
      <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto justify-end text-xs">
        <div class="flex items-center gap-1.5">
          <span class="text-[11px] font-mono text-slate-400 font-bold">Language:</span>
          <select 
            id="languageFilter" 
            class="bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs text-slate-800 font-bold outline-none cursor-pointer"
          >
            {languages.map(l => (
              <option value={l === 'All Languages' ? 'all' : l.toLowerCase()}>{l}</option>
            ))}
          </select>
        </div>

        <div class="flex items-center gap-1.5">
          <span class="text-[11px] font-mono text-slate-400 font-bold">Range:</span>
          <select 
            id="dateRangeFilter" 
            class="bg-white border border-slate-200 rounded-xl px-3 py-1.5 text-xs text-slate-800 font-bold outline-none cursor-pointer"
          >
            <option value="daily">Today</option>
            <option value="weekly" selected>This Week</option>
            <option value="monthly">This Month</option>
          </select>
        </div>
      </div>
    </section>

    <!-- Main Content Container -->
    <div class="space-y-6">
      
      <!-- VIEW 1: REPOSITORIES LEADERBOARD -->
      <div class="space-y-3.5" id="reposSection">
        {trendingRepos.map((repo, idx) => {
          const [owner, name] = (repo.repo || '').split('/');
          return (
            <article 
              class="trending-card card-aurora p-5 sm:p-6 transition-all flex flex-col md:flex-row md:items-center justify-between gap-6"
              data-owner={owner || ''}
              data-repo={name || repo.slug}
              data-language={repo.language.toLowerCase()}
            >
              <div class="flex items-start gap-4">
                <span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-900 font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 border border-slate-200">
                  #{idx + 1}
                </span>
                <div class="space-y-1.5">
                  <div class="flex flex-wrap items-center gap-2">
                    <h2 class="text-base font-black text-slate-900 hover:text-blue-600 transition-colors">
                      <a href={`/open-source/${repo.slug}`}>
                        {repo.name}
                      </a>
                    </h2>
                    <span class="text-[10px] font-mono uppercase font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200">
                      {repo.category}
                    </span>
                    <span class="text-xs font-mono text-slate-400 font-medium">{repo.repo}</span>
                    <span class="text-[10px] font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
                      Verified Active
                    </span>
                  </div>

                  <p class="text-xs text-slate-600 line-clamp-2 max-w-3xl leading-relaxed">
                    {repo.oneMinuteSummary || repo.description}
                  </p>

                  <div class="flex items-center gap-3 text-xs font-mono text-slate-400 pt-1">
                    <span>Lang: <strong class="text-slate-800">{repo.language}</strong></span>
                    <span>&bull;</span>
                    <span>VRAM: <strong class="text-emerald-700">{repo.hardwareSpecs?.minVramGb || '8GB'}</strong></span>
                    <span>&bull;</span>
                    <span>License: <strong class="text-slate-800">{repo.license}</strong></span>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between md:flex-col md:items-end gap-3 shrink-0 pt-3 md:pt-0 border-t md:border-t-0 border-slate-100">
                <div class="text-right">
                  <div class="text-base font-black text-slate-900 font-mono live-stars">★ {repo.stars}</div>
                  <div class="text-[11px] font-mono text-slate-400 live-forks">{repo.forks} forks</div>
                </div>

                <div class="flex items-center gap-2">
                  <button 
                    type="button" 
                    class="quickstart-trigger-btn font-mono text-[11px] font-bold text-blue-700 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-xl transition-colors cursor-pointer inline-flex items-center gap-1 shadow-2xs"
                    data-repo-json={JSON.stringify(repo)}
                  >
                    <span>&gt;_ Quickstart</span>
                  </button>
                  <a 
                    href={`/open-source/${repo.slug}`} 
                    class="bg-slate-900 hover:bg-blue-600 text-white text-xs font-bold px-3.5 py-1.5 rounded-xl shadow-xs transition-colors inline-flex items-center gap-1"
                  >
                    Setup Guide &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- VIEW 2: DEVELOPERS & ORGANIZATIONS LEADERBOARD (Hidden by default) -->
      <div class="hidden grid grid-cols-1 md:grid-cols-2 gap-4" id="devsSection">
        {TOP_AI_DEVELOPERS_ORGS.map((dev, idx) => (
          <div class="card-aurora p-5 space-y-4 flex flex-col justify-between">
            <div class="flex items-start gap-4">
              <span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-900 font-mono font-bold text-xs flex items-center justify-center shrink-0 border border-slate-200">
                #{idx + 1}
              </span>
              <img 
                src={dev.avatarUrl} 
                alt={dev.name} 
                class="w-12 h-12 rounded-2xl border border-slate-200 bg-slate-50 object-cover shrink-0 shadow-xs"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&background=2563EB&color=fff&size=128';"
              />
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="font-black text-sm text-slate-900 hover:text-blue-600 truncate">
                    <a href={dev.htmlUrl} target="_blank" rel="noopener noreferrer">{dev.name}</a>
                  </h3>
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200">
                    {dev.category}
                  </span>
                </div>
                <div class="text-xs text-slate-400 font-mono">@{dev.login}</div>
              </div>
            </div>

            <!-- Flagship Project Card -->
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-1">
              <div class="text-[10px] font-mono text-slate-400 uppercase tracking-wider font-bold flex items-center justify-between">
                <span>Flagship Project</span>
                <span class="text-blue-600 font-bold">{dev.totalStarsEstimate} stars</span>
              </div>
              <div class="font-bold text-slate-900">{dev.popularRepo}</div>
              <p class="text-slate-500 text-[11px] line-clamp-2 leading-relaxed">{dev.popularRepoDesc}</p>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-[11px] font-mono text-slate-400">Verified AI Organization</span>
              <a 
                href={dev.htmlUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-bold text-blue-600 hover:underline inline-flex items-center gap-1"
              >
                <span>View Profile</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>

  <RepoQuickstartDrawer />
  <Footer />
</Layout>

<script>
  import { fetchLiveRepoStats } from '../services/githubLiveService';

  document.addEventListener('DOMContentLoaded', () => {
    const tabRepos = document.getElementById('tabRepos');
    const tabDevs = document.getElementById('tabDevs');
    const reposSection = document.getElementById('reposSection');
    const devsSection = document.getElementById('devsSection');
    const languageFilter = document.getElementById('languageFilter') as HTMLSelectElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.trending-card');

    // Quickstart Drawer click handler
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest('.quickstart-trigger-btn');
      if (btn) {
        const raw = btn.getAttribute('data-repo-json');
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            if ((window as any).aioOpenQuickstartDrawer) {
              (window as any).aioOpenQuickstartDrawer(parsed);
            }
          } catch(err) {}
        }
      }
    });

    // Tab Switching
    tabRepos?.addEventListener('click', () => {
      tabRepos.className = 'view-mode-btn px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white cursor-pointer shadow-xs transition-all';
      tabDevs!.className = 'view-mode-btn px-4 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 cursor-pointer transition-all';
      reposSection?.classList.remove('hidden');
      devsSection?.classList.add('hidden');
    });

    tabDevs?.addEventListener('click', () => {
      tabDevs.className = 'view-mode-btn px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white cursor-pointer shadow-xs transition-all';
      tabRepos!.className = 'view-mode-btn px-4 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 cursor-pointer transition-all';
      devsSection?.classList.remove('hidden');
      reposSection?.classList.add('hidden');
    });

    // Language Filtering
    languageFilter?.addEventListener('change', () => {
      const selectedLang = languageFilter.value.toLowerCase();
      cards.forEach(card => {
        const cardLang = card.getAttribute('data-language') || '';
        if (selectedLang === 'all' || cardLang.includes(selectedLang)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });

    // Hydrate Live GitHub Stats
    cards.forEach(async (card) => {
      const owner = card.getAttribute('data-owner');
      const repo = card.getAttribute('data-repo');
      if (owner && repo) {
        try {
          const stats = await fetchLiveRepoStats(owner, repo);
          if (stats) {
            const starEl = card.querySelector('.live-stars');
            const forkEl = card.querySelector('.live-forks');
            if (starEl && stats.formattedStars) starEl.textContent = `★ ${stats.formattedStars}`;
            if (forkEl && stats.formattedForks) forkEl.textContent = `${stats.formattedForks} forks`;
          }
        } catch (e) {}
      }
    });
  });
</script>
