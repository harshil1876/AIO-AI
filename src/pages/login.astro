---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Log In | AI Discovery Platform" description="Log in to your AI Discovery account to manage your bookmarks and submit reviews.">
  <Header currentPath="/login" />

  <main class="w-full flex-1 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm bg-canvas-elevated border border-hairline rounded-lg p-8 shadow-xs">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-semibold text-ink tracking-tight mb-1.5">Welcome back</h1>
        <p class="text-xs text-mute">Enter your credentials to access your account</p>
      </div>

      <div id="errorAlert" class="hidden mb-4 p-3 rounded-md bg-red-50 border border-red-200 text-xs text-red-700"></div>
      <div id="successAlert" class="hidden mb-4 p-3 rounded-md bg-emerald-50 border border-emerald-200 text-xs text-emerald-700"></div>

      <form id="loginForm" class="flex flex-col gap-4 text-xs">
        <div>
          <label class="block font-medium text-body mb-1">Email address</label>
          <input 
            type="email" 
            id="email" 
            placeholder="you@example.com" 
            required
            class="w-full bg-canvas border border-hairline hover:border-faint focus:border-ink rounded-sm px-3 py-2 text-ink placeholder-faint outline-none transition-colors"
          />
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="font-medium text-body">Password</label>
            <a href="#" class="text-mute hover:text-ink transition-colors">Forgot?</a>
          </div>
          <input 
            type="password" 
            id="password" 
            placeholder="••••••••" 
            required
            class="w-full bg-canvas border border-hairline hover:border-faint focus:border-ink rounded-sm px-3 py-2 text-ink placeholder-faint outline-none transition-colors"
          />
        </div>

        <button 
          type="submit" 
          id="submitBtn"
          class="w-full mt-2 bg-ink text-on-primary font-medium py-2.5 rounded-pill hover:bg-black transition-colors cursor-pointer shadow-xs text-center"
        >
          Sign In
        </button>
      </form>

      <div class="mt-6 pt-6 border-t border-hairline text-center text-xs text-mute">
        <span>Don't have an account?</span>
        <a href="/signup" class="text-ink font-medium hover:underline ml-1">Sign up</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const errorAlert = document.getElementById('errorAlert') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in...';

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorAlert.textContent = error.message;
      errorAlert.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign In';
    } else if (data.session) {
      window.location.href = '/profile';
    }
  });
</script>
