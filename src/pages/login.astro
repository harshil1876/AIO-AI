---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Log In | AIO AI" description="Log in to your AIO AI account to manage your bookmarks, workflows, and submit verified reviews.">
  <Header currentPath="/login" />

  <main class="w-full flex-1 flex items-center justify-center px-6 py-16 bg-canvas">
    <div class="w-full max-w-md bg-white border border-[#E2E8F0] rounded-2xl p-8 shadow-xs">
      <div class="text-center mb-6">
        <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-200 text-primary flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
        </div>
        <h1 class="text-2xl font-black text-ink tracking-tight mb-1.5">Welcome Back</h1>
        <p class="text-xs text-neutral-500">Sign in to manage bookmarks, export stacks, and submit reviews</p>
      </div>

      <!-- Quick Demo Sign In Button -->
      <button 
        id="demoLoginBtn"
        type="button"
        class="w-full py-2.5 px-4 mb-4 rounded-xl bg-blue-50 border border-blue-200 text-primary text-xs font-bold hover:bg-blue-100 transition-colors cursor-pointer flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
        </svg>
        <span>Instant Demo Login (One Click)</span>
      </button>

      <div class="flex items-center gap-2 my-4 text-neutral-400 text-xs">
        <div class="h-px bg-neutral-200 flex-1"></div>
        <span class="text-[10px] font-mono uppercase">or with supabase credentials</span>
        <div class="h-px bg-neutral-200 flex-1"></div>
      </div>

      <div id="errorAlert" class="hidden mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-xs text-red-700 font-medium"></div>

      <form id="loginForm" class="flex flex-col gap-4 text-xs">
        <div>
          <label class="block font-semibold text-ink mb-1">Email address</label>
          <input 
            type="email" 
            id="email" 
            placeholder="you@example.com" 
            required
            class="w-full bg-surface border border-[#E2E8F0] focus:border-primary rounded-lg px-3 py-2.5 text-ink outline-none transition-colors font-sans"
          />
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="font-semibold text-ink">Password</label>
            <a href="#" class="text-neutral-400 hover:text-ink transition-colors">Forgot?</a>
          </div>
          <input 
            type="password" 
            id="password" 
            placeholder="••••••••" 
            required
            class="w-full bg-surface border border-[#E2E8F0] focus:border-primary rounded-lg px-3 py-2.5 text-ink outline-none transition-colors font-sans"
          />
        </div>

        <button 
          type="submit" 
          id="submitBtn"
          class="w-full mt-2 bg-primary text-white font-bold py-2.5 rounded-xl hover:bg-blue-700 transition-colors cursor-pointer shadow-xs text-center"
        >
          Sign In
        </button>
      </form>

      <div class="mt-6 pt-6 border-t border-[#E2E8F0] text-center text-xs text-neutral-500">
        <span>Don't have an account?</span>
        <a href="/signup" class="text-primary font-bold hover:underline ml-1">Sign up</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const errorAlert = document.getElementById('errorAlert') as HTMLDivElement;
  const demoLoginBtn = document.getElementById('demoLoginBtn');

  // Check redirect param
  const urlParams = new URLSearchParams(window.location.search);
  const redirectTarget = urlParams.get('redirect') || '/profile';

  demoLoginBtn?.addEventListener('click', () => {
    const demoUser = {
      id: 'demo-usr-994',
      email: 'builder@aio-ai.dev',
      role: 'member',
      created_at: new Date().toISOString()
    };
    localStorage.setItem('aio_user', JSON.stringify(demoUser));
    if (redirectTarget.includes('admin')) {
      localStorage.setItem('aio_admin_unlocked', 'true');
    }
    window.location.href = redirectTarget;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in...';

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorAlert.textContent = error.message;
      errorAlert.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign In';
    } else if (data.session) {
      localStorage.setItem('aio_user', JSON.stringify({
        id: data.session.user.id,
        email: data.session.user.email,
        role: 'member',
        created_at: new Date().toISOString()
      }));
      window.location.href = redirectTarget;
    }
  });
</script>
