---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Log In to Workspace | AIO AI" 
  description="Sign in to your AIO AI account to manage your saved tools, workflows, custom stacks, and benchmarks."
  hideSidebar={true}
>
  <!-- Public Minimal Header -->
  <header class="border-b border-[#E2E8F0] bg-white px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-black text-xs tracking-tight">
        AI
      </div>
      <span class="text-[#09090B] font-black tracking-tight text-base">AIO AI</span>
    </a>
    <div class="text-xs text-slate-500">
      Don't have an account? <a href="/signup" class="text-[#2563EB] font-bold hover:underline ml-1">Sign Up</a>
    </div>
  </header>

  <main class="w-full flex-1 flex items-center justify-center px-6 py-14 bg-[#F8FAFF] min-h-[calc(100vh-140px)]">
    <div class="w-full max-w-md bg-white border border-[#E2E8F0] rounded-2xl p-8 shadow-sm hover:shadow-md transition-all">
      
      <div class="text-center mb-6">
        <h1 class="text-2xl font-black text-[#09090B] tracking-tight mb-1.5">Welcome to Workspace</h1>
        <p class="text-xs text-slate-500">Sign in to sync saved tools, active stacks, and reputation points</p>
      </div>

      <!-- 1. Prominent "Continue with Google" Button (Top) -->
      <button 
        id="googleLoginBtn"
        type="button"
        class="w-full py-3 px-4 mb-4 rounded-xl bg-white hover:bg-[#F8FAFF] border border-[#E2E8F0] text-[#09090B] text-xs font-bold transition-all shadow-xs hover:border-[#2563EB] cursor-pointer flex items-center justify-center gap-3"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
        <span>Continue with Google</span>
      </button>

      <div class="flex items-center gap-2 my-4 text-slate-400 text-xs">
        <div class="h-px bg-slate-200 flex-1"></div>
        <span class="text-[10px] font-mono uppercase">or with email credentials</span>
        <div class="h-px bg-slate-200 flex-1"></div>
      </div>

      <div id="errorAlert" class="hidden mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700 font-medium"></div>

      <form id="loginForm" class="flex flex-col gap-4 text-xs">
        <div>
          <label class="block font-bold text-[#09090B] mb-1">Email address</label>
          <input 
            type="email" 
            id="email" 
            placeholder="you@example.com" 
            required
            class="w-full bg-[#F8FAFF] border border-[#E2E8F0] focus:border-[#2563EB] rounded-xl px-3.5 py-2.5 text-[#09090B] outline-none transition-colors font-sans"
          />
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="font-bold text-[#09090B]">Password</label>
            <a href="#" class="text-slate-400 hover:text-ink transition-colors">Forgot password?</a>
          </div>
          <input 
            type="password" 
            id="password" 
            placeholder="••••••••" 
            required
            class="w-full bg-[#F8FAFF] border border-[#E2E8F0] focus:border-[#2563EB] rounded-xl px-3.5 py-2.5 text-[#09090B] outline-none transition-colors font-sans"
          />
        </div>

        <button 
          type="submit" 
          id="submitBtn"
          class="w-full mt-2 bg-[#2563EB] text-white font-bold py-3 rounded-xl hover:bg-[#1D4ED8] transition-colors cursor-pointer shadow-xs text-center"
        >
          Sign In to Workspace
        </button>
      </form>

      <!-- Instant Demo Sign-In Option -->
      <div class="mt-5 pt-4 border-t border-[#E2E8F0] text-center">
        <button
          type="button"
          id="demoLoginBtn"
          class="w-full py-2.5 px-3 rounded-xl bg-slate-50 hover:bg-slate-100 border border-[#E2E8F0] text-slate-700 text-xs font-semibold transition-colors cursor-pointer flex items-center justify-center gap-2"
        >
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
          <span>Instant Demo Sign-In (Builder Mode)</span>
        </button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const errorAlert = document.getElementById('errorAlert') as HTMLDivElement;
  const googleLoginBtn = document.getElementById('googleLoginBtn');
  const demoLoginBtn = document.getElementById('demoLoginBtn');

  // Ensure redirect target defaults to /dashboard rather than public landing page
  const urlParams = new URLSearchParams(window.location.search);
  const rawRedirect = urlParams.get('redirect');
  const redirectTarget = (rawRedirect && rawRedirect !== '/') ? rawRedirect : '/dashboard';

  // 1. If active session already exists or arrives via OAuth, redirect immediately
  supabase.auth.onAuthStateChange((_event, session) => {
    if (session?.user) {
      localStorage.setItem('aio_user', JSON.stringify({
        id: session.user.id,
        email: session.user.email,
        name: session.user.user_metadata?.full_name || session.user.email?.split('@')[0] || 'Builder',
        role: 'member',
        authProvider: session.user.app_metadata?.provider || 'google',
        created_at: new Date().toISOString()
      }));
      window.location.replace(redirectTarget);
    }
  });

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session?.user) {
      localStorage.setItem('aio_user', JSON.stringify({
        id: session.user.id,
        email: session.user.email,
        name: session.user.user_metadata?.full_name || session.user.email?.split('@')[0] || 'Builder',
        role: 'member',
        authProvider: session.user.app_metadata?.provider || 'google',
        created_at: new Date().toISOString()
      }));
      window.location.replace(redirectTarget);
    }
  });

  // 2. Real Google OAuth
  googleLoginBtn?.addEventListener('click', async () => {
    errorAlert?.classList.add('hidden');
    if (googleLoginBtn) {
      googleLoginBtn.setAttribute('disabled', 'true');
    }
    try {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: window.location.origin + redirectTarget
        }
      });
      if (error) {
        if (errorAlert) {
          errorAlert.textContent = error.message;
          errorAlert.classList.remove('hidden');
        }
        if (googleLoginBtn) {
          googleLoginBtn.removeAttribute('disabled');
        }
      }
    } catch (err: any) {
      if (errorAlert) {
        errorAlert.textContent = err.message || 'Failed to initiate Google sign-in';
        errorAlert.classList.remove('hidden');
      }
      if (googleLoginBtn) {
        googleLoginBtn.removeAttribute('disabled');
      }
    }
  });

  // 3. Real Email / Password Login
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in...';

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorAlert.textContent = error.message;
        errorAlert.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign In to Workspace';
        return;
      }

      if (data.session) {
        localStorage.setItem('aio_user', JSON.stringify({
          id: data.session.user.id,
          email: data.session.user.email,
          name: data.session.user.user_metadata?.full_name || data.session.user.email?.split('@')[0] || 'Builder',
          role: 'member',
          authProvider: 'email',
          created_at: new Date().toISOString()
        }));

        window.location.href = redirectTarget;
      }
    } catch (err: any) {
      errorAlert.textContent = err.message || 'An unexpected error occurred';
      errorAlert.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign In to Workspace';
    }
  });

  // 4. Instant Demo Sign-In
  demoLoginBtn?.addEventListener('click', () => {
    localStorage.setItem('aio_user', JSON.stringify({
      id: 'demo-builder-id',
      email: 'builder@aio-ai.dev',
      name: 'Builder',
      role: 'member',
      authProvider: 'demo',
      created_at: new Date().toISOString()
    }));
    window.location.href = redirectTarget;
  });
</script>
