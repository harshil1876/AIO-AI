---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { getTrendingTools, getAllCategories, getIndianAITools, getFreeTools } from '../services/dataService';
import { NEWS_STORIES } from '../data/newsData';
import { WORKFLOWS_DATA } from '../data/workflowsData';
import { OPEN_SOURCE_REPOS } from '../data/openSourceData';
import { CREATORS_DATA } from '../data/creatorsData';
import { COMMUNITY_POSTS } from '../data/communityData';

const trendingTools = await getTrendingTools(6);
const categories = await getAllCategories();
const indianTools = await getIndianAITools();
const freeTools = await getFreeTools(3);

const topNews = NEWS_STORIES.slice(0, 4);
const featuredWorkflows = WORKFLOWS_DATA.slice(0, 3);
const featuredRepos = OPEN_SOURCE_REPOS.slice(0, 4);
const featuredCreators = CREATORS_DATA.slice(0, 4);
const recentPosts = COMMUNITY_POSTS.slice(0, 3);
---

<Layout 
  title="AIO AI — All-In-One AI Intelligence, Tools, Workflows & Creators"
  description="The unified, intent-driven AI discovery platform: 113+ verified tools, 16+ production workflows, 20+ open-source repos, 18+ YouTube creators, daily Neo-Brutalist tech news, and built-in creator utilities."
  hideSidebar={true}
>
  <!-- Public Marketing Header (Clean & Uncluttered — No internal workspace sidebar toggle) -->
  <header class="w-full border-b border-[#E2E8F0] bg-white/95 backdrop-blur-md sticky top-0 z-40 px-4 sm:px-6 py-3.5 transition-colors">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-black text-sm tracking-tight shadow-xs group-hover:bg-[#2563EB] transition-colors">
          AI
        </div>
        <span class="font-black text-[#09090B] text-lg tracking-tight group-hover:text-[#2563EB] transition-colors">
          AIO AI
        </span>
      </a>

      <!-- Public Marketing Nav Links -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-bold text-slate-600">
        <a href="/tools" data-auth-required="true" data-auth-action="Explore 113+ Verified AI Tools" class="hover:text-[#2563EB] transition-colors">Explore Tools</a>
        <a href="/finder" data-auth-required="true" data-auth-action="AI Intent Finder Blueprint" class="hover:text-[#2563EB] transition-colors text-[#2563EB] flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
          </svg>
          <span>AI Finder</span>
        </a>
        <a href="/workflows" data-auth-required="true" data-auth-action="16+ Production AI Workflows" class="hover:text-[#2563EB] transition-colors">Workflows</a>
        <a href="/news/daily" data-auth-required="true" data-auth-action="Daily Neo-Brutalist AI News" class="hover:text-[#2563EB] transition-colors">Daily AI News</a>
        <a href="/open-source" data-auth-required="true" data-auth-action="Self-Hosted Open Source Hub" class="hover:text-[#2563EB] transition-colors">Open Source</a>
        <a href="/creators" data-auth-required="true" data-auth-action="18+ Curated AI Creators" class="hover:text-[#2563EB] transition-colors">Creators</a>
        <a href="/docs" data-auth-required="true" data-auth-action="AIO AI Platform Documentation" class="hover:text-[#2563EB] transition-colors">Docs</a>
      </nav>

      <!-- Public Auth CTAs -->
      <div class="flex items-center gap-3">
        <a href="/login" class="text-xs font-bold text-slate-700 hover:text-ink px-3 py-2 rounded-xl hover:bg-slate-100 transition-colors" id="publicNavLogin">
          Sign In
        </a>
        <a href="/signup" class="text-xs font-bold bg-[#09090B] hover:bg-[#2563EB] text-white px-4 py-2 rounded-xl transition-all shadow-xs" id="publicNavSignup">
          Get Started Free
        </a>
        <a href="/profile" class="hidden text-xs font-bold bg-[#2563EB] hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition-all shadow-xs" id="publicNavDashboard">
          Profile &rarr;
        </a>
      </div>
    </div>
  </header>

  <main class="w-full flex flex-col bg-[#FFFFFF]">
    
    <!-- MODULE 1: HERO PLATFORM SHOWCASE -->
    <section class="w-full px-4 sm:px-6 pt-16 pb-14 md:pt-24 md:pb-20 flex flex-col items-center justify-center text-center max-w-5xl mx-auto">
      
      <!-- Live Verified Platform Badge (Zero Emoji) -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#BFDBFE] bg-[#EFF6FF] text-xs font-semibold text-[#2563EB] mb-8 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>AIO AI • 113 Verified Tools • Zero Fabricated Reviews</span>
      </div>

      <!-- Main Display Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-[#09090B] tracking-tight mb-6 leading-tight max-w-4xl" style="letter-spacing: -2px;">
        Find the right AI <br class="hidden sm:inline" />
        <span class="text-[#2563EB] relative inline-block">
          for anything.
        </span>
      </h1>
      
      <p class="text-base sm:text-xl text-slate-600 mb-8 max-w-2xl font-normal leading-relaxed">
        The unified decision loop connecting <strong class="text-[#09090B] font-bold">113+ verified AI tools</strong>, multi-step production workflows, open-source models, and creator intelligence in one high-contrast platform.
      </p>
      
      <!-- Wide Search / Intent Input Box -->
      <form id="heroIntentForm" action="/finder" method="GET" class="w-full max-w-2xl bg-white border-2 border-[#09090B] rounded-2xl shadow-[6px_6px_0px_0px_#09090B] p-2 flex items-center mb-6 transition-all focus-within:shadow-[8px_8px_0px_0px_#2563EB]">
        <span class="pl-3 text-slate-400">
          <svg class="w-5 h-5 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </span>
        <input 
          id="heroIntentInput"
          type="text" 
          name="q"
          placeholder="What do you want to build or automate? (e.g. video editing, code pair, RAG)" 
          class="w-full bg-transparent text-[#09090B] placeholder-slate-400 px-3 py-2.5 outline-none text-xs sm:text-sm font-sans" 
        />
        <button 
          type="submit" 
          class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-bold text-xs sm:text-sm rounded-xl px-5 py-2.5 transition-colors whitespace-nowrap cursor-pointer shadow-xs border border-[#09090B]"
        >
          Match Blueprint
        </button>
      </form>

      <!-- Quick Intent Chips -->
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-slate-600 max-w-3xl mb-8">
        <span class="font-bold text-[#09090B] font-mono text-[11px] uppercase">Popular:</span>
        <a href="/finder" data-auth-required="true" data-auth-action="AI Intent Finder Blueprint" class="hover:text-white hover:bg-[#2563EB] transition-all px-3 py-1 rounded-lg border border-[#BFDBFE] bg-[#EFF6FF] text-[#2563EB] font-bold flex items-center gap-1 shadow-2xs">
          <span>AI Intent Finder</span>
          <span>&rarr;</span>
        </a>
        <a href="/tools?q=video" data-auth-required="true" data-auth-action="YouTube Shorts & Video Catalog" class="hover:text-[#2563EB] transition-colors px-2.5 py-1 rounded-lg border border-[#E2E8F0] bg-[#F8FAFF]">YouTube Shorts & Video</a>
        <a href="/tools?category=code-assistants" data-auth-required="true" data-auth-action="AI Coding Pair Directory" class="hover:text-[#2563EB] transition-colors px-2.5 py-1 rounded-lg border border-[#E2E8F0] bg-[#F8FAFF]">AI Coding Pair</a>
        <a href="/tools?category=india-first" data-auth-required="true" data-auth-action="India-First AI Directory" class="hover:text-[#2563EB] transition-colors px-2.5 py-1 rounded-lg border border-orange-200 bg-orange-50 text-orange-800 font-bold">India-First AI (16)</a>
        <a href="/open-source" data-auth-required="true" data-auth-action="Open Source Hub (20+ Repos)" class="hover:text-[#2563EB] transition-colors px-2.5 py-1 rounded-lg border border-purple-200 bg-purple-50 text-purple-800 font-bold">Open Source (20+)</a>
      </div>

      <!-- Live Platform Counters Bento Strip -->
      <div class="w-full grid grid-cols-2 sm:grid-cols-5 gap-3 max-w-4xl pt-4 border-t border-[#E2E8F0] text-center font-mono">
        <a href="/tools" data-auth-required="true" data-auth-action="113+ Verified AI Tools" class="p-3 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-white transition-all block group">
          <div class="text-xl font-black text-[#09090B] group-hover:text-[#2563EB]">113+</div>
          <div class="text-[10px] uppercase text-slate-500 font-bold">Verified Tools</div>
        </a>
        <a href="/workflows" data-auth-required="true" data-auth-action="16+ Production AI Workflows" class="p-3 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-white transition-all block group">
          <div class="text-xl font-black text-[#2563EB]">16+</div>
          <div class="text-[10px] uppercase text-slate-500 font-bold">Workflows</div>
        </a>
        <a href="/open-source" data-auth-required="true" data-auth-action="20+ Open-Source Repos" class="p-3 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] hover:border-purple-600 hover:bg-white transition-all block group">
          <div class="text-xl font-black text-purple-700">20+</div>
          <div class="text-[10px] uppercase text-slate-500 font-bold">Open Source</div>
        </a>
        <a href="/creators" data-auth-required="true" data-auth-action="18+ Curated AI Creators" class="p-3 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] hover:border-emerald-600 hover:bg-white transition-all block group">
          <div class="text-xl font-black text-emerald-700">18+</div>
          <div class="text-[10px] uppercase text-slate-500 font-bold">Educators</div>
        </a>
        <a href="/news/daily" data-auth-required="true" data-auth-action="24+ Daily News Briefings" class="p-3 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] hover:border-[#09090B] hover:bg-white transition-all col-span-2 sm:col-span-1 block group">
          <div class="text-xl font-black text-[#09090B]">24+</div>
          <div class="text-[10px] uppercase text-slate-500 font-bold">News Briefings</div>
        </a>
      </div>
    </section>

    <!-- MODULE 2: THE 6 CONNECTED PILLARS BENTO GRID -->
    <section class="w-full px-4 sm:px-6 py-14 bg-[#F8FAFF] border-y border-[#E2E8F0]">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <div class="text-xs font-mono font-bold text-[#2563EB] uppercase tracking-wider mb-2">Connected Architecture</div>
          <h2 class="text-2xl sm:text-4xl font-black text-[#09090B] tracking-tight">
            Stop switching between 10 different sites.
          </h2>
          <p class="text-sm text-slate-600 mt-2">
            AIO AI binds tools, production automations, open-source replacements, daily news, and token economics into one connected graph.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white border-2 border-[#09090B] rounded-2xl p-6 shadow-[6px_6px_0px_0px_#09090B]">
            <div class="text-xs font-mono font-bold text-[#2563EB] uppercase mb-1">01. Verified Catalog</div>
            <h3 class="text-lg font-black text-[#09090B] mb-2">113+ Audited AI Tools</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Real pricing, India payment support, API availability, and zero pay-for-placement bias.
            </p>
            <a href="/tools" data-auth-required="true" data-auth-action="Explore 113+ Audited AI Tools" class="text-xs font-bold text-[#2563EB] hover:underline">Explore Catalog &rarr;</a>
          </div>

          <div class="bg-white border-2 border-[#09090B] rounded-2xl p-6 shadow-[6px_6px_0px_0px_#09090B]">
            <div class="text-xs font-mono font-bold text-[#2563EB] uppercase mb-1">02. Decision Engine</div>
            <h3 class="text-lg font-black text-[#09090B] mb-2">5-Layer Connected Blueprint</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Get matched with the primary tool, 100% free option, production workflow, and tutorial in seconds.
            </p>
            <a href="/finder" data-auth-required="true" data-auth-action="Launch 5-Layer Connected Blueprint" class="text-xs font-bold text-[#2563EB] hover:underline">Launch AI Finder &rarr;</a>
          </div>

          <div class="bg-white border-2 border-[#09090B] rounded-2xl p-6 shadow-[6px_6px_0px_0px_#09090B]">
            <div class="text-xs font-mono font-bold text-[#2563EB] uppercase mb-1">03. Production Recipes</div>
            <h3 class="text-lg font-black text-[#09090B] mb-2">16 Multi-Step Workflows</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Step-by-step automation pipelines with Free vs Freemium vs Paid monthly cost comparisons.
            </p>
            <a href="/workflows" data-auth-required="true" data-auth-action="16 Production AI Workflows" class="text-xs font-bold text-[#2563EB] hover:underline">View Workflows &rarr;</a>
          </div>

          <div class="bg-white border-2 border-[#09090B] rounded-2xl p-6 shadow-[6px_6px_0px_0px_#09090B]">
            <div class="text-xs font-mono font-bold text-[#2563EB] uppercase mb-1">04. Self-Hosting Hub</div>
            <h3 class="text-lg font-black text-[#09090B] mb-2">20 Flagship Open-Source Repos</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Docker commands, VRAM calculations, and zero-cost commercial replacements (Ollama, vLLM, ComfyUI).
            </p>
            <a href="/open-source" data-auth-required="true" data-auth-action="20 Flagship Open-Source Repos" class="text-xs font-bold text-[#2563EB] hover:underline">Self-Host Hub &rarr;</a>
          </div>

          <div class="bg-white border-2 border-[#09090B] rounded-2xl p-6 shadow-[6px_6px_0px_0px_#09090B]">
            <div class="text-xs font-mono font-bold text-[#2563EB] uppercase mb-1">05. Daily Intelligence</div>
            <h3 class="text-lg font-black text-[#09090B] mb-2">Neo-Brutalist Daily Briefing</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Factual, technical daily newspaper categorizing major model drops, APIs, and policy shifts.
            </p>
            <a href="/news/daily" data-auth-required="true" data-auth-action="Neo-Brutalist Daily Briefing" class="text-xs font-bold text-[#2563EB] hover:underline">Read Daily News &rarr;</a>
          </div>

          <div class="bg-white border-2 border-[#09090B] rounded-2xl p-6 shadow-[6px_6px_0px_0px_#09090B]">
            <div class="text-xs font-mono font-bold text-[#2563EB] uppercase mb-1">06. Developer Utilities</div>
            <h3 class="text-lg font-black text-[#09090B] mb-2">8-in-1 Client-Side Suite</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Token Calculator, Prompt Optimizer, Hook Generator, Image Resizer, and JSON-to-TypeScript.
            </p>
            <a href="/utilities" data-auth-required="true" data-auth-action="8-in-1 Developer Utilities" class="text-xs font-bold text-[#2563EB] hover:underline">Open Utilities &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- MODULE 3: FEATURED TOOLS PREVIEW -->
    <section class="w-full px-4 sm:px-6 py-14 max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-8 pb-3 border-b border-[#E2E8F0]">
        <div>
          <div class="text-xs font-mono font-bold text-[#2563EB] uppercase tracking-wider mb-1">Curated Catalog</div>
          <h2 class="text-2xl sm:text-3xl font-black text-[#09090B] tracking-tight">Verified Production AI Tools</h2>
        </div>
        <a href="/tools" data-auth-required="true" data-auth-action="View All 113+ Verified AI Tools" class="text-xs font-bold text-[#2563EB] hover:underline">View All 113+ Tools &rarr;</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {trendingTools.map(tool => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </section>

    <!-- MODULE 4: PRODUCTION WORKFLOWS SPOTLIGHT -->
    <section class="w-full px-4 sm:px-6 py-14 bg-[#F8FAFF] border-t border-[#E2E8F0]">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end justify-between mb-8 pb-3 border-b border-[#E2E8F0]">
          <div>
            <div class="text-xs font-mono font-bold text-[#2563EB] uppercase tracking-wider mb-1">Automations</div>
            <h2 class="text-2xl sm:text-3xl font-black text-[#09090B] tracking-tight">Production AI Workflows</h2>
          </div>
          <a href="/workflows" data-auth-required="true" data-auth-action="All 16 Production Workflows" class="text-xs font-bold text-[#2563EB] hover:underline">All 16 Workflows &rarr;</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredWorkflows.map(wf => (
            <div class="bg-white border-2 border-[#09090B] rounded-2xl p-6 shadow-[6px_6px_0px_0px_#09090B] flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs font-mono font-bold text-slate-400 mb-2">
                  <span>{wf.difficulty}</span>
                  <span>{wf.steps.length} Steps</span>
                </div>
                <h3 class="text-base font-black text-[#09090B] mb-2">{wf.title}</h3>
                <p class="text-xs text-slate-600 line-clamp-3 mb-4 leading-relaxed">{wf.goal}</p>
              </div>
              <div class="pt-4 border-t border-[#E2E8F0] flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-emerald-700">Free Tier: $0/mo</span>
                <a href={`/workflows/${wf.id}`} data-auth-required="true" data-auth-action={`Inspect Workflow: ${wf.title}`} class="text-xs font-bold text-[#2563EB] hover:underline">
                  Inspect &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MODULE 5: FINAL HIGH-CONVERTING CTA -->
    <section class="w-full px-4 sm:px-6 py-16 md:py-24 bg-[#09090B] text-white text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight mb-4">
          Unlock your personal AI workspace.
        </h2>
        <p class="text-sm sm:text-base text-slate-400 mb-8 max-w-xl mx-auto leading-relaxed">
          Create an account to save custom stacks, calculate token usage, track local open-source models, and submit verified reviews.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/signup" 
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#2563EB] hover:bg-blue-600 text-white font-bold text-sm transition-all shadow-md"
          >
            Get Started Free
          </a>
          <a 
            href="/login" 
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition-all"
          >
            Sign In with Google
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script is:inline>
  // Authentication & Intent Interceptors on Landing Page
  (function() {
    function isUserAuthenticated() {
      if (localStorage.getItem('aio_user')) return true;
      if (localStorage.getItem('supabase.auth.token')) return true;
      for (var i = 0; i < localStorage.length; i++) {
        var k = localStorage.key(i);
        if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1) {
          return true;
        }
      }
      return false;
    }

    var isAuth = isUserAuthenticated();

    // Adapt public nav CTAs if user is authenticated
    if (isAuth) {
      var loginBtn = document.getElementById('publicNavLogin');
      var signupBtn = document.getElementById('publicNavSignup');
      var dashBtn = document.getElementById('publicNavDashboard');
      if (loginBtn) loginBtn.classList.add('hidden');
      if (signupBtn) signupBtn.classList.add('hidden');
      if (dashBtn) {
        dashBtn.classList.remove('hidden');
        dashBtn.classList.add('inline-flex');
      }
    }

    // Intercept Hero Intent Form if unauthenticated
    var heroForm = document.getElementById('heroIntentForm');
    var heroInput = document.getElementById('heroIntentInput');
    heroForm?.addEventListener('submit', function(e) {
      if (!isUserAuthenticated()) {
        e.preventDefault();
        e.stopPropagation();
        var q = heroInput ? heroInput.value.trim() : '';
        var targetUrl = q ? ('/finder?q=' + encodeURIComponent(q)) : '/finder';
        if (typeof window.openAuthGateModal === 'function') {
          window.openAuthGateModal('AI Intent Finder Blueprint', targetUrl);
        } else {
          window.location.href = '/login?redirect=' + encodeURIComponent(targetUrl);
        }
      }
    });
  })();
</script>
