---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { NEWS_STORIES } from '../data/newsData';
import { WORKFLOWS_DATA } from '../data/workflowsData';
import { OPEN_SOURCE_REPOS } from '../data/openSourceData';
import { CREATORS_DATA } from '../data/creatorsData';

const topNews = NEWS_STORIES.slice(0, 4);
const topWorkflows = WORKFLOWS_DATA.slice(0, 3);
const featuredRepos = OPEN_SOURCE_REPOS.slice(0, 3);
const featuredCreators = CREATORS_DATA.slice(0, 3);
---

<Layout 
  title="Workspace Dashboard | AIO AI"
  description="Personalized AI engineering workspace: saved tools, stack cost estimations, daily AI news briefings, and quick creator utilities."
>
  <Header currentPath="/dashboard" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 bg-[#FFFFFF] min-h-screen space-y-8">
    
    <!-- 1. Personalized Workspace Header -->
    <div class="bg-gradient-to-r from-[#F8FAFF] via-white to-[#EFF6FF] border border-[#E2E8F0] rounded-2xl p-6 sm:p-8 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span class="text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE] uppercase flex items-center gap-1.5" id="userBadge">
            <span class="w-1.5 h-1.5 rounded-full bg-[#2563EB] animate-pulse"></span>
            <span id="userBadgeText">Verified Member</span>
          </span>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold">
            Free Plan Tier
          </span>
          <span class="text-xs text-slate-400 font-mono hidden sm:inline" id="userEmailDisplay">...</span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-black text-[#09090B] tracking-tight">
          Welcome back, <span id="userNameDisplay" class="text-[#2563EB]">Builder</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-xl leading-relaxed">
          Your personal command center for multi-model workflows, stack cost optimization, and open-source intelligence.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-3 flex-wrap shrink-0">
        <a
          href="/finder"
          class="px-4 py-2.5 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-all shadow-xs flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
          </svg>
          <span>AI Finder</span>
        </a>

        <a
          href="/stack-builder"
          class="px-4 py-2.5 rounded-xl bg-white border border-[#E2E8F0] hover:border-[#09090B] text-[#09090B] text-xs font-bold transition-colors shadow-xs flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
          </svg>
          <span>Build Stack</span>
        </a>

        <a
          href="/submit"
          class="px-3.5 py-2.5 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-colors"
          title="Submit new tool or correction"
        >
          + Submit
        </a>
      </div>
    </div>

    <!-- 2. Real-Time Workspace KPI Cards (100% Real User State — Zero Dummy Billing) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1: Saved Bookmarks -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">Saved Bookmarks</span>
          <svg class="w-4 h-4 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashBookmarkCount">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span>Pinned items</span>
          <a href="/profile" class="text-[#2563EB] hover:underline font-bold">Manage &rarr;</a>
        </div>
      </div>

      <!-- Card 2: Custom Workflows Created -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">My Workflows</span>
          <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashWorkflowCount">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span>Tested blueprints</span>
          <a href="/workflows/builder" class="text-purple-600 hover:underline font-bold">+ Studio &rarr;</a>
        </div>
      </div>

      <!-- Card 3: Custom Named Stacks -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">My Named Stacks</span>
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashStackCount">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span>Saved tool sets</span>
          <a href="/stack-builder" class="text-emerald-600 hover:underline font-bold">+ Build &rarr;</a>
        </div>
      </div>

      <!-- Card 4: Real User Reputation & Submissions -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">Reputation Points</span>
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashReputationPoints">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span class="text-amber-700 font-bold" id="dashRankTitle">Member Rank</span>
          <a href="/community" class="text-[#2563EB] hover:underline font-bold">Rules &rarr;</a>
        </div>
      </div>
    </div>

    <!-- 3. Embedded Quick AI Intent Finder Bar -->
    <div class="bg-gradient-to-b from-[#F8FAFF] to-white border border-[#E2E8F0] focus-within:border-[#2563EB] rounded-2xl p-6 shadow-xs hover:shadow-sm transition-all">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-[#2563EB]"></span>
        <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-slate-600">Quick Intent Finder</h2>
      </div>
      <p class="text-sm font-bold text-[#09090B] mb-4">What task are you executing today?</p>
      
      <form action="/finder" method="GET" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <input 
            type="text" 
            name="q"
            placeholder="e.g. Scrape LinkedIn profiles with AI, transcribing Hindi voice notes, local code refactor..." 
            class="w-full bg-white border border-[#E2E8F0] focus:border-[#2563EB] rounded-xl px-4 py-3 text-xs sm:text-sm text-[#09090B] outline-none shadow-xs font-sans placeholder:text-slate-400"
          />
        </div>
        <button 
          type="submit" 
          class="px-6 py-3 rounded-xl bg-[#09090B] hover:bg-[#2563EB] text-white text-xs font-bold transition-all shadow-xs cursor-pointer shrink-0"
        >
          Compute Blueprint &rarr;
        </button>
      </form>
    </div>

    <!-- 4. Bento Grid Modules -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left 2 Cols: Modules A, B, C -->
      <div class="lg:col-span-2 space-y-8">

        <!-- Module A: My Saved Tools & Repos -->
        <section class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs">
          <div class="flex items-center justify-between pb-4 border-b border-[#E2E8F0] mb-4">
            <div>
              <h2 class="text-base font-bold text-[#09090B]">Saved Tools & Repositories</h2>
              <p class="text-xs text-slate-500">Quick access to tools you've pinned for your engineering stack.</p>
            </div>
            <a href="/tools" class="text-xs font-bold text-[#2563EB] hover:underline">Explore 113+ Tools &rarr;</a>
          </div>

          <div id="dashSavedList" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Dynamically populated or default recommendations -->
            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-[#09090B] block">Cursor Composer</span>
                <span class="text-[11px] text-slate-500 font-mono">Code Assistants • Freemium</span>
              </div>
              <a href="/tools/cursor" class="text-xs font-bold text-[#2563EB] hover:underline">View</a>
            </div>
            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-[#09090B] block">DeepSeek R1</span>
                <span class="text-[11px] text-slate-500 font-mono">Open-Source LLMs • Free / Open</span>
              </div>
              <a href="/tools/deepseek" class="text-xs font-bold text-[#2563EB] hover:underline">View</a>
            </div>
            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-[#09090B] block">Ollama</span>
                <span class="text-[11px] text-slate-500 font-mono">Local Runner • 100% Free</span>
              </div>
              <a href="/open-source/ollama" class="text-xs font-bold text-[#2563EB] hover:underline">View</a>
            </div>
            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-[#09090B] block">Sarvam AI</span>
                <span class="text-[11px] text-slate-500 font-mono">India-First Speech & LLM</span>
              </div>
              <a href="/tools/sarvam-ai" class="text-xs font-bold text-[#2563EB] hover:underline">View</a>
            </div>
          </div>
        </section>

        <!-- Module B: Today's AI Newspaper Briefing -->
        <section class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs">
          <div class="flex items-center justify-between pb-4 border-b border-[#E2E8F0] mb-4">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#2563EB]"></span>
              <h2 class="text-base font-bold text-[#09090B]">Today's Intelligence Briefing</h2>
            </div>
            <a href="/news" class="text-xs font-bold text-[#2563EB] hover:underline">View All AI News &rarr;</a>
          </div>

          <div class="space-y-3">
            {topNews.map(story => (
              <a 
                href={`/news/${story.slug}`} 
                class="block p-4 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all group"
              >
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700">
                    {story.category}
                  </span>
                  <span class="text-[11px] font-mono text-slate-400">• {story.readingTime}</span>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors line-clamp-1">
                  {story.headline}
                </h3>
                <p class="text-xs text-slate-600 line-clamp-1 mt-0.5">
                  {story.summary}
                </p>
              </a>
            ))}
          </div>
        </section>

        <!-- Module C: Recommended Production Workflows -->
        <section class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs">
          <div class="flex items-center justify-between pb-4 border-b border-[#E2E8F0] mb-4">
            <div>
              <h2 class="text-base font-bold text-[#09090B]">Recommended Production Workflows</h2>
              <p class="text-xs text-slate-500">Executable multi-step automation recipes with validated prompts.</p>
            </div>
            <a href="/workflows" class="text-xs font-bold text-[#2563EB] hover:underline">All 16 Workflows &rarr;</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {topWorkflows.map(wf => (
              <a 
                href={`/workflows/${wf.id}`}
                class="p-4 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all flex flex-col justify-between group"
              >
                <div>
                  <div class="text-[10px] font-mono font-bold text-slate-400 uppercase mb-1">
                    {wf.steps.length} Steps • {wf.difficulty}
                  </div>
                  <h3 class="text-xs font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors mb-2 line-clamp-2">
                    {wf.title}
                  </h3>
                  <p class="text-[11px] text-slate-600 line-clamp-2 mb-3">
                    {wf.goal}
                  </p>
                </div>
                <div class="pt-2 border-t border-slate-100 text-[10px] font-mono text-emerald-700 font-bold">
                  Free Alt: $0 / mo
                </div>
              </a>
            ))}
          </div>
        </section>

      </div>

      <!-- Right 1 Col: Modules D & E -->
      <aside class="space-y-6">

        <!-- Module D: Developer & Creator Utilities Suite -->
        <div class="bg-white border border-[#E2E8F0] hover:border-[#2563EB] rounded-2xl p-5 shadow-xs hover:shadow-md transition-all">
          <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
            <h2 class="text-xs font-mono uppercase font-bold text-[#09090B]">8-in-1 Utilities Suite</h2>
            <span class="text-[10px] font-mono font-bold text-[#2563EB] bg-[#EFF6FF] px-2 py-0.5 rounded-full">Client-Side</span>
          </div>

          <div class="space-y-2 text-xs">
            <a href="/utilities#token-calculator" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">1. Token Cost Calculator</span>
              <span class="text-slate-400 font-mono text-[11px]">13 Models &rarr;</span>
            </a>
            <a href="/utilities#prompt-optimizer" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">2. AI Prompt Optimizer</span>
              <span class="text-slate-400 font-mono text-[11px]">Clean &rarr;</span>
            </a>
            <a href="/utilities#hook-generator" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">3. YouTube Hook Generator</span>
              <span class="text-slate-400 font-mono text-[11px]">Hooks &rarr;</span>
            </a>
            <a href="/utilities#image-resizer" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">4. Image Crop & Resizer</span>
              <span class="text-slate-400 font-mono text-[11px]">16:9 &rarr;</span>
            </a>
            <a href="/utilities#context-simulator" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">5. Context Window Sim</span>
              <span class="text-slate-400 font-mono text-[11px]">VRAM &rarr;</span>
            </a>
            <a href="/utilities#json-formatter" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">6. JSON to TypeScript</span>
              <span class="text-slate-400 font-mono text-[11px]">Generate &rarr;</span>
            </a>
          </div>

          <div class="mt-4 pt-3 border-t border-[#E2E8F0]">
            <a href="/utilities" class="block w-full py-2 text-center text-xs font-bold bg-[#09090B] text-white rounded-xl hover:bg-[#2563EB] transition-colors">
              Open Full Utilities Suite
            </a>
          </div>
        </div>

        <!-- Module E: Curated AI Creators to Watch -->
        <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs">
          <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-3">
            <h2 class="text-xs font-mono uppercase font-bold text-slate-500">Educators To Watch</h2>
            <a href="/creators" class="text-[11px] text-[#2563EB] hover:underline font-bold">All 18 &rarr;</a>
          </div>

          <div class="space-y-3">
            {featuredCreators.map(c => (
              <a href={`/creators/${c.slug}`} class="flex items-center gap-3 p-2 rounded-xl hover:bg-[#F8FAFF] transition-colors group">
                <div class="w-8 h-8 rounded-full bg-slate-100 border border-[#E2E8F0] font-bold text-xs text-[#09090B] flex items-center justify-center shrink-0">
                  {c.channelName.substring(0, 2).toUpperCase()}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-xs font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors truncate">
                    {c.channelName}
                  </div>
                  <div class="text-[10px] text-slate-400 font-mono truncate">
                    {c.subscribersEstimate} • {c.primaryCategory}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

      </aside>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function initDashboardAuth() {
    const nameDisplay = document.getElementById('userNameDisplay');
    const emailDisplay = document.getElementById('userEmailDisplay');
    const badgeText = document.getElementById('userBadgeText');
    const countEl = document.getElementById('dashBookmarkCount');

    // Check if OAuth tokens or code exist in URL
    const hash = window.location.hash || '';
    const search = window.location.search || '';
    const hasOAuthToken = hash.indexOf('access_token=') !== -1 || search.indexOf('code=') !== -1;

    // Helper to apply authenticated user to UI and storage
    function applyUser(user: any, authProvider = 'google') {
      const displayName = user.user_metadata?.full_name || user.name || (user.email ? user.email.split('@')[0] : 'Builder');
      const currentUser = {
        id: user.id || 'usr-active',
        email: user.email || '',
        name: displayName,
        authProvider: authProvider
      };
      localStorage.setItem('aio_user', JSON.stringify(currentUser));

      if (nameDisplay) nameDisplay.textContent = currentUser.name;
      if (emailDisplay) emailDisplay.textContent = currentUser.email;
      if (badgeText) {
        badgeText.textContent = authProvider === 'google' ? 'Google Account' : 'Verified Member';
      }

      // Clean the URL hash so tokens aren't displayed in browser address bar
      if (window.location.hash && window.location.hash.indexOf('access_token=') !== -1) {
        try {
          window.history.replaceState(null, '', window.location.pathname + window.location.search);
        } catch (e) {}
      }

      // Hydrate local KPI cards
      const bookmarks = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
      if (countEl) countEl.textContent = bookmarks.length.toString();

      const workflows = JSON.parse(localStorage.getItem('aio_custom_workflows') || '[]');
      const workflowCountEl = document.getElementById('dashWorkflowCount');
      if (workflowCountEl) workflowCountEl.textContent = workflows.length.toString();

      const stacks = JSON.parse(localStorage.getItem('aio_custom_stacks') || '[]');
      const stackCountEl = document.getElementById('dashStackCount');
      if (stackCountEl) stackCountEl.textContent = stacks.length.toString();

      const repEl = document.getElementById('dashReputationPoints');
      const rankEl = document.getElementById('dashRankTitle');
      if (repEl) repEl.textContent = '0';
      if (rankEl) rankEl.textContent = 'Member Rank';

      // Sync bookmarks and DB profile in background (non-blocking)
      syncUserDb(currentUser, user);
    }

    async function syncUserDb(currentUser: any, rawUser: any) {
      if (!currentUser.email) return;
      try {
        const { data: userRow } = await supabase
          .from('users')
          .upsert({
            auth_id: rawUser.id || undefined,
            email: currentUser.email,
            role: 'user',
            plan: 'free',
          }, { onConflict: 'email' })
          .select('id, reputation_points')
          .single();

        if (userRow?.id) {
          const repEl = document.getElementById('dashReputationPoints');
          const rankEl = document.getElementById('dashRankTitle');
          const points = userRow.reputation_points || 0;
          if (repEl) repEl.textContent = points.toString();
          if (rankEl) {
            rankEl.textContent = points >= 500 ? 'Pioneer' : points >= 100 ? 'Contributor' : 'Member';
          }

          await supabase.from('profiles').upsert({
            user_id: userRow.id,
            full_name: currentUser.name,
            avatar_url: rawUser.user_metadata?.avatar_url || null,
          }, { onConflict: 'user_id' });

          const [bRes, sRes] = await Promise.all([
            supabase.from('bookmarks').select('id').eq('user_id', userRow.id),
            supabase.from('stacks').select('id').eq('user_id', userRow.id)
          ]);

          if (bRes.data && countEl) {
            countEl.textContent = bRes.data.length.toString();
          }
          const stackCountEl = document.getElementById('dashStackCount');
          if (sRes.data && stackCountEl) {
            stackCountEl.textContent = sRes.data.length.toString();
          }
        }
      } catch (err) {
        console.warn('Background profile sync notice:', err);
      }
    }

    // 1. Check existing session first
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      applyUser(session.user, session.user.app_metadata?.provider || 'google');
      return;
    }

    // 2. Check cached localStorage user
    const cachedUserStr = localStorage.getItem('aio_user');
    if (cachedUserStr) {
      try {
        const parsed = JSON.parse(cachedUserStr);
        applyUser(parsed, parsed.authProvider || 'member');
        return;
      } catch (e) {}
    }

    // 3. If OAuth tokens are currently in the URL, wait for Supabase to process them
    if (hasOAuthToken) {
      if (badgeText) badgeText.textContent = 'Authenticating...';
      
      const { data: { subscription } } = supabase.auth.onAuthStateChange((event, newSession) => {
        if (newSession?.user) {
          subscription.unsubscribe();
          applyUser(newSession.user, newSession.user.app_metadata?.provider || 'google');
        }
      });

      // Safety timeout: if after 4 seconds no session is established, redirect to login
      setTimeout(async () => {
        const { data: { session: retrySession } } = await supabase.auth.getSession();
        if (retrySession?.user) {
          applyUser(retrySession.user, retrySession.user.app_metadata?.provider || 'google');
        } else if (!localStorage.getItem('aio_user')) {
          window.location.replace('/login?redirect=/dashboard');
        }
      }, 4000);
      return;
    }

    // 4. Truly unauthenticated: redirect to login
    window.location.replace('/login?redirect=/dashboard');
  }

  // Handle ongoing auth state changes
  supabase.auth.onAuthStateChange((_event, session) => {
    if (session?.user && !localStorage.getItem('aio_user')) {
      initDashboardAuth();
    }
  });

  initDashboardAuth();
</script>
