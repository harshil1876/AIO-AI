---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolLogo from '../components/ToolLogo.astro';
import { NEWS_STORIES } from '../data/newsData';
import { WORKFLOWS_DATA } from '../data/workflowsData';
import { OPEN_SOURCE_REPOS } from '../data/openSourceData';
import { CREATORS_DATA } from '../data/creatorsData';
import { OFFICIAL_MODELS } from '../data/modelsData';
import { TOOLS_DATA } from '../data/seedData';

const topNews = NEWS_STORIES.slice(0, 4);
const topWorkflows = WORKFLOWS_DATA.slice(0, 3);
const featuredCreators = CREATORS_DATA.slice(0, 3);
const modelsCount = OFFICIAL_MODELS.length;
const creatorsCount = CREATORS_DATA.length;

// Curated 4 Starter Recommended Tools for cold-start onboarding
const starterToolSlugs = ['cursor', 'deepseek', 'ollama', 'sarvam-ai'];
const starterTools = starterToolSlugs.map(slug => {
  return TOOLS_DATA.find(t => t.slug === slug) || {
    name: slug,
    slug: slug,
    tagline: 'Production AI engineering solution',
    categorySlug: 'code-assistants',
    pricingType: 'Freemium',
    websiteUrl: `https://${slug}.com`
  };
});
---

<Layout 
  title="Command Center | AIO AI"
  description="Personalized AI engineering workspace: saved tools, stack cost estimations, daily AI news briefings, and quick creator utilities."
>
  <Header currentPath="/dashboard" />

  <!-- Top Secondary Sub-Navigation Tabs -->
  <div class="bg-white border-b border-[#E2E8F0] px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex items-center gap-1 overflow-x-auto text-xs py-2 scrollbar-none">
      <a href="/dashboard" class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-[#2563EB] font-bold shrink-0">
        Command Center
      </a>
      <a href="/analytics" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        Ecosystem Analytics
      </a>
      <a href="/profile" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        My Profile & History
      </a>
    </div>
  </div>

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 bg-[#FFFFFF] min-h-screen space-y-8">
    
    <!-- 1. Personalized Workspace Header -->
    <div class="bg-gradient-to-r from-[#F8FAFF] via-white to-[#EFF6FF] border border-[#E2E8F0] rounded-2xl p-6 sm:p-8 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span class="text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE] uppercase flex items-center gap-1.5" id="userBadge">
            <span class="w-1.5 h-1.5 rounded-full bg-[#2563EB] animate-pulse"></span>
            <span id="userBadgeText">Verified Builder</span>
          </span>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold">
            Free Plan Tier
          </span>
          <span class="text-xs text-slate-400 font-mono hidden sm:inline" id="userEmailDisplay">harshilpival@gmail.com</span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-black text-[#09090B] tracking-tight">
          Welcome back, <span id="userNameDisplay" class="text-[#2563EB]">Harshil Patel</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-xl leading-relaxed">
          Your personal command center for multi-model workflows, stack cost optimization, and open-source intelligence.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-3 flex-wrap shrink-0">
        <a
          href="/finder"
          class="px-4 py-2.5 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-all shadow-xs flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
          </svg>
          <span>AI Finder</span>
        </a>

        <a
          href="/stack-builder"
          class="px-4 py-2.5 rounded-xl bg-white border border-[#E2E8F0] hover:border-[#09090B] text-[#09090B] text-xs font-bold transition-colors shadow-xs flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
          </svg>
          <span>Build Stack</span>
        </a>

        <a
          href="/workflows/builder"
          class="px-3.5 py-2.5 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-colors flex items-center gap-1.5"
          title="Open Workflow Studio"
        >
          <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
          </svg>
          <span>Workflow Studio</span>
        </a>
      </div>
    </div>

    <!-- 2. Futurepedia-Style "Your First 3 Steps" Gamified Onboarding Bar -->
    <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs" id="onboardingBanner">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#2563EB]" id="onboardingLevelBadge">Builder Level 1</span>
            <span class="text-slate-300">•</span>
            <span class="text-xs font-bold text-[#09090B]">Your First 3 Steps (<span id="onboardingDoneCount">0</span>/3 Completed)</span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Complete these core engineering actions to customize your AI intelligence workspace.</p>
        </div>
        <div class="w-full sm:w-48 bg-slate-100 h-2 rounded-full overflow-hidden shrink-0">
          <div id="onboardingProgressBar" class="bg-[#2563EB] h-full transition-all duration-300 w-0"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Step 1 -->
        <a 
          href="/tools" 
          id="step1Card"
          class="p-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] hover:border-[#BFDBFE] transition-all flex items-start gap-3 group"
        >
          <div id="step1Icon" class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
            1
          </div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors flex items-center gap-1.5">
              <span>Pin 3 AI Tools</span>
              <span id="step1Check" class="hidden text-emerald-600 font-bold">✓</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-0.5" id="step1Status">0 / 3 tools pinned to workspace</p>
          </div>
        </a>

        <!-- Step 2 -->
        <a 
          href="/stack-builder" 
          id="step2Card"
          class="p-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] hover:border-[#BFDBFE] transition-all flex items-start gap-3 group"
        >
          <div id="step2Icon" class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
            2
          </div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors flex items-center gap-1.5">
              <span>Build a Custom Stack</span>
              <span id="step2Check" class="hidden text-emerald-600 font-bold">✓</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-0.5" id="step2Status">Select 5 layers & save with name</p>
          </div>
        </a>

        <!-- Step 3 -->
        <a 
          href="/workflows/builder" 
          id="step3Card"
          class="p-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] hover:border-[#BFDBFE] transition-all flex items-start gap-3 group"
        >
          <div id="step3Icon" class="w-6 h-6 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
            3
          </div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors flex items-center gap-1.5">
              <span>Test or Export Studio</span>
              <span id="step3Check" class="hidden text-emerald-600 font-bold">✓</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-0.5" id="step3Status">Run simulation or export SKILL.md</p>
          </div>
        </a>
      </div>
    </div>

    <!-- 3. Real-Time Workspace KPI Cards (100% Real User State — Zero Dummy Billing) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1: Saved Bookmarks -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">Saved Bookmarks</span>
          <svg class="w-4 h-4 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashBookmarkCount">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span>Pinned items</span>
          <a href="/profile#bookmarks" class="text-[#2563EB] hover:underline font-bold">Manage &rarr;</a>
        </div>
      </div>

      <!-- Card 2: Custom Workflows Created -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">My Workflows</span>
          <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V18ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25V18Z" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashWorkflowCount">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span>Custom pipelines</span>
          <a href="/workflows/builder" class="text-purple-600 hover:underline font-bold">Studio &rarr;</a>
        </div>
      </div>

      <!-- Card 3: Named Engineering Stacks -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">My Named Stacks</span>
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashStackCount">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span>Saved architectures</span>
          <a href="/stack-builder" class="text-emerald-600 hover:underline font-bold">Builder &rarr;</a>
        </div>
      </div>

      <!-- Card 4: Verified Reputation Points -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs hover:border-[#BFDBFE] transition-colors">
        <div class="flex items-center justify-between text-slate-400 mb-2">
          <span class="text-[11px] font-mono uppercase font-bold tracking-wider">Reputation</span>
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
          </svg>
        </div>
        <div class="text-3xl font-black text-[#09090B] font-mono" id="dashReputationPoints">0</div>
        <div class="text-[11px] text-slate-500 mt-1 flex items-center justify-between">
          <span id="dashRankTitle">Verified Member</span>
          <a href="/community" class="text-amber-600 hover:underline font-bold">Earn &rarr;</a>
        </div>
      </div>
    </div>

    <!-- 4. Main 2-Column Command Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left 2 Cols: Modules A, B & C -->
      <div class="lg:col-span-2 space-y-8">

        <!-- Module A: Saved Tools & Repositories (Interactive Pin + Dynamic Cold-Start Heading) -->
        <section class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#E2E8F0] mb-4 gap-2">
            <div>
              <h2 class="text-base font-bold text-[#09090B]" id="dashSavedSectionTitle">
                Recommended Starter Stack — Click Pin to Save to Your Workspace
              </h2>
              <p class="text-xs text-slate-500" id="dashSavedSectionSubtitle">
                Curated foundation tools. Pin them to add to your personal stack.
              </p>
            </div>
            <a href="/tools" class="text-xs font-bold text-[#2563EB] hover:underline shrink-0">Explore 113+ Tools &rarr;</a>
          </div>

          <div id="dashSavedList" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {starterTools.map(tool => (
              <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] flex items-center justify-between gap-3 hover:border-[#BFDBFE] transition-colors" data-starter-slug={tool.slug}>
                <div class="flex items-center gap-3 min-w-0">
                  <ToolLogo websiteUrl={tool.websiteUrl} name={tool.name} size="sm" />
                  <div class="min-w-0">
                    <span class="font-bold text-xs text-[#09090B] block truncate">{tool.name}</span>
                    <span class="text-[10px] text-slate-500 font-mono block truncate">
                      {tool.pricingType} • #{tool.categorySlug?.replace('-', ' ')}
                    </span>
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <a href={`/tools/${tool.slug}`} class="text-xs font-semibold text-slate-500 hover:text-[#09090B]">
                    View
                  </a>
                  <button 
                    type="button"
                    class="dash-pin-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-[#E2E8F0] text-[#2563EB] hover:border-[#2563EB] hover:bg-[#EFF6FF] transition-all cursor-pointer shadow-2xs"
                    data-tool-slug={tool.slug}
                    data-tool-name={tool.name}
                  >
                    📌 Pin
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Module B: Today's AI Intelligence Briefing (Hydrated Live with Timestamps & Entities) -->
        <section class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs">
          <div class="flex items-center justify-between pb-4 border-b border-[#E2E8F0] mb-4">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#2563EB] animate-pulse"></span>
              <h2 class="text-base font-bold text-[#09090B]">Today's Intelligence Briefing</h2>
              <span class="text-[10px] font-mono text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.2 rounded-full font-bold">
                LIVE WIRE
              </span>
            </div>
            <a href="/news" class="text-xs font-bold text-[#2563EB] hover:underline">View All AI News &rarr;</a>
          </div>

          <div class="space-y-3" id="dashNewsContainer">
            {topNews.map(story => (
              <a 
                href={`/news/${story.slug}`} 
                class="block p-4 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all group"
              >
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]">
                    [BREAKING]
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">• {story.readingTime || '2m read'}</span>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors line-clamp-1">
                  {story.headline}
                </h3>
                <p class="text-xs text-slate-600 line-clamp-1 mt-0.5">
                  {story.summary}
                </p>
              </a>
            ))}
          </div>
        </section>

        <!-- Module C: Recommended Production Workflows -->
        <section class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs">
          <div class="flex items-center justify-between pb-4 border-b border-[#E2E8F0] mb-4">
            <div>
              <h2 class="text-base font-bold text-[#09090B]">Recommended Production Workflows</h2>
              <p class="text-xs text-slate-500">Executable multi-step automation recipes with validated prompts.</p>
            </div>
            <a href="/workflows" class="text-xs font-bold text-[#2563EB] hover:underline">All 16 Workflows &rarr;</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {topWorkflows.map(wf => (
              <a 
                href={`/workflows/${wf.id}`}
                class="p-4 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all flex flex-col justify-between group"
              >
                <div>
                  <div class="text-[10px] font-mono font-bold text-slate-400 uppercase mb-1">
                    {wf.steps.length} Steps • {wf.difficulty}
                  </div>
                  <h3 class="text-xs font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors mb-2 line-clamp-2">
                    {wf.title}
                  </h3>
                  <p class="text-[11px] text-slate-600 line-clamp-2 mb-3">
                    {wf.goal}
                  </p>
                </div>
                <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] font-mono">
                  <span class="text-emerald-700 font-bold">Free Alt: $0</span>
                  <span class="text-[#2563EB] font-bold group-hover:underline">Inspect &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>

      </div>

      <!-- Right 1 Col: Modules D & E -->
      <aside class="space-y-6">

        <!-- Module D: Developer & Creator Utilities Suite (Dynamically binds to modelsCount) -->
        <div class="bg-white border border-[#E2E8F0] hover:border-[#2563EB] rounded-2xl p-5 shadow-xs hover:shadow-md transition-all">
          <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
            <h2 class="text-xs font-mono uppercase font-bold text-[#09090B]">8-in-1 Utilities Suite</h2>
            <span class="text-[10px] font-mono font-bold text-[#2563EB] bg-[#EFF6FF] px-2 py-0.5 rounded-full">Client-Side</span>
          </div>

          <div class="space-y-2 text-xs">
            <a href="/token-calculator" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">1. Token Cost Calculator</span>
              <span class="text-[#2563EB] font-mono text-[11px] font-bold">{modelsCount} Models &rarr;</span>
            </a>
            <a href="/utilities#prompt-optimizer" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">2. AI Prompt Optimizer</span>
              <span class="text-slate-400 font-mono text-[11px]">Clean &rarr;</span>
            </a>
            <a href="/utilities#cursorrules-generator" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">3. .cursorrules / SKILL.md</span>
              <span class="text-purple-600 font-mono text-[11px] font-bold">Export &rarr;</span>
            </a>
            <a href="/utilities#hook-generator" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">4. YouTube Hook Generator</span>
              <span class="text-slate-400 font-mono text-[11px]">Hooks &rarr;</span>
            </a>
            <a href="/utilities#image-resizer" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">5. Image Crop & Resizer</span>
              <span class="text-slate-400 font-mono text-[11px]">16:9 &rarr;</span>
            </a>
            <a href="/utilities#context-simulator" class="flex items-center justify-between p-2.5 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all">
              <span class="font-bold text-[#09090B]">6. Context Window Sim</span>
              <span class="text-slate-400 font-mono text-[11px]">VRAM &rarr;</span>
            </a>
          </div>

          <div class="mt-4 pt-3 border-t border-[#E2E8F0]">
            <a href="/utilities" class="block w-full py-2 text-center text-xs font-bold bg-[#09090B] text-white rounded-xl hover:bg-[#2563EB] transition-colors">
              Open Full Utilities Suite
            </a>
          </div>
        </div>

        <!-- Module E: Curated AI Creators to Watch (Dynamically binds to creatorsCount) -->
        <div class="bg-white border border-[#E2E8F0] rounded-2xl p-5 shadow-xs">
          <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-3">
            <h2 class="text-xs font-mono uppercase font-bold text-slate-500">Educators To Watch</h2>
            <a href="/creators" class="text-[11px] text-[#2563EB] hover:underline font-bold">All {creatorsCount} &rarr;</a>
          </div>

          <div class="space-y-3">
            {featuredCreators.map(c => {
              const cleanHandle = c.handle ? c.handle.replace('@', '') : (c.youtubeUrl?.split('@')[1] || c.slug);
              const unavatarUrl = `https://unavatar.io/youtube/${cleanHandle}`;
              return (
                <a href={`/creators/${c.slug}`} class="flex items-center gap-3 p-2 rounded-xl hover:bg-[#F8FAFF] transition-colors group">
                  <div class="w-9 h-9 rounded-full overflow-hidden bg-slate-100 border border-[#E2E8F0] font-bold text-xs text-[#09090B] flex items-center justify-center shrink-0">
                    <img 
                      src={unavatarUrl} 
                      alt={c.channelName} 
                      class="w-full h-full object-cover" 
                      loading="lazy"
                      onerror={`this.onerror=null; this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(c.channelName)}&background=2563EB&color=fff';`}
                    />
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="text-xs font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors truncate">
                      {c.channelName}
                    </div>
                    <div class="text-[10px] text-slate-400 font-mono truncate">
                      {c.subscribersEstimate} • {c.primaryCategory}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

      </aside>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { fetchLiveAINews } from '../services/liveNewsService';

  async function initDashboard() {
    const nameDisplay = document.getElementById('userNameDisplay');
    const emailDisplay = document.getElementById('userEmailDisplay');
    const badgeText = document.getElementById('userBadgeText');
    const countEl = document.getElementById('dashBookmarkCount');
    const sectionTitle = document.getElementById('dashSavedSectionTitle');
    const sectionSubtitle = document.getElementById('dashSavedSectionSubtitle');

    // 1. Read Current User Session
    let currentUser: any = null;
    const localUserStr = localStorage.getItem('aio_user');
    if (localUserStr) {
      try { currentUser = JSON.parse(localUserStr); } catch (e) {}
    }

    if (!currentUser) {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && (k === 'supabase.auth.token' || (k.startsWith('sb-') && k.endsWith('-auth-token')))) {
          try {
            const parsed = JSON.parse(localStorage.getItem(k) || '{}');
            const sessionUser = parsed.user || (parsed.currentSession && parsed.currentSession.user);
            if (sessionUser) {
              const meta = sessionUser.user_metadata || {};
              currentUser = {
                id: sessionUser.id,
                email: sessionUser.email || '',
                name: meta.full_name || meta.name || sessionUser.email?.split('@')[0] || 'Builder',
                authProvider: meta.iss ? 'google' : 'email'
              };
              localStorage.setItem('aio_user', JSON.stringify(currentUser));
            }
          } catch(e) {}
          break;
        }
      }
    }

    if (currentUser) {
      if (nameDisplay) nameDisplay.textContent = currentUser.name || 'Builder';
      if (emailDisplay) emailDisplay.textContent = currentUser.email || '';
      if (badgeText) badgeText.textContent = currentUser.authProvider === 'google' ? 'Google Account' : 'Verified Builder';
    }

    // 2. Synchronize Bookmarks & UI Counters
    function refreshBookmarksUI() {
      const savedBookmarks: string[] = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
      const bCount = savedBookmarks.length;

      if (countEl) countEl.textContent = String(bCount);

      if (bCount === 0) {
        if (sectionTitle) sectionTitle.textContent = 'Recommended Starter Stack — Click Pin to Save to Your Workspace';
        if (sectionSubtitle) sectionSubtitle.textContent = 'Curated foundation tools. Pin them to add to your personal stack.';
      } else {
        if (sectionTitle) sectionTitle.textContent = `My Saved Tools & Repositories (${bCount})`;
        if (sectionSubtitle) sectionSubtitle.textContent = 'Quick access to the tools you have pinned to your engineering workspace.';
      }

      // Update Pin Buttons State
      document.querySelectorAll('.dash-pin-btn').forEach((btn: any) => {
        const slug = btn.getAttribute('data-tool-slug');
        if (savedBookmarks.includes(slug)) {
          btn.textContent = '✓ Pinned';
          btn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
          btn.classList.remove('text-[#2563EB]', 'bg-white');
        } else {
          btn.textContent = '📌 Pin';
          btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
          btn.classList.add('text-[#2563EB]', 'bg-white');
        }
      });

      // Update Onboarding Steps
      updateOnboardingProgress(bCount);
    }

    // 3. Pin Button Click Handler
    document.querySelectorAll('.dash-pin-btn').forEach((btn: any) => {
      btn.addEventListener('click', async () => {
        const slug = btn.getAttribute('data-tool-slug');
        let savedBookmarks: string[] = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
        
        if (savedBookmarks.includes(slug)) {
          savedBookmarks = savedBookmarks.filter(s => s !== slug);
        } else {
          savedBookmarks.push(slug);
          // Persist to Supabase if authenticated
          if (currentUser?.id) {
            try {
              await supabase.from('bookmarks').insert({ user_id: currentUser.id, tool_slug: slug });
            } catch (err) {
              console.warn('Supabase bookmark insert notice:', err);
            }
          }
        }
        localStorage.setItem('aio_bookmarks', JSON.stringify(savedBookmarks));
        refreshBookmarksUI();
      });
    });

    // 4. Onboarding Progress Calculation
    function updateOnboardingProgress(bCount: number) {
      const stacks = JSON.parse(localStorage.getItem('aio_custom_stacks') || '[]');
      const workflows = JSON.parse(localStorage.getItem('aio_custom_workflows') || '[]');

      const step1Done = bCount >= 3;
      const step2Done = stacks.length >= 1;
      const step3Done = workflows.length >= 1;

      let completedSteps = 0;
      if (step1Done) completedSteps++;
      if (step2Done) completedSteps++;
      if (step3Done) completedSteps++;

      const countSpan = document.getElementById('onboardingDoneCount');
      const progressBar = document.getElementById('onboardingProgressBar');
      const levelBadge = document.getElementById('onboardingLevelBadge');

      if (countSpan) countSpan.textContent = String(completedSteps);
      if (progressBar) progressBar.style.width = `${(completedSteps / 3) * 100}%`;
      if (levelBadge) {
        levelBadge.textContent = completedSteps === 3 ? 'Master Builder (Level 3)' : completedSteps >= 1 ? 'Builder Level 2' : 'Builder Level 1';
      }

      // Step 1 UI
      const s1Icon = document.getElementById('step1Icon');
      const s1Check = document.getElementById('step1Check');
      const s1Status = document.getElementById('step1Status');
      if (s1Status) s1Status.textContent = `${bCount} / 3 tools pinned to workspace`;
      if (step1Done) {
        s1Icon?.classList.add('bg-emerald-100', 'text-emerald-700');
        s1Check?.classList.remove('hidden');
      }

      // Step 2 UI
      const s2Icon = document.getElementById('step2Icon');
      const s2Check = document.getElementById('step2Check');
      const s2Status = document.getElementById('step2Status');
      if (s2Status) s2Status.textContent = stacks.length >= 1 ? `${stacks.length} named stack saved` : 'Select 5 layers & save with name';
      if (step2Done) {
        s2Icon?.classList.add('bg-emerald-100', 'text-emerald-700');
        s2Check?.classList.remove('hidden');
      }

      // Step 3 UI
      const s3Icon = document.getElementById('step3Icon');
      const s3Check = document.getElementById('step3Check');
      const s3Status = document.getElementById('step3Status');
      if (s3Status) s3Status.textContent = workflows.length >= 1 ? `${workflows.length} workflow pipelines active` : 'Run simulation or export SKILL.md';
      if (step3Done) {
        s3Icon?.classList.add('bg-emerald-100', 'text-emerald-700');
        s3Check?.classList.remove('hidden');
      }

      // Workflow & Stack KPI Counters
      const wfCountEl = document.getElementById('dashWorkflowCount');
      if (wfCountEl) wfCountEl.textContent = String(workflows.length);
      const stackCountEl = document.getElementById('dashStackCount');
      if (stackCountEl) stackCountEl.textContent = String(stacks.length);
    }

    refreshBookmarksUI();

    // 5. Hydrate Dashboard Intelligence Briefing with Live News Stream
    try {
      const liveItems = await fetchLiveAINews();
      if (liveItems && liveItems.length > 0) {
        const newsContainer = document.getElementById('dashNewsContainer');
        if (newsContainer) {
          const top4 = liveItems.slice(0, 4);
          newsContainer.innerHTML = top4.map(item => `
            <a 
              href="${item.url}" 
              target="_blank"
              rel="noopener noreferrer"
              class="block p-4 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all group"
            >
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]">
                  ${item.sourceBadge}
                </span>
                <span class="text-[10px] font-mono text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded-full">
                  ${item.category}
                </span>
                <span class="text-[11px] font-mono text-slate-400">• ${item.timeAgo}</span>
              </div>
              <h3 class="text-xs sm:text-sm font-bold text-[#09090B] group-hover:text-[#2563EB] transition-colors line-clamp-1">
                ${item.title}
              </h3>
              <div class="mt-1 flex items-center justify-between text-[11px] text-slate-500">
                <span>Verified Source</span>
                <span class="text-[#2563EB] font-bold group-hover:underline">Read Story ↗</span>
              </div>
            </a>
          `).join('');
        }
      }
    } catch (e) {
      console.warn('Dashboard live news hydration notice:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
</script>
