---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { getAllCategories, getAllTools, calculateAuthenticScore } from '../services/dataService';

const categories = await getAllCategories();
const allTools = await getAllTools();

// Compute authentic category average score
const categoryScores: Record<string, number> = {};
categories.forEach(cat => {
  const catTools = allTools.filter(t => (t.categorySlugs || []).includes(cat.slug) || (t as any).categorySlug === cat.slug);
  if (catTools.length > 0) {
    const sum = catTools.reduce((acc, t) => acc + calculateAuthenticScore(t).total, 0);
    categoryScores[cat.slug] = Math.round(sum / catTools.length);
  } else {
    categoryScores[cat.slug] = 85;
  }
});

const DOMAINS = [
  {
    title: 'Content & Creative',
    description: 'Tools for visual, audio, video, and written media creation.',
    slugs: ['video-generation', 'image-art', 'audio-voice', 'writing-copy']
  },
  {
    title: 'Development & IT',
    description: 'Autonomous coding, pair programming, and model weight deployment.',
    slugs: ['code-assistants', 'web-app-builders', 'open-source-models']
  },
  {
    title: 'Business & Productivity',
    description: 'Automating multi-step tasks, research summarization, and outbound ops.',
    slugs: ['research-analysis', 'automation-workflows', 'sales-marketing']
  },
  {
    title: 'Conversational & Agents',
    description: 'Omni-chatbots, reasoning systems, and autonomous task agents.',
    slugs: ['general-chatbots', 'autonomous-agents']
  },
  {
    title: 'Regional & Specialized Innovation',
    description: 'Indigenous LLMs, Indic translation, and regional data sovereignty.',
    slugs: ['india-first']
  }
];
---

<Layout 
  title="AI Categories & Leaderboards | AIO AI"
  description="Explore our comprehensive 5-domain taxonomy covering all creative, development, automation, and regional AI tools with top 10 leaderboards."
>
  <Header currentPath="/categories" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-10 md:py-14">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="text-[11px] font-mono text-mute uppercase tracking-wider mb-1">
            Taxonomy Architecture & Top 10 Leaderboards
          </div>
          <h1 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-2">
            Explore AI Categories
          </h1>
          <p class="text-xs sm:text-sm text-body max-w-2xl leading-relaxed">
            Structured by domain and user intent, helping you locate specialized models, leaderboards, and workflows in seconds.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 text-xs">
          <a href="/tools" class="px-3.5 py-2 rounded-md bg-ink hover:bg-neutral-800 text-on-primary font-medium transition-colors shadow-xs">
            Browse All Tools &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Domains and Category Groups -->
    <div class="w-full max-w-7xl mx-auto px-6 py-10 flex flex-col gap-10">
      {DOMAINS.map(domain => {
        const domainCats = categories.filter(c => domain.slugs.includes(c.slug));
        return (
          <section>
            <div class="border-b border-hairline pb-2.5 mb-5 flex items-end justify-between">
              <div>
                <h2 class="text-lg font-semibold text-ink tracking-tight">{domain.title}</h2>
                <p class="text-xs text-mute mt-0.5">{domain.description}</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {domainCats.map(cat => (
                <div class="bg-canvas-elevated border border-hairline rounded-lg p-5 flex flex-col justify-between hover:border-faint transition-all shadow-xs group">
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <div class="p-2 rounded bg-canvas border border-hairline text-ink">
                        <CategoryIcon slug={cat.slug} class="w-5 h-5 text-ink" />
                      </div>
                      <div class="flex items-center gap-1.5">
                        <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-50 text-primary border border-blue-200">
                          Avg {categoryScores[cat.slug] || 85}
                        </span>
                        <span class="text-[11px] font-mono text-mute">{cat.count || 0} tools</span>
                      </div>
                    </div>

                    <h3 class="font-semibold text-ink text-sm group-hover:underline mb-1">
                      <a href={`/tools?category=${cat.slug}`}>
                        {cat.name}
                      </a>
                    </h3>
                    <p class="text-xs text-body leading-relaxed mb-4 line-clamp-2">
                      {cat.description}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
                    <a href={`/tools?category=${cat.slug}&sort=score`} class="text-[11px] font-mono text-mute hover:text-ink transition-colors">
                      Top 10 Leaderboard
                    </a>
                    <a href={`/tools?category=${cat.slug}`} class="font-medium text-ink hover:underline inline-flex items-center gap-0.5">
                      <span>Explore</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
      <!-- 5-Factor Authenticity Scoring Methodology Section -->
      <section class="border-t border-hairline pt-10 mt-6">
        <div class="bg-canvas-elevated border border-hairline rounded-xl p-8 shadow-xs">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-hairline pb-4 mb-6">
            <div>
              <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-mono font-bold mb-2">
                TRANSPARENCY STANDARD
              </div>
              <h2 class="text-xl font-bold text-ink">The 5-Factor Authenticity Scoring Framework</h2>
              <p class="text-xs text-mute mt-1">
                Zero pay-to-win placements. Every score on AIO AI is calculated deterministically across 5 auditable criteria (0–100 pts).
              </p>
            </div>
            <a href="/tools" class="px-4 py-2 rounded-lg bg-ink text-white text-xs font-semibold hover:bg-neutral-800 transition-colors shrink-0">
              Explore Verified Tools &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-5 gap-4 text-xs">
            <div class="p-4 rounded-lg bg-surface border border-hairline">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-ink">1. Docs & API</span>
                <span class="font-mono text-primary font-bold">25 pts</span>
              </div>
              <p class="text-mute text-[11px] leading-relaxed">
                Public API specifications, GitHub source repository presence, and SDK developer ergonomics.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-surface border border-hairline">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-ink">2. Pricing Transparency</span>
                <span class="font-mono text-emerald-600 font-bold">25 pts</span>
              </div>
              <p class="text-mute text-[11px] leading-relaxed">
                Clear self-serve pricing tiers, permanent free tier allowances, and upfront pricing without hidden sales calls.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-surface border border-hairline">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-ink">3. Workflow Interop</span>
                <span class="font-mono text-purple-600 font-bold">20 pts</span>
              </div>
              <p class="text-mute text-[11px] leading-relaxed">
                Standard format exports (JSON/CSV), webhook/MCP/REST pipeline readiness, and self-hosted alternative options.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-surface border border-hairline">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-ink">4. Domain Health</span>
                <span class="font-mono text-teal-600 font-bold">15 pts</span>
              </div>
              <p class="text-mute text-[11px] leading-relaxed">
                Valid HTTPS endpoints, verified active HTTP 200 uptime, and current SSL certificate integrity.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-surface border border-hairline">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-ink">5. Community Signal</span>
                <span class="font-mono text-amber-600 font-bold">15 pts</span>
              </div>
              <p class="text-mute text-[11px] leading-relaxed">
                Verified developer reviews, GitHub star velocity, and real practitioner adoption without astroturfing.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>