---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { getAllCategories } from '../services/dataService';

const categories = await getAllCategories();

const DOMAINS = [
  {
    title: 'Content & Creative',
    description: 'Tools for visual, audio, video, and written media creation.',
    slugs: ['video-generation', 'image-art', 'audio-voice', 'writing-copy']
  },
  {
    title: 'Development & IT',
    description: 'Autonomous coding, pair programming, and model weight deployment.',
    slugs: ['code-assistants', 'web-app-builders', 'open-source-models']
  },
  {
    title: 'Business & Productivity',
    description: 'Automating multi-step tasks, research summarization, and outbound ops.',
    slugs: ['research-analysis', 'automation-workflows', 'sales-marketing']
  },
  {
    title: 'Conversational & Agents',
    description: 'Omni-chatbots, reasoning systems, and autonomous task agents.',
    slugs: ['general-chatbots', 'autonomous-agents']
  },
  {
    title: 'Regional & Specialized Innovation',
    description: 'Indigenous LLMs, Indic translation, and regional data sovereignty.',
    slugs: ['india-first']
  }
];
---

<Layout 
  title="AI Categories & Leaderboards | AIO AI"
  description="Explore our comprehensive 5-domain taxonomy covering all creative, development, automation, and regional AI tools with top 10 leaderboards."
>
  <Header currentPath="/categories" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-10 md:py-14">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="text-[11px] font-mono text-mute uppercase tracking-wider mb-1">
            Taxonomy Architecture & Top 10 Leaderboards
          </div>
          <h1 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-2">
            Explore AI Categories
          </h1>
          <p class="text-xs sm:text-sm text-body max-w-2xl leading-relaxed">
            Structured by domain and user intent, helping you locate specialized models, leaderboards, and workflows in seconds.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 text-xs">
          <a href="/tools" class="px-3.5 py-2 rounded-md bg-ink hover:bg-neutral-800 text-on-primary font-medium transition-colors shadow-xs">
            Browse All Tools &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Domains and Category Groups -->
    <div class="w-full max-w-7xl mx-auto px-6 py-10 flex flex-col gap-10">
      {DOMAINS.map(domain => {
        const domainCats = categories.filter(c => domain.slugs.includes(c.slug));
        return (
          <section>
            <div class="border-b border-hairline pb-2.5 mb-5 flex items-end justify-between">
              <div>
                <h2 class="text-lg font-semibold text-ink tracking-tight">{domain.title}</h2>
                <p class="text-xs text-mute mt-0.5">{domain.description}</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {domainCats.map(cat => (
                <div class="bg-canvas-elevated border border-hairline rounded-lg p-5 flex flex-col justify-between hover:border-faint transition-all shadow-xs group">
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <div class="p-2 rounded bg-canvas border border-hairline text-ink">
                        <CategoryIcon slug={cat.slug} class="w-5 h-5 text-ink" />
                      </div>
                      <span class="text-[11px] font-mono text-mute">{cat.count || 0} tools</span>
                    </div>

                    <h3 class="font-semibold text-ink text-sm group-hover:underline mb-1">
                      <a href={`/tools?category=${cat.slug}`}>
                        {cat.name}
                      </a>
                    </h3>
                    <p class="text-xs text-body leading-relaxed mb-4 line-clamp-2">
                      {cat.description}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
                    <a href={`/tools?category=${cat.slug}&sort=score`} class="text-[11px] font-mono text-mute hover:text-ink transition-colors">
                      Top 10 Leaderboard
                    </a>
                    <a href={`/tools?category=${cat.slug}`} class="font-medium text-ink hover:underline inline-flex items-center gap-0.5">
                      <span>Explore</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>

  <Footer />
</Layout>