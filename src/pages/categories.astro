---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import ToolLogo from '../components/ToolLogo.astro';
import { getAllCategories, getAllTools, calculateAuthenticScore } from '../services/dataService';

const categories = await getAllCategories();
const allTools = await getAllTools();

// Compute authentic category average score and top 5 tools per category
const categoryScores: Record<string, number> = {};
const categoryTopTools: Record<string, any[]> = {};

categories.forEach(cat => {
  const catTools = allTools.filter(t => (t.categorySlugs || []).includes(cat.slug) || (t as any).categorySlug === cat.slug);
  
  // Sort tools by 5-factor score descending
  const scoredTools = catTools.map(t => ({
    ...t,
    scorecard: calculateAuthenticScore(t)
  })).sort((a, b) => b.scorecard.total - a.scorecard.total);

  categoryTopTools[cat.slug] = scoredTools.slice(0, 5);

  if (catTools.length > 0) {
    const sum = scoredTools.reduce((acc, t) => acc + t.scorecard.total, 0);
    categoryScores[cat.slug] = Math.round(sum / catTools.length);
  } else {
    categoryScores[cat.slug] = 85;
  }
});

const DOMAINS = [
  {
    title: 'Content & Creative',
    description: 'Tools for visual, audio, video, and written media creation.',
    slugs: ['video-generation', 'image-art', 'audio-voice', 'writing-copy']
  },
  {
    title: 'Development & IT',
    description: 'Autonomous coding, pair programming, and model weight deployment.',
    slugs: ['code-assistants', 'web-app-builders', 'open-source-models']
  },
  {
    title: 'Business & Productivity',
    description: 'Automating multi-step tasks, research summarization, and outbound ops.',
    slugs: ['research-analysis', 'automation-workflows', 'sales-marketing']
  },
  {
    title: 'Conversational & Agents',
    description: 'Omni-chatbots, reasoning systems, and autonomous task agents.',
    slugs: ['general-chatbots', 'autonomous-agents']
  },
  {
    title: 'Regional & Specialized Innovation',
    description: 'Indigenous LLMs, Indic translation, and regional data sovereignty.',
    slugs: ['india-first']
  }
];
---

<Layout 
  title="AI Categories Leaderboard & Bento Previews | AIO AI"
  description="Explore our comprehensive 13-category taxonomy covering all creative, development, automation, and sovereign AI tools with top 5 ranked bento previews."
>
  <Header currentPath="/categories" />

  <!-- Top Secondary Sub-Navigation Tabs -->
  <div class="bg-white border-b border-[#E2E8F0] px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex items-center gap-1 overflow-x-auto text-xs py-2 scrollbar-none">
      <a href="/tools" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        All 113 Tools
      </a>
      <a href="/categories" class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-[#2563EB] font-bold shrink-0">
        Categories Leaderboard
      </a>
      <a href="/india-ai" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        India-First AI
      </a>
      <a href="/compare" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        Side-by-Side Compare
      </a>
    </div>
  </div>

  <main class="w-full flex flex-col min-h-screen bg-[#F8FAFF]">
    
    <!-- Hero Header -->
    <section class="border-b border-[#E2E8F0] bg-white px-4 sm:px-6 py-8 sm:py-12">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="text-[11px] font-mono text-[#2563EB] font-bold uppercase tracking-wider mb-1.5 flex items-center gap-2">
            <span>AIxploria-Style Top Ranked Bento Engine</span>
            <span>•</span>
            <span class="text-slate-400">13 Categories</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-[#09090B] tracking-tight mb-2">
            Categories & Top-5 Ranked Bento Grid
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 max-w-2xl leading-relaxed">
            Every category ranked deterministically using our 5-Factor Authenticity Score (Docs, Pricing, Interop, Health, and Community Signal).
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 text-xs">
          <a href="/tools" class="px-4 py-2.5 rounded-xl bg-[#09090B] hover:bg-neutral-800 text-white font-bold transition-all shadow-xs">
            Browse All 113 Tools &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Domains and Category Bento Groups -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-10 flex flex-col gap-10">
      {DOMAINS.map(domain => {
        const domainCats = categories.filter(c => domain.slugs.includes(c.slug));
        return (
          <section>
            <div class="border-b border-[#E2E8F0] pb-3 mb-6 flex items-end justify-between">
              <div>
                <h2 class="text-lg font-black text-[#09090B] tracking-tight">{domain.title}</h2>
                <p class="text-xs text-slate-500 mt-0.5">{domain.description}</p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {domainCats.map(cat => {
                const topTools = categoryTopTools[cat.slug] || [];
                return (
                  <div class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs hover:border-[#2563EB] transition-all flex flex-col justify-between">
                    <div>
                      <!-- Category Header -->
                      <div class="flex items-start justify-between gap-3 mb-4">
                        <div class="flex items-center gap-3">
                          <div class="p-2.5 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] text-[#09090B] shrink-0">
                            <CategoryIcon slug={cat.slug} class="w-5 h-5 text-[#2563EB]" />
                          </div>
                          <div>
                            <h3 class="font-bold text-[#09090B] text-base hover:text-[#2563EB] transition-colors">
                              <a href={`/tools?category=${cat.slug}`}>
                                {cat.name}
                              </a>
                            </h3>
                            <span class="text-[11px] font-mono text-slate-400">{cat.count || 0} tools indexed</span>
                          </div>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                          <span class="text-[11px] font-mono font-bold px-2 py-0.5 rounded-full bg-blue-50 text-[#2563EB] border border-blue-200">
                            Avg {categoryScores[cat.slug] || 85}/100
                          </span>
                        </div>
                      </div>

                      <p class="text-xs text-slate-600 leading-relaxed mb-4">
                        {cat.description}
                      </p>

                      <!-- AIxploria-Style Top 5 Ranked Bento Tools List -->
                      <div class="space-y-2 mb-4">
                        <div class="text-[10px] font-mono uppercase font-bold text-slate-400 tracking-wider">
                          Top-5 Ranked in {cat.name}
                        </div>
                        {topTools.map((t, idx) => (
                          <div class="p-2.5 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] hover:bg-white hover:border-[#BFDBFE] transition-all flex items-center justify-between gap-3 group">
                            <div class="flex items-center gap-2.5 min-w-0">
                              <span class="text-[11px] font-mono font-bold text-slate-400 w-4 text-center">
                                #{idx + 1}
                              </span>
                              <ToolLogo websiteUrl={t.websiteUrl} name={t.name} size="sm" />
                              <div class="min-w-0">
                                <a href={`/tools/${t.slug}`} class="font-bold text-xs text-[#09090B] group-hover:text-[#2563EB] transition-colors truncate block">
                                  {t.name}
                                </a>
                                <span class="text-[10px] text-slate-500 font-mono block truncate">
                                  {t.tagline}
                                </span>
                              </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                              <span class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded bg-white border border-[#E2E8F0] text-slate-700">
                                {t.pricingType}
                              </span>
                              <span class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">
                                {t.scorecard?.total || 85}/100
                              </span>
                              <a href={`/tools/${t.slug}`} class="text-[11px] text-[#2563EB] font-bold hover:underline">
                                Inspect &rarr;
                              </a>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <!-- Card Footer Actions -->
                    <div class="pt-4 border-t border-[#E2E8F0] flex items-center justify-between text-xs">
                      <a href={`/tools?category=${cat.slug}&sort=score`} class="text-[11px] font-mono text-slate-500 hover:text-[#2563EB] transition-colors">
                        View Full Ranked Leaderboard &rarr;
                      </a>
                      <a href={`/tools?category=${cat.slug}`} class="font-bold text-[#09090B] hover:text-[#2563EB] inline-flex items-center gap-1 transition-colors">
                        <span>Browse All {cat.count || 0}</span>
                        <span>&rarr;</span>
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}

      <!-- 5-Factor Authenticity Scoring Methodology Section -->
      <section class="border-t border-[#E2E8F0] pt-10 mt-6">
        <div class="bg-white border border-[#E2E8F0] rounded-2xl p-6 sm:p-8 shadow-xs">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#E2E8F0] pb-4 mb-6">
            <div>
              <div class="text-[11px] font-mono font-bold text-[#2563EB] uppercase tracking-wider mb-1">
                Deterministic Scoring Standard
              </div>
              <h2 class="text-xl font-black text-[#09090B] tracking-tight">
                Our 5-Factor Authenticity Methodology
              </h2>
            </div>
            <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 self-start md:self-auto">
              100% Deterministic • 0% Sponsored Placement
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF]">
              <div class="font-mono text-xs font-bold text-[#2563EB] mb-1">Max 25 Pts</div>
              <div class="font-bold text-xs text-[#09090B] mb-1">1. Docs & API Maturity</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">
                OpenAPI specifications, public SDK availability, interactive playgrounds, and developer changelogs.
              </p>
            </div>

            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF]">
              <div class="font-mono text-xs font-bold text-[#2563EB] mb-1">Max 25 Pts</div>
              <div class="font-bold text-xs text-[#09090B] mb-1">2. Pricing Transparency</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">
                Public pricing page, free tier / trial terms, clear overage limits, and self-serve upgrade flows.
              </p>
            </div>

            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF]">
              <div class="font-mono text-xs font-bold text-[#2563EB] mb-1">Max 20 Pts</div>
              <div class="font-bold text-xs text-[#09090B] mb-1">3. Workflow Interop</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">
                Support for webhooks, n8n/Zapier integrations, REST/gRPC endpoints, and MCP server extensions.
              </p>
            </div>

            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF]">
              <div class="font-mono text-xs font-bold text-[#2563EB] mb-1">Max 15 Pts</div>
              <div class="font-bold text-xs text-[#09090B] mb-1">4. Live Domain Health</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">
                Strict HTTPS enforcement, 99.9% uptime track record, and low-latency DNS resolution.
              </p>
            </div>

            <div class="p-4 rounded-xl border border-[#E2E8F0] bg-[#F8FAFF]">
              <div class="font-mono text-xs font-bold text-[#2563EB] mb-1">Max 15 Pts</div>
              <div class="font-bold text-xs text-[#09090B] mb-1">5. Community Signal</div>
              <p class="text-[11px] text-slate-500 leading-relaxed">
                Verifiable GitHub stars, practitioner discourse, independent benchmarks, and production adoption.
              </p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
