---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Sign Up | AIO AI" description="Create an account to bookmark your favorite AI tools and share verified reviews.">
  <Header currentPath="/signup" />

  <main class="w-full flex-1 flex items-center justify-center px-6 py-16 bg-canvas">
    <div class="w-full max-w-md bg-white border border-[#E2E8F0] rounded-2xl p-8 shadow-xs">
      <div class="text-center mb-6">
        <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-200 text-primary flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM4 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.375 12.375 0 0 1 10.375 21c-2.348 0-4.542-.647-6.375-1.765Z" />
          </svg>
        </div>
        <h1 class="text-2xl font-black text-ink tracking-tight mb-1.5">Join AIO AI</h1>
        <p class="text-xs text-neutral-500">Create an account to participate in the verified AI discovery community</p>
      </div>

      <!-- Quick Demo Sign In Button -->
      <button 
        id="demoSignupBtn"
        type="button"
        class="w-full py-2.5 px-4 mb-4 rounded-xl bg-blue-50 border border-blue-200 text-primary text-xs font-bold hover:bg-blue-100 transition-colors cursor-pointer flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
        </svg>
        <span>Instant Demo Account (One Click)</span>
      </button>

      <div class="flex items-center gap-2 my-4 text-neutral-400 text-xs">
        <div class="h-px bg-neutral-200 flex-1"></div>
        <span class="text-[10px] font-mono uppercase">or register email</span>
        <div class="h-px bg-neutral-200 flex-1"></div>
      </div>

      <div id="errorAlert" class="hidden mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-xs text-red-700 font-medium"></div>
      <div id="successAlert" class="hidden mb-4 p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-medium"></div>

      <form id="signupForm" class="flex flex-col gap-4 text-xs">
        <div>
          <label class="block font-semibold text-ink mb-1">Email address</label>
          <input 
            type="email" 
            id="email" 
            placeholder="you@example.com" 
            required
            class="w-full bg-surface border border-[#E2E8F0] focus:border-primary rounded-lg px-3 py-2.5 text-ink outline-none transition-colors font-sans"
          />
        </div>

        <div>
          <label class="block font-semibold text-ink mb-1">Password</label>
          <input 
            type="password" 
            id="password" 
            placeholder="At least 6 characters" 
            required
            minlength="6"
            class="w-full bg-surface border border-[#E2E8F0] focus:border-primary rounded-lg px-3 py-2.5 text-ink outline-none transition-colors font-sans"
          />
        </div>

        <button 
          type="submit" 
          id="submitBtn"
          class="w-full mt-2 bg-primary text-white font-bold py-2.5 rounded-xl hover:bg-blue-700 transition-colors cursor-pointer shadow-xs text-center"
        >
          Create Account
        </button>
      </form>

      <div class="mt-6 pt-6 border-t border-[#E2E8F0] text-center text-xs text-neutral-500">
        <span>Already have an account?</span>
        <a href="/login" class="text-primary font-bold hover:underline ml-1">Log in</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('signupForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const errorAlert = document.getElementById('errorAlert') as HTMLDivElement;
  const successAlert = document.getElementById('successAlert') as HTMLDivElement;
  const demoSignupBtn = document.getElementById('demoSignupBtn');

  demoSignupBtn?.addEventListener('click', () => {
    const demoUser = {
      id: 'demo-usr-994',
      email: 'builder@aio-ai.dev',
      role: 'member',
      created_at: new Date().toISOString()
    };
    localStorage.setItem('aio_user', JSON.stringify(demoUser));
    window.location.href = '/profile';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    successAlert?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating account...';

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    const { data, error } = await supabase.auth.signUp({
      email,
      password,
    });

    if (error) {
      errorAlert.textContent = error.message;
      errorAlert.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create Account';
    } else {
      successAlert.textContent = 'Account created successfully! Check your email for verification link or sign in.';
      successAlert.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create Account';
      if (data.session) {
        localStorage.setItem('aio_user', JSON.stringify({
          id: data.session.user.id,
          email: data.session.user.email,
          role: 'member',
          created_at: new Date().toISOString()
        }));
        setTimeout(() => {
          window.location.href = '/profile';
        }, 1200);
      }
    }
  });
</script>
