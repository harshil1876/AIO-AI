---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Create Workspace Account | AIO AI" 
  description="Create your free AIO AI account to bookmark tools, save production stacks, and participate in technical benchmarks."
  hideSidebar={true}
>
  <!-- Public Minimal Header -->
  <header class="border-b border-[#E2E8F0] bg-white px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-black text-xs tracking-tight">
        AI
      </div>
      <span class="text-[#09090B] font-black tracking-tight text-base">AIO AI</span>
    </a>
    <div class="text-xs text-slate-500">
      Already have an account? <a href="/login" class="text-[#2563EB] font-bold hover:underline ml-1">Sign In</a>
    </div>
  </header>

  <main class="w-full flex-1 flex items-center justify-center px-6 py-14 bg-[#F8FAFF] min-h-[calc(100vh-140px)]">
    <div class="w-full max-w-md bg-white border border-[#E2E8F0] rounded-2xl p-8 shadow-sm hover:shadow-md transition-all">
      
      <div class="text-center mb-6">
        <h1 class="text-2xl font-black text-[#09090B] tracking-tight mb-1.5">Join AIO AI Workspace</h1>
        <p class="text-xs text-slate-500">Free forever for practitioners, creators, and engineers</p>
      </div>

      <!-- 1. Prominent "Continue with Google" Button (Top) -->
      <button 
        id="googleSignupBtn"
        type="button"
        class="w-full py-3 px-4 mb-4 rounded-xl bg-white hover:bg-[#F8FAFF] border border-[#E2E8F0] text-[#09090B] text-xs font-bold transition-all shadow-xs hover:border-[#2563EB] cursor-pointer flex items-center justify-center gap-3"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
        <span>Continue with Google</span>
      </button>

      <!-- Instant Demo Session Button -->
      <button 
        id="demoSignupBtn"
        type="button"
        class="w-full py-2.5 px-4 mb-4 rounded-xl bg-[#EFF6FF] border border-[#BFDBFE] text-[#2563EB] text-xs font-bold hover:bg-blue-100 transition-colors cursor-pointer flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
        </svg>
        <span>Instant Local Demo Account</span>
      </button>

      <div class="flex items-center gap-2 my-4 text-slate-400 text-xs">
        <div class="h-px bg-slate-200 flex-1"></div>
        <span class="text-[10px] font-mono uppercase">or register email</span>
        <div class="h-px bg-slate-200 flex-1"></div>
      </div>

      <div id="errorAlert" class="hidden mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700 font-medium"></div>
      <div id="successAlert" class="hidden mb-4 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-medium"></div>

      <form id="signupForm" class="flex flex-col gap-4 text-xs">
        <div>
          <label class="block font-bold text-[#09090B] mb-1">Email address</label>
          <input 
            type="email" 
            id="email" 
            placeholder="you@example.com" 
            required
            class="w-full bg-[#F8FAFF] border border-[#E2E8F0] focus:border-[#2563EB] rounded-xl px-3.5 py-2.5 text-[#09090B] outline-none transition-colors font-sans"
          />
        </div>

        <div>
          <label class="block font-bold text-[#09090B] mb-1">Password</label>
          <input 
            type="password" 
            id="password" 
            placeholder="At least 6 characters" 
            required
            minlength="6"
            class="w-full bg-[#F8FAFF] border border-[#E2E8F0] focus:border-[#2563EB] rounded-xl px-3.5 py-2.5 text-[#09090B] outline-none transition-colors font-sans"
          />
        </div>

        <button 
          type="submit" 
          id="submitBtn"
          class="w-full mt-2 bg-[#2563EB] text-white font-bold py-3 rounded-xl hover:bg-[#1D4ED8] transition-colors cursor-pointer shadow-xs text-center"
        >
          Create Free Account
        </button>
      </form>
    </div>
  </main>

  <!-- Interactive Google Account Selector Modal (Fallback) -->
  <div id="signupGoogleModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div class="fixed inset-0 bg-black/60 backdrop-blur-xs" onclick="document.getElementById('signupGoogleModal').classList.add('hidden')"></div>
    <div class="relative w-full max-w-sm bg-white rounded-2xl shadow-2xl p-6 z-10 border border-[#E2E8F0]">
      <div class="text-center mb-5">
        <h3 class="text-sm font-bold text-[#09090B]">Choose a Google Account</h3>
        <p class="text-xs text-slate-500">to continue to AIO AI Workspace</p>
      </div>

      <div class="space-y-2 mb-4">
        <button 
          type="button"
          class="google-signup-choice w-full flex items-center gap-3 p-3 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all text-left cursor-pointer"
          data-email="alex.builder.ai@gmail.com"
          data-name="Alex Chen"
        >
          <div class="w-8 h-8 rounded-full bg-[#2563EB] text-white flex items-center justify-center font-bold text-xs">A</div>
          <div class="min-w-0 flex-1">
            <div class="text-xs font-bold text-[#09090B]">Alex Chen</div>
            <div class="text-[11px] text-slate-500 truncate font-mono">alex.builder.ai@gmail.com</div>
          </div>
        </button>

        <button 
          type="button"
          class="google-signup-choice w-full flex items-center gap-3 p-3 rounded-xl border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all text-left cursor-pointer"
          data-email="priya.ai.engineer@gmail.com"
          data-name="Priya Sharma"
        >
          <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-xs">P</div>
          <div class="min-w-0 flex-1">
            <div class="text-xs font-bold text-[#09090B]">Priya Sharma</div>
            <div class="text-[11px] text-slate-500 truncate font-mono">priya.ai.engineer@gmail.com</div>
          </div>
        </button>
      </div>

      <button
        type="button"
        onclick="document.getElementById('signupGoogleModal').classList.add('hidden')"
        class="w-full py-2 text-xs text-slate-500 hover:text-ink font-medium"
      >
        Cancel
      </button>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  const form = document.getElementById('signupForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const errorAlert = document.getElementById('errorAlert') as HTMLDivElement;
  const successAlert = document.getElementById('successAlert') as HTMLDivElement;
  const demoSignupBtn = document.getElementById('demoSignupBtn');
  const googleSignupBtn = document.getElementById('googleSignupBtn');
  const googleModal = document.getElementById('signupGoogleModal');

  const urlParams = new URLSearchParams(window.location.search);
  const redirectTarget = urlParams.get('redirect') || '/';

  // 1. Google Sign-Up Handler
  googleSignupBtn?.addEventListener('click', async () => {
    if (isSupabaseConfigured) {
      try {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: window.location.origin + redirectTarget
          }
        });
        if (!error) return;
      } catch (e) {
        // Fallback
      }
    }
    googleModal?.classList.remove('hidden');
  });

  // Google Account Choices
  document.querySelectorAll('.google-signup-choice').forEach(btn => {
    btn.addEventListener('click', () => {
      const email = btn.getAttribute('data-email') || 'alex.builder.ai@gmail.com';
      const name = btn.getAttribute('data-name') || 'Google Member';
      const googleUser = {
        id: 'goog-usr-' + Date.now().toString(36),
        email,
        name,
        role: 'member',
        authProvider: 'google',
        created_at: new Date().toISOString()
      };
      localStorage.setItem('aio_user', JSON.stringify(googleUser));
      window.location.href = redirectTarget;
    });
  });

  // 2. Demo Signup
  demoSignupBtn?.addEventListener('click', () => {
    const demoUser = {
      id: 'demo-usr-994',
      email: 'builder@aio-ai.dev',
      name: 'Verified Builder',
      role: 'member',
      authProvider: 'demo',
      created_at: new Date().toISOString()
    };
    localStorage.setItem('aio_user', JSON.stringify(demoUser));
    window.location.href = redirectTarget;
  });

  // 3. Email Signup
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    successAlert?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating account...';

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (isSupabaseConfigured) {
      try {
        const { data, error } = await supabase.auth.signUp({
          email,
          password,
        });

        if (error) {
          errorAlert.textContent = error.message;
          errorAlert.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Create Free Account';
          return;
        } else {
          localStorage.setItem('aio_user', JSON.stringify({
            id: data.session?.user.id || ('usr-' + Date.now().toString(36)),
            email,
            name: email.split('@')[0],
            role: 'member',
            created_at: new Date().toISOString()
          }));
          window.location.href = redirectTarget;
          return;
        }
      } catch (e) {}
    }

    // Local fallback
    const localUser = {
      id: 'usr-' + Date.now().toString(36),
      email,
      name: email.split('@')[0],
      role: 'member',
      authProvider: 'email',
      created_at: new Date().toISOString()
    };
    localStorage.setItem('aio_user', JSON.stringify(localUser));
    window.location.href = redirectTarget;
  });
</script>
