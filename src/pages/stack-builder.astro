---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="AI Stack Builder & Cost Calculator | AIO AI"
  description="Assemble the optimal AI stack for your role. Compare cloud subscription costs against 100% free open-source alternatives with real-time ROI calculations."
>
  <Header currentPath="/stack-builder" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-surface px-6 py-12 md:py-16 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-blue-200 bg-blue-50 text-xs font-semibold text-primary mb-4 font-mono">
          <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
          </svg>
          <span>INTERACTIVE COST & ARCHITECTURE COMBINATOR</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-ink tracking-tight mb-4">
          AI Stack Builder
        </h1>
        <p class="text-neutral-600 text-sm md:text-base max-w-xl mx-auto leading-relaxed">
          Select your role and customize your tool combination. Calculate your real monthly expenses vs open-source alternatives.
        </p>
      </div>
    </section>

    <!-- Interactive Builder Form & Calculator -->
    <div class="w-full max-w-6xl mx-auto px-6 py-12 flex-1">
      <!-- Role Selector Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-10">
        <button class="role-tab px-5 py-2.5 rounded-xl border border-ink bg-ink text-white text-xs font-bold transition-colors cursor-pointer shadow-xs" data-role="creator">
          Content Creator / YouTuber
        </button>
        <button class="role-tab px-5 py-2.5 rounded-xl border border-[#E2E8F0] bg-white text-neutral-600 hover:text-ink text-xs font-semibold transition-colors cursor-pointer shadow-xs" data-role="engineer">
          Software Engineer / Dev
        </button>
        <button class="role-tab px-5 py-2.5 rounded-xl border border-[#E2E8F0] bg-white text-neutral-600 hover:text-ink text-xs font-semibold transition-colors cursor-pointer shadow-xs" data-role="marketer">
          Growth & Marketing Lead
        </button>
        <button class="role-tab px-5 py-2.5 rounded-xl border border-[#E2E8F0] bg-white text-neutral-600 hover:text-ink text-xs font-semibold transition-colors cursor-pointer shadow-xs" data-role="india">
          India-First Enterprise
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left: Tool Stack Configuration -->
        <div class="lg:col-span-2 flex flex-col gap-6">
          <div class="bg-white border border-[#E2E8F0] rounded-2xl p-6 md:p-8 shadow-xs">
            <h2 class="text-lg font-black text-ink tracking-tight mb-4 border-b border-[#E2E8F0] pb-3">
              Configured Tool Stack
            </h2>

            <div class="space-y-4" id="toolsListContainer">
              <!-- Dynamically populated by JS -->
            </div>
          </div>

          <!-- Architecture & Data Flow -->
          <div class="bg-white border border-[#E2E8F0] rounded-2xl p-6 md:p-8 shadow-xs">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-400 mb-3">
              Data Flow Pipeline
            </h3>
            <div id="stackConnectionDesc" class="text-xs text-neutral-800 leading-relaxed p-4 rounded-xl bg-surface border border-[#E2E8F0] font-mono">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>

        <!-- Right: Cost & Savings Dashboard -->
        <div class="flex flex-col gap-6">
          <!-- Cost Breakdown Card -->
          <div class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-400 mb-4 border-b border-[#E2E8F0] pb-2">
              Monthly Cost Assessment
            </h3>

            <div class="space-y-4 mb-6">
              <div class="flex justify-between items-center text-sm">
                <span class="text-neutral-600">Commercial Cloud Stack:</span>
                <span id="commercialCostText" class="font-mono font-black text-ink text-xl">$44 / mo</span>
              </div>
              <div class="flex justify-between items-center text-sm">
                <span class="text-neutral-600">Open-Source Local Stack:</span>
                <span class="font-mono font-black text-emerald-600 text-xl">$0 / mo</span>
              </div>
              <div class="pt-3 border-t border-[#E2E8F0] flex justify-between items-center text-sm">
                <span class="text-neutral-700 font-semibold">Annual Savings Potential:</span>
                <span id="annualSavingsText" class="font-mono font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg">
                  $528 / yr
                </span>
              </div>
            </div>

            <div class="space-y-2">
              <button 
                id="shareStackBtn"
                class="w-full bg-[#09090B] text-white font-bold text-xs rounded-xl py-3 hover:bg-neutral-800 transition-colors cursor-pointer text-center shadow-xs flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" />
                </svg>
                <span id="shareBtnText">Save & Share Public Stack</span>
              </button>

              <button 
                id="exportStackBtn"
                class="w-full bg-white border border-[#E2E8F0] text-ink font-bold text-xs rounded-xl py-2.5 hover:bg-slate-50 transition-colors cursor-pointer text-center shadow-xs flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                </svg>
                <span>Export Stack Configuration (JSON)</span>
              </button>
            </div>

            <div id="shareSuccessNotice" class="hidden mt-3 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-mono break-all"></div>
          </div>

          <!-- Privacy & Data Sovereignty Note -->
          <div class="p-5 rounded-2xl border border-blue-200 bg-blue-50 text-xs text-blue-900 leading-relaxed shadow-xs">
            <strong class="font-bold block mb-1">Local Deployment Advantage:</strong>
            Switching to open-source components guarantees 100% data residency, zero token rate limits, and full IP security.
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const STACKS: Record<string, { title: string; tools: Array<{ name: string; cost: number; role: string; openAlt: string }>; flow: string }> = {
    creator: {
      title: 'Content Creator Production Stack',
      tools: [
        { name: 'ChatGPT Plus', cost: 20, role: 'Scripts & Hooks', openAlt: 'Llama 3.1 8B (Free)' },
        { name: 'ElevenLabs Starter', cost: 5, role: 'Voice Synthesis', openAlt: 'Kokoro TTS (Free)' },
        { name: 'Midjourney Standard', cost: 10, role: 'Cover Art & Thumbnails', openAlt: 'ComfyUI + Flux (Free)' },
        { name: 'Make Core', cost: 9, role: 'Auto-Publishing Webhook', openAlt: 'n8n Self-Hosted (Free)' }
      ],
      flow: 'ChatGPT drafts script -> ElevenLabs synthesizes voiceover -> Midjourney renders visuals -> Make stitches and queues the video.'
    },
    engineer: {
      title: 'Software Engineer DevOps Stack',
      tools: [
        { name: 'Claude 3.5 Sonnet Pro', cost: 20, role: 'Architecture & Refactoring', openAlt: 'DeepSeek R1 / Qwen 2.5 Coder (Free)' },
        { name: 'GitHub Copilot', cost: 10, role: 'Inline IDE Autocomplete', openAlt: 'Aider or Continue.dev (Free)' },
        { name: 'n8n Fair-Code', cost: 0, role: 'CI/CD Webhook & PR Review', openAlt: 'n8n Self-Hosted (Free)' }
      ],
      flow: 'Copilot suggests code inside IDE -> PR opened on GitHub -> n8n triggers Claude to audit security & edge cases.'
    },
    marketer: {
      title: 'Growth & Performance Marketing Stack',
      tools: [
        { name: 'Claude Pro', cost: 20, role: 'Long-Form Copy & SEO', openAlt: 'Llama 3.3 70B (Free)' },
        { name: 'Make Pro', cost: 16, role: 'Lead Enrichment & CRM sync', openAlt: 'n8n Self-Hosted (Free)' },
        { name: 'Notion AI', cost: 10, role: 'Campaign Knowledge Base', openAlt: 'AnythingLLM Local (Free)' }
      ],
      flow: 'Form submission received -> Make enriches domain via Clearbit -> Claude drafts customized email -> Notion AI logs contact.'
    },
    india: {
      title: 'India-First Enterprise Sovereign Stack',
      tools: [
        { name: 'Sarvam AI', cost: 0, role: 'Indic Vernacular Speech & Transcribe', openAlt: 'Sarvam Saaras (Indic Weights)' },
        { name: 'Krutrim AI', cost: 0, role: '22 Indian Language Reasoning', openAlt: 'Krutrim Sovereign Cloud' },
        { name: 'n8n Self-Hosted', cost: 0, role: 'Customer WhatsApp & Telephony Webhook', openAlt: 'n8n Docker (Free)' }
      ],
      flow: 'Customer audio captured -> Sarvam transcribes Indic vernacular -> Krutrim resolves regional query -> Sarvam synthesizes native audio response.'
    }
  };

  document.addEventListener('DOMContentLoaded', async () => {
    const roleTabs = document.querySelectorAll('.role-tab');
    const container = document.getElementById('toolsListContainer');
    const flowDesc = document.getElementById('stackConnectionDesc');
    const commercialCostText = document.getElementById('commercialCostText');
    const annualSavingsText = document.getElementById('annualSavingsText');
    const exportBtn = document.getElementById('exportStackBtn');
    const shareBtn = document.getElementById('shareStackBtn');
    const shareText = document.getElementById('shareBtnText');
    const shareNotice = document.getElementById('shareSuccessNotice');

    let currentRole = 'creator';

    function renderStack(roleKey: string) {
      const stack = STACKS[roleKey];
      if (!stack || !container || !flowDesc || !commercialCostText || !annualSavingsText) return;

      let totalMonthly = 0;

      container.innerHTML = stack.tools.map(tool => {
        totalMonthly += tool.cost;
        return `
          <div class="p-4 rounded-xl border border-[#E2E8F0] bg-surface flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold text-ink text-sm">${tool.name}</span>
                <span class="text-xs text-neutral-400 font-mono">(${tool.role})</span>
              </div>
              <div class="text-xs text-emerald-700 flex items-center gap-1 font-mono">
                <span>Free Alt:</span> <strong class="text-emerald-800">${tool.openAlt}</strong>
              </div>
            </div>
            <div class="text-right shrink-0">
              <span class="font-mono font-black text-ink text-base">$${tool.cost}/mo</span>
            </div>
          </div>
        `;
      }).join('');

      flowDesc.textContent = stack.flow;
      commercialCostText.textContent = `$${totalMonthly} / mo`;
      annualSavingsText.textContent = `$${totalMonthly * 12} / yr`;
    }

    roleTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        roleTabs.forEach(t => {
          t.classList.remove('border-ink', 'bg-ink', 'text-white', 'font-bold');
          t.classList.add('border-[#E2E8F0]', 'bg-white', 'text-neutral-600', 'font-semibold');
        });
        tab.classList.remove('border-[#E2E8F0]', 'bg-white', 'text-neutral-600', 'font-semibold');
        tab.classList.add('border-ink', 'bg-ink', 'text-white', 'font-bold');

        currentRole = tab.getAttribute('data-role') || 'creator';
        renderStack(currentRole);
      });
    });

    // Save & Share Public Stack via Supabase stacks table
    shareBtn?.addEventListener('click', async () => {
      let authorName = 'Anonymous Practitioner';
      let userDbId: number | null = null;

      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.user) {
          authorName = session.user.user_metadata?.full_name || session.user.email?.split('@')[0] || authorName;
          const { data: u } = await supabase.from('users').select('id').eq('email', session.user.email).single();
          if (u?.id) userDbId = u.id;
        } else {
          const cachedStr = localStorage.getItem('aio_user');
          if (cachedStr) {
            const parsed = JSON.parse(cachedStr);
            authorName = parsed.name || parsed.email?.split('@')[0] || authorName;
          }
        }
      } catch(e) {}

      const activeStack = STACKS[currentRole];
      const stackSlug = `stack-${currentRole}-${Date.now()}`;
      const totalCost = commercialCostText?.textContent || '$44 / mo';

      if (shareBtn && shareText) {
        shareBtn.setAttribute('disabled', 'true');
        shareText.textContent = 'Saving to Database...';
      }

      try {
        const { data, error } = await supabase.from('stacks').insert({
          slug: stackSlug,
          title: activeStack.title,
          description: activeStack.flow,
          author_name: authorName,
          user_id: userDbId,
          tools: activeStack.tools.map(t => t.name),
          estimated_monthly_cost: totalCost,
          is_public: true
        }).select().single();

        const shareUrl = `${window.location.origin}/stack-builder?stackId=${data?.slug || stackSlug}`;
        navigator.clipboard?.writeText(shareUrl);

        if (shareNotice) {
          shareNotice.innerHTML = `<strong>Stack Saved!</strong> Share URL copied to clipboard:<br><a href="${shareUrl}" class="underline text-emerald-900 font-bold">${shareUrl}</a>`;
          shareNotice.classList.remove('hidden');
        }
      } catch (err: any) {
        console.warn('Fallback stack share notice:', err);
        const fallbackUrl = `${window.location.origin}/stack-builder?role=${currentRole}`;
        navigator.clipboard?.writeText(fallbackUrl);
        if (shareNotice) {
          shareNotice.innerHTML = `<strong>Link copied!</strong> Share URL: <a href="${fallbackUrl}" class="underline">${fallbackUrl}</a>`;
          shareNotice.classList.remove('hidden');
        }
      } finally {
        if (shareBtn && shareText) {
          shareBtn.removeAttribute('disabled');
          shareText.textContent = 'Save & Share Public Stack';
        }
      }
    });

    // Export Stack JSON
    exportBtn?.addEventListener('click', () => {
      const data = STACKS[currentRole];
      navigator.clipboard?.writeText(JSON.stringify(data, null, 2));
      alert('Selected stack configuration JSON copied to clipboard!');
    });

    // Check URL for ?stackId=... or ?role=...
    const urlParams = new URLSearchParams(window.location.search);
    const sharedStackId = urlParams.get('stackId');
    const paramRole = urlParams.get('role');

    if (sharedStackId) {
      try {
        const { data: dbStack } = await supabase
          .from('stacks')
          .select('*')
          .or(`slug.eq.${sharedStackId}`)
          .single();

        if (dbStack && shareNotice) {
          shareNotice.innerHTML = `Viewing Shared Stack: <strong>${dbStack.title}</strong> by <em>${dbStack.author_name}</em> (${dbStack.estimated_monthly_cost || ''})`;
          shareNotice.classList.remove('hidden');
        }
      } catch (e) {}
    } else if (paramRole && STACKS[paramRole]) {
      currentRole = paramRole;
      roleTabs.forEach(t => {
        if (t.getAttribute('data-role') === paramRole) {
          t.classList.add('border-ink', 'bg-ink', 'text-white', 'font-bold');
          t.classList.remove('border-[#E2E8F0]', 'bg-white', 'text-neutral-600', 'font-semibold');
        } else {
          t.classList.remove('border-ink', 'bg-ink', 'text-white', 'font-bold');
          t.classList.add('border-[#E2E8F0]', 'bg-white', 'text-neutral-600', 'font-semibold');
        }
      });
    }

    renderStack(currentRole);
  });
</script>
