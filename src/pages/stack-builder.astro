---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 6 Curated Role Stacks (Futurepedia Pattern)
const CURATED_ROLE_STACKS = [
  {
    id: 'zero-cost-local',
    name: 'Zero-Cost Local AI Dev Stack',
    costUsd: 0,
    costInr: 0,
    badge: '100% Free / Self-Hosted',
    badgeColor: 'emerald',
    description: 'Frontier code generation, local model inference, and vector retrieval with 0 cloud API fees.',
    layers: {
      l1: { slug: 'deepseek-v3', name: 'DeepSeek-V3', logo: 'https://www.google.com/s2/favicons?domain=deepseek.com&sz=128' },
      l2: { slug: 'n8n-selfhosted', name: 'n8n Self-Hosted', logo: 'https://www.google.com/s2/favicons?domain=n8n.io&sz=128' },
      l3: { slug: 'chroma', name: 'Chroma DB', logo: 'https://www.google.com/s2/favicons?domain=trychroma.com&sz=128' },
      l4: { slug: 'aider', name: 'Aider CLI', logo: 'https://www.google.com/s2/favicons?domain=aider.chat&sz=128' },
      l5: { slug: 'ollama', name: 'Ollama Local', logo: 'https://www.google.com/s2/favicons?domain=ollama.com&sz=128' }
