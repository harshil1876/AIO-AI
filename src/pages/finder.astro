---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Finder | AI Discovery Platform">
	<main class="w-full flex flex-col min-h-screen">
		<nav class="bg-canvas border-b border-hairline px-6 py-3 flex items-center justify-between sticky top-0 z-50">
			<div class="flex items-center gap-6">
				<a href="/" class="text-ink font-semibold tracking-tight text-lg">AI Discovery</a>
				<div class="hidden md:flex items-center gap-2">
					<a href="/tools" class="text-body text-sm hover:text-ink px-2 py-1 transition-colors rounded-full hover:bg-hairline-soft">Discover</a>
					<a href="/workflows" class="text-body text-sm hover:text-ink px-2 py-1 transition-colors rounded-full hover:bg-hairline-soft">Workflows</a>
				</div>
			</div>
		</nav>

		<div class="flex-1 flex flex-col items-center justify-center w-full px-6 py-12 max-w-4xl mx-auto text-center">
			<h1 class="text-4xl md:text-5xl font-semibold text-ink tracking-tight mb-4" style="letter-spacing: -1.28px;">
				AI Finder
			</h1>
			<p class="text-body text-lg mb-8 max-w-xl">
				Describe what you want to do in natural language, and we'll recommend the best tools and workflows.
			</p>
			
			<div class="w-full bg-canvas-elevated border border-hairline rounded-lg shadow-sm p-4 mb-12 text-left">
				<form class="flex flex-col gap-4" onsubmit="event.preventDefault(); document.getElementById('results').classList.remove('hidden');">
					<textarea 
						placeholder="E.g., I want to automatically create and publish three Instagram posts every day from a Google Sheet. I prefer free or freemium tools." 
						class="w-full h-32 bg-transparent text-ink placeholder-faint resize-none outline-none text-base"
					></textarea>
					<div class="flex justify-end">
						<button type="submit" class="bg-ink text-on-primary font-medium rounded-pill px-6 py-2 hover:bg-black transition-colors">
							Find Solutions
						</button>
					</div>
				</form>
			</div>

			<div id="results" class="hidden w-full text-left flex flex-col gap-8">
				<h2 class="text-2xl font-semibold text-ink tracking-tight border-b border-hairline pb-4">Recommendations</h2>
				
				<div class="bg-canvas-elevated border border-hairline rounded-md p-6 relative overflow-hidden">
					<div class="absolute top-0 left-0 w-1 h-full bg-link"></div>
					<div class="flex items-center gap-2 mb-2">
						<span class="text-xs font-semibold uppercase tracking-wider text-link">Best Match</span>
					</div>
					<h3 class="text-lg font-semibold text-ink mb-2">Example Tool + Automation</h3>
					<p class="text-sm text-body mb-4">Based on your requirement for free/freemium tools to automate Instagram posting from Google Sheets, this combination offers the best reliability under a free tier.</p>
					
					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/tools/example-tool" class="flex-1 border border-hairline rounded-sm p-4 hover:bg-hairline-soft transition-colors block">
							<div class="text-sm font-semibold text-ink mb-1">Example Tool</div>
							<div class="text-xs text-mute">Freemium • Automation</div>
						</a>
						<a href="/workflows" class="flex-1 border border-hairline rounded-sm p-4 hover:bg-hairline-soft transition-colors block">
							<div class="text-sm font-semibold text-ink mb-1">View the Workflow</div>
							<div class="text-xs text-mute">Step-by-step guide</div>
						</a>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
