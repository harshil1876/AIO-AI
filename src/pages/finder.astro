---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllTools } from '../services/dataService';
import { WORKFLOWS_DATA } from '../data/workflowsData';
import { OPEN_SOURCE_REPOS } from '../data/openSourceData';
import { CREATORS_DATA } from '../data/creatorsData';

const allTools = await getAllTools();

// 25 High-Demand Engineering & Creator Tasks Directory
const TOP_25_TASKS = [
  { rank: 1, task: 'Automated Git PR Review & Security Scan', category: 'Code Assistants', freeTool: 'Ollama + DeepSeek Coder', proTool: 'Cursor Composer', query: 'Automated git pull request review and security scan' },
  { rank: 2, task: 'Faceless YouTube Shorts & Reels Automation', category: 'Video Generation', freeTool: 'ComfyUI + FFMPEG', proTool: 'InVideo AI', query: 'Faceless YouTube shorts and reels automation from trending topics' },
  { rank: 3, task: 'Indic Speech Voiceover & Multilingual TTS', category: 'Regional AI', freeTool: 'Bhashini Public API', proTool: 'Sarvam AI', query: 'Indian language text to speech and voiceover in Hindi Tamil Telugu' },
  { rank: 4, task: 'WhatsApp Autonomous Customer Support Bot', category: 'Autonomous Agents', freeTool: 'n8n + DeepSeek-R1', proTool: 'Yellow.ai / Haptik', query: 'Automated WhatsApp customer support bot with memory' },
  { rank: 5, task: 'Private Offline PDF RAG Document Search', category: 'Research & Analysis', freeTool: 'ChromaDB + Ollama', proTool: 'Perplexity Pro', query: 'Private offline RAG document search over company PDFs on local hardware' },
  { rank: 6, task: 'Full-Stack Web App from UI Wireframe', category: 'Web & App Builders', freeTool: 'v0 by Vercel (Free)', proTool: 'Bolt.new / Lovable', query: 'Generate full stack react web application from wireframe prompt' },
  { rank: 7, task: 'Photorealistic Image Generation & Inpainting', category: 'Image & Art', freeTool: 'Flux.1 Schnell (Local)', proTool: 'Midjourney v6', query: 'Generate photorealistic images and asset artwork locally' },
  { rank: 8, task: 'Podcast Audio Cleanup & Auto-Transcribe', category: 'Audio & Voice', freeTool: 'Whisper Large v3', proTool: 'ElevenLabs Reader', query: 'Podcast audio cleanup and accurate speaker separated transcription' },
  { rank: 9, task: 'Automated Outbound Email & Lead Enrichment', category: 'Sales & Marketing', freeTool: 'n8n + Firecrawl', proTool: 'Clay.com + Claude', query: 'Automated lead enrichment and personalized cold email pipeline' },
  { rank: 10, task: 'Natural Language to Complex SQL Generator', category: 'Code Assistants', freeTool: 'Vanna.ai (Open Source)', proTool: 'Cursor / Claude Sonnet', query: 'Generate complex PostgreSQL queries from natural language business questions' },
  { rank: 11, task: 'Local Model Inference on 8GB-16GB VRAM', category: 'Open Source', freeTool: 'llama.cpp / Ollama', proTool: 'Together.ai / RunPod', query: 'Run DeepSeek-R1 and Llama 3 locally on 8GB to 16GB VRAM' },
  { rank: 12, task: 'Multi-Agent Competitive Intelligence Radar', category: 'Autonomous Agents', freeTool: 'LangGraph + Ollama', proTool: 'CrewAI Enterprise', query: 'Autonomous multi-agent research pipeline tracking competitors and pricing' },
  { rank: 13, task: 'Multilingual Healthcare Clinical Triage', category: 'Healthcare AI', freeTool: 'Qure.ai Sandbox', proTool: 'Qure.ai Commercial', query: 'Automated chest X-ray and medical scan analysis in clinics' },
  { rank: 14, task: 'Long-Form SEO Technical Article Drafter', category: 'Writing & Copy', freeTool: 'DeepSeek-V3 API', proTool: 'Writesonic / Claude', query: 'Draft 2000-word technical SEO engineering articles with clean formatting' },
  { rank: 15, task: 'Real-Time Hacker News & ArXiv AI Digest', category: 'Research & Analysis', freeTool: 'Hugging Face Daily', proTool: 'Perplexity Enterprise', query: 'Curate daily breaking AI research papers and hacker news discussions' },
  { rank: 16, task: 'Figma UI to Clean React Tailwind Component', category: 'Web & App Builders', freeTool: 'v0 free quota', proTool: 'Windsurf Cascade', query: 'Convert Figma designs into accessible React Tailwind components' },
  { rank: 17, task: 'Voice Clone & Dubbing for Education', category: 'Audio & Voice', freeTool: 'ChatTTS (Open Source)', proTool: 'ElevenLabs Pro', query: 'Clone educator voice and dub educational course into 5 languages' },
  { rank: 18, task: 'E-commerce Product Photo Background Studio', category: 'Image & Art', freeTool: 'ComfyUI BiRefNet', proTool: 'Photoroom Pro', query: 'Remove product background and replace with studio lighting scene' },
  { rank: 19, task: 'Slack / Discord DevOps Incident Summary Bot', category: 'Automation Workflows', freeTool: 'n8n Webhook + Ollama', proTool: 'PagerDuty + OpenAI', query: 'Summarize Datadog alert spikes and post post-mortem directly to Slack' },
  { rank: 20, task: 'Customer Support Ticket Sentiment Classifier', category: 'Research & Analysis', freeTool: 'spaCy + Mistral 7B', proTool: 'Zendesk AI', query: 'Classify incoming Zendesk tickets by urgency sentiment and feature tag' },
  { rank: 21, task: 'Indic Farmer Crop Disease Voice Advisory', category: 'AgriTech AI', freeTool: 'KissanAI Dhenu (Free)', proTool: 'Wadhwani AI Agri', query: 'Voice assistant in Hindi and Marathi diagnosing crop leaf disease from photos' },
  { rank: 22, task: 'Automated Meeting Transcript to Action Items', category: 'Business & Productivity', freeTool: 'Whisper.cpp + n8n', proTool: 'Otter.ai / Fireflies', query: 'Transcribe Zoom meeting and extract clean action items with owners' },
  { rank: 23, task: 'LLM Agent Function Calling with OpenAPI', category: 'Autonomous Agents', freeTool: 'LiteLLM Proxy', proTool: 'Anthropic Claude Tool Calling', query: 'Build reliable autonomous tool calling agent using strict OpenAPI schemas' },
  { rank: 24, task: 'Legacy Codebase Refactoring & Migration', category: 'Code Assistants', freeTool: 'DeepSeek-R1 32B', proTool: 'Cursor Composer Pro', query: 'Refactor legacy JavaScript codebase into modern TypeScript Astro architecture' },
  { rank: 25, task: 'LLM Token Spend Analytics & Budget Alerts', category: 'Token Economics', freeTool: 'AIO AI Token Suite', proTool: 'Helicone / Portkey', query: 'Calculate exact token costs across OpenAI Claude and DeepSeek with budget limit' },
];
---

<Layout 
  title="Solution Architect & Intent Decision Engine | AIO AI"
  description="Describe your engineering task, budget, or persona. Our 2-Pane Solution Architect maps your requirement into a 3-Step Connected Pipeline, $0 Open Source Stack, and complete Execution Kit."
>
  <Header currentPath="/finder" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-10">
    
    <!-- Hero Banner -->
    <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-400/30 bg-blue-500/10 text-[11px] font-mono font-bold text-blue-300">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          <span>INTENT DECISION ENGINE & SOLUTION ARCHITECT</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Solution Finder & Architect
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Select your persona and budget or describe your problem in natural language. We synthesize a verified 3-tier connected pipeline: <strong class="text-emerald-300">$0 Open Source</strong>, <strong class="text-blue-300">Freemium Cloud</strong>, and <strong class="text-purple-300">Enterprise Blueprint</strong>.
        </p>
      </div>
    </section>

    <!-- TOP INTENT SELECTOR: PERSONA + BUDGET + 8 TEMPLATES -->
    <section class="card-aurora p-6 sm:p-8 space-y-6">
      
      <!-- Persona Filter Chips -->
      <div>
        <label class="block text-xs font-mono uppercase font-bold text-slate-500 mb-2.5">
          1. Select Your Builder Persona:
        </label>
        <div class="flex flex-wrap gap-2" id="personaChipGroup">
          <button type="button" class="persona-chip px-3.5 py-1.5 rounded-xl border border-blue-600 bg-blue-50 text-blue-700 font-bold text-xs cursor-pointer shadow-xs" data-persona="engineer">
            👨‍💻 Full-Stack Engineer
          </button>
          <button type="button" class="persona-chip px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-medium text-xs cursor-pointer" data-persona="creator">
            🎬 Content Creator / Media
          </button>
          <button type="button" class="persona-chip px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-medium text-xs cursor-pointer" data-persona="hacker">
            ⚡ Solo Indie Hacker
          </button>
          <button type="button" class="persona-chip px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-medium text-xs cursor-pointer" data-persona="lead">
            🏢 Enterprise Tech Lead
          </button>
          <button type="button" class="persona-chip px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-medium text-xs cursor-pointer" data-persona="researcher">
            🔬 AI Researcher / Indic
          </button>
        </div>
      </div>

      <!-- Budget Selector Chips -->
      <div>
        <label class="block text-xs font-mono uppercase font-bold text-slate-500 mb-2.5">
          2. Target Monthly Budget:
        </label>
        <div class="flex flex-wrap gap-2" id="budgetChipGroup">
          <button type="button" class="budget-chip px-3.5 py-1.5 rounded-xl border border-emerald-600 bg-emerald-50 text-emerald-800 font-bold text-xs cursor-pointer shadow-xs" data-budget="free">
            🟢 $0 (100% Free / Self-Hosted)
          </button>
          <button type="button" class="budget-chip px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-medium text-xs cursor-pointer" data-budget="freemium">
            🔵 &lt; $20 / mo (Freemium Sandbox)
          </button>
          <button type="button" class="budget-chip px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-medium text-xs cursor-pointer" data-budget="pro">
            🟣 $50 – $100 / mo (Pro Stack)
          </button>
          <button type="button" class="budget-chip px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-medium text-xs cursor-pointer" data-budget="enterprise">
            🟡 Enterprise Scale (Custom SLAs)
          </button>
        </div>
      </div>

      <!-- Prompt Bar & 8 1-Click Templates -->
      <div class="space-y-3">
        <label for="architectPrompt" class="block text-xs font-mono uppercase font-bold text-slate-700">
          3. Natural Language Requirement or Goal:
        </label>
        <div class="relative">
          <textarea 
            id="architectPrompt" 
            rows="2"
            placeholder="e.g. Free AI for YouTube Shorts voiceover and video generation in Hindi on 12GB VRAM, or automated PR reviews on GitHub..."
            class="w-full bg-white border border-slate-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 rounded-2xl p-4 text-xs sm:text-sm text-slate-900 placeholder-slate-400 outline-none transition-all resize-none shadow-xs font-medium"
          >Automated git pull request review and security scan</textarea>
          <button 
            type="button" 
            id="runArchitectBtn"
            class="absolute right-3 bottom-3 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs cursor-pointer shadow-sm transition-all flex items-center gap-1.5"
          >
            <span>Architect Pipeline</span>
            <span>&rarr;</span>
          </button>
        </div>

        <!-- 8 Quick 1-Click Templates -->
        <div class="pt-2">
          <span class="text-[11px] font-mono text-slate-400 uppercase font-semibold block mb-2">Or choose an instant blueprint template:</span>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              Automated Git PR Review & Security Scan
            </button>
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              Faceless YouTube Shorts & Reels Automation
            </button>
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              Indic Speech Voiceover & Multilingual TTS
            </button>
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              WhatsApp Autonomous Customer Support Bot
            </button>
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              Private Offline PDF RAG Document Search
            </button>
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              Full-Stack Web App from UI Wireframe
            </button>
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              Photorealistic Image Generation & Inpainting
            </button>
            <button type="button" class="prompt-preset-btn text-xs bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 px-3 py-1.5 rounded-xl border border-slate-200 hover:border-blue-300 transition-all cursor-pointer font-medium">
              E-Commerce Product Background Studio
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- MAIN 2-PANE WORKSPACE: INTERACTIVE SOLUTION ARCHITECT -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT PANE (7 COLS): 3 TIERS & 3-STEP CONNECTED PIPELINE FLOW -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Tier Selection Switcher Tabs -->
        <div class="flex items-center gap-2 p-1.5 bg-slate-100 rounded-2xl border border-slate-200 text-xs font-mono font-bold">
          <button type="button" class="tier-tab-btn flex-1 py-2 px-3 rounded-xl bg-white text-emerald-800 shadow-xs border border-emerald-300 cursor-pointer" data-tier="A">
            Option A: $0 Open Source
          </button>
          <button type="button" class="tier-tab-btn flex-1 py-2 px-3 rounded-xl text-slate-600 hover:text-slate-900 cursor-pointer" data-tier="B">
            Option B: Freemium Cloud
          </button>
          <button type="button" class="tier-tab-btn flex-1 py-2 px-3 rounded-xl text-slate-600 hover:text-slate-900 cursor-pointer" data-tier="C">
            Option C: Enterprise Flow
          </button>
        </div>

        <!-- Tier Card Detail -->
        <div class="card-aurora p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div>
              <span id="tierPill" class="text-[10px] font-mono font-bold uppercase px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                100% Free / Self-Hosted Stack
              </span>
              <h2 id="tierTitle" class="text-2xl font-black text-slate-900 mt-2">Ollama + DeepSeek Coder</h2>
            </div>
            <div class="text-right">
              <span id="tierCost" class="text-2xl font-black font-mono text-emerald-700">$0 / ₹0</span>
              <span class="block text-[10px] font-mono text-slate-400">per month</span>
            </div>
          </div>

          <p id="tierDescription" class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Run open weights completely on your local workstation or private server with zero cloud API fees and complete code privacy.
          </p>

          <!-- 3-STEP CONNECTED PIPELINE VISUAL FLOW -->
          <div class="space-y-3 pt-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 block">
              Visual 3-Step Execution Pipeline:
            </span>

            <div class="space-y-4 relative">
              <!-- Step 1: Input Trigger -->
              <div class="bg-white border-2 border-blue-200 rounded-2xl p-4 flex items-start gap-3.5 shadow-xs relative">
                <span class="w-6 h-6 rounded-full bg-blue-600 text-white font-mono font-bold text-xs flex items-center justify-center shrink-0">1</span>
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 text-xs">Trigger & Ingestion Node</span>
                    <span id="step1Tool" class="text-[10px] font-mono font-bold bg-blue-50 text-blue-700 px-2 py-0.5 rounded-md">GitHub Webhook / Git CLI</span>
                  </div>
                  <p id="step1Desc" class="text-xs text-slate-500 mt-1">Intercepts commits and pull requests, extracting file diffs and commit messages.</p>
                </div>
              </div>

              <!-- Connecting Line Down -->
              <div class="w-0.5 h-4 bg-blue-300 mx-auto"></div>

              <!-- Step 2: Reasoning Engine -->
              <div class="bg-white border-2 border-purple-200 rounded-2xl p-4 flex items-start gap-3.5 shadow-xs relative">
                <span class="w-6 h-6 rounded-full bg-purple-600 text-white font-mono font-bold text-xs flex items-center justify-center shrink-0">2</span>
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 text-xs">Inference & Reasoning Core</span>
                    <span id="step2Tool" class="text-[10px] font-mono font-bold bg-purple-50 text-purple-700 px-2 py-0.5 rounded-md">DeepSeek-Coder-V2 16B</span>
                  </div>
                  <p id="step2Desc" class="text-xs text-slate-500 mt-1">Performs static security analysis, code style audits, and detects potential regressions.</p>
                </div>
              </div>

              <!-- Connecting Line Down -->
              <div class="w-0.5 h-4 bg-purple-300 mx-auto"></div>

              <!-- Step 3: Synthesis & Action -->
              <div class="bg-white border-2 border-emerald-200 rounded-2xl p-4 flex items-start gap-3.5 shadow-xs relative">
                <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-mono font-bold text-xs flex items-center justify-center shrink-0">3</span>
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-900 text-xs">Synthesis & Action Delivery</span>
                    <span id="step3Tool" class="text-[10px] font-mono font-bold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-md">n8n / Octokit PR Comment</span>
                  </div>
                  <p id="step3Desc" class="text-xs text-slate-500 mt-1">Posts inline code comments, approvals, or Slack alerts directly to the development channel.</p>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- RIGHT PANE (5 COLS): EXECUTION KIT & TELEMETRY -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="card-aurora p-6 sm:p-7 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <h3 class="text-base font-black text-slate-900 tracking-tight">Execution Kit & Specifications</h3>
            <span class="text-[10px] font-mono font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md">Ready to Deploy</span>
          </div>

          <!-- Specs List -->
          <div class="space-y-3 text-xs">
            <div class="flex justify-between items-center p-2.5 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-500">Hardware / VRAM:</span>
              <span id="kitHardware" class="font-mono font-bold text-slate-900">8GB – 16GB VRAM</span>
            </div>
            <div class="flex justify-between items-center p-2.5 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-500">Data Sovereignty:</span>
              <span id="kitSovereignty" class="font-mono font-bold text-emerald-700">100% Local / Zero Leakage</span>
            </div>
            <div class="flex justify-between items-center p-2.5 rounded-xl bg-white border border-slate-200">
              <span class="text-slate-500">Setup Complexity:</span>
              <span id="kitSetupTime" class="font-mono font-bold text-slate-900">~10 Mins (Docker / CLI)</span>
            </div>
          </div>

          <!-- Quick Terminal Command -->
          <div class="space-y-1.5">
            <span class="text-[10px] font-mono font-bold text-slate-400 uppercase">One-Click Terminal Command:</span>
            <div class="p-3 rounded-xl bg-slate-900 text-slate-100 font-mono text-xs overflow-x-auto flex items-center justify-between group">
              <code id="kitCliCommand">ollama run deepseek-coder-v2:16b</code>
              <button type="button" id="copyCliBtn" class="text-[10px] bg-slate-800 hover:bg-slate-700 px-2 py-1 rounded text-slate-300 font-sans cursor-pointer transition-colors ml-2 shrink-0">
                Copy
              </button>
            </div>
          </div>

          <!-- Recommended System Prompt / Instructions -->
          <div class="space-y-1.5">
            <span class="text-[10px] font-mono font-bold text-slate-400 uppercase">Automated Agent Prompt:</span>
            <div class="p-3 rounded-xl bg-white border border-slate-200 text-slate-700 font-mono text-[11px] h-28 overflow-y-auto leading-relaxed" id="kitPromptText">
              You are a senior security and performance code review agent. Examine the incoming git patch for SQL injection, authentication bypasses, N+1 query patterns, and type mismatches. Provide markdown diff suggestions with exact line numbers.
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-2.5 pt-2">
            <a 
              href="/stack-builder" 
              id="loadStackArchitectBtn" 
              class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs text-center block shadow-sm transition-all cursor-pointer"
            >
              Load into Stack Architect &rarr;
            </a>
            <a 
              href="/workflows/builder" 
              id="openWorkflowStudioBtn" 
              class="w-full py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 font-bold text-xs text-center block transition-all cursor-pointer"
            >
              Customize in Workflow Studio ⚡
            </a>
          </div>
        </div>

      </div>

    </section>

    <!-- TAAFT-INSPIRED TOP 25 TASKS DIRECTORY TABLE -->
    <section class="card-aurora p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
        <div>
          <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-blue-600 mb-1">
            TAAFT-Inspired Jobs-to-be-Done Matrix
          </div>
          <h2 class="text-xl font-black text-slate-900 tracking-tight">
            Top 25 AI Engineering & Creator Tasks Directory
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Filter by engineering task to instantly view the top $0 open-source tool, pro alternative, and verified workflow blueprint.
          </p>
        </div>
        <div class="w-full sm:w-64">
          <input 
            type="text" 
            id="taskTableFilter" 
            placeholder="Filter 25 tasks..." 
            class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl px-3 py-2 text-xs text-slate-900 outline-none font-medium"
          />
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-200 font-mono text-[11px] text-slate-400 uppercase">
              <th class="py-3 pr-3 font-bold w-12">#</th>
              <th class="py-3 px-3 font-bold">Task / Job-to-be-Done</th>
              <th class="py-3 px-3 font-bold">Category</th>
              <th class="py-3 px-3 font-bold text-emerald-700">Best Free / $0 Tool</th>
              <th class="py-3 px-3 font-bold text-blue-600">Best Pro Tool</th>
              <th class="py-3 pl-3 font-bold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="tasksTableBody">
            {TOP_25_TASKS.map(item => (
              <tr class="hover:bg-blue-50/40 transition-colors task-table-row" data-search-term={`${item.task.toLowerCase()} ${item.category.toLowerCase()} ${item.freeTool.toLowerCase()} ${item.proTool.toLowerCase()}`}>
                <td class="py-3.5 pr-3 font-mono font-bold text-slate-400">{item.rank}</td>
                <td class="py-3.5 px-3 font-bold text-slate-900">
                  <span class="block">{item.task}</span>
                </td>
                <td class="py-3.5 px-3">
                  <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 font-mono text-[10px]">
                    {item.category}
                  </span>
                </td>
                <td class="py-3.5 px-3 font-mono text-emerald-700 font-semibold">
                  {item.freeTool}
                </td>
                <td class="py-3.5 px-3 font-mono text-blue-600 font-semibold">
                  {item.proTool}
                </td>
                <td class="py-3.5 pl-3 text-right">
                  <button 
                    type="button" 
                    class="launch-task-btn px-3 py-1 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white font-bold transition-all text-[11px] cursor-pointer shadow-2xs"
                    data-query={item.query}
                  >
                    Load Architect ⚡
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var promptArea = document.getElementById('architectPrompt');
    var runBtn = document.getElementById('runArchitectBtn');
    var tierButtons = document.querySelectorAll('.tier-tab-btn');
    var personaChips = document.querySelectorAll('.persona-chip');
    var budgetChips = document.querySelectorAll('.budget-chip');
    var presetButtons = document.querySelectorAll('.prompt-preset-btn');
    var launchButtons = document.querySelectorAll('.launch-task-btn');
    var tableFilter = document.getElementById('taskTableFilter');

    var currentTier = 'A';
    var currentIntent = 'Automated git pull request review and security scan';

    // Blueprint Data Matrix
    var solutions = {
      code: {
        A: {
          title: 'Ollama + DeepSeek Coder V2',
          pill: '100% Free / Self-Hosted Stack',
          cost: '$0 / ₹0',
          desc: 'Run 16B code reasoning weights completely on your local GPU with zero API subscription cost and 100% data sovereignty.',
          step1Tool: 'GitHub Webhook / Git CLI',
          step1Desc: 'Intercepts pull requests and extracts source code diffs.',
          step2Tool: 'DeepSeek-Coder-V2 (Local 16B)',
          step2Desc: 'Performs syntax validation, logic bug hunting, and security auditing.',
          step3Tool: 'Octokit / n8n Local',
          step3Desc: 'Posts markdown code review summaries directly into GitHub PR comments.',
          hardware: '8GB – 16GB VRAM / Apple Silicon',
          sovereignty: '100% Local / Zero Cloud Leakage',
          setup: '~10 Mins (Docker / CLI)',
          cli: 'ollama run deepseek-coder-v2:16b',
          prompt: 'You are a senior security code review agent. Audit the incoming git patch for vulnerabilities, memory leaks, and performance regressions. Format output as GitHub markdown diffs.',
          stackUrl: '/stack-builder?preset=local-code-review'
        },
        B: {
          title: 'Cursor Composer Pro',
          pill: 'Best-Value Freemium Cloud',
          cost: '$20 / ₹1,650',
          desc: 'Cloud-accelerated multi-file context reasoning with Claude 3.5 Sonnet and 500 fast requests per month.',
          step1Tool: 'Cursor IDE Workspace',
          step1Desc: 'Embeds full repository context and file symbols.',
          step2Tool: 'Claude 3.5 Sonnet Engine',
          step2Desc: 'Generates refactor proposals and tests across multi-file boundaries.',
          step3Tool: 'Git Staging Diff',
          step3Desc: 'Interactive 1-click diff application directly in editor.',
          hardware: 'Any PC / Cloud Accelerated',
          sovereignty: 'Encrypted Cloud Ingestion',
          setup: '~2 Mins (Desktop App)',
          cli: 'cursor --install-extension aio.ai-toolkit',
          prompt: 'Review current git diff against project architecture conventions. Propose clean refactors and unit tests.',
          stackUrl: '/stack-builder?preset=cursor-pro'
        },
        C: {
          title: 'Enterprise Multi-Agent Code QA',
          pill: 'Enterprise Automated Pipeline',
          cost: '$150 / ₹12,500',
          desc: 'End-to-end automated PR review bot with SonarQube integration, OWASP Top 10 auditing, and automated rollback triggers.',
          step1Tool: 'GitHub Actions CI Runner',
          step1Desc: 'Triggers on PR open, checkout branch, run test suites.',
          step2Tool: 'Anthropic Claude Sonnet API',
          step2Desc: 'Executes architectural compliance and vulnerability heuristics.',
          step3Tool: 'Slack DevOps Alerts + Supabase Log',
          step3Desc: 'Stores compliance metrics and alerts engineering team on failures.',
          hardware: 'Cloud Scaled Runner',
          sovereignty: 'SOC2 / HIPAA Compliant Gateway',
          setup: '~30 Mins (CI/CD Pipeline)',
          cli: 'docker run -e ANTHROPIC_API_KEY=$KEY aio/pr-agent:latest',
          prompt: 'Execute full enterprise audit: Security, Performance, Documentation, Test Coverage. Block PR if risk score > 4.',
          stackUrl: '/stack-builder?preset=enterprise-qa'
        }
      },
      video: {
        A: {
          title: 'ComfyUI + Flux.1 Schnell + FFMPEG',
          pill: '100% Free / Self-Hosted Stack',
          cost: '$0 / ₹0',
          desc: 'Generate photorealistic scenes locally and assemble vertical video reels with zero recurring cloud subscription fees.',
          step1Tool: 'Ollama Llama-3 (Scripting)',
          step1Desc: 'Generates 60-second viral storytelling script with timing cues.',
          step2Tool: 'ComfyUI + Flux.1 Schnell',
          step2Desc: 'Renders 9:16 high-resolution image frames in 4 steps.',
          step3Tool: 'FFMPEG + Piper TTS',
          step3Desc: 'Stitches voiceover, background music, and video frames into MP4.',
          hardware: '12GB VRAM (NVIDIA RTX or Mac M-Series)',
          sovereignty: '100% Local GPU Inference',
          setup: '~15 Mins (Docker / Python)',
          cli: 'git clone https://github.com/comfyanonymous/ComfyUI',
          prompt: 'Write a high-retention 60s script about historical mysteries. Include frame visual descriptions for image generator.',
          stackUrl: '/stack-builder?preset=comfyui-video'
        },
        B: {
          title: 'InVideo AI Pro Studio',
          pill: 'Best-Value Freemium Cloud',
          cost: '$25 / ₹2,050',
          desc: 'Cloud automated text-to-video studio with automated voice clones, stock footage matching, and auto-subtitles.',
          step1Tool: 'InVideo AI Web Studio',
          step1Desc: 'User inputs prompt or article URL for video conversion.',
          step2Tool: 'iStock + ElevenLabs Engine',
          step2Desc: 'Assembles stock B-roll, captions, and emotional AI voiceover.',
          step3Tool: 'YouTube Shorts Exporter',
          step3Desc: 'Direct multi-channel export in 1080p vertical video format.',
          hardware: 'Browser Only (0GB VRAM)',
          sovereignty: 'Cloud Hosted Media',
          setup: 'Instant (No Install)',
          cli: 'curl -X POST https://api.invideo.io/v1/generate ...',
          prompt: 'Create a dynamic 45-second educational short about space exploration with upbeat pacing and subtitles.',
          stackUrl: '/stack-builder?preset=invideo-studio'
        },
        C: {
          title: 'Headless Creator Media Pipeline',
          pill: 'Enterprise Automated Pipeline',
          cost: '$120 / ₹9,900',
          desc: 'Autonomous daily trend scraper, video synthesis engine, and automatic scheduled publishing to YouTube & Instagram.',
          step1Tool: 'n8n RSS & Trends Scraper',
          step1Desc: 'Monitors Reddit and Google Trends for viral breakout topics.',
          step2Tool: 'HeyGen / Runway API',
          step2Desc: 'Generates avatar presenter and cinematic B-roll sequences.',
          step3Tool: 'YouTube Data API v3',
          step3Desc: 'Uploads video, generates SEO tags, and posts community poll.',
          hardware: 'Managed Cloud API',
          sovereignty: 'Creator API Keys Managed',
          setup: '~45 Mins (Workflow Studio)',
          cli: 'npx @aio/media-pipeline --publish daily',
          prompt: 'Synthesize morning tech digest into 60s vertical format with high-contrast subtitles and hook statement.',
          stackUrl: '/stack-builder?preset=creator-pipeline'
        }
      }
    };

    function updateArchitectView() {
      var q = currentIntent.toLowerCase();
      var solKey = (q.includes('video') || q.includes('short') || q.includes('reel') || q.includes('media')) ? 'video' : 'code';
      var data = solutions[solKey][currentTier] || solutions.code[currentTier];

      // Update Header
      document.getElementById('tierPill').textContent = data.pill;
      document.getElementById('tierTitle').textContent = data.title;
      document.getElementById('tierCost').textContent = data.cost;
      document.getElementById('tierDescription').textContent = data.desc;

      // Update 3 Steps
      document.getElementById('step1Tool').textContent = data.step1Tool;
      document.getElementById('step1Desc').textContent = data.step1Desc;
      document.getElementById('step2Tool').textContent = data.step2Tool;
      document.getElementById('step2Desc').textContent = data.step2Desc;
      document.getElementById('step3Tool').textContent = data.step3Tool;
      document.getElementById('step3Desc').textContent = data.step3Desc;

      // Update Right Kit
      document.getElementById('kitHardware').textContent = data.hardware;
      document.getElementById('kitSovereignty').textContent = data.sovereignty;
      document.getElementById('kitSetupTime').textContent = data.setup;
      document.getElementById('kitCliCommand').textContent = data.cli;
      document.getElementById('kitPromptText').textContent = data.prompt;
      document.getElementById('loadStackArchitectBtn').setAttribute('href', data.stackUrl);
    }

    // Tier Switching Tabs
    tierButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        tierButtons.forEach(function(b) {
          b.className = 'tier-tab-btn flex-1 py-2 px-3 rounded-xl text-slate-600 hover:text-slate-900 cursor-pointer';
        });
        btn.className = 'tier-tab-btn flex-1 py-2 px-3 rounded-xl bg-white text-blue-700 shadow-xs border border-blue-300 cursor-pointer font-bold';
        currentTier = btn.getAttribute('data-tier') || 'A';
        updateArchitectView();
      });
    });

    // Preset Buttons
    presetButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var text = btn.textContent.trim();
        if (promptArea) promptArea.value = text;
        currentIntent = text;
        updateArchitectView();
      });
    });

    // Table Launch Buttons
    launchButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var q = btn.getAttribute('data-query') || '';
        if (promptArea) promptArea.value = q;
        currentIntent = q;
        updateArchitectView();
        window.scrollTo({ top: 300, behavior: 'smooth' });
      });
    });

    // Form Run Button
    runBtn?.addEventListener('click', function() {
      var val = promptArea?.value?.trim() || '';
      if (val) {
        currentIntent = val;
        updateArchitectView();
      }
    });

    // Copy CLI Button
    document.getElementById('copyCliBtn')?.addEventListener('click', function() {
      var cmd = document.getElementById('kitCliCommand')?.textContent || '';
      navigator.clipboard.writeText(cmd);
      var orig = this.textContent;
      this.textContent = 'Copied!';
      var self = this;
      setTimeout(function() { self.textContent = orig; }, 1800);
    });

    // Table Search Filter
    tableFilter?.addEventListener('input', function(e) {
      var q = e.target.value.toLowerCase().trim();
      document.querySelectorAll('.task-table-row').forEach(function(row) {
        var text = row.getAttribute('data-search-term') || '';
        row.style.display = text.includes(q) ? '' : 'none';
      });
    });

    updateArchitectView();
  });
</script>
