---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllTools } from '../services/dataService';
import { WORKFLOWS_DATA } from '../data/workflowsData';
import { OPEN_SOURCE_REPOS } from '../data/openSourceData';
import { CREATORS_DATA } from '../data/creatorsData';

const allTools = await getAllTools();
---

<Layout 
  title="AI Intent Finder | Connected Decision Blueprint & Tool Matcher"
  description="Describe your task or workflow goal in natural language. We analyze your requirements and return a complete Connected Decision Blueprint: Best Overall Tool, 100% Free Option, Matching Workflow, Open-Source Alternative, and Creator Tutorial."
>
  <Header currentPath="/finder" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-6 py-12 md:py-16 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#BFDBFE] bg-[#EFF6FF] text-xs font-semibold text-[#2563EB] mb-4 shadow-xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
          </svg>
          <span>Intent & Ecosystem Decision Engine</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4" style="letter-spacing: -1.4px;">
          AI Intent Finder
        </h1>
        <p class="text-slate-600 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Describe what you want to build or automate in plain English. Get a complete <strong class="text-ink font-semibold">Connected Decision Blueprint</strong> matching the best overall tool, free options, multi-step workflows, open-source repos, and tutorials.
        </p>
      </div>
    </section>

    <!-- Interactive Finder Workspace -->
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-10 flex-1">
      <form id="finderForm" class="bg-white border-2 border-[#09090B] rounded-xl p-6 md:p-8 shadow-[6px_6px_0px_0px_#09090B] mb-12">
        <label for="taskPrompt" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-700 mb-2">
          Describe Your Goal, Task, or Budget Requirements:
        </label>
        
        <textarea 
          id="taskPrompt"
          rows="3"
          placeholder="e.g. Free AI for YouTube Shorts voiceover and video generation in Indian languages, or automated customer support on WhatsApp." 
          class="w-full bg-[#F8FAFF] border-2 border-[#E2E8F0] hover:border-[#BFDBFE] focus:border-[#2563EB] rounded-lg p-3.5 text-ink placeholder-slate-400 resize-none outline-none text-sm leading-relaxed transition-colors mb-4 font-sans"
        ></textarea>

        <!-- Quick Intent Preset Chips -->
        <div class="mb-6">
          <div class="text-xs text-slate-500 mb-2.5 font-medium flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.516 0c.85.493 1.509 1.333 1.509 2.316V18" />
            </svg>
            <span>Or test one-click real practitioner prompts:</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="example-btn text-xs bg-[#F8FAFF] hover:bg-[#EFF6FF] text-slate-700 hover:text-[#2563EB] px-3 py-1.5 rounded-md border border-[#E2E8F0] hover:border-[#BFDBFE] transition-all cursor-pointer font-medium text-left">
              Free AI for YouTube Shorts & Reels
            </button>
            <button type="button" class="example-btn text-xs bg-[#F8FAFF] hover:bg-[#EFF6FF] text-slate-700 hover:text-[#2563EB] px-3 py-1.5 rounded-md border border-[#E2E8F0] hover:border-[#BFDBFE] transition-all cursor-pointer font-medium text-left">
              Automated WhatsApp customer support
            </button>
            <button type="button" class="example-btn text-xs bg-[#F8FAFF] hover:bg-[#EFF6FF] text-slate-700 hover:text-[#2563EB] px-3 py-1.5 rounded-md border border-[#E2E8F0] hover:border-[#BFDBFE] transition-all cursor-pointer font-medium text-left">
              Open-source coding assistant & git refactoring
            </button>
            <button type="button" class="example-btn text-xs bg-[#F8FAFF] hover:bg-[#EFF6FF] text-slate-700 hover:text-[#2563EB] px-3 py-1.5 rounded-md border border-[#E2E8F0] hover:border-[#BFDBFE] transition-all cursor-pointer font-medium text-left">
              Indic regional language translation & voice
            </button>
            <button type="button" class="example-btn text-xs bg-[#F8FAFF] hover:bg-[#EFF6FF] text-slate-700 hover:text-[#2563EB] px-3 py-1.5 rounded-md border border-[#E2E8F0] hover:border-[#BFDBFE] transition-all cursor-pointer font-medium text-left">
              Private offline RAG over company PDFs
            </button>
          </div>
        </div>

        <!-- Submit Bar -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-[#E2E8F0]">
          <div class="text-xs text-slate-500 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Real-time multi-dimensional scoring across 113+ tools, 16+ workflows, 20+ repos & 18+ creators</span>
          </div>
          <button 
            type="submit"
            id="matchBtn"
            class="w-full sm:w-auto bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-bold text-xs px-6 py-3 rounded-lg shadow-[3px_3px_0px_0px_#09090B] border-2 border-[#09090B] transition-all cursor-pointer inline-flex items-center justify-center gap-2"
          >
            <span>Generate Decision Blueprint</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </form>

      <!-- Connected Decision Blueprint Results Section -->
      <div id="resultsSection" class="hidden flex-col gap-8">
        
        <!-- Results Header Banner -->
        <div class="p-4 rounded-xl bg-[#F8FAFF] border-2 border-[#09090B] shadow-[4px_4px_0px_0px_#09090B] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <div class="text-[11px] font-mono uppercase text-[#2563EB] font-bold tracking-wider">Ecosystem Match Result</div>
            <h2 class="text-lg md:text-xl font-bold text-ink">Connected Decision Blueprint</h2>
            <p id="queryEcho" class="text-xs text-slate-600 mt-0.5"></p>
          </div>
          <button 
            type="button" 
            id="resetFinderBtn" 
            class="text-xs font-semibold text-slate-600 hover:text-ink px-3 py-1.5 rounded border border-[#E2E8F0] bg-white hover:bg-slate-50 transition-colors cursor-pointer shrink-0"
          >
            Clear Blueprint
          </button>
        </div>

        <!-- Layer 1: Core 3-Tier Tool Recommendation Cards -->
        <div>
          <h3 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-500 mb-3">1. Recommended Tool Tiers</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="recommendationCards">
            <!-- Dynamically populated by JS: Best Overall, Best 100% Free, Best Premium -->
          </div>
        </div>

        <!-- Layer 2: Connected Multi-Step Workflow Blueprint -->
        <div class="p-6 rounded-xl bg-white border-2 border-[#09090B] shadow-[4px_4px_0px_0px_#09090B]" id="workflowContainer">
          <div class="flex items-center justify-between mb-4 border-b border-[#E2E8F0] pb-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase font-bold px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]">
                Matching Workflow
              </span>
              <span class="text-xs text-slate-500 font-medium" id="workflowDifficulty">Intermediate &bull; 20 min setup</span>
            </div>
            <a id="workflowLink" href="/workflows" class="text-xs font-bold text-[#2563EB] hover:underline inline-flex items-center gap-1">
              <span>View Full Blueprint</span>
              <span>&rarr;</span>
            </a>
          </div>

          <h4 class="text-base font-bold text-ink mb-1" id="workflowTitle">Faceless YouTube Shorts Automation</h4>
          <p class="text-xs text-slate-600 mb-4" id="workflowDesc">End-to-end automated pipeline turning trending topics into published shorts.</p>

          <div class="p-3.5 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] mb-4">
            <div class="text-[11px] font-mono uppercase text-slate-500 font-semibold mb-2">Workflow Execution Flow:</div>
            <div class="flex flex-wrap items-center gap-2 text-xs" id="workflowStepsFlow">
              <!-- Dynamically populated steps -->
            </div>
          </div>

          <div class="flex items-center justify-between text-xs text-slate-600 pt-2">
            <div>
              <span class="text-slate-500">Estimated Cost:</span>
              <strong class="text-ink font-semibold ml-1" id="workflowCost">~$17/mo or $0 (Local)</strong>
            </div>
            <a id="workflowActionBtn" href="/workflows" class="text-xs font-semibold px-3 py-1.5 rounded-md bg-[#09090B] text-white hover:bg-neutral-800 transition-colors shadow-xs">
              Inspect Steps & JSON Export
            </a>
          </div>
        </div>

        <!-- Layer 3: Connected Open-Source & Creator Intelligence Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- Open-Source Self-Hostable Alternative -->
          <div class="p-5 rounded-xl bg-white border-2 border-[#09090B] shadow-[4px_4px_0px_0px_#09090B] flex flex-col justify-between" id="repoCard">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-mono uppercase font-bold px-2 py-0.5 rounded bg-purple-50 text-purple-700 border border-purple-200">
                  Self-Hostable Open Source
                </span>
                <span class="text-xs font-mono font-bold text-slate-700" id="repoStars">★ 118k</span>
              </div>
              <h4 class="text-base font-bold text-ink mb-1" id="repoName">Ollama</h4>
              <p class="text-xs text-slate-600 mb-3" id="repoDesc">Run open weights models locally on macOS, Linux, and Windows with zero cloud fees.</p>
              
              <div class="p-2.5 rounded bg-[#F8FAFF] border border-[#E2E8F0] text-[11px] font-mono text-slate-700 mb-4 overflow-x-auto" id="repoCmd">
                ollama run deepseek-r1:14b
              </div>
            </div>

            <div class="flex items-center justify-between border-t border-[#E2E8F0] pt-3">
              <span class="text-[11px] text-slate-500" id="repoVram">VRAM: 8 GB Min</span>
              <a id="repoLink" href="/open-source" class="text-xs font-bold text-[#2563EB] hover:underline">
                View Setup Guide &rarr;
              </a>
            </div>
          </div>

          <!-- Recommended YouTube Creator to Learn From -->
          <div class="p-5 rounded-xl bg-white border-2 border-[#09090B] shadow-[4px_4px_0px_0px_#09090B] flex flex-col justify-between" id="creatorCard">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-mono uppercase font-bold px-2 py-0.5 rounded bg-red-50 text-red-700 border border-red-200">
                  Tutorial / Masterclass
                </span>
                <span class="text-xs font-mono font-bold text-slate-700" id="creatorSubs">980K+ Subs</span>
              </div>
              <h4 class="text-base font-bold text-ink mb-1" id="creatorName">Andrej Karpathy</h4>
              <p class="text-xs text-slate-600 mb-3" id="creatorDesc">Learn the inner mechanics and implementation from scratch.</p>

              <div class="p-2.5 rounded bg-[#F8FAFF] border border-[#E2E8F0] text-xs text-slate-700 mb-4">
                <div class="text-[10px] font-mono uppercase text-slate-500 font-semibold mb-1">Recommended Video:</div>
                <div class="font-medium truncate" id="creatorVideoTitle">Let's build GPT: from scratch in code</div>
              </div>
            </div>

            <div class="flex items-center justify-between border-t border-[#E2E8F0] pt-3">
              <span class="text-[11px] text-slate-500" id="creatorCategory">AI Research</span>
              <a id="creatorLink" href="/creators" class="text-xs font-bold text-[#2563EB] hover:underline">
                View Creator Curriculum &rarr;
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ toolsData: allTools, workflowsData: WORKFLOWS_DATA, reposData: OPEN_SOURCE_REPOS, creatorsData: CREATORS_DATA }}>
  window.AIO_TOOLS = toolsData || [];
  window.AIO_WORKFLOWS = workflowsData || [];
  window.AIO_REPOS = reposData || [];
  window.AIO_CREATORS = creatorsData || [];

  function initAIOFinder() {
    const form = document.getElementById('finderForm');
    const textarea = document.getElementById('taskPrompt');
    const resultsSection = document.getElementById('resultsSection');
    const recommendationCards = document.getElementById('recommendationCards');
    const queryEcho = document.getElementById('queryEcho');
    const resetFinderBtn = document.getElementById('resetFinderBtn');
    const exampleBtns = document.querySelectorAll('.example-btn');

    // Workflow Elements
    const workflowTitle = document.getElementById('workflowTitle');
    const workflowDesc = document.getElementById('workflowDesc');
    const workflowDifficulty = document.getElementById('workflowDifficulty');
    const workflowStepsFlow = document.getElementById('workflowStepsFlow');
    const workflowCost = document.getElementById('workflowCost');
    const workflowLink = document.getElementById('workflowLink');
    const workflowActionBtn = document.getElementById('workflowActionBtn');

    // Repo Elements
    const repoName = document.getElementById('repoName');
    const repoDesc = document.getElementById('repoDesc');
    const repoStars = document.getElementById('repoStars');
    const repoCmd = document.getElementById('repoCmd');
    const repoVram = document.getElementById('repoVram');
    const repoLink = document.getElementById('repoLink');

    // Creator Elements
    const creatorName = document.getElementById('creatorName');
    const creatorDesc = document.getElementById('creatorDesc');
    const creatorSubs = document.getElementById('creatorSubs');
    const creatorVideoTitle = document.getElementById('creatorVideoTitle');
    const creatorCategory = document.getElementById('creatorCategory');
    const creatorLink = document.getElementById('creatorLink');

    const tools = window.AIO_TOOLS;
    const workflows = window.AIO_WORKFLOWS;
    const repos = window.AIO_REPOS;
    const creators = window.AIO_CREATORS;

    exampleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (textarea) {
          textarea.value = btn.textContent.trim();
          executeMatching();
        }
      });
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        executeMatching();
      });
    }

    if (resetFinderBtn) {
      resetFinderBtn.addEventListener('click', () => {
        if (resultsSection) resultsSection.classList.add('hidden');
        if (textarea) textarea.value = '';
      });
    }

    function executeMatching() {
      const query = (textarea?.value || '').toLowerCase().trim();
      if (!query) {
        textarea?.focus();
        return;
      }

      const wantsFree = query.includes('free') || query.includes('open source') || query.includes('zero cost') || query.includes('self host');
      const isVideo = query.includes('video') || query.includes('shorts') || query.includes('reels') || query.includes('animation');
      const isVoice = query.includes('voice') || query.includes('speech') || query.includes('audio') || query.includes('podcast') || query.includes('clone');
      const isCode = query.includes('code') || query.includes('programming') || query.includes('developer') || query.includes('refactor') || query.includes('git');
      const isIndia = query.includes('india') || query.includes('indic') || query.includes('hindi') || query.includes('regional') || query.includes('tamil') || query.includes('telugu');
      const isAutomation = query.includes('automate') || query.includes('workflow') || query.includes('n8n') || query.includes('connect') || query.includes('agent');
      const isImage = query.includes('image') || query.includes('art') || query.includes('photo') || query.includes('logo') || query.includes('thumbnail');
      const isRAG = query.includes('rag') || query.includes('pdf') || query.includes('document') || query.includes('search') || query.includes('knowledge');

      // 1. Score Tools Safely (with robust normalization for categorySlug & categorySlugs)
      const scoredTools = tools.map(t => {
        let score = 0;
        const reasons = [];

        // Safe category normalization
        const catList = Array.isArray(t.categorySlugs) 
          ? t.categorySlugs 
          : (t.categorySlug ? [t.categorySlug] : (t.categories || []));

        const hasCat = (cat) => catList.includes(cat);

        if (isVideo && (hasCat('video-generation') || hasCat('video'))) {
          score += 45;
          reasons.push('Specialized in generative video synthesis & camera motion');
        }
        if (isVoice && (hasCat('audio-voice') || hasCat('voice') || hasCat('audio'))) {
          score += 45;
          reasons.push('Industry-leading natural speech synthesis & voice cloning');
        }
        if (isCode && (hasCat('code-assistants') || hasCat('coding'))) {
          score += 45;
          reasons.push('Deep programming agent & IDE assistance');
        }
        if (isIndia && (t.isIndianAI || hasCat('india-first') || hasCat('indic'))) {
          score += 50;
          reasons.push('Native Indic language support & sovereign Indian cloud hosting');
        }
        if (isAutomation && (hasCat('automation-workflows') || hasCat('automation'))) {
          score += 45;
          reasons.push('High-throughput API & webhook orchestration');
        }
        if (isImage && (hasCat('image-art') || hasCat('image'))) {
          score += 45;
          reasons.push('Photorealistic diffusion & typography generation');
        }
        if (isRAG && (hasCat('research-rag') || hasCat('rag') || hasCat('search'))) {
          score += 40;
          reasons.push('Accurate semantic document indexing & vector citation');
        }

        if (wantsFree && (t.pricingType === 'Free' || t.freeTier || t.pricingType === 'Open Source')) {
          score += 25;
          reasons.push(`Accessible zero-cost tier (${t.pricingType})`);
        }

        // Tagline / description match
        const tag = (t.tagline || '').toLowerCase();
        const desc = (t.description || '').toLowerCase();
        if (tag.includes(query) || desc.includes(query)) {
          score += 20;
        }

        // Platform base score
        score += ((t.platformScore || 80) / 10);

        return { tool: t, score, reasons };
      });

      scoredTools.sort((a, b) => b.score - a.score);

      // Best Overall Match
      const bestOverall = scoredTools[0]?.tool || tools[0];
      const bestOverallReason = scoredTools[0]?.reasons[0] || 'Highest platform reliability & benchmark performance';

      // Best 100% Free / Open Source Match
      const freeMatches = scoredTools.filter(st => st.tool.pricingType === 'Free' || st.tool.freeTier || st.tool.pricingType === 'Open Source');
      const bestFree = freeMatches[0]?.tool || tools.find(t => t.pricingType === 'Free' || t.freeTier) || bestOverall;
      const bestFreeReason = freeMatches[0]?.reasons[0] || 'Zero upfront credit card required with functional free tier';

      // Best Premium / Enterprise Match
      const premiumMatches = scoredTools.filter(st => st.tool.pricingType === 'Paid' || st.tool.pricingType === 'Freemium');
      const bestPremium = premiumMatches[0]?.tool || bestOverall;
      const bestPremiumReason = premiumMatches[0]?.reasons[0] || 'Advanced enterprise features, priority SLA & model depth';

      // 2. Render Tool Recommendation Cards
      if (recommendationCards) {
        recommendationCards.innerHTML = `
          <!-- 1. Best Overall -->
          <div class="bg-white border-2 border-[#09090B] rounded-xl p-5 shadow-[4px_4px_0px_0px_#2563EB] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-mono uppercase font-bold px-2.5 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]">
                  Best Overall Match
                </span>
                <span class="text-xs font-mono font-bold text-ink">Score: ${bestOverall.platformScore || 90}</span>
              </div>
              <h4 class="text-base font-bold text-ink mb-1">${bestOverall.name}</h4>
              <p class="text-xs text-slate-600 line-clamp-2 mb-3">${bestOverall.tagline}</p>
              <div class="p-2.5 rounded bg-[#F8FAFF] border border-[#E2E8F0] text-[11px] text-[#2563EB] font-medium mb-4">
                &bull; ${bestOverallReason}
              </div>
            </div>
            <div class="flex items-center justify-between border-t border-[#E2E8F0] pt-3 text-xs">
              <span class="font-semibold text-slate-700">${bestOverall.pricingType}</span>
              <a href="/tools/${bestOverall.slug}" class="font-bold text-[#2563EB] hover:underline">
                View Tool &rarr;
              </a>
            </div>
          </div>

          <!-- 2. Best Free Option -->
          <div class="bg-white border-2 border-[#09090B] rounded-xl p-5 shadow-[4px_4px_0px_0px_#10B981] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-mono uppercase font-bold px-2.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">
                  Best 100% Free Option
                </span>
                <span class="text-xs font-mono font-bold text-emerald-700">Free Tier</span>
              </div>
              <h4 class="text-base font-bold text-ink mb-1">${bestFree.name}</h4>
              <p class="text-xs text-slate-600 line-clamp-2 mb-3">${bestFree.tagline}</p>
              <div class="p-2.5 rounded bg-emerald-50/50 border border-emerald-100 text-[11px] text-emerald-800 font-medium mb-4">
                &bull; ${bestFreeReason}
              </div>
            </div>
            <div class="flex items-center justify-between border-t border-[#E2E8F0] pt-3 text-xs">
              <span class="font-semibold text-emerald-700">${bestFree.pricingType}</span>
              <a href="/tools/${bestFree.slug}" class="font-bold text-[#2563EB] hover:underline">
                View Tool &rarr;
              </a>
            </div>
          </div>

          <!-- 3. Best Premium / Production Option -->
          <div class="bg-white border-2 border-[#09090B] rounded-xl p-5 shadow-[4px_4px_0px_0px_#09090B] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-mono uppercase font-bold px-2.5 py-0.5 rounded bg-slate-100 text-slate-800 border border-slate-300">
                  Best Enterprise / Pro
                </span>
                <span class="text-xs font-mono font-bold text-slate-700">Pro Feature Set</span>
              </div>
              <h4 class="text-base font-bold text-ink mb-1">${bestPremium.name}</h4>
              <p class="text-xs text-slate-600 line-clamp-2 mb-3">${bestPremium.tagline}</p>
              <div class="p-2.5 rounded bg-[#F8FAFF] border border-[#E2E8F0] text-[11px] text-slate-700 font-medium mb-4">
                &bull; ${bestPremiumReason}
              </div>
            </div>
            <div class="flex items-center justify-between border-t border-[#E2E8F0] pt-3 text-xs">
              <span class="font-semibold text-slate-700">${bestPremium.pricingType}</span>
              <a href="/tools/${bestPremium.slug}" class="font-bold text-[#2563EB] hover:underline">
                View Tool &rarr;
              </a>
            </div>
          </div>
        `;
      }

      // 3. Match Workflow Blueprint
      let matchedWf = workflows[0];
      if (isVideo) {
        matchedWf = workflows.find(w => w.id === 'shorts-creator-pipeline') || workflows[0];
      } else if (isCode) {
        matchedWf = workflows.find(w => w.id === 'pr-code-review-bot') || workflows[1];
      } else if (isIndia || isVoice) {
        matchedWf = workflows.find(w => w.id === 'indic-customer-support-agent') || workflows[2];
      } else if (isRAG) {
        matchedWf = workflows.find(w => w.id === 'local-private-rag-knowledgebase') || workflows[0];
      } else if (isAutomation) {
        matchedWf = workflows.find(w => w.id === 'autonomous-customer-support-triage') || workflows[0];
      }

      if (workflowTitle) workflowTitle.textContent = matchedWf.title;
      if (workflowDesc) workflowDesc.textContent = matchedWf.goal;
      if (workflowDifficulty) workflowDifficulty.textContent = `${matchedWf.difficulty} • ${matchedWf.time}`;
      if (workflowCost) workflowCost.textContent = matchedWf.estimatedCost;
      if (workflowLink) workflowLink.href = `/workflows/${matchedWf.id}`;
      if (workflowActionBtn) workflowActionBtn.href = `/workflows/${matchedWf.id}`;

      if (workflowStepsFlow) {
        workflowStepsFlow.innerHTML = matchedWf.steps.slice(0, 4).map((s, idx) => `
          <div class="flex items-center gap-1.5 font-medium">
            <span class="px-2 py-0.5 rounded bg-white border border-[#E2E8F0] text-slate-800 font-semibold shadow-2xs">${idx + 1}. ${s.title}</span>
            ${idx < Math.min(matchedWf.steps.length - 1, 3) ? '<span class="text-slate-400 font-bold">&rarr;</span>' : ''}
          </div>
        `).join('');
      }

      // 4. Match Open-Source Alternative
      let matchedRepo = repos[0];
      if (isCode) {
        matchedRepo = repos.find(r => r.slug === 'aider' || r.slug === 'openhands') || repos[0];
      } else if (isVideo || isImage) {
        matchedRepo = repos.find(r => r.slug === 'comfyui') || repos[0];
      } else if (isAutomation) {
        matchedRepo = repos.find(r => r.slug === 'n8n' || r.slug === 'dify') || repos[0];
      } else if (isVoice) {
        matchedRepo = repos.find(r => r.slug === 'chatterbox-tts' || r.slug === 'whisper-openai') || repos[0];
      }

      if (repoName) repoName.textContent = matchedRepo.name;
      if (repoDesc) repoDesc.textContent = matchedRepo.oneMinuteSummary || matchedRepo.description;
      if (repoStars) repoStars.textContent = `★ ${matchedRepo.stars}`;
      if (repoCmd) repoCmd.textContent = matchedRepo.quickstartCommands?.cli || matchedRepo.quickstartCommands?.docker || 'git clone ' + matchedRepo.url;
      if (repoVram) repoVram.textContent = `VRAM: ${matchedRepo.hardwareSpecs?.minVramGb || 'N/A'}`;
      if (repoLink) repoLink.href = `/open-source/${matchedRepo.slug}`;

      // 5. Match YouTube Creator / Tutorial
      let matchedCreator = creators[0];
      if (isCode) {
        matchedCreator = creators.find(c => c.slug === 'fireship' || c.slug === 'theprimeagen') || creators[0];
      } else if (isIndia) {
        matchedCreator = creators.find(c => c.slug === 'krish-naik' || c.slug === 'varun-mayya') || creators[0];
      } else if (isAutomation) {
        matchedCreator = creators.find(c => c.slug === 'cole-medin' || c.slug === 'ai-jason') || creators[0];
      } else if (isVideo || isImage) {
        matchedCreator = creators.find(c => c.slug === 'matt-wolfe') || creators[0];
      }

      if (creatorName) creatorName.textContent = matchedCreator.channelName;
      if (creatorDesc) creatorDesc.textContent = matchedCreator.description;
      if (creatorSubs) creatorSubs.textContent = `${matchedCreator.subscribersEstimate} Subs`;
      if (creatorCategory) creatorCategory.textContent = matchedCreator.primaryCategory;
      if (creatorLink) creatorLink.href = `/creators/${matchedCreator.slug}`;
      if (creatorVideoTitle && matchedCreator.topVideos?.[0]) {
        creatorVideoTitle.textContent = matchedCreator.topVideos[0].title;
      }

      // 6. Reveal Blueprint
      if (queryEcho) {
        queryEcho.textContent = `Target Intent: "${query}" &bull; Matched across 5 ecosystem layers`;
      }
      if (resultsSection) {
        resultsSection.classList.remove('hidden');
        resultsSection.classList.add('flex');
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAIOFinder);
  } else {
    initAIOFinder();
  }
</script>
