---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import { getAllTools, getToolBySlug } from '../../services/dataService';

export async function getStaticPaths() {
  const tools = await getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { slug } = Astro.params;
const tool = Astro.props.tool || (await getToolBySlug(slug!));

if (!tool) {
  return Astro.redirect('/tools');
}

// Get alternative tools
const allTools = await getAllTools();
const alternativeTools = allTools.filter(t => tool.alternatives.includes(t.slug));
---

<Layout 
  title={`${tool.name} Review, Cost-to-Value & Alternatives | AI Discovery`}
  description={tool.tagline}
>
  <Header currentPath="/tools" />

  <main class="w-full flex flex-col min-h-screen">
    <!-- Breadcrumbs -->
    <div class="border-b border-hairline bg-canvas px-6 py-3">
      <div class="max-w-6xl mx-auto flex items-center gap-2 text-xs text-mute">
        <a href="/" class="hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/tools" class="hover:text-ink transition-colors">Tools</a>
        <span>/</span>
        <span class="text-ink font-medium">{tool.name}</span>
      </div>
    </div>

    <!-- Hero Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-10 md:py-14">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-8">
        <div class="flex items-start gap-5">
          <ToolLogo websiteUrl={tool.websiteUrl} name={tool.name} size="lg" />
          <div>
            <div class="flex items-center gap-2 flex-wrap mb-1.5">
              <h1 class="text-3xl md:text-4xl font-semibold text-ink tracking-tight">
                {tool.name}
              </h1>
              {tool.isVerified && (
                <span class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full font-medium inline-flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                  </svg>
                  <span>Verified Official</span>
                </span>
              )}
              {tool.isIndianAI && (
                <span class="text-xs bg-orange-50 text-orange-700 border border-orange-200 px-2 py-0.5 rounded-full font-medium inline-flex items-center gap-1">
                  India-First AI
                </span>
              )}
              {tool.badge && (
                <span class="text-xs bg-hairline-soft text-ink border border-hairline px-2 py-0.5 rounded-full font-medium">
                  {tool.badge}
                </span>
              )}
            </div>

            <p class="text-base md:text-lg text-body mb-4 max-w-2xl font-normal leading-relaxed">
              {tool.tagline}
            </p>

            <div class="flex flex-wrap items-center gap-3 text-xs text-mute">
              <div class="flex items-center gap-1 text-ink font-medium">
                <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                </svg>
                <span>{tool.rating.toFixed(1)} / 5.0</span>
                <span class="text-mute font-normal">({tool.reviewCount.toLocaleString()} reviews)</span>
              </div>
              <span>•</span>
              <div class="flex items-center gap-1">
                <span class="text-mute">Platform Score:</span>
                <span class="font-mono font-bold text-ink bg-hairline-soft px-1.5 py-0.5 rounded-xs">{tool.platformScore}/100</span>
              </div>
              <span>•</span>
              <div class="flex items-center gap-1">
                <span class="text-mute">Value Score:</span>
                <span class="font-mono font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded-xs">{tool.valueScore}/100</span>
              </div>
              <span>•</span>
              <span class="capitalize">{tool.pricingType}</span>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0">
          <a 
            href={tool.websiteUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-ink text-on-primary font-medium text-sm rounded-pill px-6 py-3 hover:bg-black transition-colors text-center inline-flex items-center justify-center gap-2 shadow-xs"
          >
            <span>Visit Official Website</span>
            <span>↗</span>
          </a>

          <button 
            id="bookmarkBtn"
            class="bg-canvas-elevated text-ink border border-hairline hover:border-faint text-sm font-medium rounded-pill px-6 py-2.5 transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-xs"
          >
            <svg id="bookmarkIcon" class="w-4 h-4 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
            </svg>
            <span id="bookmarkText">Save to Bookmarks</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Main Content & Sidebar -->
    <div class="w-full max-w-6xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Column (Overview, Cost-to-Value, Features, Pros/Cons, Reviews) -->
        <div class="lg:col-span-2 flex flex-col gap-12">
          <!-- Overview -->
          <section>
            <h2 class="text-xl font-semibold text-ink tracking-tight mb-4 border-b border-hairline pb-2.5">
              About {tool.name}
            </h2>
            <div class="text-sm md:text-base text-body leading-relaxed space-y-4">
              <p>{tool.description}</p>
            </div>
          </section>

          <!-- UNIQUE FEATURE: Cost-to-Value Score Breakdown -->
          <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 border-b border-hairline pb-4">
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-emerald-700 mb-1 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
                  </svg>
                  <span>Proprietary ROI Analysis</span>
                </div>
                <h2 class="text-xl font-semibold text-ink tracking-tight">
                  Cost-to-Value Score: <span class="font-mono text-emerald-600">{tool.valueScore}/100</span>
                </h2>
              </div>
              <span class="text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1 rounded-full font-medium shrink-0">
                Verified Benchmark
              </span>
            </div>

            <!-- Value Verdict -->
            <p class="text-sm text-body leading-relaxed mb-6 font-medium">
              <span class="text-ink">Executive Verdict:</span> {tool.valueVerdict}
            </p>

            <!-- Metrics Bars -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-6">
              <!-- Free Tier Generosity -->
              <div class="p-4 rounded-md border border-hairline bg-canvas">
                <div class="flex items-center justify-between text-xs mb-2">
                  <span class="text-mute font-medium">Free Tier Generosity</span>
                  <span class="font-mono font-bold text-ink">{tool.freeTierGenerosity} / 10</span>
                </div>
                <div class="w-full bg-hairline-soft h-2 rounded-full overflow-hidden">
                  <div class="bg-ink h-full rounded-full" style={`width: ${tool.freeTierGenerosity * 10}%`}></div>
                </div>
              </div>

              <!-- Pricing Scalability -->
              <div class="p-4 rounded-md border border-hairline bg-canvas">
                <div class="flex items-center justify-between text-xs mb-2">
                  <span class="text-mute font-medium">Pricing Scalability</span>
                  <span class="font-mono font-bold text-ink">{tool.pricingScalability} / 10</span>
                </div>
                <div class="w-full bg-hairline-soft h-2 rounded-full overflow-hidden">
                  <div class="bg-ink h-full rounded-full" style={`width: ${tool.pricingScalability * 10}%`}></div>
                </div>
              </div>
            </div>

            <!-- Hidden Costs Disclosure -->
            <div class="p-3.5 rounded-md border border-hairline bg-hairline-soft/50 text-xs text-body">
              <strong class="text-ink font-semibold">Transparency & Hidden Costs:</strong> {tool.hiddenCosts}
            </div>
          </section>

          <!-- Key Features -->
          <section>
            <h2 class="text-xl font-semibold text-ink tracking-tight mb-4 border-b border-hairline pb-2.5">
              Core Capabilities & Features
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {tool.features.map(feature => (
                <div class="flex items-start gap-2.5 p-3 rounded-md border border-hairline bg-canvas-elevated text-sm text-body">
                  <span class="text-ink font-bold mt-0.5">•</span>
                  <span>{feature}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Best Use Cases -->
          <section>
            <h2 class="text-xl font-semibold text-ink tracking-tight mb-4 border-b border-hairline pb-2.5">
              Recommended Use Cases
            </h2>
            <ul class="space-y-2.5">
              {tool.useCases.map(useCase => (
                <li class="flex items-start gap-3 text-sm text-body">
                  <span class="w-1.5 h-1.5 rounded-full bg-ink mt-2 shrink-0"></span>
                  <span>{useCase}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Pros and Cons -->
          <section>
            <h2 class="text-xl font-semibold text-ink tracking-tight mb-4 border-b border-hairline pb-2.5">
              Pros & Limitations
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Pros -->
              <div class="p-5 rounded-md border border-emerald-200 bg-emerald-50/40">
                <div class="text-xs font-semibold text-emerald-800 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                  <span>Strengths</span>
                </div>
                <ul class="space-y-2 text-xs md:text-sm text-emerald-950">
                  {tool.pros.map(pro => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-600 font-bold">•</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Cons -->
              <div class="p-5 rounded-md border border-amber-200 bg-amber-50/40">
                <div class="text-xs font-semibold text-amber-800 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                  </svg>
                  <span>Considerations</span>
                </div>
                <ul class="space-y-2 text-xs md:text-sm text-amber-950">
                  {tool.cons.map(con => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-600 font-bold">•</span>
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>

          <!-- Verified Alternatives -->
          {alternativeTools.length > 0 && (
            <section>
              <h2 class="text-xl font-semibold text-ink tracking-tight mb-4 border-b border-hairline pb-2.5">
                Top Alternatives to {tool.name}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {alternativeTools.map(alt => (
                  <a 
                    href={`/tools/${alt.slug}`}
                    class="p-4 rounded-md border border-hairline bg-canvas-elevated hover:border-faint transition-all flex items-start justify-between gap-3 group"
                  >
                    <div>
                      <div class="font-semibold text-ink text-sm group-hover:text-link transition-colors">
                        {alt.name}
                      </div>
                      <div class="text-xs text-mute line-clamp-1 mt-0.5">
                        {alt.tagline}
                      </div>
                      <div class="mt-2 text-xs text-body font-mono">
                        Score: {alt.platformScore} • Value: {alt.valueScore}
                      </div>
                    </div>
                    <span class="text-mute group-hover:text-ink transition-colors text-sm">→</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- Community Reviews -->
          <section>
            <div class="flex items-center justify-between mb-4 border-b border-hairline pb-2.5">
              <h2 class="text-xl font-semibold text-ink tracking-tight">
                Community Feedback
              </h2>
              <span class="text-xs text-mute">{tool.reviewCount.toLocaleString()} verified ratings</span>
            </div>

            <!-- Review Submission Box -->
            <div class="bg-canvas-elevated border border-hairline rounded-md p-5 mb-6 shadow-xs">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-mute mb-3">Leave a Practitioner Review</h3>
              <form id="reviewForm" class="flex flex-col gap-3 text-xs">
                <div class="flex flex-col sm:flex-row gap-3">
                  <div class="w-full sm:w-1/3">
                    <label class="block font-medium text-body mb-1">Your Rating</label>
                    <select id="reviewRating" class="w-full bg-canvas border border-hairline rounded-sm px-2.5 py-2 outline-none text-ink font-medium">
                      <option value="5">★★★★★ 5.0 - Exceptional</option>
                      <option value="4">★★★★☆ 4.0 - Good Value</option>
                      <option value="3">★★★☆☆ 3.0 - Average</option>
                      <option value="2">★★☆☆☆ 2.0 - Needs Work</option>
                      <option value="1">★☆☆☆☆ 1.0 - Not Recommended</option>
                    </select>
                  </div>
                  <div class="w-full sm:w-2/3">
                    <label class="block font-medium text-body mb-1">Your Name or Role</label>
                    <input type="text" id="reviewerName" placeholder="e.g. Senior Frontend Dev" required class="w-full bg-canvas border border-hairline rounded-sm px-2.5 py-2 outline-none text-ink placeholder-faint" />
                  </div>
                </div>

                <div>
                  <label class="block font-medium text-body mb-1">Your Experience & Practical Feedback</label>
                  <textarea id="reviewContent" rows="2" placeholder="How has this tool performed in your daily production workflow?" required class="w-full bg-canvas border border-hairline rounded-sm p-2.5 outline-none text-ink placeholder-faint resize-none"></textarea>
                </div>

                <div class="flex justify-end">
                  <button type="submit" id="submitReviewBtn" class="bg-ink text-on-primary font-medium text-xs px-4 py-2 rounded-pill hover:bg-black transition-colors cursor-pointer shadow-xs">
                    Post Verified Review
                  </button>
                </div>
              </form>
            </div>

            <div class="space-y-4" id="reviewsContainer">
              <div class="bg-canvas-elevated border border-hairline rounded-md p-5">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-hairline-soft font-semibold text-ink text-xs flex items-center justify-center">
                      AI
                    </div>
                    <span class="text-xs font-semibold text-ink">Verified Practitioner</span>
                  </div>
                  <div class="flex items-center gap-1 text-xs text-amber-500">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                    </svg>
                    <span class="text-ink font-mono font-medium">5.0</span>
                  </div>
                </div>
                <p class="text-xs md:text-sm text-body leading-relaxed">
                  "{tool.name} has been essential in our daily workflow. The reliability and speed are top-tier compared to alternatives."
                </p>
                <div class="text-[11px] text-faint mt-2">Verified review • 3 days ago</div>
              </div>
            </div>
          </section>
        </div>

        <!-- Right Sidebar (Pricing & Specs) -->
        <aside class="flex flex-col gap-6">
          <!-- Pricing Overview Card -->
          <div class="bg-canvas-elevated border border-hairline rounded-md p-6 shadow-xs">
            <h3 class="font-semibold text-ink text-sm uppercase tracking-wider mb-4 border-b border-hairline pb-2">
              Pricing Details
            </h3>

            <div class="space-y-3.5 text-sm">
              <div class="flex justify-between items-center">
                <span class="text-mute">Pricing Model</span>
                <span class="font-medium text-ink font-mono">{tool.pricingType}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-mute">Free Tier Available</span>
                <span class="font-medium text-emerald-600">{tool.freeTier ? 'Yes (Forever Free)' : 'No (Paid Only)'}</span>
              </div>
              {tool.startingPrice && (
                <div class="flex justify-between items-center">
                  <span class="text-mute">Starting Price</span>
                  <span class="font-medium text-ink font-mono">{tool.startingPrice}</span>
                </div>
              )}
              <div class="flex justify-between items-center">
                <span class="text-mute">Verification</span>
                <span class="font-medium text-ink">Official Website Checked</span>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-hairline">
              <a 
                href={tool.websiteUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="block w-full bg-ink text-on-primary font-medium text-xs rounded-pill py-2.5 text-center hover:bg-black transition-colors"
              >
                Go to {tool.name} ↗
              </a>
            </div>
          </div>

          <!-- UNIQUE FEATURE: The Self-Hosted / Open-Source Switch -->
          {tool.openSourceAlternative && (
            <div class="bg-purple-50/50 border border-purple-200 rounded-md p-6 shadow-xs">
              <div class="text-[11px] font-bold uppercase tracking-wider text-purple-800 mb-1 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                <span>Self-Hosted Switch</span>
              </div>
              <h4 class="text-base font-semibold text-purple-950 mb-2">
                Want zero subscription costs?
              </h4>
              <p class="text-xs text-purple-900 leading-relaxed mb-4">
                {tool.openSourceAlternative.savings}
              </p>
              <a 
                href={`/tools/${tool.openSourceAlternative.slug}`}
                class="inline-flex items-center justify-between w-full bg-purple-900 text-white font-medium text-xs rounded-pill px-4 py-2 hover:bg-purple-950 transition-colors"
              >
                <span>View {tool.openSourceAlternative.name}</span>
                <span>→</span>
              </a>
            </div>
          )}

          <!-- Metadata & Taxonomy -->
          <div class="bg-canvas-elevated border border-hairline rounded-md p-6 shadow-xs">
            <h3 class="font-semibold text-ink text-sm uppercase tracking-wider mb-4 border-b border-hairline pb-2">
              Categorization
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {tool.categorySlugs.map(cat => (
                <a 
                  href={`/tools?category=${cat}`} 
                  class="text-xs bg-hairline-soft text-body hover:text-ink px-2.5 py-1 rounded-sm transition-colors border border-hairline capitalize"
                >
                  {cat.replace('-', ' ')}
                </a>
              ))}
            </div>
          </div>

          <!-- Trust & Verification Notice -->
          <div class="p-4 rounded-md border border-hairline bg-canvas text-xs text-mute">
            <div class="font-medium text-ink mb-1">Data Integrity & Disclosures</div>
            <p class="leading-relaxed mb-2">
              All tools are checked periodically. We never misrepresent affiliate links as official URLs.
            </p>
            <a href="mailto:support@aidiscovery.internal" class="text-link hover:underline">
              Report incorrect information →
            </a>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bookmarkBtn = document.getElementById('bookmarkBtn');
    const bookmarkIcon = document.getElementById('bookmarkIcon');
    const bookmarkText = document.getElementById('bookmarkText');
    const toolSlug = window.location.pathname.split('/').filter(Boolean).pop();

    if (!bookmarkBtn || !toolSlug) return;

    const savedBookmarks = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
    let isBookmarked = savedBookmarks.includes(toolSlug);

    function updateUI() {
      if (isBookmarked) {
        bookmarkText.textContent = 'Saved in Bookmarks';
        bookmarkBtn.classList.add('bg-hairline-soft', 'border-ink');
        if (bookmarkIcon) bookmarkIcon.classList.add('text-ink', 'fill-current');
      } else {
        bookmarkText.textContent = 'Save to Bookmarks';
        bookmarkBtn.classList.remove('bg-hairline-soft', 'border-ink');
        if (bookmarkIcon) bookmarkIcon.classList.remove('text-ink', 'fill-current');
      }
    }

    updateUI();

    bookmarkBtn.addEventListener('click', () => {
      let bookmarks = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
      if (bookmarks.includes(toolSlug)) {
        bookmarks = bookmarks.filter(slug => slug !== toolSlug);
        isBookmarked = false;
      } else {
        bookmarks.push(toolSlug);
        isBookmarked = true;
      }
      localStorage.setItem('aio_bookmarks', JSON.stringify(bookmarks));
      updateUI();
    });

    // Review Submission
    const reviewForm = document.getElementById('reviewForm');
    const reviewRating = document.getElementById('reviewRating');
    const reviewerName = document.getElementById('reviewerName');
    const reviewContent = document.getElementById('reviewContent');
    const reviewsContainer = document.getElementById('reviewsContainer');

    // Load any existing user submitted reviews for this tool from localStorage
    const savedReviews = JSON.parse(localStorage.getItem(`aio_reviews_${toolSlug}`) || '[]');
    savedReviews.forEach(rev => {
      appendReview(rev.name, rev.rating, rev.content, rev.time);
    });

    function appendReview(name, rating, content, time) {
      if (!reviewsContainer) return;
      const reviewEl = document.createElement('div');
      reviewEl.className = 'bg-canvas-elevated border border-hairline rounded-md p-5';
      reviewEl.innerHTML = `
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full bg-ink text-on-primary font-semibold text-xs flex items-center justify-center font-mono">
              ${(name || 'U').charAt(0).toUpperCase()}
            </div>
            <span class="text-xs font-semibold text-ink">${name}</span>
          </div>
          <div class="flex items-center gap-1 text-xs text-amber-500 font-mono font-medium">
            <span>★</span>
            <span class="text-ink">${Number(rating).toFixed(1)}</span>
          </div>
        </div>
        <p class="text-xs md:text-sm text-body leading-relaxed">${content}</p>
        <div class="text-[11px] text-faint mt-2">Verified review • ${time}</div>
      `;
      reviewsContainer.prepend(reviewEl);
    }

    reviewForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = reviewerName?.value.trim() || 'Verified Member';
      const rating = reviewRating?.value || '5';
      const content = reviewContent?.value.trim();

      if (!content) return;

      appendReview(name, rating, content, 'Just now');

      // Persist in localStorage
      const current = JSON.parse(localStorage.getItem(`aio_reviews_${toolSlug}`) || '[]');
      current.unshift({ name, rating, content, time: 'Just now' });
      localStorage.setItem(`aio_reviews_${toolSlug}`, JSON.stringify(current));

      // Reset form
      reviewForm.reset();
      alert('Thank you! Your verified practitioner review has been posted.');
    });
  });
</script>
