---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CREATORS_DATA } from '../../data/creatorsData';

const categories = ['All', 'AI Coding', 'AI Tutorials', 'AI News', 'AI Agents', 'AI Research', 'Indian AI', 'No-Code & Workflows'];
---

<Layout 
  title="AI & Tech YouTube Creators Hub | AIO AI"
  description="Discover 18+ verified AI educators, YouTube creators, and researchers. Explore what tools they teach, curriculum pillars, and must-watch tutorials."
>
  <Header currentPath="/creators" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-4 sm:px-6 py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-red-200 bg-red-50 text-xs font-semibold text-red-700 mb-4 shadow-xs font-mono">
          <span>18+ VERIFIED GLOBAL & INDIAN AI EDUCATORS</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-ink tracking-tight mb-3">
          AI & Tech Creator Discovery
        </h1>
        <p class="text-slate-600 text-sm sm:text-base max-w-2xl leading-relaxed">
          The curated guide to YouTube researchers, engineers, and educators who teach generative AI, local models, agentic automation, and coding.
        </p>
      </div>
    </section>

    <!-- Creators Grid -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-12 flex-1">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {CREATORS_DATA.map((creator) => (
          <article class="bg-white border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B] hover:shadow-[7px_7px_0px_0px_#DC2626] hover:-translate-y-0.5 transition-all flex flex-col justify-between">
            <div>
              <!-- Top Row: Category & Subs -->
              <div class="flex items-center justify-between text-xs font-mono mb-3">
                <span class="bg-red-50 text-red-700 border border-red-200 font-bold px-2 py-0.5 rounded-xs text-[10px] uppercase">
                  {creator.primaryCategory}
                </span>
                <span class="text-slate-600 font-bold">{creator.subscribersEstimate}</span>
              </div>

              <!-- Channel Info -->
              <div class="flex items-start gap-3 mb-3">
                <div class="w-12 h-12 rounded-lg bg-[#09090B] text-white flex items-center justify-center font-bold text-base shrink-0 font-mono">
                  {creator.channelName.substring(0, 2).toUpperCase()}
                </div>
                <div>
                  <h2 class="text-lg font-bold text-ink hover:text-red-600 transition-colors leading-snug">
                    <a href={`/creators/${creator.slug}`}>
                      {creator.channelName}
                    </a>
                  </h2>
                  <div class="text-xs font-mono text-slate-500">{creator.handle} &bull; {creator.language}</div>
                </div>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-2">
                {creator.description}
              </p>

              <!-- Tools Taught Chips -->
              <div class="mb-4">
                <span class="text-[10px] font-mono uppercase text-slate-500 font-bold block mb-1.5">Tools & Models Taught:</span>
                <div class="flex flex-wrap gap-1.5">
                  {creator.toolsTaught?.slice(0, 4).map(tool => (
                    <span class="px-2 py-0.5 rounded bg-[#F8FAFF] border border-[#E2E8F0] text-slate-700 text-[11px] font-medium">
                      #{tool}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Top Must-Watch Tutorial Preview -->
              {creator.topVideos?.[0] && (
                <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] mb-4 text-xs">
                  <div class="text-[10px] font-mono uppercase text-slate-500 font-bold mb-1">Must-Watch Entry Point:</div>
                  <div class="font-medium text-ink truncate">{creator.topVideos[0].title}</div>
                  <div class="text-[11px] text-slate-500 mt-0.5 font-mono">{creator.topVideos[0].duration} &bull; {creator.topVideos[0].viewsEstimate} views</div>
                </div>
              )}
            </div>

            <!-- Card Bottom Bar -->
            <div class="pt-3 border-t border-[#E2E8F0] flex items-center justify-between text-xs">
              <span class="text-[11px] font-mono text-slate-500">
                Score: <strong class="text-ink">{creator.educationalScore}/100</strong>
              </span>
              <a 
                href={`/creators/${creator.slug}`} 
                class="font-bold text-red-600 hover:underline inline-flex items-center gap-1"
              >
                Full Curriculum &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
