---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CREATORS_DATA } from '../../data/creatorsData';
import { getCreatorAvatar } from '../../services/youtubeLiveService';

const categories = ['All', 'AI Coding', 'AI Tutorials', 'AI News', 'AI Agents', 'AI Research', 'Indian AI', 'No-Code & Workflows'];

// 3 Curated Guided Learning Tracks (Futurepedia & Competitor Blueprint Feature)
const learningTracks = [
  {
    title: 'From Zero to Local AI Engineer',
    level: 'Beginner to Advanced',
    duration: '4-Week Curriculum',
    description: 'Master neural networks from scratch, self-host open-weights LLMs with Ollama and vLLM, and run local RAG pipelines.',
    featuredCreators: ['andrej-karpathy', 'matthew-berman'],
    badge: 'Core Track'
  },
  {
    title: 'Autonomous AI Agents & n8n Orchestration',
    level: 'Intermediate',
    duration: '3-Week Curriculum',
    description: 'Build production agent workflows, multi-tool function calling, and automated lead capture with n8n and LangGraph.',
    featuredCreators: ['liam-ottley', 'cole-medin'],
    badge: 'High Demand'
  },
  {
    title: 'Fullstack AI Web & App Builder',
    level: 'All Levels',
    duration: '2-Week Sprint',
    description: 'Ship verified web applications with Cursor, bolt.new, v0.dev, and Supabase without boilerplate friction.',
    featuredCreators: ['hitesh-choudhary', 'piyush-garg'],
    badge: 'Popular'
  }
];
---

<Layout 
  title="AI & Tech YouTube Creators Hub | 60+ Global & Indian Channels"
  description="Discover 60+ verified AI educators, researchers, and engineers across India, US, UK, and Europe. Explore guided tracks, subscriber metrics, and curriculum pillars."
>
  <Header currentPath="/creators" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-10 md:py-14">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="text-[11px] font-mono text-mute uppercase tracking-wider mb-1">
            Verified Educators & Learning Curriculum
          </div>
          <h1 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-2">
            AI &amp; Tech Creator Discovery
          </h1>
          <p class="text-xs sm:text-sm text-body max-w-2xl leading-relaxed">
            The curated directory of researchers, engineers, and educators who teach generative AI, local models, agentic workflows, and coding.
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs font-mono text-mute shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{CREATORS_DATA.length} Verified Channels &bull; Global &amp; India Coverage</span>
        </div>
      </div>
    </section>

    <!-- GUIDED LEARNING TRACKS (Futurepedia Blueprint Feature) -->
    <section class="border-b border-hairline bg-canvas px-6 py-10">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-base font-semibold text-ink tracking-tight">
              Guided AI Learning Tracks
            </h2>
            <p class="text-xs text-mute">Structured multi-creator paths designed to build production skills systematically.</p>
          </div>
          <span class="text-xs font-mono text-mute">{learningTracks.length} Structured Tracks</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {learningTracks.map(track => (
            <div class="p-5 rounded-lg border border-hairline bg-canvas-elevated hover:border-faint transition-colors flex flex-col justify-between shadow-xs">
              <div>
                <div class="flex items-center justify-between text-[10px] font-mono mb-2">
                  <span class="px-2 py-0.5 rounded bg-hairline-soft text-ink font-medium border border-hairline">{track.badge}</span>
                  <span class="text-mute">{track.duration}</span>
                </div>
                <h3 class="text-sm font-semibold text-ink mb-1">{track.title}</h3>
                <p class="text-xs text-body leading-relaxed mb-4">{track.description}</p>
              </div>

              <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
                <span class="text-[11px] font-mono text-mute">{track.level}</span>
                <a href="#creatorsCatalog" class="font-medium text-ink hover:underline">
                  View Creators &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Multi-Facet Search & Filter Toolbar -->
    <section class="border-b border-hairline bg-surface px-6 py-4" id="creatorsCatalog">
      <div class="max-w-7xl mx-auto space-y-3">
        <!-- Top Row: Search Input + Select Dropdowns -->
        <div class="flex flex-col md:flex-row items-center justify-between gap-3">
          <!-- Quick Search -->
          <div class="relative w-full md:w-80">
            <input 
              type="text" 
              id="creatorSearchInput" 
              placeholder="Search by name, handle, or tool..." 
              class="w-full pl-9 pr-3 py-1.5 rounded-lg bg-canvas-elevated border border-hairline text-ink text-xs focus:outline-none focus:border-primary font-sans"
            />
            <svg class="w-3.5 h-3.5 text-mute absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
          </div>

          <!-- Dropdowns: Country, Sub Tier, Language -->
          <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto justify-end">
            <!-- Country Filter -->
            <div class="flex items-center gap-1 text-xs">
              <span class="text-[11px] font-mono text-mute">Region:</span>
              <select id="countryFilter" class="bg-canvas-elevated border border-hairline rounded-md px-2 py-1 text-xs text-ink outline-none cursor-pointer font-medium">
                <option value="all">All Regions</option>
                <option value="india">India (IN)</option>
                <option value="united states">United States (US)</option>
                <option value="united kingdom">United Kingdom (UK)</option>
                <option value="europe">Europe (EU)</option>
                <option value="canada">Canada (CA)</option>
                <option value="australia">Australia (AU)</option>
              </select>
            </div>

            <!-- Subscriber Count Tier -->
            <div class="flex items-center gap-1 text-xs">
              <span class="text-[11px] font-mono text-mute">Tier:</span>
              <select id="tierFilter" class="bg-canvas-elevated border border-hairline rounded-md px-2 py-1 text-xs text-ink outline-none cursor-pointer font-medium">
                <option value="all">All Tiers</option>
                <option value="<100k">&lt; 100K (Emerging)</option>
                <option value="100k-500k">100K - 500K (Core)</option>
                <option value="500k-2m">500K - 2M (Authority)</option>
                <option value="2m+">2M+ (Global Scale)</option>
              </select>
            </div>

            <!-- Language Filter -->
            <div class="flex items-center gap-1 text-xs">
              <span class="text-[11px] font-mono text-mute">Lang:</span>
              <select id="langFilter" class="bg-canvas-elevated border border-hairline rounded-md px-2 py-1 text-xs text-ink outline-none cursor-pointer font-medium">
                <option value="all">All Languages</option>
                <option value="english">English</option>
                <option value="hindi">Hindi / Hinglish</option>
                <option value="spanish">Spanish</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Bottom Row: Category Pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1" id="creatorCatFilter">
          {categories.map((cat, idx) => (
            <button 
              type="button" 
              class={`creator-cat-btn px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-colors shrink-0 ${
                idx === 0 
                  ? 'bg-ink text-on-primary border border-ink' 
                  : 'bg-canvas-elevated text-mute hover:text-ink border border-hairline hover:border-faint'
              }`}
              data-cat={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Creators Grid -->
    <div class="w-full max-w-7xl mx-auto px-6 py-10 flex-1">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="creatorsGrid">
        {CREATORS_DATA.map((creator) => {
          const subsStr = creator.subscribersEstimate || '100K';
          const subsNum = creator.subscriberCountNumeric || 
            (subsStr.includes('M') ? parseFloat(subsStr) * 1000000 : parseFloat(subsStr) * 1000);
          const computedTier = subsNum >= 2000000 ? '2m+' : subsNum >= 500000 ? '500k-2m' : subsNum >= 100000 ? '100k-500k' : '<100k';
          const computedCountry = creator.country || (creator.isIndiaCreator ? 'India' : 'United States');

          return (
            <article 
              class="creator-card bg-canvas-elevated border border-hairline hover:border-faint rounded-lg p-5 shadow-xs transition-all flex flex-col justify-between"
              data-category={creator.primaryCategory}
              data-name={creator.channelName.toLowerCase()}
              data-handle={(creator.handle || '').toLowerCase()}
              data-country={computedCountry.toLowerCase()}
              data-tier={creator.subscriberTier || computedTier}
              data-lang={(creator.language || 'English').toLowerCase()}
              data-tools={(creator.toolsTaught || []).join(' ').toLowerCase()}
            >
              <div>
                <!-- Top Row: Category & Subs -->
                <div class="flex items-center justify-between text-xs font-mono mb-3">
                  <div class="flex items-center gap-1.5">
                    <span class="bg-hairline-soft text-ink border border-hairline font-medium px-2 py-0.5 rounded text-[10px] uppercase">
                      {creator.primaryCategory}
                    </span>
                    {creator.isIndiaCreator && (
                      <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-orange-50 text-orange-700 border border-orange-200 uppercase">
                        India
                      </span>
                    )}
                  </div>
                  <span class="text-mute font-medium live-subs" data-handle={creator.handle}>{creator.subscribersEstimate}</span>
                </div>

                <!-- Channel Info -->
                <div class="flex items-start gap-3.5 mb-3">
                  <img 
                    src={getCreatorAvatar(creator.handle, creator.avatarUrl)} 
                    alt={creator.channelName} 
                    class="w-10 h-10 rounded-lg border border-hairline bg-surface object-cover shrink-0 shadow-2xs" 
                    loading="lazy" 
                    onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&background=2563EB&color=fff&size=128';"
                  />
                  <div>
                    <h2 class="text-sm font-semibold text-ink hover:underline leading-snug">
                      <a href={`/creators/${creator.slug}`}>
                        {creator.channelName}
                      </a>
                    </h2>
                    <div class="text-[11px] font-mono text-mute">{creator.handle} &bull; {computedCountry}</div>
                  </div>
                </div>

                <p class="text-xs text-body leading-relaxed mb-3 line-clamp-2">
                  {creator.description}
                </p>

                <!-- Tools Taught Chips -->
                <div class="mb-3">
                  <span class="text-[10px] font-mono uppercase text-mute font-semibold block mb-1">Tools &amp; Models Taught:</span>
                  <div class="flex flex-wrap gap-1">
                    {creator.toolsTaught?.slice(0, 4).map(tool => (
                      <a 
                        href={`/tools/${tool}`} 
                        class="px-2 py-0.5 rounded bg-canvas hover:bg-hairline-soft border border-hairline text-body text-[11px] font-mono transition-colors"
                      >
                        #{tool}
                      </a>
                    ))}
                  </div>
                </div>

                <!-- Top Must-Watch Tutorial Preview (Interactive Modal / Link) -->
                {creator.topVideos?.[0] && (
                  <a 
                    href={creator.topVideos[0].url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="block p-3 rounded-lg bg-canvas hover:bg-slate-50 border border-hairline hover:border-faint mb-3 text-xs space-y-1 transition-colors group cursor-pointer"
                  >
                    <div class="flex items-center justify-between text-[10px] font-mono">
                      <span class="text-mute uppercase font-semibold group-hover:text-primary">Top Must-Watch:</span>
                      <span class="px-1.5 py-0.5 rounded bg-blue-50 text-primary font-semibold border border-blue-200">
                        {creator.topVideos[0].viewsEstimate || 'Verified'} views ↗
                      </span>
                    </div>
                    <div class="font-medium text-ink truncate text-xs group-hover:text-primary transition-colors">{creator.topVideos[0].title}</div>
                    <div class="text-[11px] text-mute font-mono">{creator.topVideos[0].duration} &bull; {creator.language}</div>
                  </a>
                )}
              </div>

              <!-- Card Bottom Bar -->
              <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
                <span class="text-[11px] font-mono text-mute">
                  Score: <strong class="text-ink font-semibold">{creator.educationalScore}/100</strong>
                </span>
                <a 
                  href={`/creators/${creator.slug}`} 
                  class="font-medium text-ink hover:underline inline-flex items-center gap-1"
                >
                  Full Curriculum &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { batchRefreshCreatorStats } from '../../services/youtubeLiveService';

  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.creator-cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('.creator-card');
    const searchInput = document.getElementById('creatorSearchInput') as HTMLInputElement | null;
    const countryFilter = document.getElementById('countryFilter') as HTMLSelectElement | null;
    const tierFilter = document.getElementById('tierFilter') as HTMLSelectElement | null;
    const langFilter = document.getElementById('langFilter') as HTMLSelectElement | null;

    let activeCat = 'All';

    // Hydrate live YouTube stats if API key or cache available
    const handlesToFetch = Array.from(document.querySelectorAll<HTMLElement>('.live-subs'))
      .map(el => el.getAttribute('data-handle') || '')
      .filter(Boolean);

    if (handlesToFetch.length > 0) {
      batchRefreshCreatorStats(handlesToFetch).then(statsMap => {
        document.querySelectorAll<HTMLElement>('.live-subs').forEach(el => {
          const rawHandle = el.getAttribute('data-handle') || '';
          const clean = rawHandle.replace(/^@/, '');
          if (statsMap[clean]?.formattedSubscribers) {
            el.textContent = `${statsMap[clean].formattedSubscribers} Subs`;
          }
        });
      }).catch(() => {});
    }

    function applyFilters() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const selectedCountry = (countryFilter?.value || 'all').toLowerCase();
      const selectedTier = (tierFilter?.value || 'all').toLowerCase();
      const selectedLang = (langFilter?.value || 'all').toLowerCase();

      cards.forEach(card => {
        const cat = card.getAttribute('data-category') || '';
        const name = card.getAttribute('data-name') || '';
        const handle = card.getAttribute('data-handle') || '';
        const country = card.getAttribute('data-country') || '';
        const tier = card.getAttribute('data-tier') || '';
        const lang = card.getAttribute('data-lang') || '';
        const tools = card.getAttribute('data-tools') || '';

        const matchesCat = activeCat === 'All' || cat.toLowerCase().includes(activeCat.toLowerCase());
        const matchesQuery = !q || name.includes(q) || handle.includes(q) || tools.includes(q);
        const matchesCountry = selectedCountry === 'all' || country.includes(selectedCountry);
        const matchesTier = selectedTier === 'all' || tier === selectedTier;
        const matchesLang = selectedLang === 'all' || lang.includes(selectedLang);

        if (matchesCat && matchesQuery && matchesCountry && matchesTier && matchesLang) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.className = 'creator-cat-btn px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-colors shrink-0 bg-canvas-elevated text-mute hover:text-ink border border-hairline hover:border-faint';
        });
        btn.className = 'creator-cat-btn px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-colors shrink-0 bg-ink text-on-primary border border-ink';

        activeCat = btn.getAttribute('data-cat') || 'All';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    countryFilter?.addEventListener('change', applyFilters);
    tierFilter?.addEventListener('change', applyFilters);
    langFilter?.addEventListener('change', applyFilters);
  });
</script>
