---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CREATORS_DATA, type CreatorData } from '../../data/creatorsData';
import { TOOLS_DATA } from '../../data/seedData';

export function getStaticPaths() {
  return CREATORS_DATA.map((creator) => ({
    params: { slug: creator.slug },
    props: { creator }
  }));
}

interface Props {
  creator: CreatorData;
}

const { creator } = Astro.props;

// Find matching tool objects for tools taught
const matchingTools = TOOLS_DATA.filter(t => creator.toolsTaught.includes(t.slug));
---

<Layout 
  title={`${creator.channelName} (${creator.handle}) | AI Educator Profile`}
  description={`${creator.description} Discover top tutorials, tools taught, and educational focus areas by ${creator.channelName}.`}
>
  <Header currentPath="/creators" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Breadcrumb -->
    <div class="max-w-6xl w-full mx-auto px-6 pt-8 pb-4">
      <a 
        href="/creators" 
        class="inline-flex items-center gap-1.5 text-xs text-mute hover:text-ink transition-colors font-medium group"
      >
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span>Back to All Creators</span>
      </a>
    </div>

    <!-- Creator Header Banner -->
    <section class="max-w-6xl w-full mx-auto px-6 pb-8">
      <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 pb-6 border-b border-hairline">
          <div class="flex items-start gap-4">
            <div class="w-16 h-16 rounded-full bg-hairline-soft overflow-hidden border border-hairline shrink-0 flex items-center justify-center font-bold text-ink text-xl">
              {creator.channelName.substring(0, 2).toUpperCase()}
            </div>
            <div>
              <div class="flex items-center gap-3 mb-1">
                <h1 class="text-2xl md:text-3xl font-semibold text-ink tracking-tight">
                  {creator.channelName}
                </h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-canvas border border-hairline text-body">
                  {creator.primaryCategory}
                </span>
                {creator.isIndiaCreator && (
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20">
                    India AI Educator
                  </span>
                )}
              </div>
              <p class="text-xs text-mute font-mono mb-3">{creator.handle} &bull; Primary Language: {creator.language}</p>
              <p class="text-sm text-body leading-relaxed max-w-2xl">
                {creator.description}
              </p>
            </div>
          </div>

          <!-- YouTube Action Button -->
          <div class="shrink-0">
            <a 
              href={creator.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors shadow-xs"
            >
              <span>Visit YouTube Channel</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Audience & Scoring Metric Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6">
          <div>
            <span class="text-xs text-mute block mb-0.5 uppercase tracking-wider text-[10px]">Audience Reach</span>
            <span class="text-base font-semibold text-ink font-mono">{creator.subscribersEstimate}</span>
          </div>
          <div>
            <span class="text-xs text-mute block mb-0.5 uppercase tracking-wider text-[10px]">Avg Video Views</span>
            <span class="text-base font-semibold text-ink font-mono">{creator.avgViewsEstimate}</span>
          </div>
          <div>
            <span class="text-xs text-mute block mb-0.5 uppercase tracking-wider text-[10px]">Upload Frequency</span>
            <span class="text-base font-semibold text-ink">{creator.uploadCadence}</span>
          </div>
          <div>
            <span class="text-xs text-mute block mb-0.5 uppercase tracking-wider text-[10px]">Educational Score</span>
            <span class="text-base font-semibold text-emerald-600 dark:text-emerald-400 font-mono">{creator.educationalScore}/100</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Content Sections -->
    <div class="max-w-6xl w-full mx-auto px-6 pb-16 flex-1 flex flex-col gap-10">
      
      <!-- Recommended Entry-Point Videos -->
      <section>
        <div class="mb-4">
          <h2 class="text-base font-semibold text-ink tracking-tight">Recommended Masterclasses & Entry Points</h2>
          <p class="text-xs text-mute">Curated tutorials that provide the highest conceptual and technical ROI from this educator.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {creator.topVideos.map((video) => (
            <a 
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="p-4 rounded-lg bg-canvas-elevated border border-hairline hover:border-faint transition-all flex flex-col justify-between group shadow-xs"
            >
              <div>
                <div class="flex items-center gap-2 text-[10px] text-mute font-mono mb-2">
                  {video.duration && <span>{video.duration}</span>}
                  {video.viewsEstimate && <span>&bull; {video.viewsEstimate} views</span>}
                </div>
                <h3 class="text-sm font-semibold text-ink group-hover:underline leading-snug">
                  {video.title}
                </h3>
              </div>
              <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs text-mute group-hover:text-ink">
                <span>Watch on YouTube</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Tools Taught by this Creator -->
      {matchingTools.length > 0 && (
        <section>
          <div class="mb-4">
            <h2 class="text-base font-semibold text-ink tracking-tight">AI Tools Taught & Reviewed</h2>
            <p class="text-xs text-mute">Tools in our directory that this creator actively breaks down in their videos.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {matchingTools.map((tool) => (
              <a 
                href={`/tools/${tool.slug}`}
                class="p-4 rounded-lg bg-canvas-elevated border border-hairline hover:border-faint transition-colors flex items-start gap-3 group shadow-xs"
              >
                <div class="w-9 h-9 rounded-md bg-hairline-soft flex items-center justify-center font-bold text-xs text-ink shrink-0">
                  {tool.name.substring(0, 2).toUpperCase()}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between">
                    <h4 class="text-xs font-semibold text-ink group-hover:underline truncate">{tool.name}</h4>
                    <span class="text-[10px] text-mute font-mono">{tool.pricingType}</span>
                  </div>
                  <p class="text-[11px] text-mute truncate mt-0.5">{tool.tagline}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Top Topics Tags -->
      <section class="p-6 rounded-lg bg-canvas-elevated border border-hairline shadow-xs">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-faint mb-3">Core Expertise & Curriculum Topics</h3>
        <div class="flex flex-wrap gap-2">
          {creator.topTopics.map((topic) => (
            <span class="text-xs px-3 py-1 rounded-full bg-hairline-soft text-body font-medium">
              {topic}
            </span>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
