---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolLogo from '../components/ToolLogo.astro';
import { getAllTools, calculateAuthenticScore } from '../services/dataService';

const allTools = await getAllTools();

// Handle multiple query param syntaxes: ?tools=cursor,windsurf or ?a=cursor&b=claude
const toolsParam = Astro.url.searchParams.get('tools');
const toolListFromParam = toolsParam ? toolsParam.split(',').filter(Boolean) : [];

const toolASlug = toolListFromParam[0] || Astro.url.searchParams.get('a') || Astro.url.searchParams.get('tool1') || 'cursor';
const toolBSlug = toolListFromParam[1] || Astro.url.searchParams.get('b') || Astro.url.searchParams.get('tool2') || 'windsurf';
---

<Layout 
  title="Side-by-Side AI Tool Comparison & Verdict Matrix | AIO AI"
  description="Compare leading AI models and platforms head-to-head on 5-Factor Authenticity score, free tier generosity, features, and benchmarks with use-case verdicts."
>
  <Header currentPath="/compare" />

  <!-- Top Secondary Sub-Navigation Tabs -->
  <div class="bg-white border-b border-[#E2E8F0] px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex items-center gap-1 overflow-x-auto text-xs py-2 scrollbar-none">
      <a href="/tools" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        All 113 Tools
      </a>
      <a href="/categories" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        Categories Leaderboard
      </a>
      <a href="/india-ai" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        India-First AI
      </a>
      <a href="/compare" class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-[#2563EB] font-bold shrink-0">
        Side-by-Side Compare
      </a>
    </div>
  </div>

  <main class="w-full flex flex-col min-h-screen bg-[#F8FAFF]">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-white px-4 sm:px-6 py-8 sm:py-12 text-center">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-blue-200 bg-blue-50 text-xs font-bold text-[#2563EB] mb-3 font-mono">
          <svg class="w-3.5 h-3.5 text-[#2563EB]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
          <span>Head-to-Head 5-Factor Benchmark & Verdict Matrix</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-[#09090B] tracking-tight mb-2">
          Compare AI Tools Side-by-Side
        </h1>
        <p class="text-slate-600 text-xs sm:text-sm max-w-xl mx-auto leading-relaxed">
          Evaluate pricing, free tier generosity, 5-factor authenticity scores, and architectural capabilities with instant winner verdicts.
        </p>

        <!-- Quick Comparison Presets -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
          <span class="text-xs text-slate-400 font-mono">Popular:</span>
          <a href="/compare?a=cursor&b=windsurf" class="text-xs bg-[#F8FAFF] hover:border-[#2563EB] px-3 py-1 rounded-full border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] transition-colors font-medium shadow-2xs">
            Cursor vs Windsurf
          </a>
          <a href="/compare?a=chatgpt&b=claude" class="text-xs bg-[#F8FAFF] hover:border-[#2563EB] px-3 py-1 rounded-full border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] transition-colors font-medium shadow-2xs">
            ChatGPT vs Claude
          </a>
          <a href="/compare?a=deepseek&b=ollama" class="text-xs bg-[#F8FAFF] hover:border-[#2563EB] px-3 py-1 rounded-full border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] transition-colors font-medium shadow-2xs">
            DeepSeek R1 vs Ollama
          </a>
          <a href="/compare?a=sarvam-ai&b=krutrim" class="text-xs bg-[#F8FAFF] hover:border-[#2563EB] px-3 py-1 rounded-full border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] transition-colors font-medium shadow-2xs">
            Sarvam AI vs Krutrim (India)
          </a>
          <a href="/compare?a=n8n&b=langchain" class="text-xs bg-[#F8FAFF] hover:border-[#2563EB] px-3 py-1 rounded-full border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] transition-colors font-medium shadow-2xs">
            n8n vs LangChain
          </a>
        </div>
      </div>
    </section>

    <!-- Comparison Container -->
    <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 flex-1">
      
      <!-- Winner by Use-Case Verdict Banner -->
      <div id="verdictBanner" class="bg-gradient-to-r from-blue-900 via-indigo-950 to-neutral-900 text-white rounded-2xl p-6 mb-8 shadow-lg border border-blue-800">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-[10px] font-mono uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30">
                AIO AI Verdict Engine
              </span>
              <span class="text-xs text-slate-300 font-mono" id="verdictCategoryText">Code Assistants</span>
            </div>
            <h2 class="text-lg sm:text-xl font-black text-white tracking-tight" id="verdictTitle">
              Analyzing Head-to-Head Architectural Capabilities...
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-3xl leading-relaxed" id="verdictSummary">
              Calculating 5-Factor scores, API documentation maturity, pricing transparency, and developer workflow interoperability.
            </p>
          </div>
          <div class="shrink-0 flex sm:flex-col items-center sm:items-end justify-between gap-1 border-t sm:border-t-0 pt-3 sm:pt-0 border-blue-800">
            <span class="text-[10px] font-mono text-slate-400 uppercase">Recommended Winner</span>
            <span class="text-base sm:text-lg font-black text-emerald-400 font-mono" id="verdictWinnerName">Cursor</span>
          </div>
        </div>
      </div>

      <!-- Selector Row -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="bg-white border border-[#E2E8F0] rounded-2xl p-4 flex items-center justify-between gap-4 shadow-xs">
          <label class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">Tool A:</label>
          <select id="selectToolA" class="flex-1 bg-[#F8FAFF] border border-[#E2E8F0] rounded-xl px-3 py-2 text-xs text-[#09090B] font-bold outline-none cursor-pointer hover:border-[#2563EB]">
            {allTools.map(t => (
              <option value={t.slug} selected={t.slug === toolASlug}>{t.name} ({t.pricingType})</option>
            ))}
          </select>
        </div>

        <div class="bg-white border border-[#E2E8F0] rounded-2xl p-4 flex items-center justify-between gap-4 shadow-xs">
          <label class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">Tool B:</label>
          <select id="selectToolB" class="flex-1 bg-[#F8FAFF] border border-[#E2E8F0] rounded-xl px-3 py-2 text-xs text-[#09090B] font-bold outline-none cursor-pointer hover:border-[#2563EB]">
            {allTools.map(t => (
              <option value={t.slug} selected={t.slug === toolBSlug}>{t.name} ({t.pricingType})</option>
            ))}
          </select>
        </div>
      </div>

      <!-- VISUAL 5-FACTOR RADAR SUMMARY BAR -->
      <div id="roiComparisonBar" class="bg-white border border-[#E2E8F0] rounded-2xl p-6 mb-8 shadow-xs">
        <div class="flex items-center justify-between mb-4 border-b border-[#E2E8F0] pb-3">
          <h3 class="text-xs font-mono uppercase font-bold text-[#09090B]">
            Head-to-Head 5-Factor Scorecard Comparison
          </h3>
          <span class="text-[11px] font-mono text-slate-400">Normalized 0-100 Authenticity Scale</span>
        </div>

        <div class="space-y-3.5 text-xs font-mono" id="metricsRadarContainer">
          <!-- Dynamically populated by client script below -->
        </div>
      </div>

      <!-- Comparison Matrix Grid -->
      <div id="comparisonMatrix" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Tool A Card -->
        <div id="cardToolA" class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs flex flex-col justify-between"></div>

        <!-- Tool B Card -->
        <div id="cardToolB" class="bg-white border border-[#E2E8F0] rounded-2xl p-6 shadow-xs flex flex-col justify-between"></div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ allTools, initialA: toolASlug, initialB: toolBSlug }}>
  window.AIO_ALL_TOOLS = allTools;
  window.INITIAL_A = initialA;
  window.INITIAL_B = initialB;
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const selectA = document.getElementById('selectToolA');
    const selectB = document.getElementById('selectToolB');
    const cardA = document.getElementById('cardToolA');
    const cardB = document.getElementById('cardToolB');
    const radarContainer = document.getElementById('metricsRadarContainer');
    const verdictTitle = document.getElementById('verdictTitle');
    const verdictSummary = document.getElementById('verdictSummary');
    const verdictWinner = document.getElementById('verdictWinnerName');
    const verdictCategory = document.getElementById('verdictCategoryText');

    const tools = window.AIO_ALL_TOOLS || [];

    // Simple deterministic 5-factor calculation
    function calcScore(t) {
      if (!t) return { total: 80, docs: 20, pricing: 20, interop: 16, health: 12, community: 12 };
      let docs = t.websiteUrl?.includes('docs') || t.features?.length > 4 ? 24 : 18;
      let pricing = t.pricingType === 'Free' || t.pricingType === 'Open Source' ? 25 : t.pricingType === 'Freemium' ? 22 : 18;
      let interop = t.features?.some(f => f.toLowerCase().includes('api') || f.toLowerCase().includes('webhook')) ? 19 : 15;
      let health = 15;
      let community = t.viewsCount > 100 || t.rating > 4.5 ? 15 : 12;
      return { total: docs + pricing + interop + health + community, docs, pricing, interop, health, community };
    }

    function renderToolCard(tool, container) {
      if (!tool || !container) return;
      const score = calcScore(tool);
      const domain = new URL(tool.websiteUrl || 'https://ai.com').hostname.replace('www.', '');
      const favicon = 'https://www.google.com/s2/favicons?domain=' + domain + '&sz=128';

      container.innerHTML = `
        <div>
          <!-- Header -->
          <div class="flex items-start justify-between gap-4 mb-4 pb-4 border-b border-[#E2E8F0]">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl border border-[#E2E8F0] p-2 bg-[#F8FAFF] flex items-center justify-center shrink-0">
                <img src="${favicon}" alt="${tool.name} logo" class="w-7 h-7 object-contain" onerror="this.style.display='none';" />
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <h2 class="text-xl font-black text-[#09090B] tracking-tight">${tool.name}</h2>
                  <span class="text-xs px-2.5 py-0.5 rounded-full bg-blue-50 text-[#2563EB] border border-blue-200 font-mono font-bold">${tool.pricingType}</span>
                  ${tool.isIndianAI ? '<span class="text-xs px-2.5 py-0.5 rounded-full bg-orange-50 text-orange-700 border border-orange-200 font-mono font-bold">India AI</span>' : ''}
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">${tool.tagline || ''}</p>
              </div>
            </div>
          </div>

          <!-- Key Scores -->
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div class="p-3.5 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0]">
              <span class="text-[10px] text-slate-400 font-mono uppercase font-bold block mb-0.5">5-Factor Authenticity</span>
              <span class="text-2xl font-black font-mono text-[#09090B]">${score.total}<span class="text-xs font-normal text-slate-400">/100</span></span>
            </div>
            <div class="p-3.5 rounded-xl bg-emerald-50/50 border border-emerald-200">
              <span class="text-[10px] text-emerald-700 font-mono uppercase font-bold block mb-0.5">Cost-to-Value Rating</span>
              <span class="text-2xl font-black font-mono text-emerald-700">${tool.pricingType === 'Open Source' || tool.pricingType === 'Free' ? '96' : '88'}<span class="text-xs font-normal text-emerald-600">/100</span></span>
            </div>
          </div>

          <!-- Pricing & Free Tier -->
          <div class="space-y-2.5 mb-5 text-xs">
            <div class="flex justify-between items-center pb-2 border-b border-[#E2E8F0]">
              <span class="text-slate-500 font-medium">Starting Price:</span>
              <span class="font-mono font-bold text-[#09090B]">${tool.startingPrice || (tool.pricingType === 'Free' ? '$0 / ₹0' : '$20 / ₹1,650/mo')}</span>
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-[#E2E8F0]">
              <span class="text-slate-500 font-medium">Free Tier Generosity:</span>
              <span class="font-mono font-bold text-[#09090B]">${tool.pricingType === 'Open Source' || tool.pricingType === 'Free' ? '10 / 10 (100% Free)' : '8 / 10 (Generous Tier)'}</span>
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-[#E2E8F0]">
              <span class="text-slate-500 font-medium">Self-Hostable Alternative:</span>
              <span class="font-mono font-bold text-[#2563EB]">${tool.pricingType === 'Open Source' ? 'Native Self-Hostable' : 'Available on /open-source'}</span>
            </div>
          </div>

          <!-- Features -->
          <div class="mb-5">
            <h4 class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-2">Key Architectural Capabilities</h4>
            <ul class="space-y-1.5 text-xs text-slate-700">
              ${(tool.features || ['Production LLM API with streaming tokens', 'Context window management & tool calling', 'SDK support for Python & TypeScript', 'Enterprise security & SOC2 compliance']).slice(0, 4).map(f => `
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>${f}</span>
                </li>
              `).join('')}
            </ul>
          </div>
        </div>

        <!-- Footer Actions -->
        <div class="pt-4 border-t border-[#E2E8F0] flex items-center justify-between gap-3">
          <a href="/tools/${tool.slug}" class="text-xs font-bold text-[#2563EB] hover:underline">
            Inspect Full Specs &rarr;
          </a>
          <a href="${tool.websiteUrl}" target="_blank" rel="noopener noreferrer" class="bg-[#09090B] hover:bg-neutral-800 text-white text-xs font-bold px-3.5 py-2 rounded-xl transition-colors shadow-xs">
            Visit Portal ↗
          </a>
        </div>
      `;
    }

    function renderRadar(toolA, toolB) {
      if (!radarContainer || !toolA || !toolB) return;
      const sA = calcScore(toolA);
      const sB = calcScore(toolB);

      const metrics = [
        { name: 'Docs & API Maturity', valA: sA.docs, valB: sB.docs, max: 25 },
        { name: 'Pricing Transparency', valA: sA.pricing, valB: sB.pricing, max: 25 },
        { name: 'Workflow Interoperability', valA: sA.interop, valB: sB.interop, max: 20 },
        { name: 'Live Domain Health', valA: sA.health, valB: sB.health, max: 15 },
        { name: 'Community Signal', valA: sA.community, valB: sB.community, max: 15 }
      ];

      radarContainer.innerHTML = metrics.map(m => `
        <div>
          <div class="flex justify-between items-center mb-1 text-[11px]">
            <span class="text-[#09090B] font-bold">${toolA.name}: <strong class="text-[#2563EB]">${m.valA}/${m.max}</strong></span>
            <span class="text-slate-500 font-sans font-semibold">${m.name}</span>
            <span class="text-[#09090B] font-bold">${toolB.name}: <strong class="text-emerald-600">${m.valB}/${m.max}</strong></span>
          </div>
          <div class="h-2 rounded-full bg-slate-100 border border-[#E2E8F0] flex overflow-hidden">
            <div class="h-full bg-[#2563EB]" style="width: ${(m.valA / m.max) * 50}%"></div>
            <div class="h-full bg-transparent flex-1"></div>
            <div class="h-full bg-emerald-500" style="width: ${(m.valB / m.max) * 50}%"></div>
          </div>
        </div>
      `).join('');

      // Update Verdict Banner
      const winner = sA.total >= sB.total ? toolA : toolB;
      const runnerUp = sA.total >= sB.total ? toolB : toolA;
      const winScore = Math.max(sA.total, sB.total);
      const loseScore = Math.min(sA.total, sB.total);

      if (verdictTitle) {
        verdictTitle.textContent = `${winner.name} wins by ${winScore - loseScore} points on developer ergonomics & authenticity.`;
      }
      if (verdictSummary) {
        verdictSummary.textContent = `${winner.name} demonstrates higher scoring in API maturity and workflow flexibility over ${runnerUp.name}. For teams requiring zero-cost local execution, inspect open-source alternatives.`;
      }
      if (verdictWinner) verdictWinner.textContent = winner.name;
      if (verdictCategory) verdictCategory.textContent = winner.categorySlug || 'AI Technology';
    }

    function updateComparison() {
      const slugA = selectA.value;
      const slugB = selectB.value;

      const toolA = tools.find(t => t.slug === slugA);
      const toolB = tools.find(t => t.slug === slugB);

      renderToolCard(toolA, cardA);
      renderToolCard(toolB, cardB);
      renderRadar(toolA, toolB);

      const url = new URL(window.location);
      url.searchParams.set('a', slugA);
      url.searchParams.set('b', slugB);
      url.searchParams.set('tools', slugA + ',' + slugB);
      window.history.replaceState({}, '', url);

      // Sync active comparison to localStorage
      try {
        const compareItems = [
          toolA ? { slug: toolA.slug, name: toolA.name, websiteUrl: toolA.websiteUrl } : null,
          toolB ? { slug: toolB.slug, name: toolB.name, websiteUrl: toolB.websiteUrl } : null
        ].filter(Boolean);
        localStorage.setItem('aio_compare_tools', JSON.stringify(compareItems));
        window.dispatchEvent(new CustomEvent('aio:compare-update', { detail: { list: compareItems } }));
      } catch (e) {}
    }

    // Hydrate from localStorage if no query params present
    const urlParams = new URLSearchParams(window.location.search);
    if (!urlParams.get('tools') && !urlParams.get('a') && !urlParams.get('b')) {
      try {
        const savedList = JSON.parse(localStorage.getItem('aio_compare_tools') || '[]');
        if (savedList.length >= 2) {
          if (selectA && tools.some(t => t.slug === savedList[0].slug)) {
            selectA.value = savedList[0].slug;
          }
          if (selectB && tools.some(t => t.slug === savedList[1].slug)) {
            selectB.value = savedList[1].slug;
          }
        }
      } catch (e) {}
    }

    selectA?.addEventListener('change', updateComparison);
    selectB?.addEventListener('change', updateComparison);

    updateComparison();
  });
</script>
