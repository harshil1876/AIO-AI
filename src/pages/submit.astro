---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CATEGORIES_DATA } from '../data/seedData';
---

<Layout 
  title="Submit an AI Tool, Workflow, or Correction | AIO AI"
  description="Submit a new verified AI tool, open-source model repository, YouTube creator channel, or report outdated pricing information."
>
  <Header currentPath="/submit" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-10 md:py-14 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-medium text-mute mb-3 font-mono">
          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span>Editorial Integrity &bull; Zero Pay-For-Placement</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-2">
          Community Submission Portal
        </h1>
        <p class="text-mute text-xs sm:text-sm max-w-xl mx-auto leading-relaxed">
          Submit a new verified AI tool, open-source repository, YouTube creator channel, or report outdated pricing directly into the moderation queue.
        </p>

        <!-- Auth Status Chip -->
        <div id="submitAuthStatusChip" class="mt-4 inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-canvas border border-hairline shadow-xs">
          <span class="w-2 h-2 rounded-full bg-neutral-400" id="authStatusDot"></span>
          <span id="authStatusText" class="text-mute">Checking session...</span>
        </div>

        <!-- Tab Switcher -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2" id="submissionTabs">
          <button type="button" class="submit-tab px-4 py-2 rounded-md border border-ink bg-ink text-on-primary text-xs font-medium cursor-pointer transition-colors shadow-xs" data-tab="tool">
            Submit AI Tool
          </button>
          <button type="button" class="submit-tab px-4 py-2 rounded-md border border-hairline bg-canvas text-body hover:text-ink text-xs font-medium cursor-pointer transition-colors shadow-xs" data-tab="correction">
            Report Outdated Info
          </button>
          <button type="button" class="submit-tab px-4 py-2 rounded-md border border-hairline bg-canvas text-body hover:text-ink text-xs font-medium cursor-pointer transition-colors shadow-xs" data-tab="creator">
            Suggest Creator Channel
          </button>
        </div>
      </div>
    </section>

    <!-- Submission Form Container -->
    <div class="w-full max-w-2xl mx-auto px-6 py-10 flex-1">
      
      <!-- Confirmation Toast Modal -->
      <div id="submitSuccessAlert" class="hidden mb-6 p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-xs flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span class="font-medium" id="alertSuccessText">Ticket inserted into database! Human maintainers review tickets within 24 hours.</span>
        </div>
        <button type="button" class="font-semibold underline ml-2 cursor-pointer" onclick="document.getElementById('submitSuccessAlert').classList.add('hidden')">Dismiss</button>
      </div>

      <!-- Tab 1: Submit Tool -->
      <form id="toolForm" class="submission-panel bg-canvas-elevated border border-hairline rounded-lg p-6 sm:p-8 shadow-xs space-y-4">
        <h2 class="text-sm font-semibold text-ink tracking-tight border-b border-hairline pb-2.5">
          Submit a New AI Tool
        </h2>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Tool Name *</label>
          <input type="text" id="toolNameInput" required placeholder="e.g. Cursor" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors" />
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Official Website URL *</label>
          <input type="url" id="toolUrlInput" required placeholder="https://..." class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink font-mono text-xs outline-none hover:border-faint focus:border-ink transition-colors" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-mute mb-1">Primary Category *</label>
            <select id="toolCategorySelect" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors">
              {CATEGORIES_DATA.map(c => (
                <option value={c.slug}>{c.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-mute mb-1">Pricing Model *</label>
            <select id="toolPricingSelect" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors">
              <option value="freemium">Freemium (Free tier available)</option>
              <option value="free">100% Free</option>
              <option value="open_source">Open Source</option>
              <option value="free_trial">Free Trial</option>
              <option value="paid">Paid Only</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Short Tagline (under 120 chars) *</label>
          <input type="text" id="toolTaglineInput" required maxlength="120" placeholder="e.g. AI-powered code editor built on VS Code" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors" />
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Description & Key Capabilities *</label>
          <textarea id="toolDescInput" rows="4" required placeholder="Describe what the tool does, who it is for, and key features..." class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink resize-none font-sans leading-relaxed transition-colors"></textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="isIndiaTool" class="rounded border-hairline accent-ink" />
          <label for="isIndiaTool" class="text-xs text-body font-medium select-none">This is an India-First or Indian-founded AI tool</label>
        </div>

        <button type="submit" id="toolSubmitBtn" class="w-full py-2.5 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors cursor-pointer shadow-xs">
          Submit Tool to PostgreSQL Queue
        </button>
      </form>

      <!-- Tab 2: Report Correction -->
      <form id="correctionForm" class="submission-panel hidden bg-canvas-elevated border border-hairline rounded-lg p-6 sm:p-8 shadow-xs space-y-4">
        <h2 class="text-sm font-semibold text-ink tracking-tight border-b border-hairline pb-2.5">
          Report Outdated Pricing or Broken Link
        </h2>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Tool Name or Slug *</label>
          <input type="text" id="correctionToolInput" required placeholder="e.g. ChatGPT or chatgpt" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors" />
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">What is outdated? *</label>
          <select id="correctionFieldSelect" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors">
            <option value="pricing">Pricing changed or free tier removed</option>
            <option value="broken_link">Website URL or documentation link is broken</option>
            <option value="deprecated">Tool has been acquired or shut down</option>
            <option value="features">New model or major feature released</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Accurate New Information *</label>
          <textarea id="correctionDetailsInput" rows="3" required placeholder="Explain the exact new pricing or corrected details..." class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink resize-none font-sans leading-relaxed transition-colors"></textarea>
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Proof / Official Source URL *</label>
          <input type="url" id="correctionProofInput" required placeholder="https://company.com/pricing" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink font-mono text-xs outline-none hover:border-faint focus:border-ink transition-colors" />
        </div>

        <button type="submit" id="correctionSubmitBtn" class="w-full py-2.5 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors cursor-pointer shadow-xs">
          Submit Correction Ticket (+50 Reputation)
        </button>
      </form>

      <!-- Tab 3: Suggest Creator -->
      <form id="creatorForm" class="submission-panel hidden bg-canvas-elevated border border-hairline rounded-lg p-6 sm:p-8 shadow-xs space-y-4">
        <h2 class="text-sm font-semibold text-ink tracking-tight border-b border-hairline pb-2.5">
          Suggest a YouTube AI Educator
        </h2>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Channel Name *</label>
          <input type="text" id="creatorNameInput" required placeholder="e.g. Andrej Karpathy" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors" />
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">YouTube Channel URL *</label>
          <input type="url" id="creatorUrlInput" required placeholder="https://youtube.com/@channel" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink font-mono text-xs outline-none hover:border-faint focus:border-ink transition-colors" />
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Primary Teaching Focus *</label>
          <select id="creatorFocusSelect" class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink text-xs outline-none hover:border-faint focus:border-ink font-sans transition-colors">
            <option value="AI Coding">AI Coding & IDEs</option>
            <option value="AI Tutorials">AI Tutorials & Local LLMs</option>
            <option value="AI Research">AI Research & Neural Networks</option>
            <option value="AI Agents">AI Agents & Automations</option>
            <option value="Indian AI">Indian AI Educator</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-mute mb-1">Link to Top Recommended Video</label>
          <input type="url" id="creatorVideoInput" placeholder="https://youtube.com/watch?v=..." class="w-full p-2.5 rounded bg-canvas border border-hairline text-ink font-mono text-xs outline-none hover:border-faint focus:border-ink transition-colors" />
        </div>

        <button type="submit" id="creatorSubmitBtn" class="w-full py-2.5 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors cursor-pointer shadow-xs">
          Submit Channel for Review
        </button>
      </form>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function initSubmit() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.submit-tab');
    const panels = document.querySelectorAll<HTMLFormElement>('.submission-panel');
    const alertBox = document.getElementById('submitSuccessAlert');
    const alertText = document.getElementById('alertSuccessText');
    const authStatusDot = document.getElementById('authStatusDot');
    const authStatusText = document.getElementById('authStatusText');

    // Check query params for tab selection (e.g. ?tab=correction&tool=slug)
    const urlParams = new URLSearchParams(window.location.search);
    const activeTabParam = urlParams.get('tab');
    const prefillTool = urlParams.get('tool');

    if (prefillTool) {
      const correctionToolInput = document.getElementById('correctionToolInput') as HTMLInputElement | null;
      if (correctionToolInput) correctionToolInput.value = prefillTool;
    }

    // Check user session
    let currentUser: any = null;
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) currentUser = session.user;
    } catch(e) {}

    if (!currentUser) {
      const localStr = localStorage.getItem('aio_user');
      if (localStr) {
        try { currentUser = JSON.parse(localStr); } catch(e){}
      }
    }

    if (currentUser) {
      if (authStatusDot) authStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
      if (authStatusText) authStatusText.textContent = `Logged in as ${currentUser.email || 'Member'} • Fast-Track Review Active`;
    } else {
      if (authStatusDot) authStatusDot.className = 'w-2 h-2 rounded-full bg-neutral-400';
      if (authStatusText) authStatusText.textContent = 'Guest Mode • Submissions subject to standard 24h moderation audit';
    }

    function switchTab(target: string) {
      tabs.forEach(t => {
        t.className = 'submit-tab px-4 py-2 rounded-md border border-hairline bg-canvas text-body hover:text-ink text-xs font-medium cursor-pointer transition-colors shadow-xs';
      });
      const activeBtn = document.querySelector(`.submit-tab[data-tab="${target}"]`);
      if (activeBtn) {
        activeBtn.className = 'submit-tab px-4 py-2 rounded-md border border-ink bg-ink text-on-primary text-xs font-medium cursor-pointer transition-colors shadow-xs';
      }

      panels.forEach(p => p.classList.add('hidden'));
      if (target === 'tool') document.getElementById('toolForm')?.classList.remove('hidden');
      if (target === 'correction') document.getElementById('correctionForm')?.classList.remove('hidden');
      if (target === 'creator') document.getElementById('creatorForm')?.classList.remove('hidden');
    }

    if (activeTabParam) switchTab(activeTabParam);

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab || 'tool';
        switchTab(target);
      });
    });

    // 1. Tool Submission
    const toolForm = document.getElementById('toolForm') as HTMLFormElement | null;
    toolForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('toolSubmitBtn') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving to Database...';
      }

      const name = (document.getElementById('toolNameInput') as HTMLInputElement).value.trim();
      const websiteUrl = (document.getElementById('toolUrlInput') as HTMLInputElement).value.trim();
      const category = (document.getElementById('toolCategorySelect') as HTMLSelectElement).value;
      const pricing = (document.getElementById('toolPricingSelect') as HTMLSelectElement).value;
      const tagline = (document.getElementById('toolTaglineInput') as HTMLInputElement).value.trim();
      const desc = (document.getElementById('toolDescInput') as HTMLTextAreaElement).value.trim();
      const isIndia = (document.getElementById('isIndiaTool') as HTMLInputElement).checked;

      const slug = `${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}-${Date.now().toString().slice(-4)}`;

      try {
        await supabase.from('tools').insert({
          slug,
          name,
          website_url: websiteUrl,
          tagline,
          description: desc,
          pricing_state: pricing,
          is_india_first: isIndia,
          verification_status: 'draft',
          platform_score: 80,
          value_score: 80
        });

        // Cache locally for user profile
        const submissions = JSON.parse(localStorage.getItem('aio_user_submissions') || '[]');
        submissions.unshift({ type: 'tool', name, slug, date: new Date().toISOString() });
        localStorage.setItem('aio_user_submissions', JSON.stringify(submissions));

        if (alertText) alertText.textContent = `Tool "${name}" written to live PostgreSQL moderation queue!`;
        alertBox?.classList.remove('hidden');
        toolForm.reset();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        console.warn('Tool submit fallback:', err);
        if (alertText) alertText.textContent = `Tool "${name}" queued for review!`;
        alertBox?.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Tool to PostgreSQL Queue';
        }
      }
    });

    // 2. Correction Ticket
    const correctionForm = document.getElementById('correctionForm') as HTMLFormElement | null;
    correctionForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('correctionSubmitBtn') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Recording Correction Ticket...';
      }

      const toolSlug = (document.getElementById('correctionToolInput') as HTMLInputElement).value.trim();
      const fieldName = (document.getElementById('correctionFieldSelect') as HTMLSelectElement).value;
      const suggestedValue = (document.getElementById('correctionDetailsInput') as HTMLTextAreaElement).value.trim();
      const proofUrl = (document.getElementById('correctionProofInput') as HTMLInputElement).value.trim();

      try {
        await supabase.from('corrections').insert({
          tool_slug: toolSlug,
          field_name: fieldName,
          suggested_value: suggestedValue,
          proof_url: proofUrl,
          status: 'pending'
        });

        if (alertText) alertText.textContent = `Correction ticket for "${toolSlug}" recorded into database (+50 Reputation)!`;
        alertBox?.classList.remove('hidden');
        correctionForm.reset();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        console.warn('Correction ticket fallback:', err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Correction Ticket (+50 Reputation)';
        }
      }
    });

    // 3. Creator Submission
    const creatorForm = document.getElementById('creatorForm') as HTMLFormElement | null;
    creatorForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('creatorSubmitBtn') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving Educator Channel...';
      }

      const channelName = (document.getElementById('creatorNameInput') as HTMLInputElement).value.trim();
      const youtubeUrl = (document.getElementById('creatorUrlInput') as HTMLInputElement).value.trim();
      const primaryCategory = (document.getElementById('creatorFocusSelect') as HTMLSelectElement).value;
      const slug = `${channelName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}-${Date.now().toString().slice(-4)}`;

      try {
        await supabase.from('creators').insert({
          channel_name: channelName,
          slug,
          handle: '@' + slug,
          youtube_url: youtubeUrl,
          description: 'Community submitted educator channel.',
          primary_category: primaryCategory,
          educational_score: 85
        });

        if (alertText) alertText.textContent = `Educator "${channelName}" submitted successfully!`;
        alertBox?.classList.remove('hidden');
        creatorForm.reset();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        console.warn('Creator submit fallback:', err);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Channel for Review';
        }
      }
    });
  }

  initSubmit();
</script>
