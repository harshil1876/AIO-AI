---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CATEGORIES_DATA } from '../data/seedData';
---

<Layout 
  title="Submit an AI Tool, Workflow, or Correction | AIO AI"
  description="Submit a new verified AI tool, open-source model repository, YouTube creator channel, or report outdated pricing information."
>
  <Header currentPath="/submit" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-surface px-6 py-12 md:py-16 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-blue-200 bg-blue-50 text-xs font-semibold text-primary mb-4 font-mono">
          <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span>EDITORIAL INTEGRITY • ZERO PAY-FOR-PLACEMENT</span>
        </div>

        <h1 class="text-3xl md:text-5xl font-black text-ink tracking-tight mb-4">
          Community Submission Portal
        </h1>
        <p class="text-neutral-600 text-sm md:text-base max-w-xl mx-auto leading-relaxed">
          Submit a new verified AI tool, open-source repository, YouTube creator channel, or report outdated pricing. All submissions are reviewed by human maintainers.
        </p>

        <!-- Auth Status Chip -->
        <div id="submitAuthStatusChip" class="mt-4 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono bg-white border border-[#E2E8F0] shadow-xs">
          <span class="w-2 h-2 rounded-full bg-neutral-400" id="authStatusDot"></span>
          <span id="authStatusText" class="text-neutral-600">Checking session...</span>
        </div>

        <!-- Tab Switcher -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2" id="submissionTabs">
          <button class="submit-tab px-5 py-2 rounded-xl border border-ink bg-ink text-white text-xs font-bold cursor-pointer transition-colors shadow-xs" data-tab="tool">
            Submit AI Tool
          </button>
          <button class="submit-tab px-5 py-2 rounded-xl border border-[#E2E8F0] bg-white text-neutral-600 hover:text-ink text-xs font-semibold cursor-pointer transition-colors shadow-xs" data-tab="correction">
            Report Outdated Info
          </button>
          <button class="submit-tab px-5 py-2 rounded-xl border border-[#E2E8F0] bg-white text-neutral-600 hover:text-ink text-xs font-semibold cursor-pointer transition-colors shadow-xs" data-tab="creator">
            Suggest Creator Channel
          </button>
        </div>
      </div>
    </section>

    <!-- Submission Form Container -->
    <div class="w-full max-w-2xl mx-auto px-6 py-12 flex-1">
      
      <!-- Confirmation Toast Modal -->
      <div id="submitSuccessAlert" class="hidden mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span class="font-medium">Submission received successfully! Our editorial team reviews tickets within 24 hours.</span>
        </div>
        <button type="button" class="font-bold underline ml-2 cursor-pointer" onclick="document.getElementById('submitSuccessAlert').classList.add('hidden')">Dismiss</button>
      </div>

      <!-- Tab 1: Submit Tool -->
      <form id="toolForm" class="submission-panel bg-white border border-[#E2E8F0] rounded-2xl p-6 md:p-8 shadow-xs space-y-5">
        <h2 class="text-base font-bold text-ink tracking-tight border-b border-[#E2E8F0] pb-3">
          Submit a New AI Tool
        </h2>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Tool Name *</label>
          <input type="text" required placeholder="e.g. Cursor" class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none focus:border-primary font-sans" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Official Website URL *</label>
          <input type="url" required placeholder="https://..." class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink font-mono focus:outline-none focus:border-primary" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-ink mb-1.5">Primary Category *</label>
            <select class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none font-sans">
              {CATEGORIES_DATA.map(c => (
                <option value={c.slug}>{c.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-ink mb-1.5">Pricing Model *</label>
            <select class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none font-sans">
              <option value="freemium">Freemium (Free tier available)</option>
              <option value="free">100% Free</option>
              <option value="open_source">Open Source</option>
              <option value="free_trial">Free Trial (Card required)</option>
              <option value="paid">Paid Only</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Short Tagline (under 120 chars) *</label>
          <input type="text" required maxlength="120" placeholder="e.g. AI-powered code editor built on VS Code" class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none focus:border-primary font-sans" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Description & Key Capabilities *</label>
          <textarea rows="4" required placeholder="Describe what the tool does, who it is for, and why it is significant..." class="w-full p-3 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none focus:border-primary resize-none font-sans leading-relaxed"></textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="isIndiaTool" class="rounded border-[#E2E8F0] accent-primary" />
          <label for="isIndiaTool" class="text-xs text-neutral-700 font-medium">This is an India-First or Indian-founded AI tool</label>
        </div>

        <button type="submit" class="w-full py-3 rounded-xl bg-primary text-white hover:bg-blue-700 text-xs font-bold transition-colors cursor-pointer shadow-xs">
          Submit Tool for Editorial Review
        </button>
      </form>

      <!-- Tab 2: Report Correction -->
      <form id="correctionForm" class="submission-panel hidden bg-white border border-[#E2E8F0] rounded-2xl p-6 md:p-8 shadow-xs space-y-5">
        <h2 class="text-base font-bold text-ink tracking-tight border-b border-[#E2E8F0] pb-3">
          Report Outdated Pricing or Broken Link
        </h2>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Tool Name or Slug *</label>
          <input type="text" required placeholder="e.g. ChatGPT or /tools/chatgpt" class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none focus:border-primary font-sans" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">What is outdated? *</label>
          <select class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none font-sans">
            <option value="pricing">Pricing changed or free tier removed</option>
            <option value="broken_link">Website URL or documentation link is broken</option>
            <option value="deprecated">Tool has been acquired or shut down</option>
            <option value="features">New model or major feature released</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Accurate New Information *</label>
          <textarea rows="3" required placeholder="Explain the exact new pricing or corrected details..." class="w-full p-3 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none focus:border-primary resize-none font-sans leading-relaxed"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Proof / Official Source URL *</label>
          <input type="url" required placeholder="https://company.com/pricing" class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink font-mono focus:outline-none focus:border-primary" />
        </div>

        <button type="submit" class="w-full py-3 rounded-xl bg-primary text-white hover:bg-blue-700 text-xs font-bold transition-colors cursor-pointer shadow-xs">
          Submit Correction Ticket (+50 Reputation)
        </button>
      </form>

      <!-- Tab 3: Suggest Creator -->
      <form id="creatorForm" class="submission-panel hidden bg-white border border-[#E2E8F0] rounded-2xl p-6 md:p-8 shadow-xs space-y-5">
        <h2 class="text-base font-bold text-ink tracking-tight border-b border-[#E2E8F0] pb-3">
          Suggest a YouTube AI Educator
        </h2>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Channel Name *</label>
          <input type="text" required placeholder="e.g. Andrej Karpathy" class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none focus:border-primary font-sans" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">YouTube Channel URL *</label>
          <input type="url" required placeholder="https://youtube.com/@channel" class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink font-mono focus:outline-none focus:border-primary" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Primary Teaching Focus *</label>
          <select class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink focus:outline-none font-sans">
            <option value="AI Coding">AI Coding & IDEs</option>
            <option value="AI Tutorials">AI Tutorials & Local LLMs</option>
            <option value="AI Research">AI Research & Neural Networks</option>
            <option value="AI Agents">AI Agents & Automations</option>
            <option value="Indian AI">Indian AI Educator</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink mb-1.5">Link to Top Recommended Video</label>
          <input type="url" placeholder="https://youtube.com/watch?v=..." class="w-full p-2.5 rounded-lg text-xs bg-surface border border-[#E2E8F0] text-ink font-mono focus:outline-none focus:border-primary" />
        </div>

        <button type="submit" class="w-full py-3 rounded-xl bg-primary text-white hover:bg-blue-700 text-xs font-bold transition-colors cursor-pointer shadow-xs">
          Submit Channel for Review
        </button>
      </form>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function initSubmit() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.submit-tab');
    const panels = document.querySelectorAll<HTMLFormElement>('.submission-panel');
    const alertBox = document.getElementById('submitSuccessAlert');
    const authStatusDot = document.getElementById('authStatusDot');
    const authStatusText = document.getElementById('authStatusText');

    // Check user session
    let currentUser: any = null;
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) currentUser = session.user;
    } catch(e) {}

    if (!currentUser) {
      const localStr = localStorage.getItem('aio_user');
      if (localStr) {
        try { currentUser = JSON.parse(localStr); } catch(e){}
      }
    }

    if (currentUser) {
      if (authStatusDot) {
        authStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
      }
      if (authStatusText) {
        authStatusText.textContent = `Logged in as ${currentUser.email || 'Member'} • Fast-Track Review Active`;
      }
    } else {
      if (authStatusDot) {
        authStatusDot.className = 'w-2 h-2 rounded-full bg-amber-500';
      }
      if (authStatusText) {
        authStatusText.textContent = 'Guest Mode • Submissions subject to standard 24h editorial audit';
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('border-ink', 'bg-ink', 'text-white', 'font-bold');
          t.classList.add('border-[#E2E8F0]', 'bg-white', 'text-neutral-600', 'font-semibold');
        });
        tab.classList.add('border-ink', 'bg-ink', 'text-white', 'font-bold');
        tab.classList.remove('border-[#E2E8F0]', 'bg-white', 'text-neutral-600', 'font-semibold');

        const target = tab.dataset.tab;
        panels.forEach(p => p.classList.add('hidden'));

        if (target === 'tool') document.getElementById('toolForm')?.classList.remove('hidden');
        if (target === 'correction') document.getElementById('correctionForm')?.classList.remove('hidden');
        if (target === 'creator') document.getElementById('creatorForm')?.classList.remove('hidden');
      });
    });

    panels.forEach(form => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.reset();
        alertBox?.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  initSubmit();
</script>
