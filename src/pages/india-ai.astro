---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolLogo from '../components/ToolLogo.astro';
import { TOOLS_DATA } from '../data/seedData';
import { calculateAuthenticScore } from '../services/dataService';

const indianTools = TOOLS_DATA.filter(t => t.isIndianAI).map(tool => {
  const scorecard = calculateAuthenticScore(tool);
  
  // Custom sovereign metadata map
  const meta: Record<string, { hq: string; languages: string[]; capability: string; inrPricing: string; freeTier: string }> = {
    'sarvam-ai': {
      hq: 'Bengaluru',
      languages: ['Hindi', 'Tamil', 'Telugu', 'Kannada', 'Malayalam', 'Bengali', 'Marathi', 'Gujarati', 'Punjabi', 'Odia', 'Hinglish'],
      capability: 'Indic Voice ASR / TTS & Sovereign LLM (Sarvam-2B)',
      inrPricing: '₹0.15 / 1K chars TTS',
      freeTier: '100K API tokens / month free'
    },
    'krutrim': {
      hq: 'Bengaluru',
      languages: ['Hindi', 'Tamil', 'Telugu', 'Kannada', 'Marathi', 'Bengali', 'Gujarati', 'English'],
      capability: 'Sovereign Cloud & Multilingual Foundation LLM',
      inrPricing: '₹12 / 1M tokens',
      freeTier: '₹500 free cloud compute credits'
    },
    'bhashini': {
      hq: 'New Delhi',
      languages: ['All 22 Scheduled Indian Languages'],
      capability: 'National Public Digital AI Infrastructure (MeitY)',
      inrPricing: '₹0 (100% Free Public Good)',
      freeTier: 'Open Public API for Indian citizens & developers'
    },
    'karya': {
      hq: 'Bengaluru',
      languages: ['Hindi', 'Marathi', 'Bhojpuri', 'Telugu', 'Kannada', 'Tamil'],
      capability: 'Ethical High-Quality Indic Speech Dataset Crowdsourcing',
      inrPricing: 'Custom enterprise dataset licensing',
      freeTier: 'Open research benchmarks'
    },
    'qure-ai': {
      hq: 'Mumbai',
      languages: ['English', 'Hindi'],
      capability: 'Healthcare AI (Chest X-Ray & Brain CT Diagnostic Interpretation)',
      inrPricing: '₹80 per automated scan report',
      freeTier: 'Pilot deployment sandbox for clinics'
    },
    'gnani-ai': {
      hq: 'Bengaluru',
      languages: ['Hindi', 'Tamil', 'Telugu', 'Kannada', 'Malayalam', 'Marathi', 'Gujarati', 'Bengali'],
      capability: 'Conversational Voice Automation & Indic Speech Biometrics',
      inrPricing: '₹1.50 per customer minute',
      freeTier: '14-day voice bot evaluation sandbox'
    },
    'reverie': {
      hq: 'Bengaluru',
      languages: ['All 22 Indian Languages'],
      capability: 'Indic Localization, Neural Machine Translation & Voice Bots',
      inrPricing: '₹0.20 per translated word',
      freeTier: 'Free developer translation SDK quota'
    },
    'yellow-ai': {
      hq: 'Bengaluru / San Mateo',
      languages: ['Hindi', 'Tamil', 'Telugu', 'Kannada', 'Bengali', 'Marathi', 'English'],
      capability: 'Enterprise Autonomous Dynamic AI Agent Cloud',
      inrPricing: '₹3,500 / month starter plan',
      freeTier: '21-day enterprise trial sandbox'
    },
    'haptik': {
      hq: 'Mumbai',
      languages: ['Hindi', 'Hinglish', 'Tamil', 'Telugu', 'Gujarati', 'Marathi'],
      capability: 'WhatsApp Conversational Commerce & Customer Support Bots',
      inrPricing: '₹0.40 per WhatsApp session message',
      freeTier: 'Self-serve developer sandbox'
    },
    'neysa': {
      hq: 'Mumbai',
      languages: ['English'],
      capability: 'AI Acceleration Cloud & Sovereign GPU Compute Infrastructure',
      inrPricing: '₹180 / GPU-hour (Nvidia H100)',
      freeTier: '₹2,000 launch GPU compute credit'
    },
    'corover': {
      hq: 'Bengaluru / New Delhi',
      languages: ['14+ Indian Languages & Voice Modalities'],
      capability: 'BharatGPT Sovereign Conversational Virtual Assistant for IRCTC',
      inrPricing: 'Enterprise deployment model',
      freeTier: 'Free web demo chatbot'
    },
    'wadhwani-ai': {
      hq: 'Mumbai',
      languages: ['Hindi', 'Marathi', 'Telugu', 'Kannada', 'Tamil'],
      capability: 'AI for Social Good (AgriTech Pest Management, TB Screening)',
      inrPricing: '₹0 (Philanthropic / Public Good)',
      freeTier: '100% Free for public health & agriculture'
    },
    'kissan-ai': {
      hq: 'Bengaluru',
      languages: ['Hindi', 'Gujarati', 'Marathi', 'Tamil', 'Telugu', 'Punjabi', 'Kannada'],
      capability: 'Dhenu Indic Agri-Voice Assistant for Rural Farmers',
      inrPricing: '₹0 for individual farmers',
      freeTier: 'Unlimited farmer advisory queries'
    },
    'invideo-ai': {
      hq: 'Mumbai',
      languages: ['50+ Global & Indian Languages'],
      capability: 'Text-to-Video Generator with Voiceover & Script Automation',
      inrPricing: '₹1,650 / month (Paid Plans)',
      freeTier: '10 mins / week free with watermark'
    },
    'vidyo-ai': {
      hq: 'Bengaluru',
      languages: ['English', 'Hindi', 'Tamil', 'Spanish'],
      capability: 'Long-form Video to Viral Shorts & Reels Repurposing',
      inrPricing: '₹1,200 / month (Pro Plans)',
      freeTier: '75 minutes processing / month free'
    },
    'writesonic': {
      hq: 'Delhi NCR',
      languages: ['25+ Languages including Hindi'],
      capability: 'SEO Content Generator, Chatsonic & Voice-Trained Agents',
      inrPricing: '₹1,100 / month',
      freeTier: '10,000 words free tier monthly'
    }
  };

  const resolved = meta[tool.slug] || {
    hq: 'India',
    languages: ['English', 'Hindi', 'Regional Languages'],
    capability: 'Sovereign Indic AI Innovation',
    inrPricing: 'Self-serve INR pricing available',
    freeTier: 'Free tier available'
  };

  return {
    ...tool,
    scorecard,
    sovereign: resolved
  };
});
---

<Layout 
  title="India-First Sovereign AI Hub | AIO AI"
  description="Curated index of 16+ verified Indian AI innovators building sovereign models, Indic voice infrastructure, public digital goods, and enterprise agents."
>
  <Header currentPath="/india-ai" />

  <!-- Top Secondary Sub-Navigation Tabs -->
  <div class="bg-white border-b border-[#E2E8F0] px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex items-center gap-1 overflow-x-auto text-xs py-2 scrollbar-none">
      <a href="/tools" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        All 113 Tools
      </a>
      <a href="/categories" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        Categories Leaderboard
      </a>
      <a href="/india-ai" class="px-3 py-1.5 rounded-lg bg-[#EFF6FF] text-[#2563EB] font-bold shrink-0">
        India-First AI
      </a>
      <a href="/compare" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-[#09090B] hover:bg-slate-50 font-medium shrink-0">
        Side-by-Side Compare
      </a>
    </div>
  </div>

  <main class="w-full flex flex-col min-h-screen bg-[#F8FAFF]">
    
    <!-- Hero Banner -->
    <section class="border-b border-[#E2E8F0] bg-white px-4 sm:px-6 py-8 sm:py-12">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            <span class="text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-orange-50 text-orange-700 border border-orange-200 uppercase flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-orange-500"></span>
              <span>16 Sovereign Innovators</span>
            </span>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold">
              Data Sovereignty Verified
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-[#09090B] tracking-tight mb-2">
            India-First Sovereign AI Catalog
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 max-w-2xl leading-relaxed">
            From Indic speech foundational models and digital public goods to sovereign cloud GPUs and farmer voice assistants — discover the cutting-edge AI technologies built in India for 1.4 billion people.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 text-xs">
          <a href="/tools" class="px-4 py-2.5 rounded-xl border border-[#E2E8F0] bg-white text-slate-700 hover:text-[#09090B] font-bold transition-all shadow-xs">
            All 113 Tools &rarr;
          </a>
          <a href="/submit" class="px-4 py-2.5 rounded-xl bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-bold transition-all shadow-xs">
            + Submit Indian AI Tool
          </a>
        </div>
      </div>
    </section>

    <!-- Grid of Sovereign AI Cards -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
      
      <!-- Quick Filter Bar -->
      <div class="mb-6 flex items-center justify-between gap-4 flex-wrap bg-white border border-[#E2E8F0] p-4 rounded-2xl shadow-xs">
        <div class="flex items-center gap-2 text-xs">
          <span class="font-bold text-[#09090B]">HQ Hubs:</span>
          <span class="px-2 py-0.5 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] text-slate-600 font-mono text-[11px]">Bengaluru (8)</span>
          <span class="px-2 py-0.5 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] text-slate-600 font-mono text-[11px]">Mumbai (4)</span>
          <span class="px-2 py-0.5 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] text-slate-600 font-mono text-[11px]">New Delhi (3)</span>
        </div>
        <div class="text-xs font-mono text-slate-400">
          Showing 16 Verified Sovereign Solutions
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {indianTools.map(tool => (
          <div class="bg-white border border-[#E2E8F0] hover:border-[#2563EB] rounded-2xl p-6 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <!-- Top Row: Logo, Name, Hub & Score -->
              <div class="flex items-start justify-between gap-3 mb-3">
                <div class="flex items-center gap-3 min-w-0">
                  <ToolLogo websiteUrl={tool.websiteUrl} name={tool.name} size="md" />
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <a href={`/tools/${tool.slug}`} class="font-bold text-base text-[#09090B] hover:text-[#2563EB] transition-colors truncate">
                        {tool.name}
                      </a>
                      <span class="text-[10px] font-mono font-bold px-2 py-0.2 rounded-full bg-slate-100 text-slate-700">
                        📍 {tool.sovereign.hq}
                      </span>
                    </div>
                    <span class="text-[11px] text-slate-500 font-mono block truncate mt-0.5">
                      {tool.tagline}
                    </span>
                  </div>
                </div>

                <div class="flex flex-col items-end shrink-0">
                  <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                    Score: {tool.scorecard.total}/100
                  </span>
                  <span class="text-[10px] font-mono text-slate-400 mt-1">{tool.pricingType}</span>
                </div>
              </div>

              <!-- Sovereign Capability Highlight Box -->
              <div class="p-3 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] mb-3 text-xs">
                <div class="font-bold text-[#09090B] flex items-center gap-1.5 mb-1">
                  <span class="text-[#2563EB]">🇮🇳</span>
                  <span>Sovereign Capability:</span>
                </div>
                <div class="text-slate-700 font-medium">
                  {tool.sovereign.capability}
                </div>
              </div>

              <!-- Economics & Free Quotas Callout -->
              <div class="grid grid-cols-2 gap-2 mb-3 text-[11px]">
                <div class="p-2.5 rounded-lg border border-[#E2E8F0] bg-white">
                  <span class="text-[10px] font-mono uppercase font-bold text-slate-400 block">Native Pricing</span>
                  <span class="font-bold text-[#09090B] font-mono">{tool.sovereign.inrPricing}</span>
                </div>
                <div class="p-2.5 rounded-lg border border-emerald-200 bg-emerald-50/50">
                  <span class="text-[10px] font-mono uppercase font-bold text-emerald-700 block">Free Tier / Quota</span>
                  <span class="font-bold text-emerald-900 font-mono">{tool.sovereign.freeTier}</span>
                </div>
              </div>

              <!-- Supported Indian Languages -->
              <div class="mb-4">
                <span class="text-[10px] font-mono uppercase font-bold text-slate-400 block mb-1.5">Supported Indic Languages</span>
                <div class="flex items-center gap-1 flex-wrap">
                  {tool.sovereign.languages.slice(0, 6).map(lang => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                      {lang}
                    </span>
                  ))}
                  {tool.sovereign.languages.length > 6 && (
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-full bg-blue-50 text-[#2563EB] font-bold">
                      +{tool.sovereign.languages.length - 6} more
                    </span>
                  )}
                </div>
              </div>
            </div>

            <!-- Card Bottom Actions -->
            <div class="pt-3 border-t border-[#E2E8F0] flex items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  onclick={`window.addToCompare && window.addToCompare('${tool.slug}', '${tool.name}', '${tool.websiteUrl}')`}
                  class="tool-compare-btn text-[11px] font-bold px-2 py-1 rounded-lg border border-[#E2E8F0] bg-white text-slate-700 hover:border-[#2563EB] hover:text-[#2563EB] transition-colors cursor-pointer shadow-2xs"
                  data-tool-slug={tool.slug}
                >
                  + Compare
                </button>
                <button
                  type="button"
                  onclick={`window.toggleToolBookmark && window.toggleToolBookmark('${tool.slug}')`}
                  class="tool-bookmark-btn p-1.5 rounded-lg border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-blue-50 text-slate-600 hover:text-[#2563EB] transition-colors cursor-pointer"
                  data-tool-slug={tool.slug}
                  title="Pin to Workspace"
                >
                  📌
                </button>
              </div>

              <div class="flex items-center gap-2">
                <a href={`/tools/${tool.slug}`} class="text-slate-700 hover:text-[#09090B] font-semibold px-2.5 py-1 rounded-lg hover:bg-slate-100 transition-colors">
                  Details
                </a>
                <a 
                  href={tool.websiteUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1 rounded-lg bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-bold transition-all shadow-xs"
                >
                  Visit Portal ↗
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
