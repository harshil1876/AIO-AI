---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { NEWS_STORIES, type NewsStory } from '../../data/newsData';
import { TOOLS_DATA } from '../../data/seedData';

export function getStaticPaths() {
  return NEWS_STORIES.map((story) => ({
    params: { slug: story.id },
    props: { story }
  }));
}

interface Props {
  story: NewsStory;
}

const { story } = Astro.props;

// Find connected tools
const connectedTools = TOOLS_DATA.filter(t => 
  story.relatedEntities.some(e => e.toLowerCase() === t.name.toLowerCase() || e.toLowerCase() === t.slug.toLowerCase())
);
---

<Layout 
  title={`${story.title} | AI Discovery News`}
  description={story.summary}
>
  <Header currentPath="/news" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <div class="max-w-4xl w-full mx-auto px-6 pt-8 pb-4">
      <a 
        href="/news" 
        class="inline-flex items-center gap-1.5 text-xs text-mute hover:text-ink transition-colors font-medium group"
      >
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span>Back to All News</span>
      </a>
    </div>

    <article class="max-w-4xl w-full mx-auto px-6 pb-16 flex-1">
      <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-10 shadow-xs mb-8">
        <div class="flex items-center gap-2 text-xs text-mute mb-4">
          <span class="px-2.5 py-0.5 rounded font-mono bg-hairline-soft text-ink text-[11px] font-medium">
            {story.category}
          </span>
          <span>&bull;</span>
          <span>{story.publishedDate}</span>
          <span>&bull;</span>
          <span>Reported by {story.source}</span>
        </div>

        <h1 class="text-2xl md:text-4xl font-semibold text-ink tracking-tight mb-6 leading-tight" style="letter-spacing: -0.8px;">
          {story.title}
        </h1>

        <div class="prose text-sm md:text-base text-body leading-relaxed space-y-4 mb-8">
          <p>{story.summary}</p>
        </div>

        <div class="p-5 rounded-lg border border-hairline bg-canvas mb-8">
          <span class="text-xs font-semibold text-ink uppercase tracking-wider block mb-1.5">
            Why This Breakthrough Matters
          </span>
          <p class="text-xs md:text-sm text-body leading-relaxed">
            {story.whyItMatters}
          </p>
        </div>

        <div class="pt-6 border-t border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs text-mute">Connected Entities:</span>
            {story.relatedEntities.map(e => (
              <span class="px-2 py-0.5 rounded text-xs font-mono bg-hairline-soft text-ink">{e}</span>
            ))}
          </div>

          <a 
            href={story.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors self-start sm:self-auto shadow-xs"
          >
            <span>Read Primary Source on {story.source}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Mentioned Tools in this Story -->
      {connectedTools.length > 0 && (
        <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
          <h2 class="text-sm font-semibold text-ink tracking-tight mb-3">Mentioned AI Tools in Directory</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {connectedTools.map((tool) => (
              <a 
                href={`/tools/${tool.slug}`}
                class="p-3.5 rounded border border-hairline hover:border-faint transition-colors flex items-center justify-between group"
              >
                <div>
                  <h3 class="text-xs font-semibold text-ink group-hover:underline">{tool.name}</h3>
                  <p class="text-[11px] text-mute truncate max-w-[200px]">{tool.tagline}</p>
                </div>
                <span class="text-[10px] text-mute font-mono px-2 py-0.5 rounded bg-hairline-soft">
                  {tool.pricingType}
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>

  <Footer />
</Layout>
