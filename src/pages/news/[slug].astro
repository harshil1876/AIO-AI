---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { NEWS_STORIES, type NewsStory } from '../../data/newsData';
import { TOOLS_DATA } from '../../data/seedData';
import { OPEN_SOURCE_REPOS } from '../../data/openSourceData';
import { CREATORS_DATA } from '../../data/creatorsData';

export function getStaticPaths() {
  const paths = [];
  const seen = new Set<string>();

  for (const story of NEWS_STORIES) {
    const slug = story.slug || story.id;
    if (!seen.has(slug)) {
      seen.add(slug);
      paths.push({
        params: { slug },
        props: { story }
      });
    }
    if (story.id && story.id !== slug && !seen.has(story.id)) {
      seen.add(story.id);
      paths.push({
        params: { slug: story.id },
        props: { story }
      });
    }
  }

  return paths;
}

interface Props {
  story: NewsStory;
}

const { story } = Astro.props;

// Connected tools from seedData
const connectedTools = TOOLS_DATA.filter(t => 
  story.relatedToolSlugs?.includes(t.slug) || 
  story.relatedEntities?.some(e => e.toLowerCase() === t.name.toLowerCase() || e.toLowerCase() === t.slug.toLowerCase())
);

// Connected repos
const connectedRepos = OPEN_SOURCE_REPOS.filter(r => 
  story.relatedRepoSlugs?.includes(r.slug)
);

// Connected creators
const connectedCreators = CREATORS_DATA.filter(c => 
  story.relatedCreatorSlugs?.includes(c.slug)
);
---

<Layout 
  title={`${story.headline} | The AIO AI Gazette`}
  description={story.summary}
>
  <Header currentPath="/news" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Breadcrumb -->
    <div class="max-w-4xl w-full mx-auto px-4 sm:px-6 pt-8 pb-4">
      <a 
        href="/news" 
        class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-slate-600 hover:text-[#2563EB] transition-colors group"
      >
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span>&larr; BACK TO ALL NEWS</span>
      </a>
    </div>

    <!-- Article Content in Neo-Brutalist Layout -->
    <article class="max-w-4xl w-full mx-auto px-4 sm:px-6 pb-16 flex-1">
      <div class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-10 shadow-[6px_6px_0px_0px_#09090B] mb-10">
        
        <!-- Metadata Header -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono mb-4 pb-4 border-b border-[#E2E8F0]">
          <span class="bg-[#2563EB] text-white border border-[#09090B] font-bold px-2.5 py-0.5 rounded-xs shadow-[2px_2px_0px_0px_#09090B]">
            {story.topic}
          </span>
          <div class="flex items-center gap-3 text-slate-500">
            <span>{story.publishedAt}</span>
            <span>&bull;</span>
            <span>{story.readingTime}</span>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-ink tracking-tight mb-6 leading-tight">
          {story.headline}
        </h1>

        <!-- 30-Second Executive TL;DR Box -->
        <div class="p-4 rounded-xl bg-amber-50 border-2 border-[#09090B] shadow-[3px_3px_0px_0px_#09090B] mb-6">
          <div class="text-[10px] font-mono uppercase font-bold text-amber-900 tracking-wider mb-1 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>30-Second Executive TL;DR</span>
          </div>
          <p class="text-xs sm:text-sm font-semibold text-amber-950 leading-relaxed">
            {story.summary}
          </p>
        </div>

        <!-- Deep Technical Breakdown -->
        <div class="space-y-4 text-sm sm:text-base text-slate-800 leading-relaxed font-normal mb-8 pb-6 border-b border-[#E2E8F0]">
          <p>{story.summary}</p>
          <p>
            This announcement marks a critical inflection point in autonomous reasoning and enterprise throughput. Across internal evaluations and community latency benchmarks, the system introduces verifiable improvements over legacy foundation baselines.
          </p>
        </div>

        <!-- Key Takeaways -->
        {story.keyTakeaways && story.keyTakeaways.length > 0 && (
          <div class="mb-8">
            <h3 class="text-xs font-mono uppercase font-bold text-[#2563EB] tracking-wider mb-3">
              Key Architectural Takeaways:
            </h3>
            <div class="p-4 rounded-xl bg-[#F8FAFF] border-2 border-[#09090B] shadow-[3px_3px_0px_0px_#09090B]">
              <ul class="space-y-2 text-sm text-slate-700 list-disc list-inside">
                {story.keyTakeaways.map(takeaway => (
                  <li class="leading-relaxed">{takeaway}</li>
                ))}
              </ul>
            </div>
          </div>
        )}

        <!-- Why It Matters Neo-Brutalist Callout -->
        <div class="p-5 rounded-xl bg-[#EFF6FF] border-2 border-[#09090B] shadow-[4px_4px_0px_0px_#2563EB] mb-8">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-3 h-3 bg-[#2563EB]"></span>
            <h3 class="text-xs font-mono uppercase font-bold text-ink tracking-wider">
              Strategic Significance & Why It Matters:
            </h3>
          </div>
          <p class="text-sm text-slate-800 leading-relaxed font-medium">
            {story.whyItMatters}
          </p>
        </div>

        <!-- Technical Details & Specifications -->
        {story.technicalDetails && (
          <div class="mb-8">
            <h3 class="text-xs font-mono uppercase font-bold text-slate-600 tracking-wider mb-2">
              Technical Specifications & Pricing Details:
            </h3>
            <div class="p-4 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] font-mono text-xs text-slate-700 leading-relaxed">
              {story.technicalDetails}
            </div>
          </div>
        )}

        <!-- Official Citation & Source -->
        <div class="pt-6 border-t-2 border-[#09090B] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="text-xs font-mono text-slate-600">
            Reported by <strong class="text-ink font-bold">{story.sourceName}</strong> &bull; Verified by AIO AI
          </div>
          <a 
            href={story.sourceUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-[#09090B] hover:bg-neutral-800 text-white font-mono text-xs font-bold px-4 py-2 rounded-lg shadow-[3px_3px_0px_0px_#2563EB] transition-all inline-flex items-center justify-center gap-1.5"
          >
            <span>Read Official Announcement</span>
            <span>↗</span>
          </a>
        </div>

      </div>

      <!-- Practitioner Reaction & Discussion Thread -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[5px_5px_0px_0px_#09090B] mb-10">
        <div class="flex items-center justify-between border-b-2 border-[#09090B] pb-3 mb-6">
          <h2 class="text-sm font-mono uppercase font-bold tracking-wider text-ink flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#2563EB]"></span>
            <span>Practitioner Reaction & Analysis Thread</span>
          </h2>
          <span class="text-xs font-mono text-slate-500 font-semibold" id="commentCountBadge">0 Comments</span>
        </div>

        <!-- Comment Input Form -->
        <form id="storyCommentForm" class="space-y-3 mb-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-mono font-bold uppercase text-slate-600 mb-1">Your Name / Role *</label>
              <input type="text" id="commentAuthor" required placeholder="e.g. Lead Research Engineer" class="w-full p-2 rounded-lg border-2 border-[#09090B] text-xs font-mono" />
            </div>
            <div>
              <label class="block text-[11px] font-mono font-bold uppercase text-slate-600 mb-1">Your Industry Verdict *</label>
              <select id="commentVerdict" class="w-full p-2 rounded-lg border-2 border-[#09090B] text-xs font-mono">
                <option value="Bullish">Bullish on this Architecture</option>
                <option value="Cautious">Cautious / Overhyped</option>
                <option value="Neutral">Neutral / Testing Locally</option>
              </select>
            </div>
          </div>
          <div>
            <textarea id="commentContent" rows="2" required placeholder="Share your technical verdict or benchmarks on this news..." class="w-full p-2.5 rounded-lg border-2 border-[#09090B] text-xs leading-relaxed resize-none font-mono"></textarea>
          </div>
          <button type="submit" class="bg-[#09090B] text-white hover:bg-[#2563EB] text-xs font-mono font-bold px-4 py-2 rounded-lg shadow-[2px_2px_0px_0px_#2563EB] transition-colors cursor-pointer">
            Post Practitioner Verdict
          </button>
        </form>

        <!-- Comments Container -->
        <div id="storyCommentsList" class="space-y-3">
          <div id="noCommentsText" class="p-6 text-center text-xs font-mono text-slate-500 border border-dashed border-[#E2E8F0] rounded-lg">
            No reactions posted yet. Be the first practitioner to weigh in!
          </div>
        </div>
      </section>

      <!-- Connected Ecosystem Entities Section -->
      {(connectedTools.length > 0 || connectedRepos.length > 0 || connectedCreators.length > 0) && (
        <section class="bg-[#F8FAFF] border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B]">
          <h2 class="text-sm font-mono uppercase font-bold tracking-wider text-ink mb-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#2563EB]"></span>
            <span>Entities & Tools Mentioned in This Story</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {connectedTools.map(tool => (
              <a 
                href={`/tools/${tool.slug}`}
                class="bg-white border-2 border-[#09090B] p-3.5 rounded-lg hover:border-[#2563EB] hover:shadow-[3px_3px_0px_0px_#2563EB] transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono mb-1">
                    <span class="text-[#2563EB] font-bold">TOOL</span>
                    <span class="text-slate-500 font-semibold">{tool.pricingType}</span>
                  </div>
                  <div class="font-bold text-ink text-sm truncate">{tool.name}</div>
                  <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">{tool.tagline}</div>
                </div>
                <div class="mt-2 text-[10px] font-bold text-[#2563EB] hover:underline">
                  View Profile &rarr;
                </div>
              </a>
            ))}

            {connectedRepos.map(repo => (
              <a 
                href={`/open-source/${repo.slug}`}
                class="bg-white border-2 border-[#09090B] p-3.5 rounded-lg hover:border-[#2563EB] hover:shadow-[3px_3px_0px_0px_#2563EB] transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono mb-1">
                    <span class="text-purple-700 font-bold">OPEN SOURCE</span>
                    <span class="text-slate-500 font-semibold">★ {repo.stars}</span>
                  </div>
                  <div class="font-bold text-ink text-sm truncate">{repo.name}</div>
                  <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">{repo.description}</div>
                </div>
                <div class="mt-2 text-[10px] font-bold text-purple-700 hover:underline">
                  View Repo & Setup &rarr;
                </div>
              </a>
            ))}

            {connectedCreators.map(creator => (
              <a 
                href={`/creators/${creator.slug}`}
                class="bg-white border-2 border-[#09090B] p-3.5 rounded-lg hover:border-[#2563EB] hover:shadow-[3px_3px_0px_0px_#2563EB] transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono mb-1">
                    <span class="text-red-700 font-bold">CREATOR</span>
                    <span class="text-slate-500 font-semibold">{creator.subscribersEstimate}</span>
                  </div>
                  <div class="font-bold text-ink text-sm truncate">{creator.channelName}</div>
                  <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">{creator.primaryCategory}</div>
                </div>
                <div class="mt-2 text-[10px] font-bold text-red-700 hover:underline">
                  View Masterclass &rarr;
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </article>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const storySlug = window.location.pathname.split('/').filter(Boolean).pop();
  const form = document.getElementById('storyCommentForm') as HTMLFormElement | null;
  const authorInput = document.getElementById('commentAuthor') as HTMLInputElement | null;
  const verdictInput = document.getElementById('commentVerdict') as HTMLSelectElement | null;
  const contentInput = document.getElementById('commentContent') as HTMLTextAreaElement | null;
  const commentsList = document.getElementById('storyCommentsList');
  const noComments = document.getElementById('noCommentsText');
  const countBadge = document.getElementById('commentCountBadge');

  let comments: any[] = [];
  const localKey = `aio_story_reactions_${storySlug}`;

  function appendReactionCard(author: string, verdict: string, content: string, date: string) {
    if (!commentsList) return;
    const card = document.createElement('div');
    card.className = 'p-3.5 rounded-lg border-2 border-[#09090B] bg-white text-xs font-mono shadow-[2px_2px_0px_0px_#09090B]';
    card.innerHTML = `
      <div class="flex items-center justify-between mb-1.5">
        <span class="font-bold text-ink">${author}</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
          verdict === 'Bullish' ? 'bg-emerald-100 text-emerald-800' :
          verdict === 'Cautious' ? 'bg-red-100 text-red-800' : 'bg-slate-100 text-slate-800'
        }">${verdict}</span>
      </div>
      <p class="text-slate-700 font-sans text-xs mb-1">${content}</p>
      <span class="text-[10px] text-slate-400 font-mono">${date}</span>
    `;
    commentsList.prepend(card);
  }

  function updateBadge() {
    if (countBadge) countBadge.textContent = `${comments.length} Reaction${comments.length === 1 ? '' : 's'}`;
  }

  // Load from cache
  const cached = localStorage.getItem(localKey);
  if (cached) {
    try {
      comments = JSON.parse(cached);
      if (comments.length > 0) {
        noComments?.classList.add('hidden');
        comments.forEach(c => appendReactionCard(c.author, c.verdict, c.content, c.date));
        updateBadge();
      }
    } catch(e) {}
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const author = authorInput?.value.trim() || 'Practitioner';
    const verdict = verdictInput?.value || 'Bullish';
    const content = contentInput?.value.trim() || '';

    if (!content) return;

    noComments?.classList.add('hidden');
    appendReactionCard(author, verdict, content, 'Just now');
    comments.unshift({ author, verdict, content, date: 'Just now' });
    localStorage.setItem(localKey, JSON.stringify(comments));
    updateBadge();

    form.reset();
  });
</script>
