---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { NEWS_STORIES } from '../../data/newsData';
---

<Layout 
  title="AI News Today & Breakthroughs | AI Discovery Platform"
  description="Concise, verified daily summaries of major generative AI model updates, breakthroughs, and ecosystem shifts."
>
  <Header currentPath="/news" />

  <main class="w-full flex flex-col min-h-screen">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-12 md:py-16">
      <div class="max-w-5xl mx-auto">
        <div class="text-xs text-mute uppercase font-mono tracking-wider mb-2">Intelligence Briefing</div>
        <h1 class="text-3xl md:text-4xl font-semibold text-ink tracking-tight mb-2">
          AI News & Daily Developments
        </h1>
        <p class="text-sm md:text-base text-body max-w-2xl leading-relaxed">
          High-signal summaries explaining what happened, why it matters, and direct official citations.
        </p>
      </div>
    </section>

    <!-- News Stories Stream -->
    <div class="w-full max-w-5xl mx-auto px-6 py-12 flex flex-col gap-6">
      {NEWS_STORIES.map(story => (
        <article class="bg-canvas-elevated border border-hairline rounded-md p-6 md:p-8 hover:border-faint transition-all shadow-xs">
          <div class="flex items-center justify-between text-xs text-mute mb-3">
            <span class="font-mono bg-hairline-soft px-2 py-0.5 rounded-xs text-ink">{story.category}</span>
            <span>{story.publishedDate} • via {story.source}</span>
          </div>

          <h2 class="text-xl md:text-2xl font-semibold text-ink tracking-tight mb-3">
            <a href={story.sourceUrl} target="_blank" rel="noopener noreferrer" class="hover:text-link transition-colors inline-flex items-center gap-1.5">
              <span>{story.title}</span>
              <span class="text-sm text-mute">↗</span>
            </a>
          </h2>

          <p class="text-sm md:text-base text-body leading-relaxed mb-4">
            {story.summary}
          </p>

          <div class="p-3.5 rounded-md border border-hairline bg-canvas text-xs md:text-sm text-body mb-5">
            <strong class="text-ink font-semibold">Why it matters:</strong> {story.whyItMatters}
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-hairline text-xs">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-mute">Entities:</span>
              {story.relatedEntities.map(e => (
                <span class="bg-hairline-soft text-ink px-2 py-0.5 rounded-xs font-mono">{e}</span>
              ))}
            </div>

            <a 
              href={story.sourceUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-link hover:text-link-deep font-medium inline-flex items-center gap-1"
            >
              <span>Read Original Source</span>
              <span>↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
