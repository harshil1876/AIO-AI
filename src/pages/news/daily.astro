---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { NEWS_STORIES } from '../../data/newsData';

const topStories = NEWS_STORIES.slice(0, 10);
---

<Layout 
  title="Daily AI Executive Briefing | The 3-Minute Newspaper"
  description="High-density daily executive intelligence briefing on frontier AI models, open-source weights, and enterprise tools."
>
  <Header currentPath="/news" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Masthead -->
    <section class="border-b-4 border-[#09090B] bg-[#F8FAFF] px-4 sm:px-6 py-8">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between text-xs font-mono font-bold text-slate-800 border-b-2 border-[#09090B] pb-2 mb-4">
          <span>DAILY EXECUTIVE BRIEFING</span>
          <span>EST. READ TIME: 3 MINUTES</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black uppercase text-ink tracking-tight font-mono mb-2">
          TODAY'S AI DISPATCH
        </h1>
        <p class="text-sm font-mono text-slate-600 uppercase tracking-wider">
          Curated for CTOs, AI Engineers, and Tech Founders
        </p>
      </div>
    </section>

    <!-- Briefing Items Timeline -->
    <div class="max-w-4xl w-full mx-auto px-4 sm:px-6 py-10 flex-1">
      <div class="space-y-8">
        {topStories.map((story, idx) => (
          <article class="bg-white border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B] hover:shadow-[7px_7px_0px_0px_#2563EB] transition-all">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono mb-3">
              <span class="bg-[#2563EB] text-white px-2.5 py-0.5 rounded-xs font-bold border border-[#09090B] shadow-[2px_2px_0px_0px_#09090B]">
                BRIEF #{idx + 1} &bull; {story.topic}
              </span>
              <span class="text-slate-500 font-semibold">{story.publishedAt} via {story.sourceName}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-black text-ink mb-3 leading-snug hover:text-[#2563EB] transition-colors">
              <a href={`/news/${story.slug}`}>
                {story.headline}
              </a>
            </h2>

            <p class="text-sm text-slate-700 leading-relaxed mb-4">
              {story.summary}
            </p>

            <!-- Key Takeaways Bullets -->
            {story.keyTakeaways && story.keyTakeaways.length > 0 && (
              <div class="mb-4">
                <span class="text-[11px] font-mono uppercase font-bold text-slate-500 block mb-1.5">Key Takeaways:</span>
                <ul class="space-y-1 text-xs text-slate-700 list-disc list-inside">
                  {story.keyTakeaways.map(bullet => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Neo-Brutalist Why It Matters Box -->
            <div class="p-4 rounded-lg bg-[#EFF6FF] border-2 border-[#BFDBFE] text-xs text-slate-700 mb-5">
              <strong class="text-[#2563EB] font-mono uppercase tracking-wider text-[11px] block mb-1">
                Why It Matters to You:
              </strong>
              <p class="leading-relaxed">{story.whyItMatters}</p>
            </div>

            <!-- Footer: Entity Tags & Full Story Link -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-[#E2E8F0] text-xs">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-mono text-slate-500 text-[11px]">Related:</span>
                {story.relatedToolSlugs?.slice(0, 3).map(slug => (
                  <a href={`/tools/${slug}`} class="px-2 py-0.5 rounded bg-[#F8FAFF] hover:bg-[#EFF6FF] border border-[#E2E8F0] hover:border-[#BFDBFE] text-[#2563EB] font-mono text-[11px] font-semibold transition-colors">
                    #{slug}
                  </a>
                ))}
              </div>

              <div class="flex items-center gap-3">
                <a 
                  href={story.sourceUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-slate-500 hover:text-ink text-xs inline-flex items-center gap-1"
                >
                  Official Citation ↗
                </a>
                <a 
                  href={`/news/${story.slug}`} 
                  class="font-bold text-[#2563EB] hover:underline inline-flex items-center gap-1"
                >
                  Read Deep Dive &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
