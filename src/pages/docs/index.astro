---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Documentation Sections Data
const DOCS_SECTIONS = [
  {
    id: 'overview',
    title: 'Platform Overview & Quickstart',
    description: 'Learn how AIO AI interconnects 6 ecosystem pillars to deliver unbiased AI discovery and execution.',
    badge: 'Core Concept'
  },
  {
    id: 'ai-finder',
    title: 'AI Finder & Intent Engine',
    description: 'Deterministic multi-signal matching algorithm that pairs your problem with the optimal tool stack.',
    badge: 'Algorithms'
  },
  {
    id: 'ranking-methodology',
    title: 'Verification & Editorial Scoring',
    description: 'Our mathematical scoring formula (0–100), verification lifecycle, and strict zero-pay-for-placement policy.',
    badge: 'Integrity'
  },
  {
    id: 'workflows-guide',
    title: 'Workflows & Stack Builder Guide',
    description: 'How to assemble multi-agent workflows, estimate 3-tier budgets (Free/Freemium/Paid), and export configurations.',
    badge: 'Production'
  },
  {
    id: 'open-source-vram',
    title: 'Open-Source Self-Hosting & VRAM Specs',
    description: 'Hardware calculation formula, Ollama/vLLM deployment recipes, and quantization tradeoffs (Q4 vs Q8).',
    badge: 'Hardware'
  },
  {
    id: 'token-calculator',
    title: 'Official LLM Token Calculator Math',
    description: 'Precision cost formulas across 13 frontier models, caching discounts, and Indian Rupee (INR) conversion.',
    badge: 'Economics'
  },
  {
    id: 'community-reputation',
    title: 'Community, Reputation & Bounty Rules',
    description: 'Point economy, peer review trust tiers, and the data correction bounty workflow.',
    badge: 'Governance'
  },
  {
    id: 'architecture-schema',
    title: 'Platform Architecture & Entity Graph',
    description: 'Astro 5 + Tailwind v4 + Supabase PostgreSQL + Drizzle ORM 24-table schema reference.',
    badge: 'Engineering'
  }
];
---

<Layout 
  title="Platform Documentation & Engineering Specifications | AIO AI"
  description="Technical guides, scoring formulas, VRAM references, and architecture documentation for the AIO AI ecosystem."
>
  <Header currentPath="/docs" />

  <main class="w-full flex-1 min-h-screen bg-canvas">
    <!-- Top Hero Banner -->
    <section class="border-b border-[#E2E8F0] bg-surface px-6 py-12 md:py-16">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-200 bg-blue-50 text-[11px] font-mono font-semibold text-primary mb-3">
            <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
            <span>ENGINEERING & SPECIFICATION PORTAL</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-black text-ink tracking-tight mb-3">
            Platform Documentation
          </h1>
          <p class="text-sm md:text-base text-neutral-600 max-w-2xl leading-relaxed">
            Transparent algorithmic models, scoring formulas, deployment commands, and system architecture powering the entire AIO AI discovery platform.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a 
            href="/finder"
            class="px-4 py-2.5 rounded-lg bg-primary text-white text-xs font-semibold hover:bg-blue-700 transition-colors shadow-xs flex items-center gap-2"
          >
            <span>Launch AI Finder</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </a>
          <a 
            href="/tools"
            class="px-4 py-2.5 rounded-lg bg-white border border-[#E2E8F0] text-ink text-xs font-semibold hover:border-ink transition-colors shadow-xs"
          >
            Explore Catalog
          </a>
        </div>
      </div>
    </section>

    <!-- Curated 7 Deep Technical Guides Banner -->
    <section class="max-w-7xl mx-auto px-6 pt-10">
      <div class="card-aurora p-6 sm:p-8 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <div>
            <span class="text-[10px] font-mono uppercase font-bold text-blue-600 block">Technical Guides Portal</span>
            <h2 class="text-xl font-black text-slate-900 tracking-tight">7 Dedicated Engineering Architecture Guides</h2>
          </div>
          <span class="text-xs font-mono font-bold text-slate-400">Deep Dives & Math</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <a href="/docs/authenticity-scoring" class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-blue-600 font-bold block mb-1">01 • Scoring Engine</span>
              <h3 class="text-xs font-black text-slate-900 mb-1">5-Factor Authenticity Scoring</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">Mathematical breakdown of the 0–100 benchmark scoring formula.</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-2 block">Read Guide &rarr;</span>
          </a>

          <a href="/docs/solution-finder-engine" class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-blue-600 font-bold block mb-1">02 • Algorithms</span>
              <h3 class="text-xs font-black text-slate-900 mb-1">Solution Finder Engine</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">Deterministic mapping of user intents to 3-tier Decision Blueprints.</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-2 block">Read Guide &rarr;</span>
          </a>

          <a href="/docs/workflow-studio-guide" class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-blue-600 font-bold block mb-1">03 • Orchestration</span>
              <h3 class="text-xs font-black text-slate-900 mb-1">Workflow Studio & SKILL.md</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">Standard specification for Antigravity agent definition bundles.</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-2 block">Read Guide &rarr;</span>
          </a>

          <a href="/docs/utility-studio-handbook" class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-blue-600 font-bold block mb-1">04 • Client Security</span>
              <h3 class="text-xs font-black text-slate-900 mb-1">Utility Studio Handbook</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">Client-side sandbox isolation, Web Workers, and zero data leakage.</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-2 block">Read Guide &rarr;</span>
          </a>

          <a href="/docs/open-source-vram-math" class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-blue-600 font-bold block mb-1">05 • Hardware Math</span>
              <h3 class="text-xs font-black text-slate-900 mb-1">Open-Source VRAM Sizing</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">Mathematical formulas across FP16, Q8, Q4_K_M quantizations.</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-2 block">Read Guide &rarr;</span>
          </a>

          <a href="/docs/community-governance" class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-blue-600 font-bold block mb-1">06 • Governance</span>
              <h3 class="text-xs font-black text-slate-900 mb-1">Community Governance & Safety</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">Peer review standards and real-time anti-abuse profanity filter.</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-2 block">Read Guide &rarr;</span>
          </a>

          <a href="/docs/database-rls-security" class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase text-blue-600 font-bold block mb-1">07 • Infrastructure</span>
              <h3 class="text-xs font-black text-slate-900 mb-1">Database RLS Security</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">Supabase PostgreSQL RLS policies and auth trigger sync architecture.</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-2 block">Read Guide &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Docs Layout Container: Left Navigation + Center Content + Right TOC -->
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col lg:flex-row gap-10">
      
      <!-- Sticky Left Guide Navigation -->
      <aside class="w-full lg:w-64 shrink-0">
        <div class="lg:sticky lg:top-24 bg-white border border-[#E2E8F0] rounded-xl p-4 shadow-xs">
          <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400 mb-3 px-2">
            Guides & References
          </div>
          <nav class="space-y-1" id="docsNav">
            {DOCS_SECTIONS.map((sec, idx) => (
              <a 
                href={`#${sec.id}`}
                class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium text-neutral-600 hover:text-primary hover:bg-blue-50 transition-colors docs-nav-link"
                data-target={sec.id}
              >
                <span class="truncate">{idx + 1}. {sec.title.split('&')[0]}</span>
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-500 shrink-0 ml-1">
                  {sec.badge}
                </span>
              </a>
            ))}
          </nav>

          <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
            <div class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider px-2 mb-2">
              API & Schema Specs
            </div>
            <a 
              href="#architecture-schema" 
              class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
            >
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
              </svg>
              <span>24 PostgreSQL Tables</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Center Main Content -->
      <div class="flex-1 min-w-0 space-y-16">

        <!-- 1. Platform Overview & Quickstart -->
        <section id="overview" class="scroll-mt-24 bg-white border border-[#E2E8F0] rounded-xl p-6 md:p-8 shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono font-bold text-primary px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200">Guide 01</span>
            <span class="text-xs text-neutral-400 font-mono">Updated October 2026</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-black text-ink tracking-tight mb-4">
            Platform Overview & Connected Pillars
          </h2>
          <p class="text-sm text-neutral-600 leading-relaxed mb-6">
            Unlike traditional static AI directories that only aggregate affiliate links, AIO AI is designed as a relational knowledge graph connecting tools directly to open-source self-hosted alternatives, production multi-step workflows, YouTube creator masterclasses, live daily intelligence, and interactive utilities.
          </p>

          <!-- 6 Pillars Bento Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-6">
            <div class="p-4 rounded-lg bg-surface border border-neutral-200">
              <div class="text-xs font-bold font-mono text-primary mb-1">01. Verified Tools</div>
              <p class="text-xs text-neutral-600">113+ cataloged AI tools audited for API status, pricing tiers, and India payment support.</p>
            </div>
            <div class="p-4 rounded-lg bg-surface border border-neutral-200">
              <div class="text-xs font-bold font-mono text-primary mb-1">02. Daily AI News</div>
              <p class="text-xs text-neutral-600">Neo-brutalist intelligence feed categorizing technical releases, model updates, and regulatory shifts.</p>
            </div>
            <div class="p-4 rounded-lg bg-surface border border-neutral-200">
              <div class="text-xs font-bold font-mono text-primary mb-1">03. Production Workflows</div>
              <p class="text-xs text-neutral-600">16+ executable multi-step recipes with Free, Freemium, and Paid cost comparisons.</p>
            </div>
            <div class="p-4 rounded-lg bg-surface border border-neutral-200">
              <div class="text-xs font-bold font-mono text-primary mb-1">04. Open-Source Hub</div>
              <p class="text-xs font-mono text-xs text-neutral-600">20 flagship self-hosted alternatives with exact VRAM requirements and Docker commands.</p>
            </div>
            <div class="p-4 rounded-lg bg-surface border border-neutral-200">
              <div class="text-xs font-bold font-mono text-primary mb-1">05. AI Educators</div>
              <p class="text-xs text-neutral-600">18 curated global and Indian YouTube educators mapped to the specific tools they teach.</p>
            </div>
            <div class="p-4 rounded-lg bg-surface border border-neutral-200">
              <div class="text-xs font-bold font-mono text-primary mb-1">06. Interactive Utilities</div>
              <p class="text-xs text-neutral-600">8 client-side tools including LLM Token Calculator, Prompt Optimizer, and Cost Simulator.</p>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-blue-50 border border-blue-200 text-xs text-blue-900 leading-relaxed">
            <strong>Core Architecture Principle:</strong> Every detail page (e.g. <code>/tools/[slug]</code>) automatically queries cross-referenced workflows, creator tutorials, and open-source alternatives through two-way foreign keys in PostgreSQL.
          </div>
        </section>

        <!-- 2. AI Finder & Intent Engine -->
        <section id="ai-finder" class="scroll-mt-24 bg-white border border-[#E2E8F0] rounded-xl p-6 md:p-8 shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono font-bold text-primary px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200">Guide 02</span>
            <span class="text-xs text-neutral-400 font-mono">Matching Engine</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-black text-ink tracking-tight mb-4">
            AI Finder & Intent Engine Algorithm
          </h2>
          <p class="text-sm text-neutral-600 leading-relaxed mb-4">
            The AI Finder does not use fuzzy probabilistic search. It computes a deterministic multi-signal match score based on 4 discrete constraints input by the user:
          </p>

          <div class="bg-surface border border-[#E2E8F0] rounded-lg p-5 mb-6 font-mono text-xs text-neutral-800 space-y-3">
            <div class="font-bold text-ink">// Mathematical Matching Weight Allocation:</div>
            <div>Score(Tool) = W_category * S_cat + W_pricing * S_price + W_experience * S_exp + W_local * S_local</div>
            <div class="text-neutral-500 pl-4">
              • W_category (40%): Direct match with task intent category.<br/>
              • W_pricing (30%): Budget filter compliance (Free, Freemium, Paid).<br/>
              • W_experience (15%): Skill calibration (Beginner, Intermediate, Developer).<br/>
              • W_local (15%): Indian payment or local execution requirement.
            </div>
          </div>

          <h3 class="text-base font-bold text-ink mb-2">Connected Decision Blueprint Output</h3>
          <p class="text-sm text-neutral-600 leading-relaxed mb-4">
            When matched, the engine returns a 5-layer Connected Decision Blueprint rather than a single tool:
          </p>
          <ul class="space-y-2 text-xs text-neutral-700 list-disc list-inside">
            <li><strong>Best Primary Tool:</strong> Highest scoring commercial or hybrid product.</li>
            <li><strong>100% Free Option:</strong> Zero-cost tier alternative for students and bootstrappers.</li>
            <li><strong>Matching Production Workflow:</strong> Multi-step recipe showing how to incorporate the tool.</li>
            <li><strong>Open-Source Self-Hosted Alternative:</strong> Private, local-first repository with VRAM specs.</li>
            <li><strong>Curated Creator Tutorial:</strong> Top educator video teaching masterclasses on the subject.</li>
          </ul>
        </section>

        <!-- 3. Verification & Editorial Scoring -->
        <section id="ranking-methodology" class="scroll-mt-24 bg-white border border-[#E2E8F0] rounded-xl p-6 md:p-8 shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono font-bold text-primary px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200">Guide 03</span>
            <span class="text-xs text-neutral-400 font-mono">Platform Score</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-black text-ink tracking-tight mb-4">
            Verification & Editorial Ranking Methodology
          </h2>
          <p class="text-sm text-neutral-600 leading-relaxed mb-4">
            Per PRD Section 44 and Section 67, pre-seeded catalog tools never display fabricated user star ratings. Community ratings start strictly at 0 reviews until submitted by verified accounts. To help users compare tools objectively, our editorial team computes a transparent <strong>Platform Score (0–100)</strong>.
          </p>

          <div class="bg-neutral-900 text-white rounded-lg p-5 mb-6 font-mono text-xs space-y-2">
            <div class="text-blue-400 font-bold">// Platform Score Formula:</div>
            <div>PlatformScore = (FeatureBreadth * 0.25) + (APIReliability * 0.25) + (PricingTransparency * 0.20) + (CommunityReputation * 0.15) + (DocumentationQuality * 0.15)</div>
          </div>

          <div class="overflow-x-auto border border-[#E2E8F0] rounded-lg mb-6">
            <table class="w-full text-xs text-left">
              <thead class="bg-surface border-b border-[#E2E8F0] font-mono text-neutral-500 uppercase">
                <tr>
                  <th class="p-3">Component</th>
                  <th class="p-3">Weight</th>
                  <th class="p-3">Evaluation Criteria</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#E2E8F0]">
                <tr>
                  <td class="p-3 font-semibold text-ink">Feature Breadth</td>
                  <td class="p-3 font-mono text-primary font-bold">25%</td>
                  <td class="p-3 text-neutral-600">Model diversity, context window capacity, multimodal input/output support.</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold text-ink">API & Enterprise Reliability</td>
                  <td class="p-3 font-mono text-primary font-bold">25%</td>
                  <td class="p-3 text-neutral-600">Uptime SLA, latency benchmarks, SOC 2 compliance, rate limit tier clarity.</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold text-ink">Pricing Transparency</td>
                  <td class="p-3 font-mono text-primary font-bold">20%</td>
                  <td class="p-3 text-neutral-600">Clear token metering, explicit cancellation, zero hidden overage traps, INR billing.</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold text-ink">Community Reputation</td>
                  <td class="p-3 font-mono text-primary font-bold">15%</td>
                  <td class="p-3 text-neutral-600">Verified practitioner reviews, GitHub sentiment, active Discord responsiveness.</td>
                </tr>
                <tr>
                  <td class="p-3 font-semibold text-ink">Documentation & Onboarding</td>
                  <td class="p-3 font-mono text-primary font-bold">15%</td>
                  <td class="p-3 text-neutral-600">Code examples in Python/TS, quickstart tutorials, clear SDK documentation.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-xs text-emerald-900">
            <strong>Zero Pay-For-Placement Guarantee:</strong> No vendor can purchase a higher Platform Score or sponsor search position. Sponsored items are strictly labeled and never affect organic sorting.
          </div>
        </section>

        <!-- 4. Workflows & Stack Builder Guide -->
        <section id="workflows-guide" class="scroll-mt-24 bg-white border border-[#E2E8F0] rounded-xl p-6 md:p-8 shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono font-bold text-primary px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200">Guide 04</span>
            <span class="text-xs text-neutral-400 font-mono">Workflows</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-black text-ink tracking-tight mb-4">
            Production Workflows & Stack Builder
          </h2>
          <p class="text-sm text-neutral-600 leading-relaxed mb-4">
            Workflows connect standalone tools into chained automation pipelines (e.g. Lead Scraping + LLM Enrichment + Personalized Outreach + CRM Sync). Each workflow specifies 3 distinct execution budget tiers:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="p-4 rounded-lg bg-emerald-50 border border-emerald-200">
              <div class="text-xs font-mono font-bold text-emerald-800 uppercase mb-1">Tier 1: 100% Free</div>
              <p class="text-xs text-emerald-700">Utilizes open-source self-hosted tools (Ollama, n8n Community, Crawl4AI) or generous free tiers without card requirements.</p>
            </div>
            <div class="p-4 rounded-lg bg-blue-50 border border-blue-200">
              <div class="text-xs font-mono font-bold text-primary uppercase mb-1">Tier 2: Freemium Hybrid</div>
              <p class="text-xs text-blue-800">Balances managed cloud webhooks with pay-per-token inference (e.g. Make.com Free + DeepSeek API at $0.14/M tokens).</p>
            </div>
            <div class="p-4 rounded-lg bg-neutral-100 border border-neutral-300">
              <div class="text-xs font-mono font-bold text-neutral-900 uppercase mb-1">Tier 3: Enterprise Pro</div>
              <p class="text-xs text-neutral-700">Dedicated high-availability APIs with guaranteed uptime SLAs (Claude 3.5 Sonnet, Enterprise Zapier, dedicated vector DBs).</p>
            </div>
          </div>

          <h3 class="text-base font-bold text-ink mb-2">Workflow Security & Secrets Best Practice</h3>
          <p class="text-sm text-neutral-600 leading-relaxed mb-3">
            Never hardcode production API keys in client templates. When exporting workflows from AIO AI:
          </p>
          <div class="bg-neutral-900 text-neutral-200 rounded-lg p-4 font-mono text-xs space-y-1">
            <div class="text-neutral-400"># Recommended .env specification for exported pipelines:</div>
            <div>OPENAI_API_KEY=sk-...</div>
            <div>ANTHROPIC_API_KEY=sk-ant-...</div>
            <div>OLLAMA_HOST=http://localhost:11434</div>
            <div>DATABASE_URL=postgresql://postgres:password@localhost:5432/aio_ai</div>
          </div>
        </section>

        <!-- 5. Open-Source Self-Hosting & VRAM Specs -->
