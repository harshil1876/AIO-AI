<script is:inline>
  (function() {
    var isINR = false;
    var exchangeRate = 86.50;

    var seatsInput = document.getElementById('saasSeatsInput');
    var inputTokInput = document.getElementById('inputTokensInput');
    var outputTokInput = document.getElementById('outputTokensInput');

    var swapMidjourney = document.getElementById('swapMidjourney');
    var swapZapier = document.getElementById('swapZapier');
    var swapVoice = document.getElementById('swapVoice');
    var swapCoding = document.getElementById('swapCoding');

    var totalSpendDisplay = document.getElementById('totalSpendDisplay');
    var totalSpendInrDisplay = document.getElementById('totalSpendInrDisplay');
    var saasSubSpend = document.getElementById('saasSubSpend');
    var apiTokenSpend = document.getElementById('apiTokenSpend');
    var openSourceSavings = document.getElementById('openSourceSavings');
    var annualSavingsDisplay = document.getElementById('annualSavingsDisplay');
    var annualSavingsInrDisplay = document.getElementById('annualSavingsInrDisplay');

    function calculateSpend() {
      var seats = parseInt(seatsInput?.value || '2', 10);
      var inTok = parseFloat(inputTokInput?.value || '5');
      var outTok = parseFloat(outputTokInput?.value || '2');

      var saasCost = seats * 20;
      var apiCost = (inTok * 1.50) + (outTok * 6.00);

      var savings = 0;
      if (swapMidjourney?.checked) savings += 30;
      if (swapZapier?.checked) savings += 20;
      if (swapVoice?.checked) savings += 22;
      if (swapCoding?.checked) savings += 20;

      var total = saasCost + apiCost;
      var annual = savings * 12;

      if (isINR) {
        if (totalSpendDisplay) totalSpendDisplay.textContent = '₹' + (total * exchangeRate).toFixed(2);
        if (totalSpendInrDisplay) totalSpendInrDisplay.textContent = '$' + total.toFixed(2) + ' USD equivalent';
        if (saasSubSpend) saasSubSpend.textContent = '₹' + (saasCost * exchangeRate).toFixed(2);
        if (apiTokenSpend) apiTokenSpend.textContent = '₹' + (apiCost * exchangeRate).toFixed(2);
        if (openSourceSavings) openSourceSavings.textContent = '-₹' + (savings * exchangeRate).toFixed(2) + ' / mo';
        if (annualSavingsDisplay) annualSavingsDisplay.textContent = '₹' + (annual * exchangeRate).toLocaleString() + ' / yr';
        if (annualSavingsInrDisplay) annualSavingsInrDisplay.textContent = '$' + annual.toLocaleString() + ' USD preserved';
      } else {
        if (totalSpendDisplay) totalSpendDisplay.textContent = '$' + total.toFixed(2);
        if (totalSpendInrDisplay) totalSpendInrDisplay.textContent = '₹' + (total * exchangeRate).toFixed(2) + ' / month';
        if (saasSubSpend) saasSubSpend.textContent = '$' + saasCost.toFixed(2);
        if (apiTokenSpend) apiTokenSpend.textContent = '$' + apiCost.toFixed(2);
        if (openSourceSavings) openSourceSavings.textContent = '-$' + savings.toFixed(2) + ' / mo';
        if (annualSavingsDisplay) annualSavingsDisplay.textContent = '$' + annual.toLocaleString() + ' / yr';
        if (annualSavingsInrDisplay) annualSavingsInrDisplay.textContent = '₹' + (annual * exchangeRate).toLocaleString() + ' / year preserved';
      }
    }

    // Update Category Prices Currency
    function updateCategoryCurrency(toInr) {
      document.querySelectorAll('.cat-avg-price').forEach(function(el) {
        var baseUsd = parseFloat(el.getAttribute('data-usd') || '15');
        if (toInr) {
          el.textContent = '₹' + Math.round(baseUsd * exchangeRate) + '/mo';
        } else {
          el.textContent = '$' + baseUsd + '/mo';
        }
      });
    }

    // Currency Switcher
    var btnUSD = document.getElementById('currencyUSD');
    var btnINR = document.getElementById('currencyINR');

    btnUSD?.addEventListener('click', function() {
      isINR = false;
      btnUSD.className = 'currency-toggle px-3 py-1.5 rounded-xl text-xs font-mono font-bold bg-blue-600 text-white transition-all cursor-pointer shadow-sm';
      btnINR.className = 'currency-toggle px-3 py-1.5 rounded-xl text-xs font-mono font-bold text-slate-300 hover:text-white transition-all cursor-pointer';
      calculateSpend();
      updateCategoryCurrency(false);
    });

    btnINR?.addEventListener('click', function() {
      isINR = true;
      btnINR.className = 'currency-toggle px-3 py-1.5 rounded-xl text-xs font-mono font-bold bg-blue-600 text-white transition-all cursor-pointer shadow-sm';
      btnUSD.className = 'currency-toggle px-3 py-1.5 rounded-xl text-xs font-mono font-bold text-slate-300 hover:text-white transition-all cursor-pointer';
      calculateSpend();
      updateCategoryCurrency(true);
    });

    [seatsInput, inputTokInput, outputTokInput, swapMidjourney, swapZapier, swapVoice, swapCoding].forEach(function(el) {
      el?.addEventListener('input', calculateSpend);
      el?.addEventListener('change', calculateSpend);
    });

    calculateSpend();

    // Chart 1 Dynamic Velocity Toggle & SVG Curve Recomputation
    var velocityButtons = document.querySelectorAll('.velocity-toggle');
    var xLabelStart = document.getElementById('xLabelStart');
    var toolsAreaPath = document.getElementById('toolsAreaPath');
    var reposAreaPath = document.getElementById('reposAreaPath');
    var toolsLinePath = document.getElementById('toolsLinePath');
    var reposLinePath = document.getElementById('reposLinePath');
    var workflowsLinePath = document.getElementById('workflowsLinePath');

    velocityButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        velocityButtons.forEach(function(b) {
          b.className = 'velocity-toggle px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer';
        });
        btn.className = 'velocity-toggle px-3 py-1 rounded-lg bg-white text-blue-600 shadow-xs cursor-pointer';
        var range = btn.getAttribute('data-range');
        if (range === '30d') {
          if (xLabelStart) xLabelStart.textContent = '30 Days Ago';
          toolsAreaPath?.setAttribute('d', 'M 0,220 L 0,205 Q 200,185 400,130 T 800,20 L 800,220 Z');
          toolsLinePath?.setAttribute('d', 'M 0,205 Q 200,185 400,130 T 800,20');
          reposAreaPath?.setAttribute('d', 'M 0,220 L 0,215 Q 200,195 400,160 T 800,50 L 800,220 Z');
          reposLinePath?.setAttribute('d', 'M 0,215 Q 200,195 400,160 T 800,50');
          workflowsLinePath?.setAttribute('d', 'M 0,218 Q 200,210 400,180 T 800,85');
        } else if (range === '90d') {
          if (xLabelStart) xLabelStart.textContent = '90 Days Ago';
          toolsAreaPath?.setAttribute('d', 'M 0,220 L 0,195 Q 200,170 400,120 T 800,30 L 800,220 Z');
          toolsLinePath?.setAttribute('d', 'M 0,195 Q 200,170 400,120 T 800,30');
          reposAreaPath?.setAttribute('d', 'M 0,220 L 0,210 Q 200,190 400,150 T 800,60 L 800,220 Z');
          reposLinePath?.setAttribute('d', 'M 0,210 Q 200,190 400,150 T 800,60');
          workflowsLinePath?.setAttribute('d', 'M 0,215 Q 200,205 400,175 T 800,95');
        } else {
          if (xLabelStart) xLabelStart.textContent = 'Apr 2025';
          toolsAreaPath?.setAttribute('d', 'M 0,220 L 0,190 Q 200,160 400,110 T 800,25 L 800,220 Z');
          toolsLinePath?.setAttribute('d', 'M 0,190 Q 200,160 400,110 T 800,25');
          reposAreaPath?.setAttribute('d', 'M 0,220 L 0,210 Q 200,190 400,150 T 800,60 L 800,220 Z');
          reposLinePath?.setAttribute('d', 'M 0,210 Q 200,190 400,150 T 800,60');
          workflowsLinePath?.setAttribute('d', 'M 0,215 Q 200,205 400,175 T 800,95');
        }
      });
    });

    // Chart 4 Provider filter for scatter plot with dynamic count
    var providerButtons = document.querySelectorAll('.provider-filter');
    var dots = document.querySelectorAll('.model-scatter-dot');
    var scatterBadge = document.getElementById('scatterCountBadge');

    providerButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        providerButtons.forEach(function(b) {
          b.className = 'provider-filter px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 cursor-pointer';
        });
        btn.className = 'provider-filter px-3 py-1 rounded-lg bg-slate-900 text-white cursor-pointer';
        var prov = btn.getAttribute('data-provider');
        var count = 0;
        dots.forEach(function(dot) {
          if (prov === 'all' || dot.getAttribute('data-provider') === prov) {
            dot.style.display = 'block';
            count++;
          } else {
            dot.style.display = 'none';
          }
        });
        if (scatterBadge) {
          scatterBadge.textContent = 'Showing ' + count + ' Models';
        }
      });
    });
  })();
</script>
