---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { OFFICIAL_MODELS } from '../data/modelsData';
import { OPEN_SOURCE_REPOS } from '../data/openSourceData';
import { CATEGORIES_DATA } from '../data/seedData';
import { getAllTools } from '../services/dataService';

const tools = await getAllTools();
const indiaTools = tools.filter(t => t.isIndianAI);
const freeTools = tools.filter(t => t.pricingType === 'Free');
const freemiumTools = tools.filter(t => t.pricingType === 'Freemium');
const paidTools = tools.filter(t => t.pricingType === 'Paid');
const openSourceTools = tools.filter(t => t.pricingType === 'Open Source');

// Compute category statistics for the 13 categories
const categoryStats = CATEGORIES_DATA.map(cat => {
  const catTools = tools.filter(t => t.categorySlugs?.includes(cat.slug));
  const avgScore = catTools.length 
    ? Math.round(catTools.reduce((acc, t) => acc + (t.platformScore || 85), 0) / catTools.length)
    : 85;
  
  // Parse starting price average
  const prices = catTools.map(t => {
    if (!t.startingPrice || t.pricingType === 'Free' || t.pricingType === 'Open Source') return 0;
    const match = t.startingPrice.match(/\$?(\d+(\.\d+)?)/);
    return match ? parseFloat(match[1]) : 15;
  });
  const avgPrice = prices.length ? Math.round(prices.reduce((a, b) => a + b, 0) / prices.length) : 0;

  return {
    slug: cat.slug,
    name: cat.name,
    count: catTools.length,
    avgScore,
    avgPrice: avgPrice || 18,
  };
});

// Top Repos by Stars
const sortedRepos = [...OPEN_SOURCE_REPOS].sort((a, b) => {
  const parseStars = (s: string) => {
    const num = parseFloat(s.replace(/[^0-9.]/g, ''));
    return s.includes('k') ? num * 1000 : num;
  };
  return parseStars(b.stars) - parseStars(a.stars);
});
---

<Layout 
  title="Market Intelligence & Ecosystem Telemetry | AIO AI"
  description="Authoritative AI market intelligence: Ecosystem velocity, pricing model distributions, LLM price-performance scatter plot, category authenticity benchmarking, and sovereign India AI telemetry."
>
  <Header currentPath="/analytics" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-12">
    
    <!-- Top Header & Executive Telemetry Strip -->
    <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-400/30 bg-blue-500/10 text-[11px] font-mono font-bold text-blue-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>ECOSYSTEM VELOCITY TELEMETRY • V2.0 LIVE</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            Market Intelligence & Telemetry
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            Real-time economic intelligence across verified SaaS software, frontier LLM inference rates, open-source replacement economics, and sovereign AI telemetry.
          </p>
        </div>

        <!-- Global Currency Switcher -->
        <div class="flex items-center gap-2 bg-slate-900/80 backdrop-blur-md p-1.5 rounded-2xl border border-slate-700/60 shrink-0 self-start md:self-end">
          <span class="text-xs font-mono font-bold text-slate-400 pl-2">Currency:</span>
          <button 
            type="button" 
            id="currencyUSD" 
            class="currency-toggle px-3 py-1.5 rounded-xl text-xs font-mono font-bold bg-blue-600 text-white transition-all cursor-pointer shadow-sm"
          >
            USD ($)
          </button>
          <button 
            type="button" 
            id="currencyINR" 
            class="currency-toggle px-3 py-1.5 rounded-xl text-xs font-mono font-bold text-slate-300 hover:text-white transition-all cursor-pointer"
          >
            INR (₹)
          </button>
        </div>
      </div>

      <!-- Quick KPI Counters -->
      <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-8 border-t border-slate-800/80">
        <div class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl p-4">
          <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-400">Verified Catalog</span>
          <div class="text-2xl sm:text-3xl font-black font-mono text-white mt-1">{tools.length} <span class="text-xs font-normal text-blue-400 font-sans">Tools</span></div>
          <span class="text-[11px] text-slate-400">100% verified URLs</span>
        </div>
        <div class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl p-4">
          <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-400">Open-Source Hub</span>
          <div class="text-2xl sm:text-3xl font-black font-mono text-emerald-400 mt-1">{OPEN_SOURCE_REPOS.length} <span class="text-xs font-normal text-emerald-300 font-sans">Repos</span></div>
          <span class="text-[11px] text-slate-400">Self-hostable code</span>
        </div>
        <div class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl p-4">
          <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-400">Frontier LLMs</span>
          <div class="text-2xl sm:text-3xl font-black font-mono text-purple-400 mt-1">{OFFICIAL_MODELS.length} <span class="text-xs font-normal text-purple-300 font-sans">Models</span></div>
          <span class="text-[11px] text-slate-400">Live token rates</span>
        </div>
        <div class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-2xl p-4">
          <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-400">Sovereign India AI</span>
          <div class="text-2xl sm:text-3xl font-black font-mono text-amber-400 mt-1">{indiaTools.length} <span class="text-xs font-normal text-amber-300 font-sans">Pioneers</span></div>
          <span class="text-[11px] text-slate-400">22 Indic languages</span>
        </div>
      </div>
    </section>

    <!-- CHART 1: ECOSYSTEM VELOCITY AREA CHART -->
    <section class="card-aurora p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-blue-600"></span>
            <h2 class="text-xl font-black text-slate-900 tracking-tight">1. Ecosystem Growth & Velocity Trajectory</h2>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Cumulative adoption curve of verified tools, open-source repositories, and community workflows.</p>
        </div>
        
        <!-- Timeline Toggle Buttons -->
        <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-mono font-bold">
          <button type="button" class="velocity-toggle px-3 py-1 rounded-lg bg-white text-blue-600 shadow-xs cursor-pointer" data-range="12m">12 Months</button>
          <button type="button" class="velocity-toggle px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer" data-range="90d">90 Days</button>
          <button type="button" class="velocity-toggle px-3 py-1 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer" data-range="30d">30 Days</button>
        </div>
      </div>

      <!-- Area Chart SVG Container -->
      <div class="relative bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-6 overflow-hidden">
        <div class="flex items-center justify-end gap-6 text-xs font-mono mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-blue-600"></span>
            <span class="text-slate-700 font-bold">Verified Tools</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="text-slate-700 font-bold">Open-Source Repos</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-purple-500"></span>
            <span class="text-slate-700 font-bold">Workflows</span>
          </div>
        </div>

        <div class="h-64 sm:h-80 w-full relative">
          <svg id="velocityChartSvg" class="w-full h-full overflow-visible" viewBox="0 0 800 240" preserveAspectRatio="none">
            <defs>
              <linearGradient id="toolsGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#2563EB" stop-opacity="0.35"/>
                <stop offset="100%" stop-color="#2563EB" stop-opacity="0.0"/>
              </linearGradient>
              <linearGradient id="reposGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#10B981" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#10B981" stop-opacity="0.0"/>
              </linearGradient>
            </defs>

            <!-- Grid Lines -->
            <line x1="0" y1="40" x2="800" y2="40" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4,4"/>
            <line x1="0" y1="100" x2="800" y2="100" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4,4"/>
            <line x1="0" y1="160" x2="800" y2="160" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4,4"/>
            <line x1="0" y1="220" x2="800" y2="220" stroke="#E2E8F0" stroke-width="1.5"/>

            <!-- Area Paths -->
            <path id="toolsAreaPath" d="M 0,220 L 0,190 Q 200,160 400,110 T 800,25 L 800,220 Z" fill="url(#toolsGrad)" />
            <path id="reposAreaPath" d="M 0,220 L 0,210 Q 200,190 400,150 T 800,60 L 800,220 Z" fill="url(#reposGrad)" />

            <!-- Stroke Paths -->
            <path id="toolsLinePath" d="M 0,190 Q 200,160 400,110 T 800,25" fill="none" stroke="#2563EB" stroke-width="3" stroke-linecap="round" />
            <path id="reposLinePath" d="M 0,210 Q 200,190 400,150 T 800,60" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" />
            <path id="workflowsLinePath" d="M 0,215 Q 200,205 400,175 T 800,95" fill="none" stroke="#8B5CF6" stroke-width="2" stroke-dasharray="3,3" />

            <!-- Highlight Nodes -->
            <circle cx="800" cy="25" r="5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2" />
            <circle cx="800" cy="60" r="5" fill="#10B981" stroke="#FFFFFF" stroke-width="2" />
            <circle cx="800" cy="95" r="5" fill="#8B5CF6" stroke="#FFFFFF" stroke-width="2" />
          </svg>
        </div>

        <!-- X-Axis Labels -->
        <div class="flex justify-between items-center text-[10px] font-mono text-slate-400 mt-2 px-1">
          <span id="xLabelStart">Apr 2025</span>
          <span>Jul 2025</span>
          <span>Oct 2025</span>
          <span>Jan 2026</span>
          <span id="xLabelEnd" class="font-bold text-slate-700">Present (Active)</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2: CHARTS 2 & 3 (TWO-COLUMN GRID) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- CHART 2: PRICING MODEL DISTRIBUTION DONUT CHART -->
      <section class="card-aurora p-6 sm:p-8 space-y-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
              <h2 class="text-lg font-black text-slate-900 tracking-tight">2. Pricing Model Market Share</h2>
            </div>
            <span class="text-xs font-mono font-bold text-slate-500">{tools.length} Tools Cataloged</span>
          </div>
          <p class="text-xs text-slate-500 mt-2">Distribution of monetization structures across the verified AI software ecosystem.</p>

          <!-- Donut SVG + Legend Row -->
          <div class="flex flex-col sm:flex-row items-center justify-around gap-6 mt-6">
            <!-- Donut SVG -->
            <div class="relative w-48 h-48 shrink-0">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 120 120">
                <!-- Circle background -->
                <circle cx="60" cy="60" r="48" fill="none" stroke="#F1F5F9" stroke-width="16" />
                
                <!-- Segments (circumference = 2 * PI * 48 ≈ 301.59) -->
                <!-- Freemium: 50% = 150.8 -->
                <circle cx="60" cy="60" r="48" fill="none" stroke="#2563EB" stroke-width="16"
                  stroke-dasharray="151 302" stroke-dashoffset="0" class="transition-all duration-500 hover:stroke-blue-700" />
                <!-- Open Source: 25% = 75.4 -->
                <circle cx="60" cy="60" r="48" fill="none" stroke="#10B981" stroke-width="16"
                  stroke-dasharray="75 302" stroke-dashoffset="-151" class="transition-all duration-500 hover:stroke-emerald-600" />
                <!-- 100% Free: 15% = 45.2 -->
                <circle cx="60" cy="60" r="48" fill="none" stroke="#8B5CF6" stroke-width="16"
                  stroke-dasharray="45 302" stroke-dashoffset="-226" class="transition-all duration-500 hover:stroke-purple-600" />
                <!-- Paid Only: 10% = 30.2 -->
                <circle cx="60" cy="60" r="48" fill="none" stroke="#F59E0B" stroke-width="16"
                  stroke-dasharray="30 302" stroke-dashoffset="-271" class="transition-all duration-500 hover:stroke-amber-600" />
              </svg>
              <!-- Center Text inside Donut -->
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span class="text-2xl font-black text-slate-900 font-mono">{tools.length}</span>
                <span class="text-[10px] uppercase font-mono font-bold text-slate-400">Total Tools</span>
              </div>
            </div>

            <!-- Legend List -->
            <div class="space-y-3 w-full sm:w-auto text-xs font-sans">
              <div class="flex items-center justify-between sm:gap-6 pb-1.5 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-blue-600 shrink-0"></span>
                  <span class="font-bold text-slate-800">Freemium Tier</span>
                </div>
                <span class="font-mono font-bold text-slate-900">{freemiumTools.length} ({Math.round(freemiumTools.length / tools.length * 100)}%)</span>
              </div>

              <div class="flex items-center justify-between sm:gap-6 pb-1.5 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-emerald-500 shrink-0"></span>
                  <span class="font-bold text-slate-800">Open-Source Free</span>
                </div>
                <span class="font-mono font-bold text-slate-900">{openSourceTools.length} ({Math.round(openSourceTools.length / tools.length * 100)}%)</span>
              </div>

              <div class="flex items-center justify-between sm:gap-6 pb-1.5 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-purple-500 shrink-0"></span>
                  <span class="font-bold text-slate-800">100% Free / Beta</span>
                </div>
                <span class="font-mono font-bold text-slate-900">{freeTools.length} ({Math.round(freeTools.length / tools.length * 100)}%)</span>
              </div>

              <div class="flex items-center justify-between sm:gap-6">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-amber-500 shrink-0"></span>
                  <span class="font-bold text-slate-800">Paid Subscription</span>
                </div>
                <span class="font-mono font-bold text-slate-900">{paidTools.length} ({Math.round(paidTools.length / tools.length * 100)}%)</span>
              </div>
            </div>
          </div>
        </div>

        <div class="p-3.5 bg-blue-50/70 border border-blue-200/60 rounded-xl text-xs text-blue-900 flex items-center justify-between mt-4">
          <span>Self-hostable & free tools represent <strong>{Math.round((openSourceTools.length + freeTools.length) / tools.length * 100)}%</strong> of verified options.</span>
          <a href="/tools?pricing=free" class="font-bold text-blue-700 hover:underline shrink-0 ml-2">Browse Free &rarr;</a>
        </div>
      </section>

      <!-- CHART 3: CATEGORY COST VS AUTHENTICITY GROUPED BAR CHART -->
      <section class="card-aurora p-6 sm:p-8 space-y-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
              <h2 class="text-lg font-black text-slate-900 tracking-tight">3. Category Authenticity vs Starting Cost</h2>
            </div>
            <div class="flex items-center gap-3 text-[11px] font-mono">
              <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-xs bg-blue-600"></span> Avg Cost ($)</span>
              <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-xs bg-emerald-500"></span> Score (0-100)</span>
            </div>
          </div>
          <p class="text-xs text-slate-500 mt-2">Benchmark of 13 taxonomy domains: Comparing average starting price vs verified 5-factor quality score.</p>

          <!-- Grouped Bar Chart Area -->
          <div class="space-y-2.5 mt-5 max-h-72 overflow-y-auto pr-2 text-xs">
            {categoryStats.map(cat => (
              <div class="p-2 rounded-xl bg-white border border-slate-100 hover:border-slate-300 transition-colors">
                <div class="flex justify-between items-center mb-1 text-[11px]">
                  <span class="font-bold text-slate-800">{cat.name} ({cat.count} tools)</span>
                  <div class="space-x-2 font-mono">
                    <span class="cat-avg-price text-blue-700 font-bold" data-usd={cat.avgPrice}>${cat.avgPrice}/mo</span>
                    <span class="text-emerald-700 font-bold">{cat.avgScore}/100</span>
                  </div>
                </div>
                <div class="space-y-1">
                  <!-- Price Bar (scaled to max $50) -->
                  <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-600 rounded-full" style={`width: ${Math.min(100, (cat.avgPrice / 40) * 100)}%`}></div>
                  </div>
                  <!-- Score Bar (scaled 0-100) -->
                  <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full" style={`width: ${cat.avgScore}%`}></div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-600 flex items-center justify-between mt-4">
          <span>Higher quality scores correlate with transparent API pricing & open-source availability.</span>
          <a href="/categories" class="font-bold text-slate-900 hover:underline shrink-0 ml-2">All Categories &rarr;</a>
        </div>
      </section>

    </div>

    <!-- CHART 4: LLM PRICE-TO-PERFORMANCE SCATTER PLOT MATRIX -->
    <section class="card-aurora p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-purple-600"></span>
            <h2 class="text-xl font-black text-slate-900 tracking-tight">4. LLM Price-to-Performance Scatter Plot Matrix</h2>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">X-Axis: Input Cost per 1M Tokens ($) vs Y-Axis: Context Window Size (Tokens). Circle radius denotes reasoning output cost.</p>
        </div>

        <!-- Provider Filters -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono font-bold">
          <button type="button" class="provider-filter px-3 py-1 rounded-lg bg-slate-900 text-white cursor-pointer" data-provider="all">All ({OFFICIAL_MODELS.length})</button>
          <button type="button" class="provider-filter px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 cursor-pointer" data-provider="Anthropic">Anthropic</button>
          <button type="button" class="provider-filter px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 cursor-pointer" data-provider="OpenAI">OpenAI</button>
          <button type="button" class="provider-filter px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 cursor-pointer" data-provider="Google">Google</button>
          <button type="button" class="provider-filter px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 cursor-pointer" data-provider="DeepSeek">DeepSeek</button>
          <span id="scatterCountBadge" class="text-xs font-mono text-purple-600 font-bold ml-2">All {OFFICIAL_MODELS.length} Plotted</span>
        </div>
      </div>

      <!-- Scatter Plot Canvas & Interactive Stage -->
      <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 relative">
        <div class="h-80 sm:h-96 w-full relative">
          <svg id="scatterPlotSvg" class="w-full h-full overflow-visible" viewBox="0 0 800 320">
            <!-- Grid Lines -->
            <line x1="60" y1="20" x2="60" y2="280" stroke="#CBD5E1" stroke-width="1.5"/>
            <line x1="60" y1="280" x2="780" y2="280" stroke="#CBD5E1" stroke-width="1.5"/>

            <line x1="60" y1="215" x2="780" y2="215" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4,4"/>
            <line x1="60" y1="150" x2="780" y2="150" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4,4"/>
            <line x1="60" y1="85" x2="780" y2="85" stroke="#F1F5F9" stroke-width="1" stroke-dasharray="4,4"/>

            <!-- Y-Axis Labels (Context Window: 0 to 2M) -->
            <text x="50" y="284" font-size="9" text-anchor="end" fill="#64748B" font-family="monospace">0</text>
            <text x="50" y="219" font-size="9" text-anchor="end" fill="#64748B" font-family="monospace">128K</text>
            <text x="50" y="154" font-size="9" text-anchor="end" fill="#64748B" font-family="monospace">500K</text>
            <text x="50" y="89" font-size="9" text-anchor="end" fill="#64748B" font-family="monospace">1M</text>
            <text x="50" y="25" font-size="9" text-anchor="end" fill="#64748B" font-family="monospace">2M</text>

            <!-- X-Axis Labels (Cost: $0 to $15) -->
            <text x="60" y="300" font-size="9" text-anchor="middle" fill="#64748B" font-family="monospace">$0</text>
            <text x="240" y="300" font-size="9" text-anchor="middle" fill="#64748B" font-family="monospace">$2.50</text>
            <text x="420" y="300" font-size="9" text-anchor="middle" fill="#64748B" font-family="monospace">$5.00</text>
            <text x="600" y="300" font-size="9" text-anchor="middle" fill="#64748B" font-family="monospace">$10.00</text>
            <text x="780" y="300" font-size="9" text-anchor="middle" fill="#64748B" font-family="monospace">$15.00</text>

            <!-- Dynamic Model Dots -->
            {OFFICIAL_MODELS.map(m => {
              // Map input cost ($0 to $15) to X (60 to 780)
              const clampedCost = Math.min(15, m.inputCostPer1M);
              const cx = 60 + (clampedCost / 15) * 720;
              // Map context (0 to 2M) to Y (280 down to 20)
              const clampedCtx = Math.min(2000000, m.contextWindow);
              const cy = 280 - (clampedCtx / 2000000) * 260;
              
              // Provider color palette
              let color = '#2563EB'; // default
              if (m.provider === 'Anthropic') color = '#D97706';
              else if (m.provider === 'OpenAI') color = '#10B981';
              else if (m.provider === 'Google') color = '#4285F4';
              else if (m.provider === 'DeepSeek') color = '#0284C7';
              else if (m.provider === 'Meta') color = '#8B5CF6';

              return (
                <g class="model-scatter-dot transition-all cursor-pointer group" data-provider={m.provider} data-name={m.name} data-cost={m.inputCostPer1M} data-context={m.formattedContext}>
                  <circle 
                    cx={cx} 
                    cy={cy} 
                    r="7" 
                    fill={color} 
                    fill-opacity="0.8" 
                    stroke="#FFFFFF" 
                    stroke-width="1.5"
                    class="hover:r-10 transition-all duration-200"
                  />
                  <!-- Hover Label tooltip via SVG -->
                  <title>{`${m.name} (${m.provider})\nCost: $${m.inputCostPer1M}/1M | Context: ${m.formattedContext} tokens`}</title>
                </g>
              );
            })}
          </svg>
