        </div>
        <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg">
          Live Simulator
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Interactive Spend Form -->
        <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl p-6 shadow-xs space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-900 mb-1.5">SaaS Tool Seats (e.g. Cursor, Midjourney)</label>
              <input 
                type="number" 
                id="saasSeatsInput" 
                value="2" 
                min="0" 
                class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 rounded-xl p-2.5 text-xs text-slate-900 font-mono font-bold outline-none"
              />
