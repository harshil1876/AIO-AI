---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getAllTools, getAllCategories } from '../services/dataService';

const tools = await getAllTools();
const categories = await getAllCategories();
---

<Layout title="Admin Console | AI Discovery Platform">
  <div class="flex flex-col min-h-screen bg-canvas">
    <!-- Top Bar -->
    <header class="bg-canvas border-b border-hairline px-6 py-3.5 flex items-center justify-between sticky top-0 z-50">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-ink text-on-primary flex items-center justify-center text-xs font-bold">AI</span>
          <span class="text-ink font-semibold tracking-tight text-sm">AI Discovery Console</span>
        </a>
        <span class="text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-full font-mono">
          Supabase Connected
        </span>
      </div>

      <div class="flex items-center gap-3 text-xs">
        <a href="/" class="text-mute hover:text-ink transition-colors">← Back to Live Site</a>
      </div>
    </header>

    <div class="flex-1 max-w-7xl w-full mx-auto px-6 py-8">
      <!-- Stats Overview -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-canvas-elevated border border-hairline p-5 rounded-md shadow-xs">
          <div class="text-xs text-mute font-mono uppercase tracking-wider mb-1">Cataloged Tools</div>
          <div class="text-3xl font-semibold text-ink font-mono">{tools.length}</div>
        </div>
        <div class="bg-canvas-elevated border border-hairline p-5 rounded-md shadow-xs">
          <div class="text-xs text-mute font-mono uppercase tracking-wider mb-1">Active Categories</div>
          <div class="text-3xl font-semibold text-ink font-mono">{categories.length}</div>
        </div>
        <div class="bg-canvas-elevated border border-hairline p-5 rounded-md shadow-xs">
          <div class="text-xs text-mute font-mono uppercase tracking-wider mb-1">Database Sync</div>
          <div class="text-3xl font-semibold text-emerald-600 font-mono">Active</div>
        </div>
        <div class="bg-canvas-elevated border border-hairline p-5 rounded-md shadow-xs">
          <div class="text-xs text-mute font-mono uppercase tracking-wider mb-1">Verification Status</div>
          <div class="text-3xl font-semibold text-emerald-600 font-mono">100%</div>
        </div>
      </div>

      <!-- Live Tool Insertion Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-md p-6 mb-8 shadow-xs">
        <div class="flex items-center justify-between mb-4 border-b border-hairline pb-3">
          <div>
            <h2 class="text-base font-semibold text-ink">Add Verified AI Tool (Live Supabase Mutation)</h2>
            <p class="text-xs text-mute">Directly commit a new model or platform to your PostgreSQL database.</p>
          </div>
        </div>

        <div id="adminNotice" class="hidden mb-4 p-3 rounded-md text-xs font-medium"></div>

        <form id="addToolForm" class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div>
            <label class="block font-medium text-body mb-1">Tool Name *</label>
            <input type="text" id="toolName" placeholder="e.g. DeepSeek R1" class="w-full bg-canvas border border-hairline rounded-sm p-2 outline-none focus:border-ink" required />
          </div>

          <div>
            <label class="block font-medium text-body mb-1">Slug *</label>
            <input type="text" id="toolSlug" placeholder="e.g. deepseek-r1" class="w-full bg-canvas border border-hairline rounded-sm p-2 outline-none focus:border-ink font-mono" required />
          </div>

          <div>
            <label class="block font-medium text-body mb-1">Official Website URL *</label>
            <input type="url" id="toolUrl" placeholder="https://chat.deepseek.com" class="w-full bg-canvas border border-hairline rounded-sm p-2 outline-none focus:border-ink" required />
          </div>

          <div class="md:col-span-2">
            <label class="block font-medium text-body mb-1">Tagline *</label>
            <input type="text" id="toolTagline" placeholder="Breakthrough open-weights reasoning model..." class="w-full bg-canvas border border-hairline rounded-sm p-2 outline-none focus:border-ink" required />
          </div>

          <div>
            <label class="block font-medium text-body mb-1">Pricing Model *</label>
            <select id="toolPricing" class="w-full bg-canvas border border-hairline rounded-sm p-2 outline-none focus:border-ink">
              <option value="Free">Free</option>
              <option value="Freemium" selected>Freemium</option>
              <option value="Paid">Paid</option>
              <option value="Open Source">Open Source</option>
            </select>
          </div>

          <div class="md:col-span-3 flex justify-end">
            <button type="submit" id="submitToolBtn" class="bg-ink text-on-primary font-medium px-5 py-2 rounded-pill hover:bg-black transition-colors cursor-pointer">
              Commit Tool to Supabase
            </button>
          </div>
        </form>
      </div>

      <!-- Manage Existing Tools Table -->
      <div class="bg-canvas-elevated border border-hairline rounded-md shadow-xs overflow-hidden">
        <div class="px-6 py-4 border-b border-hairline flex items-center justify-between">
          <h2 class="text-sm font-semibold text-ink">Cataloged Tools ({tools.length})</h2>
          <span class="text-xs text-mute font-mono">Drizzle / PostgreSQL Synced</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead class="bg-canvas text-mute font-mono border-b border-hairline">
              <tr>
                <th class="px-6 py-3 font-medium">Tool Name</th>
                <th class="px-6 py-3 font-medium">Slug</th>
                <th class="px-6 py-3 font-medium">Pricing</th>
                <th class="px-6 py-3 font-medium">Score</th>
                <th class="px-6 py-3 font-medium">Verified</th>
                <th class="px-6 py-3 font-medium text-right">Action</th>
              </tr>
            </thead>
            <tbody class="text-body divide-y divide-hairline" id="adminToolsTableBody">
              {tools.map(tool => (
                <tr class="hover:bg-canvas transition-colors">
                  <td class="px-6 py-3 font-semibold text-ink">
                    <a href={`/tools/${tool.slug}`} class="hover:text-link transition-colors">
                      {tool.name}
                    </a>
                  </td>
                  <td class="px-6 py-3 font-mono text-mute">{tool.slug}</td>
                  <td class="px-6 py-3">
                    <span class="px-2 py-0.5 rounded-full border border-hairline font-mono text-[10px]">
                      {tool.pricingType}
                    </span>
                  </td>
                  <td class="px-6 py-3 font-mono font-bold text-ink">{tool.platformScore}/100</td>
                  <td class="px-6 py-3">
                    <span class="text-emerald-600 font-medium">✓ Verified</span>
                  </td>
                  <td class="px-6 py-3 text-right">
                    <a href={tool.websiteUrl} target="_blank" rel="noopener noreferrer" class="text-link hover:underline">
                      Visit ↗
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('addToolForm') as HTMLFormElement;
  const nameInput = document.getElementById('toolName') as HTMLInputElement;
  const slugInput = document.getElementById('toolSlug') as HTMLInputElement;
  const urlInput = document.getElementById('toolUrl') as HTMLInputElement;
  const taglineInput = document.getElementById('toolTagline') as HTMLInputElement;
  const pricingInput = document.getElementById('toolPricing') as HTMLSelectElement;
  const submitBtn = document.getElementById('submitToolBtn') as HTMLButtonElement;
  const notice = document.getElementById('adminNotice') as HTMLDivElement;
  const tableBody = document.getElementById('adminToolsTableBody') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving to Supabase...';
    notice.classList.add('hidden');

    const name = nameInput.value.trim();
    const slug = slugInput.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
    const website_url = urlInput.value.trim();
    const tagline = taglineInput.value.trim();
    const pricing_type = pricingInput.value;

    const { data, error } = await supabase.from('tools').insert([
      {
        name,
        slug,
        website_url,
        tagline,
        pricing_type,
        is_verified: true,
        platform_score: 95
      }
    ]).select();

    submitBtn.disabled = false;
    submitBtn.textContent = 'Commit Tool to Supabase';

    if (error) {
      notice.textContent = `Supabase Error: ${error.message}`;
      notice.className = 'mb-4 p-3 rounded-md text-xs font-medium bg-red-50 text-red-700 border border-red-200';
      notice.classList.remove('hidden');
    } else {
      notice.textContent = `Successfully added "${name}" directly to your Supabase PostgreSQL database!`;
      notice.className = 'mb-4 p-3 rounded-md text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200';
      notice.classList.remove('hidden');

      // Add to table
      const newRow = document.createElement('tr');
      newRow.className = 'bg-emerald-50/30 transition-colors';
      newRow.innerHTML = `
        <td class="px-6 py-3 font-semibold text-ink">
          <a href="/tools/${slug}" class="hover:text-link transition-colors">${name}</a>
        </td>
        <td class="px-6 py-3 font-mono text-mute">${slug}</td>
        <td class="px-6 py-3">
          <span class="px-2 py-0.5 rounded-full border border-hairline font-mono text-[10px]">${pricing_type}</span>
        </td>
        <td class="px-6 py-3 font-mono font-bold text-ink">95/100</td>
        <td class="px-6 py-3">
          <span class="text-emerald-600 font-medium">✓ Verified</span>
        </td>
        <td class="px-6 py-3 text-right">
          <a href="${website_url}" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">Visit ↗</a>
        </td>
      `;
      tableBody?.prepend(newRow);
      form.reset();
    }
  });
</script>
