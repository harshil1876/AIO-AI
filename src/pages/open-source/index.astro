---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RepoQuickstartDrawer from '../../components/RepoQuickstartDrawer.astro';
import { OPEN_SOURCE_REPOS } from '../../data/openSourceData';
import { HARDWARE_PRESETS } from '../../services/githubLiveService';

const categories = [
  'All',
  'Local Inference',
  'Local LLMs',
  'Agent Frameworks',
  'AI Coding',
  'Voice & Audio',
  'Image/Video/3D',
  'RAG & Vector DBs',
  'Robotics & Embodied AI',
  'Fine-Tuning & Eval'
];

// Parse minimum VRAM as numeric GB for hardware matching
function parseVramGb(vramStr?: string): number {
  if (!vramStr) return 8;
  const num = parseInt(vramStr.replace(/[^0-9]/g, ''));
  return isNaN(num) ? 8 : num;
}
---

<Layout 
  title="Open-Source AI Hub | 88 Verified Flagship Repositories & Local Setup"
  description="Explore 88 verified self-hostable open-source AI projects. Compare VRAM requirements, Docker quickstart commands, and hardware compatibility."
>
  <Header currentPath="/open-source" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-10">
    
    <!-- Hero Header -->
    <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-emerald-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-400/30 bg-emerald-500/10 text-[11px] font-mono font-bold text-emerald-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>88 VERIFIED REPOSITORIES • LOCAL HARDWARE ENGINE</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            Open-Source AI Hub
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            Curated registry of self-hostable LLM engines, autonomous agent frameworks, local diffusion GUIs, and vector engines with zero cloud telemetry.
          </p>
        </div>

        <!-- Hardware & PC Selector ("Can My PC Run This?") -->
        <div class="bg-slate-900/80 backdrop-blur-md border border-slate-700/70 rounded-2xl p-4 w-full md:w-80 shadow-md">
          <label class="block text-[11px] font-mono uppercase tracking-wider text-slate-400 mb-1.5 font-bold">
            Can My PC Run This? (Select GPU/RAM)
          </label>
          <select 
            id="hardwareSelector" 
            class="w-full bg-slate-800 border border-slate-600 text-white text-xs rounded-xl p-2.5 outline-none hover:border-slate-400 transition-colors font-medium cursor-pointer"
          >
            {HARDWARE_PRESETS.map(hw => (
              <option value={hw.id}>{hw.label}</option>
            ))}
          </select>
          <div class="text-[10px] text-slate-400 font-mono mt-2 flex items-center justify-between">
            <span>Dynamic Quantization Verdict</span>
            <span id="hardwareSummaryBadge" class="text-emerald-400 font-bold">All Presets</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Search & Safety Gate Bar -->
    <section class="card-aurora p-4 sm:p-5 flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Live Search Input -->
      <div class="relative w-full md:w-96">
        <input 
          type="text" 
          id="ghLiveSearchInput" 
          placeholder="Search 88 repos (e.g. vllm, comfyui, whisper, ollama)..." 
          class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-900 text-xs focus:outline-none focus:border-blue-600 font-sans shadow-xs font-medium"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </div>

      <!-- Action Strip: Trending Shortcut & Safety Guard -->
      <div class="flex flex-wrap items-center gap-3 w-full md:w-auto justify-end">
        <a 
          href="/trending" 
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-blue-600 text-white font-bold text-xs transition-colors shadow-xs shrink-0"
        >
          <span>🔥 GitHub Trending &rarr;</span>
        </a>

        <!-- Safety Guard Banner -->
        <div class="flex items-center gap-2 text-xs font-mono text-emerald-800 bg-emerald-50 border border-emerald-200 px-3.5 py-2 rounded-xl">
          <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
          <span>Safety Gate: <strong>&ge; 1,000 Stars</strong></span>
        </div>
      </div>
    </section>

    <!-- Category Filter Bar -->
    <section class="flex items-center justify-between gap-4 overflow-x-auto pb-1" id="catFilterBar">
      <div class="flex items-center gap-2 shrink-0">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class={`cat-pill px-3.5 py-1.5 rounded-xl text-xs font-bold cursor-pointer transition-all ${
              idx === 0 
                ? 'bg-slate-900 text-white shadow-xs' 
                : 'bg-white text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-300'
            }`}
            data-cat={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </section>

    <!-- Pagination Status Header & Page Size Selector -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-500 font-mono" id="repoPaginationStatusHeader">
      <div id="repoRangeIndicator">
        Showing 1–16 of {OPEN_SOURCE_REPOS.length} Verified Open-Source Repositories (Page 1 of {Math.ceil(OPEN_SOURCE_REPOS.length / 16)})
      </div>

      <div class="flex items-center gap-2 self-start sm:self-auto">
        <label for="reposPerPageSelect" class="text-slate-500 font-bold">Repos per page:</label>
        <select id="reposPerPageSelect" class="bg-white border border-slate-200 rounded-lg px-2.5 py-1 text-xs text-slate-800 font-bold outline-none cursor-pointer">
          <option value="16" selected>16</option>
          <option value="32">32</option>
          <option value="48">48</option>
          <option value="all">All (88)</option>
        </select>
      </div>
    </div>

    <!-- Repos Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5" id="reposGrid">
      {OPEN_SOURCE_REPOS.map((repo) => {
        const minVram = parseVramGb(repo.hardwareSpecs?.minVramGb);
        const [owner, name] = (repo.repo || '').split('/');
        return (
          <article 
            class="repo-card bg-white border border-slate-200 hover:border-blue-500 rounded-2xl p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between"
            data-category={repo.category}
            data-vram={minVram}
            data-owner={owner || ''}
            data-repo={name || repo.slug}
            data-name={repo.name.toLowerCase()}
            data-desc={(repo.oneMinuteSummary || repo.description || '').toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono mb-2.5">
                <span class="text-slate-700 font-bold uppercase text-[10px] bg-slate-100 px-2 py-0.5 rounded-md border border-slate-200">
                  {repo.category}
                </span>
                <span class="font-bold text-slate-900 live-stars">★ {repo.stars}</span>
              </div>

              <h2 class="text-base font-black text-slate-900 mb-1 hover:text-blue-600 transition-colors">
                <a href={`/open-source/${repo.slug}`}>
                  {repo.name}
                </a>
              </h2>

              <p class="text-xs text-slate-500 line-clamp-3 mb-3 leading-relaxed">
                {repo.oneMinuteSummary || repo.description}
              </p>

              <!-- Hardware Compatibility Verdict Badge ("Can My PC Run This?") -->
              <div class="hardware-verdict-badge mb-3 p-2 rounded-xl text-[10px] font-mono font-bold flex items-center justify-between border bg-emerald-50 text-emerald-800 border-emerald-200">
                <span class="verdict-label">Runs Smoothly (FP16)</span>
                <span class="verdict-vram">{repo.hardwareSpecs?.minVramGb || '8GB VRAM'}</span>
              </div>

              <!-- Replaces commercial tool badge -->
              <div class="p-2 rounded-xl bg-slate-50 border border-slate-200 text-[11px] text-slate-600 mb-3 truncate">
                <span class="text-slate-400 font-mono text-[10px] block">Replaces:</span>
                <span class="font-bold text-slate-900 truncate block">{repo.replacesCommercialTool || repo.commercialReplaces || 'Proprietary Cloud SaaS'}</span>
              </div>

              <!-- Quick Command Snippet -->
              <div class="p-2 rounded-xl bg-slate-900 text-slate-200 font-mono text-[10px] truncate mb-3 flex items-center justify-between">
                <span class="truncate">{repo.quickstartCommands?.cli || repo.quickstartCommands?.docker || 'git clone ' + repo.url}</span>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <button 
                type="button" 
                class="quickstart-trigger-btn font-mono text-[11px] font-bold text-blue-700 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-2.5 py-1 rounded-lg transition-colors cursor-pointer inline-flex items-center gap-1"
                data-repo-json={JSON.stringify(repo)}
              >
                <span>&gt;_ Quickstart</span>
              </button>
              <a 
                href={`/open-source/${repo.slug}`} 
                class="font-bold text-slate-900 hover:text-blue-600 hover:underline inline-flex items-center gap-0.5"
              >
                Setup Guide &rarr;
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- PAGINATION CONTROLS BAR -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-200" id="repoPaginationFooter">
      <div class="text-xs font-mono text-slate-500" id="repoPaginationBottomCounter">
        Page 1 of {Math.ceil(OPEN_SOURCE_REPOS.length / 16)}
      </div>

      <div class="flex items-center gap-1.5 font-mono text-xs" id="repoPaginationControls">
        <!-- Buttons injected dynamically by script -->
      </div>
    </div>

  </main>

  <RepoQuickstartDrawer />
  <Footer />
</Layout>

<script>
  import { HARDWARE_PRESETS, checkHardwareCompatibility, fetchLiveRepoStats, searchGitHubAIRepos } from '../../services/githubLiveService';

  document.addEventListener('DOMContentLoaded', () => {
    const selector = document.getElementById('hardwareSelector') as HTMLSelectElement | null;
    const summaryBadge = document.getElementById('hardwareSummaryBadge');
    const reposGrid = document.getElementById('reposGrid');
    const repoCards = Array.from(document.querySelectorAll<HTMLElement>('.repo-card'));
    const catPills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
    const searchInput = document.getElementById('ghLiveSearchInput') as HTMLInputElement | null;
    const perPageSelect = document.getElementById('reposPerPageSelect') as HTMLSelectElement | null;
    const paginationControls = document.getElementById('repoPaginationControls');
    const rangeIndicator = document.getElementById('repoRangeIndicator');
    const bottomCounter = document.getElementById('repoPaginationBottomCounter');

    let activeCat = 'All';
    let searchQuery = '';
    let currentPage = 1;
    let itemsPerPage: number | 'all' = 16;
    let filteredCards: HTMLElement[] = [...repoCards];

    function applyPagination() {
      // 1. Filter cards by Category & Query
      filteredCards = repoCards.filter(card => {
        const cat = card.getAttribute('data-category') || '';
        const name = card.getAttribute('data-name') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matchesCat = activeCat === 'All' || cat.toLowerCase().includes(activeCat.toLowerCase());
        const matchesQuery = !searchQuery || name.includes(searchQuery) || desc.includes(searchQuery);

        return matchesCat && matchesQuery;
      });

      const totalItems = filteredCards.length;
      const pageSize = itemsPerPage === 'all' ? totalItems : Number(itemsPerPage);
      const totalPages = Math.max(1, Math.ceil(totalItems / (pageSize || 1)));

      if (currentPage > totalPages) currentPage = 1;

      const startIndex = (currentPage - 1) * pageSize;
      const endIndex = itemsPerPage === 'all' ? totalItems : Math.min(startIndex + pageSize, totalItems);

      // Hide all cards first
      repoCards.forEach(c => c.style.display = 'none');

      // Show cards in current slice
      filteredCards.slice(startIndex, endIndex).forEach(card => {
        card.style.display = 'flex';
      });

      // Update counters
      const displayStart = totalItems === 0 ? 0 : startIndex + 1;
      const displayEnd = endIndex;
      if (rangeIndicator) {
        rangeIndicator.textContent = `Showing ${displayStart}–${displayEnd} of ${totalItems} Verified Repositories (Page ${currentPage} of ${totalPages})`;
      }
      if (bottomCounter) {
        bottomCounter.textContent = `Page ${currentPage} of ${totalPages}`;
      }

      // Render Pagination Buttons
      renderPaginationControls(totalPages);
    }

    function renderPaginationControls(totalPages: number) {
      if (!paginationControls) return;

      if (totalPages <= 1) {
        paginationControls.innerHTML = '';
        return;
      }

      let html = '';

      // Prev Button
      html += `<button type="button" data-page="prev" class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-bold transition-colors cursor-pointer ${
        currentPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-100 text-slate-400' : 'bg-white hover:bg-slate-50 text-slate-800'
      }" ${currentPage === 1 ? 'disabled' : ''}>← Prev</button>`;

      // Numbered Page Buttons
      for (let p = 1; p <= totalPages; p++) {
        const isActive = p === currentPage;
        html += `<button type="button" data-page="${p}" class="w-8 h-8 rounded-lg text-xs font-bold transition-all cursor-pointer ${
          isActive 
            ? 'bg-blue-600 text-white shadow-xs' 
            : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'
        }">${p}</button>`;
      }

      // Next Button
      html += `<button type="button" data-page="next" class="px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-bold transition-colors cursor-pointer ${
        currentPage === totalPages ? 'opacity-40 cursor-not-allowed bg-slate-100 text-slate-400' : 'bg-white hover:bg-slate-50 text-slate-800'
      }" ${currentPage === totalPages ? 'disabled' : ''}>Next →</button>`;

      paginationControls.innerHTML = html;
    }

    // Delegated click handler on pagination controls
    paginationControls?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>('[data-page]');
      if (!btn || btn.disabled) return;

      const action = btn.getAttribute('data-page');
      const totalItems = filteredCards.length;
      const pageSize = itemsPerPage === 'all' ? totalItems : Number(itemsPerPage);
      const totalPages = Math.max(1, Math.ceil(totalItems / (pageSize || 1)));

      if (action === 'prev') {
        if (currentPage > 1) {
          currentPage--;
          applyPagination();
          scrollToTop();
        }
      } else if (action === 'next') {
        if (currentPage < totalPages) {
          currentPage++;
          applyPagination();
          scrollToTop();
        }
      } else if (action) {
        const p = Number(action);
        if (p && p !== currentPage) {
          currentPage = p;
          applyPagination();
          scrollToTop();
        }
      }
    });

    function scrollToTop() {
      const topEl = document.getElementById('repoPaginationStatusHeader');
      if (topEl) {
        topEl.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Per Page Select Handler
    perPageSelect?.addEventListener('change', () => {
      const val = perPageSelect.value;
      itemsPerPage = val === 'all' ? 'all' : Number(val);
      currentPage = 1;
      applyPagination();
    });

    // Category Buttons
    catPills.forEach(pill => {
      pill.addEventListener('click', () => {
        catPills.forEach(p => {
          p.className = 'cat-pill px-3.5 py-1.5 rounded-xl text-xs font-bold cursor-pointer transition-all bg-white text-slate-600 hover:text-slate-900 border border-slate-200 hover:border-slate-300';
        });
        pill.className = 'cat-pill px-3.5 py-1.5 rounded-xl text-xs font-bold cursor-pointer transition-all bg-slate-900 text-white shadow-xs';
        activeCat = pill.getAttribute('data-cat') || 'All';
        currentPage = 1;
        applyPagination();
      });
    });

    // Search Input Handler
    searchInput?.addEventListener('input', (e: any) => {
      searchQuery = e.target.value.toLowerCase().trim();
      currentPage = 1;
      applyPagination();
    });

    // Hardware Compatibility Evaluator
    function updateHardwareVerdicts(presetId: string) {
      const preset = HARDWARE_PRESETS.find(p => p.id === presetId) || HARDWARE_PRESETS[0];
      if (summaryBadge) summaryBadge.textContent = preset.id === 'all' ? 'All Hardware' : `${preset.vramGb}GB Allocated`;

      repoCards.forEach(card => {
        const minVram = Number(card.getAttribute('data-vram')) || 8;
        const badge = card.querySelector('.hardware-verdict-badge');
        const label = card.querySelector('.verdict-label');
        
        if (badge && label) {
          const result = checkHardwareCompatibility(minVram, presetId);
          label.textContent = result.label;
          badge.className = `hardware-verdict-badge mb-3 p-2 rounded-xl text-[10px] font-mono font-bold flex items-center justify-between border ${result.badgeClass}`;
        }
      });
    }

    selector?.addEventListener('change', () => {
      updateHardwareVerdicts(selector.value);
    });

    // Quickstart Drawer click handler
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest('.quickstart-trigger-btn');
      if (btn) {
        const raw = btn.getAttribute('data-repo-json');
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            if ((window as any).aioOpenQuickstartDrawer) {
              (window as any).aioOpenQuickstartDrawer(parsed);
            }
          } catch(err) {}
        }
      }
    });

    // Initialize
    updateHardwareVerdicts(selector?.value || 'all');
    applyPagination();
  });
</script>
