---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OPEN_SOURCE_REPOS } from '../../data/openSourceData';

const categories = ['All', 'LLM Runtimes', 'Agent Frameworks', 'Image & Video Gen', 'RAG & Vector DBs', 'Voice & Audio', 'UI Frontends', 'Coding Agents'];
---

<Layout 
  title="Open-Source AI Hub | 20+ Flagship Repositories & Local Setup"
  description="Explore 20+ flagship self-hostable open-source AI projects. Compare VRAM requirements, Docker quickstart commands, and commercial SaaS replacements."
>
  <Header currentPath="/open-source" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-4 sm:px-6 py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-200 bg-purple-50 text-xs font-semibold text-purple-700 mb-4 shadow-xs font-mono">
          <span>20+ FLAGSHIP OPEN-SOURCE AI REPOSITORIES</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-ink tracking-tight mb-3">
          Open-Source AI Hub
        </h1>
        <p class="text-slate-600 text-sm sm:text-base max-w-2xl leading-relaxed">
          The comprehensive index of self-hostable AI runtimes, agent frameworks, local diffusion GUIs, and vector engines. Includes VRAM hardware specifications and instant CLI setup commands.
        </p>
      </div>
    </section>

    <!-- Repos Grid -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-12 flex-1">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {OPEN_SOURCE_REPOS.map((repo) => (
          <article class="bg-white border border-[#E2E8F0] hover:border-purple-300 rounded-2xl p-6 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs font-mono mb-2.5">
                <span class="text-purple-700 font-semibold uppercase text-[10px] bg-purple-50 px-2.5 py-0.5 rounded-full border border-purple-100">
                  {repo.category}
                </span>
                <span class="font-semibold text-slate-700">★ {repo.stars}</span>
              </div>

              <h2 class="text-base font-bold text-ink mb-1.5 hover:text-purple-700 transition-colors">
                <a href={`/open-source/${repo.slug}`}>
                  {repo.name}
                </a>
              </h2>

              <p class="text-xs text-slate-600 line-clamp-3 mb-3 leading-relaxed">
                {repo.oneMinuteSummary || repo.description}
              </p>

              <!-- One minute replacement notice -->
              <div class="p-2.5 rounded-xl bg-emerald-50/70 border border-emerald-200/80 text-[11px] text-emerald-800 font-medium mb-3">
                {repo.replacesCommercialTool}
              </div>

              <!-- Quick Command Snippet -->
              <div class="p-2.5 rounded-xl bg-[#F8FAFF] border border-[#E2E8F0] font-mono text-[10px] text-slate-700 truncate mb-3">
                {repo.quickstartCommands?.cli || repo.quickstartCommands?.docker || 'git clone ' + repo.url}
              </div>
            </div>

            <div class="pt-3 border-t border-[#E2E8F0] flex items-center justify-between text-xs">
              <span class="text-[10px] font-mono text-slate-500">
                {repo.hardwareSpecs?.minVramGb}
              </span>
              <a 
                href={`/open-source/${repo.slug}`} 
                class="font-semibold text-purple-700 hover:text-purple-800 hover:underline inline-flex items-center gap-0.5"
              >
                Setup Guide &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
