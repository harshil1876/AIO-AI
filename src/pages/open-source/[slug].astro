---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OPEN_SOURCE_REPOS, type OpenSourceRepo } from '../../data/openSourceData';
import { TOOLS_DATA } from '../../data/seedData';
import { WORKFLOWS_DATA } from '../../data/workflowsData';

export function getStaticPaths() {
  return OPEN_SOURCE_REPOS.map((repo) => ({
    params: { slug: repo.slug },
    props: { repo }
  }));
}

interface Props {
  repo: OpenSourceRepo;
}

const { repo } = Astro.props;

// Find connected tools & workflows
const matchingTools = TOOLS_DATA.filter(t => 
  t.slug === repo.slug || 
  t.name.toLowerCase() === repo.name.toLowerCase() ||
  repo.replacesCommercialTool?.toLowerCase().includes(t.name.toLowerCase())
);

const matchingWorkflows = WORKFLOWS_DATA.filter(w => 
  w.toolsUsed?.some(t => t.slug === repo.slug || t.name.toLowerCase() === repo.name.toLowerCase()) ||
  w.budgetVariants?.free?.stack?.some(s => s.toLowerCase().includes(repo.name.toLowerCase()))
);
---

<Layout 
  title={`${repo.name} | Open-Source AI Repo & 3-Layer Setup Guide`}
  description={repo.description}
>
  <Header currentPath="/open-source" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Breadcrumb -->
    <div class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-4 sm:px-6 py-3">
      <div class="max-w-5xl w-full mx-auto flex items-center gap-2 text-xs font-mono text-slate-500">
        <a href="/" class="hover:text-ink transition-colors">HOME</a>
        <span>/</span>
        <a href="/open-source" class="hover:text-ink transition-colors">OPEN SOURCE</a>
        <span>/</span>
        <span class="text-ink font-bold uppercase truncate">{repo.name}</span>
      </div>
    </div>

    <!-- Header Banner -->
    <section class="max-w-5xl w-full mx-auto px-4 sm:px-6 py-10">
      <div class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 pb-6 border-b border-[#E2E8F0]">
          <div>
            <div class="flex flex-wrap items-center gap-2.5 mb-2">
              <h1 class="text-2xl sm:text-4xl font-black text-ink tracking-tight">
                {repo.name}
              </h1>
              <span class="px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-purple-50 text-purple-700 border border-purple-200 uppercase">
                {repo.category}
              </span>
              <span class="px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-slate-100 text-slate-700 border border-slate-300">
                {repo.license}
              </span>
            </div>
            
            <div class="text-xs font-mono text-slate-500 mb-3">{repo.repo} &bull; Primary: {repo.language}</div>
            <p class="text-sm text-slate-700 leading-relaxed max-w-2xl">
              {repo.description}
            </p>
          </div>

          <div class="shrink-0 flex items-center gap-3">
            <a 
              href={repo.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="bg-[#09090B] hover:bg-neutral-800 text-white font-mono font-bold text-xs px-5 py-2.5 rounded-lg shadow-[3px_3px_0px_0px_#7C3AED] border-2 border-[#09090B] transition-all inline-flex items-center gap-2"
            >
              <span>GitHub Repo</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- 4-Stat Public Metrics Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 text-center font-mono">
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-ink">★ {repo.stars}</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">GitHub Stars</div>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-purple-700">{repo.forks}</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">Forks</div>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-slate-800">{repo.hardwareSpecs?.minVramGb}</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">Min VRAM</div>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-emerald-700">{repo.difficulty}</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">Difficulty</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3-LAYER INFORMATION ARCHITECTURE -->
    <div class="max-w-5xl w-full mx-auto px-4 sm:px-6 pb-16 flex-1 space-y-10">

      <!-- LAYER 1: 1-MINUTE PLAIN-ENGLISH SUMMARY -->
      <section class="bg-[#F8FAFF] border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[5px_5px_0px_0px_#09090B]">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-3 h-3 bg-purple-700"></span>
          <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-purple-700">
            Layer 1: 1-Minute Plain-English Summary (For Beginners)
          </h2>
        </div>
        <h3 class="text-xl font-bold text-ink mb-3">What does {repo.name} do, and why should you use it?</h3>
        
        <p class="text-sm text-slate-800 leading-relaxed mb-6 font-normal">
          {repo.oneMinuteSummary}
        </p>

        <!-- Replaces commercial tool badge -->
        <div class="p-4 rounded-xl bg-emerald-50 border-2 border-emerald-300 text-xs sm:text-sm text-emerald-900 font-medium flex items-center justify-between gap-4">
          <div>
            <strong class="font-bold text-emerald-950 uppercase tracking-wider text-[11px] block font-mono">Commercial SaaS It Replaces:</strong>
            <span>{repo.replacesCommercialTool}</span>
          </div>
          <span class="text-xs font-bold text-emerald-800 font-mono shrink-0">100% Free Forever</span>
        </div>
      </section>

      <!-- LAYER 2: PRACTICAL QUICKSTART & CLI SETUP GUIDE -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[5px_5px_0px_0px_#09090B]">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-3 h-3 bg-[#2563EB]"></span>
          <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-[#2563EB]">
            Layer 2: Practical Quickstart & Setup Commands
          </h2>
        </div>
        <h3 class="text-xl font-bold text-ink mb-4">Run {repo.name} in 60 Seconds</h3>

        <div class="space-y-4">
          {repo.quickstartCommands?.cli && (
            <div>
              <span class="text-xs font-mono uppercase font-bold text-slate-600 block mb-1">CLI Terminal Command:</span>
              <div class="flex items-center justify-between p-3.5 rounded-lg bg-[#09090B] text-white font-mono text-xs overflow-x-auto">
                <span>{repo.quickstartCommands.cli}</span>
                <button type="button" class="copy-cmd-btn text-[11px] font-mono text-[#2563EB] hover:underline font-bold ml-3 shrink-0 cursor-pointer" data-cmd={repo.quickstartCommands.cli}>
                  Copy
                </button>
              </div>
            </div>
          )}

          {repo.quickstartCommands?.docker && (
            <div>
              <span class="text-xs font-mono uppercase font-bold text-slate-600 block mb-1">Docker Compose / Run Command:</span>
              <div class="flex items-center justify-between p-3.5 rounded-lg bg-[#09090B] text-white font-mono text-xs overflow-x-auto">
                <span class="truncate max-w-xl">{repo.quickstartCommands.docker}</span>
                <button type="button" class="copy-cmd-btn text-[11px] font-mono text-[#2563EB] hover:underline font-bold ml-3 shrink-0 cursor-pointer" data-cmd={repo.quickstartCommands.docker}>
                  Copy
                </button>
              </div>
            </div>
          )}

          {repo.quickstartCommands?.gitClone && (
            <div>
              <span class="text-xs font-mono uppercase font-bold text-slate-600 block mb-1">Git Clone Command:</span>
              <div class="flex items-center justify-between p-3.5 rounded-lg bg-[#09090B] text-white font-mono text-xs overflow-x-auto">
                <span>{repo.quickstartCommands.gitClone}</span>
                <button type="button" class="copy-cmd-btn text-[11px] font-mono text-[#2563EB] hover:underline font-bold ml-3 shrink-0 cursor-pointer" data-cmd={repo.quickstartCommands.gitClone}>
                  Copy
                </button>
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- LAYER 3: HARDWARE, VRAM & DEVELOPER METADATA -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[5px_5px_0px_0px_#09090B]">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-3 h-3 bg-slate-800"></span>
          <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-700">
            Layer 3: Hardware, VRAM & Developer Specifications
          </h2>
        </div>
        <h3 class="text-xl font-bold text-ink mb-4">Production Hardware Requirements</h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 font-mono text-xs mb-6">
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <span class="text-slate-500 uppercase font-bold text-[10px] block mb-1">Minimum VRAM:</span>
            <span class="text-ink font-bold">{repo.hardwareSpecs?.minVramGb}</span>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <span class="text-slate-500 uppercase font-bold text-[10px] block mb-1">Recommended GPU:</span>
            <span class="text-ink font-bold">{repo.hardwareSpecs?.recommendedGpu}</span>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <span class="text-slate-500 uppercase font-bold text-[10px] block mb-1">Minimum RAM:</span>
            <span class="text-ink font-bold">{repo.hardwareSpecs?.minRamGb}</span>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <span class="text-slate-500 uppercase font-bold text-[10px] block mb-1">Verified Freshness:</span>
            <span class="text-emerald-700 font-bold">{repo.verifiedAt}</span>
          </div>
        </div>

        <div class="pt-4 border-t border-[#E2E8F0]">
          <span class="text-xs font-mono uppercase font-bold text-slate-600 block mb-2">Supported Deployment Modes:</span>
          <div class="flex flex-wrap gap-2">
            {repo.hardwareSpecs?.deploymentModes?.map(mode => (
              <span class="px-2.5 py-1 rounded-md bg-[#EFF6FF] text-[#2563EB] font-mono text-xs font-semibold border border-[#BFDBFE]">
                &bull; {mode}
              </span>
            ))}
          </div>
        </div>
      </section>

      <!-- Connected Workflows Using this Repo -->
      {matchingWorkflows.length > 0 && (
        <section class="bg-[#F8FAFF] border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B]">
          <h2 class="text-base font-black text-ink mb-4 font-mono uppercase flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-emerald-600"></span>
            <span>Production Workflows Using {repo.name}:</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {matchingWorkflows.map(wf => (
              <a 
                href={`/workflows/${wf.id}`}
                class="bg-white border-2 border-[#09090B] p-4 rounded-xl hover:shadow-[4px_4px_0px_0px_#2563EB] transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono mb-1">
                    <span class="text-emerald-700 font-bold uppercase">{wf.category}</span>
                    <span class="text-slate-500">{wf.difficulty}</span>
                  </div>
                  <h3 class="font-bold text-ink text-sm">{wf.title}</h3>
                  <p class="text-xs text-slate-600 line-clamp-2 mt-1">{wf.goal}</p>
                </div>
                <div class="mt-3 text-xs font-bold text-[#2563EB] hover:underline">
                  View Full Workflow Blueprint &rarr;
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

<script>
  function setupCopyButtons() {
    const btns = document.querySelectorAll('.copy-cmd-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-cmd') || '';
        navigator.clipboard.writeText(cmd).then(() => {
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopyButtons);
  } else {
    setupCopyButtons();
  }
</script>
