---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OPEN_SOURCE_REPOS, type OpenSourceRepo } from '../../data/openSourceData';
import { TOOLS_DATA } from '../../data/seedData';

export function getStaticPaths() {
  return OPEN_SOURCE_REPOS.map((repo) => {
    const slug = repo.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    return {
      params: { slug },
      props: { repo, slug }
    };
  });
}

interface Props {
  repo: OpenSourceRepo;
  slug: string;
}

const { repo, slug } = Astro.props;

// Find connected tool in seedData if one exists
const matchingTool = TOOLS_DATA.find(t => 
  t.slug === slug || 
  t.name.toLowerCase() === repo.name.toLowerCase()
);
---

<Layout 
  title={`${repo.name} | Open-Source AI Repository & Local Guide`}
  description={repo.description}
>
  <Header currentPath="/open-source" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Breadcrumb -->
    <div class="max-w-5xl w-full mx-auto px-6 pt-8 pb-4">
      <a 
        href="/open-source" 
        class="inline-flex items-center gap-1.5 text-xs text-mute hover:text-ink transition-colors font-medium group"
      >
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span>Back to Open Source Hub</span>
      </a>
    </div>

    <!-- Header Banner -->
    <section class="max-w-5xl w-full mx-auto px-6 pb-8">
      <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 pb-6 border-b border-hairline">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-2xl md:text-4xl font-semibold text-ink tracking-tight">
                {repo.name}
              </h1>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-canvas border border-hairline text-body">
                {repo.license}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                {repo.difficulty} Setup
              </span>
            </div>
            <p class="text-xs text-mute font-mono mb-3">{repo.repo}</p>
            <p class="text-sm text-body leading-relaxed max-w-2xl">
              {repo.description}
            </p>
          </div>

          <a 
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors shadow-xs shrink-0 self-start"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>View on GitHub ({repo.stars})</span>
          </a>
        </div>

        <!-- Repository Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6 text-xs">
          <div>
            <span class="text-faint text-[10px] uppercase tracking-wider block mb-0.5">Stars</span>
            <span class="font-semibold text-ink font-mono text-base">{repo.stars}</span>
          </div>
          <div>
            <span class="text-faint text-[10px] uppercase tracking-wider block mb-0.5">Forks</span>
            <span class="font-semibold text-ink font-mono text-base">{repo.forks}</span>
          </div>
          <div>
            <span class="text-faint text-[10px] uppercase tracking-wider block mb-0.5">Language</span>
            <span class="font-semibold text-ink text-base">{repo.language}</span>
          </div>
          <div>
            <span class="text-faint text-[10px] uppercase tracking-wider block mb-0.5">License</span>
            <span class="font-semibold text-ink font-mono text-base">{repo.license}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Detail Sections -->
    <div class="max-w-5xl w-full mx-auto px-6 pb-16 flex-1 flex flex-col gap-8">
      
      <!-- 1. Beginner 1-Minute Summary -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-mute mb-2">
          1-Minute Plain-English Overview
        </h2>
        <p class="text-sm text-body leading-relaxed mb-4">
          <strong>{repo.name}</strong> is designed to run self-hosted artificial intelligence workloads. It provides local privacy, eliminates per-token API subscriptions, and allows developers to inspect, modify, and fine-tune model execution directly on their own hardware.
        </p>
        <div class="p-4 rounded border border-hairline bg-canvas text-xs text-mute flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span>100% verified permissive open-source license. Safe for internal self-hosting.</span>
        </div>
      </section>

      <!-- 2. Local Setup & Quickstart Guide -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-mute mb-4">
          Quickstart & Installation Command
        </h2>
        
        <div class="mb-4">
          <span class="text-xs text-mute block mb-1.5 font-medium">Terminal Command:</span>
          <div class="p-3.5 bg-canvas border border-hairline rounded-md font-mono text-xs text-ink flex items-center justify-between">
            <code>git clone {repo.url}.git && cd {repo.name.toLowerCase()}</code>
            <button 
              type="button" 
              class="text-xs text-mute hover:text-ink transition-colors cursor-pointer"
              onclick={`navigator.clipboard.writeText('git clone ${repo.url}.git && cd ${repo.name.toLowerCase()}')`}
            >
              Copy
            </button>
          </div>
        </div>

        <p class="text-xs text-mute">
          Consult the official README on GitHub for detailed GPU driver requirements (CUDA, Metal, ROCm).
        </p>
      </section>

      <!-- 3. Connected Platform Tool -->
      {matchingTool && (
        <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold text-ink tracking-tight">Connected Directory Tool</h2>
            <a href={`/tools/${matchingTool.slug}`} class="text-xs font-semibold text-ink hover:underline">
              View Tool Profile &rarr;
            </a>
          </div>
          <p class="text-xs text-body leading-relaxed mb-3">
            {matchingTool.description}
          </p>
          <div class="flex items-center gap-2 text-xs font-mono text-mute">
            <span>Pricing: {matchingTool.pricingType}</span>
            <span>&bull;</span>
            <span>Editorial Score: {matchingTool.platformScore}/100</span>
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>
