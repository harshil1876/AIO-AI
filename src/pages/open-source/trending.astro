---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OPEN_SOURCE_REPOS } from '../../data/openSourceData';
---

<Layout 
  title="Trending Open-Source AI Repositories & Local LLMs | AI Discovery"
  description="Discover high-momentum open-source AI projects, local model serving engines, and autonomous agent frameworks with real developer metrics."
>
  <Header currentPath="/open-source" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-12 md:py-16">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-medium text-mute mb-4">
            <svg class="w-3.5 h-3.5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
            </svg>
            <span>GitHub Developer Momentum</span>
          </div>

          <h1 class="text-3xl md:text-5xl font-semibold text-ink tracking-tight mb-3" style="letter-spacing: -1.4px;">
            Trending Open-Source AI
          </h1>
          <p class="text-sm md:text-base text-body max-w-2xl leading-relaxed">
            The fastest-growing AI repositories, self-hostable tools, and local inference frameworks with verified open-source licenses and hardware specs.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href="/open-source" 
            class="text-xs text-body hover:text-ink font-medium border border-hairline px-3.5 py-2 rounded-md hover:bg-hairline-soft transition-colors"
          >
            All Open Source
          </a>
          <a 
            href="https://github.com/trending" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-xs text-mute hover:text-ink font-medium border border-hairline px-3.5 py-2 rounded-md hover:bg-hairline-soft transition-colors inline-flex items-center gap-1"
          >
            <span>GitHub Trending</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Repositories Grid -->
    <div class="w-full max-w-7xl mx-auto px-6 py-12 flex-1">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {OPEN_SOURCE_REPOS.map((repo) => {
          const slug = repo.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          return (
            <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 flex flex-col justify-between hover:border-faint transition-all shadow-xs group">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono font-medium text-mute">{repo.category}</span>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border border-hairline bg-canvas text-body">
                    {repo.difficulty}
                  </span>
                </div>

                <h2 class="text-lg font-semibold text-ink tracking-tight mb-1 group-hover:underline">
                  <a href={`/open-source/${slug}`}>{repo.name}</a>
                </h2>

                <p class="text-xs text-mute font-mono mb-3 truncate">{repo.repo}</p>

                <p class="text-xs text-body leading-relaxed mb-6 line-clamp-3">
                  {repo.description}
                </p>
              </div>

              <div>
                <div class="flex items-center justify-between py-3 border-y border-hairline text-xs font-mono text-mute mb-4">
                  <span class="flex items-center gap-1 font-semibold text-ink">
                    <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                    {repo.stars} stars
                  </span>
                  <span>{repo.language}</span>
                  <span>{repo.license}</span>
                </div>

                <div class="flex items-center justify-between pt-1">
                  <a 
                    href={`/open-source/${slug}`}
                    class="text-xs font-medium text-ink hover:underline"
                  >
                    View Specs & Setup &rarr;
                  </a>

                  <a 
                    href={repo.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-xs text-mute hover:text-ink transition-colors inline-flex items-center gap-1"
                  >
                    <span>GitHub</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
