---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OPEN_SOURCE_REPOS } from '../../data/openSourceData';
import { TOP_AI_DEVELOPERS_ORGS } from '../../services/githubLiveService';

// Sort verified repos by stars descending
const trendingRepos = [...OPEN_SOURCE_REPOS].sort((a, b) => {
  const parseStars = (str: string) => {
    const num = parseFloat(str.replace(/[^0-9.]/g, ''));
    return str.includes('k') ? num * 1000 : num;
  };
  return parseStars(b.stars) - parseStars(a.stars);
});

const languages = ['All Languages', 'Python', 'TypeScript', 'Rust', 'C++', 'Jupyter Notebook', 'Go'];
---

<Layout 
  title="Trending Open-Source AI Repositories & Creators | Velocity Leaderboard"
  description="Explore trending open-source AI projects, developer velocity, and active organizations ranked by GitHub adoption and live telemetry."
>
  <Header currentPath="/open-source" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-10 md:py-14">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="text-[11px] font-mono text-mute uppercase tracking-wider mb-1">
            Real Developer Velocity & Ecosystem Momentum
          </div>
          <h1 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-2">
            Trending AI Repositories & Creators
          </h1>
          <p class="text-xs sm:text-sm text-body max-w-2xl leading-relaxed">
            Mirrors authentic GitHub Trending across AI runtimes, agent frameworks, and frontier open weights with multi-language and velocity filters.
          </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 text-xs">
          <a 
            href="/open-source" 
            class="bg-canvas hover:bg-hairline-soft border border-hairline text-ink font-medium px-4 py-2 rounded-md shadow-xs transition-colors"
          >
            All 20+ Hub Repos
          </a>
          <a 
            href="https://github.com/trending" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-ink hover:bg-neutral-800 text-on-primary font-medium px-4 py-2 rounded-md shadow-xs transition-colors inline-flex items-center gap-1.5"
          >
            <span>Live GitHub Trending</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Mode Selector & Filter Toolbar -->
    <section class="border-b border-hairline bg-surface px-6 py-3">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <!-- View Mode: Repositories vs Developers & Orgs -->
        <div class="flex items-center gap-1 bg-canvas p-1 rounded-lg border border-hairline w-full sm:w-auto">
          <button 
            type="button" 
            id="tabRepos" 
            class="view-mode-btn px-4 py-1.5 rounded-md text-xs font-semibold bg-ink text-white cursor-pointer transition-colors"
          >
            Repositories
          </button>
          <button 
            type="button" 
            id="tabDevs" 
            class="view-mode-btn px-4 py-1.5 rounded-md text-xs font-medium text-mute hover:text-ink cursor-pointer transition-colors"
          >
            Developers &amp; Organizations
          </button>
        </div>

        <!-- Filter Controls: Language & Date Range -->
        <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
          <div class="flex items-center gap-1.5 text-xs">
            <span class="text-[11px] font-mono text-mute">Language:</span>
            <select 
              id="languageFilter" 
              class="bg-canvas border border-hairline rounded-md px-2.5 py-1 text-xs text-ink outline-none hover:border-faint transition-colors font-medium cursor-pointer"
            >
              {languages.map(l => (
                <option value={l === 'All Languages' ? 'all' : l.toLowerCase()}>{l}</option>
              ))}
            </select>
          </div>

          <div class="flex items-center gap-1.5 text-xs">
            <span class="text-[11px] font-mono text-mute">Range:</span>
            <select 
              id="dateRangeFilter" 
              class="bg-canvas border border-hairline rounded-md px-2.5 py-1 text-xs text-ink outline-none hover:border-faint transition-colors font-medium cursor-pointer"
            >
              <option value="daily">Today</option>
              <option value="weekly" selected>This Week</option>
              <option value="monthly">This Month</option>
            </select>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Container -->
    <div class="w-full max-w-7xl mx-auto px-6 py-10 flex-1">
      
      <!-- VIEW 1: REPOSITORIES LEADERBOARD -->
      <div class="space-y-3" id="reposSection">
        {trendingRepos.map((repo, idx) => {
          const [owner, name] = (repo.repo || '').split('/');
          return (
            <article 
              class="trending-card bg-canvas-elevated border border-hairline hover:border-faint rounded-lg p-5 shadow-xs transition-all flex flex-col md:flex-row md:items-center justify-between gap-6"
              data-owner={owner || ''}
              data-repo={name || repo.slug}
              data-language={repo.language.toLowerCase()}
            >
              <div class="flex items-start gap-4">
                <span class="w-7 h-7 rounded bg-canvas text-ink font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 border border-hairline">
                  #{idx + 1}
                </span>
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-1.5">
                    <h2 class="text-sm md:text-base font-semibold text-ink hover:underline">
                      <a href={`/open-source/${repo.slug}`}>
                        {repo.name}
                      </a>
                    </h2>
                    <span class="text-[10px] font-mono uppercase font-medium px-2 py-0.5 rounded bg-hairline-soft text-ink border border-hairline">
                      {repo.category}
                    </span>
                    <span class="text-xs font-mono text-mute">{repo.repo}</span>
                    <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                      Verified Active
                    </span>
                  </div>

                  <p class="text-xs text-body line-clamp-2 mb-2 max-w-3xl leading-relaxed">
                    {repo.oneMinuteSummary || repo.description}
                  </p>

                  <div class="flex items-center gap-3 text-xs font-mono text-mute">
                    <span>Language: <strong class="text-ink font-medium">{repo.language}</strong></span>
                    <span>&bull;</span>
                    <span>Min VRAM: <strong class="text-ink font-medium">{repo.hardwareSpecs?.minVramGb}</strong></span>
                    <span>&bull;</span>
                    <span>License: <strong class="text-ink font-medium">{repo.license}</strong></span>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between md:flex-col md:items-end gap-3 shrink-0 pt-3 md:pt-0 border-t md:border-t-0 border-hairline">
                <div class="text-right">
                  <div class="text-sm md:text-base font-bold text-ink font-mono live-stars">★ {repo.stars}</div>
                  <div class="text-[10px] font-mono text-mute live-forks">{repo.forks} forks</div>
                </div>

                <a 
                  href={`/open-source/${repo.slug}`} 
                  class="bg-ink hover:bg-neutral-800 text-on-primary text-xs font-medium px-3.5 py-1.5 rounded-md shadow-xs transition-colors inline-flex items-center gap-1"
                >
                  Setup Guide &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- VIEW 2: DEVELOPERS & ORGANIZATIONS LEADERBOARD (Hidden by default) -->
      <div class="hidden grid grid-cols-1 md:grid-cols-2 gap-4" id="devsSection">
        {TOP_AI_DEVELOPERS_ORGS.map((dev, idx) => (
          <div class="bg-canvas-elevated border border-hairline hover:border-faint rounded-lg p-5 shadow-xs transition-all flex flex-col justify-between">
            <div class="flex items-start gap-4 mb-4">
              <span class="w-7 h-7 rounded bg-canvas text-ink font-mono font-bold text-xs flex items-center justify-center shrink-0 border border-hairline">
                #{idx + 1}
              </span>
              <img 
                src={dev.avatarUrl} 
                alt={dev.name} 
                class="w-12 h-12 rounded-full border border-hairline bg-surface object-cover shrink-0"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="font-bold text-sm text-ink hover:underline truncate">
                    <a href={dev.htmlUrl} target="_blank" rel="noopener noreferrer">{dev.name}</a>
                  </h3>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-50 text-primary border border-blue-200">
                    {dev.category}
                  </span>
                </div>
                <div class="text-xs text-mute font-mono">@{dev.login}</div>
              </div>
            </div>

            <!-- Flagship Project Card -->
            <div class="p-3 rounded-lg bg-surface border border-hairline text-xs mb-4">
              <div class="text-[10px] font-mono text-mute uppercase tracking-wider mb-1 flex items-center justify-between">
                <span>Flagship Project</span>
                <span class="text-primary font-bold">{dev.totalStarsEstimate} stars</span>
              </div>
              <div class="font-bold text-ink mb-0.5">{dev.popularRepo}</div>
              <p class="text-mute text-[11px] line-clamp-2">{dev.popularRepoDesc}</p>
            </div>

            <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
              <span class="text-[11px] font-mono text-mute">GitHub Organization</span>
              <a 
                href={dev.htmlUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-ink hover:text-primary transition-colors inline-flex items-center gap-1"
              >
                <span>View Profile</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { fetchLiveRepoStats } from '../../services/githubLiveService';

  document.addEventListener('DOMContentLoaded', () => {
    const tabRepos = document.getElementById('tabRepos');
    const tabDevs = document.getElementById('tabDevs');
    const reposSection = document.getElementById('reposSection');
    const devsSection = document.getElementById('devsSection');
    const languageFilter = document.getElementById('languageFilter') as HTMLSelectElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.trending-card');

    // Tab Switching
    tabRepos?.addEventListener('click', () => {
      tabRepos.className = 'view-mode-btn px-4 py-1.5 rounded-md text-xs font-semibold bg-ink text-white cursor-pointer transition-colors';
      tabDevs!.className = 'view-mode-btn px-4 py-1.5 rounded-md text-xs font-medium text-mute hover:text-ink cursor-pointer transition-colors';
      reposSection?.classList.remove('hidden');
      devsSection?.classList.add('hidden');
    });

    tabDevs?.addEventListener('click', () => {
      tabDevs.className = 'view-mode-btn px-4 py-1.5 rounded-md text-xs font-semibold bg-ink text-white cursor-pointer transition-colors';
      tabRepos!.className = 'view-mode-btn px-4 py-1.5 rounded-md text-xs font-medium text-mute hover:text-ink cursor-pointer transition-colors';
      devsSection?.classList.remove('hidden');
      reposSection?.classList.add('hidden');
    });

    // Language Filtering
    languageFilter?.addEventListener('change', () => {
      const selectedLang = languageFilter.value.toLowerCase();
      cards.forEach(card => {
        const cardLang = card.getAttribute('data-language') || '';
        if (selectedLang === 'all' || cardLang.includes(selectedLang)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });

    // Hydrate Live GitHub Stats
    cards.forEach(async (card) => {
      const owner = card.getAttribute('data-owner');
      const repo = card.getAttribute('data-repo');
      if (owner && repo) {
        try {
          const stats = await fetchLiveRepoStats(owner, repo);
          if (stats) {
            const starEl = card.querySelector('.live-stars');
            const forkEl = card.querySelector('.live-forks');
            if (starEl && stats.formattedStars) starEl.textContent = `★ ${stats.formattedStars}`;
            if (forkEl && stats.formattedForks) forkEl.textContent = `${stats.formattedForks} forks`;
          }
        } catch (e) {}
      }
    });
  });
</script>
