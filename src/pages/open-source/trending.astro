---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OPEN_SOURCE_REPOS } from '../../data/openSourceData';

// Sort by stars descending
const trendingRepos = [...OPEN_SOURCE_REPOS].sort((a, b) => {
  const starsA = parseInt(a.stars.replace(/[^0-9]/g, '')) || 0;
  const starsB = parseInt(b.stars.replace(/[^0-9]/g, '')) || 0;
  return starsB - starsA;
});
---

<Layout 
  title="Trending Open-Source AI Repositories | AIO AI"
  description="The highest-momentum open-source AI projects ranked by GitHub stars, local VRAM specs, and active developer ecosystems."
>
  <Header currentPath="/open-source" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-4 sm:px-6 py-12 md:py-16">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-200 bg-purple-50 text-xs font-semibold text-purple-700 mb-4 shadow-xs font-mono">
            <span>REAL DEVELOPER MOMENTUM &bull; GITHUB METRICS</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-ink tracking-tight mb-3">
            Trending Open-Source AI
          </h1>
          <p class="text-slate-600 text-sm sm:text-base max-w-2xl leading-relaxed">
            Ranked by active GitHub star growth, commit velocity, and community deployment footprint across local workstations and private clusters.
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0 font-mono text-xs">
          <a 
            href="/open-source" 
            class="bg-white hover:bg-slate-50 border-2 border-[#09090B] text-ink font-bold px-4 py-2 rounded-lg shadow-[2px_2px_0px_0px_#09090B]"
          >
            All 20+ Repos
          </a>
          <a 
            href="https://github.com/trending" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-[#09090B] hover:bg-neutral-800 text-white font-bold px-4 py-2 rounded-lg shadow-[2px_2px_0px_0px_#7C3AED] inline-flex items-center gap-1.5"
          >
            <span>Live GitHub Trending</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Trending Repos Leaderboard -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-12 flex-1">
      <div class="space-y-4">
        {trendingRepos.map((repo, idx) => (
          <article class="bg-white border-2 border-[#09090B] rounded-xl p-5 sm:p-6 shadow-[4px_4px_0px_0px_#09090B] hover:shadow-[6px_6px_0px_0px_#7C3AED] hover:-translate-y-0.5 transition-all flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-start gap-4">
              <span class="w-8 h-8 rounded-lg bg-[#09090B] text-white font-mono font-bold text-sm flex items-center justify-center shrink-0 mt-0.5">
                #{idx + 1}
              </span>
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <h2 class="text-lg font-bold text-ink hover:text-purple-700 transition-colors">
                    <a href={`/open-source/${repo.slug}`}>
                      {repo.name}
                    </a>
                  </h2>
                  <span class="text-[10px] font-mono uppercase font-bold px-2 py-0.5 rounded bg-purple-50 text-purple-700 border border-purple-200">
                    {repo.category}
                  </span>
                  <span class="text-xs font-mono text-slate-500">{repo.repo}</span>
                </div>

                <p class="text-xs text-slate-600 line-clamp-2 mb-2 max-w-3xl">
                  {repo.oneMinuteSummary || repo.description}
                </p>

                <div class="flex items-center gap-4 text-xs font-mono text-slate-500">
                  <span>Language: <strong class="text-ink">{repo.language}</strong></span>
                  <span>&bull;</span>
                  <span>VRAM: <strong class="text-purple-700">{repo.hardwareSpecs?.minVramGb}</strong></span>
                  <span>&bull;</span>
                  <span>License: <strong class="text-ink">{repo.license}</strong></span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between md:flex-col md:items-end gap-3 shrink-0 pt-3 md:pt-0 border-t md:border-t-0 border-[#E2E8F0]">
              <div class="text-right">
                <div class="text-base font-black text-ink font-mono">★ {repo.stars}</div>
                <div class="text-[10px] font-mono text-slate-500">{repo.forks} forks</div>
              </div>

              <a 
                href={`/open-source/${repo.slug}`} 
                class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold font-mono px-4 py-2 rounded-lg shadow-xs inline-flex items-center gap-1"
              >
                Setup Guide &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
