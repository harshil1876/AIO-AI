---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COMMUNITY_POSTS, COMMUNITY_LEADERBOARD, REPUTATION_RULES } from '../../data/communityData';

// 10 Pre-Seeded Community Spaces
const COMMUNITY_SPACES = [
  { id: 'all', name: 'All Spaces', slug: 'all', icon: '🌐', members: '12.4k' },
  { id: 'c-ai-engineering', name: 'c/AIEngineering', slug: 'ai-engineering', icon: '⚡', members: '4.8k', desc: 'Core LLMs, prompt systems, and enterprise inference scaling.' },
  { id: 'c-open-source', name: 'c/OpenSourceHub', slug: 'open-source-hub', icon: '📦', members: '3.9k', desc: 'Self-hostable weights, Ollama, ComfyUI, and vLLM recipes.' },
  { id: 'c-robotics', name: 'c/RoboticsAndHardware', slug: 'robotics-hardware', icon: '🤖', members: '1.8k', desc: 'Embodied AI, GPU clusters, CUDA drivers, and VRAM math.' },
  { id: 'c-indic-ai', name: 'c/IndicAI', slug: 'indic-ai', icon: '🇮🇳', members: '2.5k', desc: 'Sovereign models, Bhashini, Sarvam, and 22 Indic vernaculars.' },
  { id: 'c-agents', name: 'c/AgentFrameworks', slug: 'agent-frameworks', icon: '🔄', members: '3.2k', desc: 'LangGraph, CrewAI, AutoGen, and multi-agent coordination.' },
  { id: 'c-local-llms', name: 'c/LocalLLMs', slug: 'local-llms', icon: '🖥️', members: '4.1k', desc: 'DeepSeek-R1, Llama 3.3, and GGUF quantization tuning.' },
  { id: 'c-fine-tuning', name: 'c/FineTuning', slug: 'fine-tuning', icon: '🎯', members: '1.9k', desc: 'LoRA, Unsloth, synthetic datasets, and evaluation benchmarks.' },
  { id: 'c-rag', name: 'c/RAGSystems', slug: 'rag-systems', icon: '📚', members: '2.7k', desc: 'Vector databases, hybrid dense/sparse search, and rerankers.' },
  { id: 'c-creator-tech', name: 'c/CreatorTech', slug: 'creator-tech', icon: '🎬', members: '2.1k', desc: 'Video generation, ElevenLabs TTS, and automated Shorts engines.' },
  { id: 'c-saas-scaling', name: 'c/SaaSScaling', slug: 'saas-scaling', icon: '🚀', members: '1.6k', desc: 'Indie hacker launches, pricing models, and token margins.' }
];

const postTypes = ['All', 'Discussion', 'Project / SaaS Launch', 'Open-Source Repo', 'Share Workflow'];
---

<Layout 
  title="Community Spaces & Practitioner Hub | AIO AI"
  description="Connect with verified engineers, creators, and builders. Share open-source repos, launch projects, discuss local inference, and solve technical AI challenges."
>
  <Header currentPath="/community" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    
    <!-- Hero Header -->
    <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-400/30 bg-blue-500/10 text-[11px] font-mono font-bold text-blue-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>10 CURATED SPACES • REAL VERIFIED PRACTITIONERS</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            Community Spaces
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            The hybrid Reddit + X technical forum for AI builders. Share live project launches, open-source repositories, agent workflows, and architecture debates.
          </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <button 
            type="button" 
            id="openInviteModalBtn" 
            class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold border border-slate-600 transition-colors cursor-pointer flex items-center gap-1.5"
          >
            <span>🔗</span>
            <span>Invite People</span>
          </button>
          <button 
            type="button" 
            id="openCreateSpaceModalBtn" 
            class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition-all shadow-sm cursor-pointer flex items-center gap-1.5"
          >
            <span>+</span>
            <span>Create Space</span>
          </button>
        </div>
      </div>
    </section>

    <!-- 3-COLUMN LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN: SPACES & GROUPS LIST (3 COLS) -->
      <aside class="lg:col-span-3 space-y-4">
        <div class="card-aurora p-4 sm:p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-200">
            <span class="text-xs font-mono uppercase font-bold text-slate-500">Community Spaces</span>
            <span class="text-[10px] font-mono text-slate-400">10 Spaces</span>
          </div>

          <div class="space-y-1 text-xs" id="spacesNavList">
            {COMMUNITY_SPACES.map((space, idx) => (
              <button 
                type="button" 
                class={`space-tab-btn w-full p-2.5 rounded-xl flex items-center justify-between text-left transition-all cursor-pointer ${
                  idx === 0 
                    ? 'bg-blue-600 text-white font-bold shadow-xs' 
                    : 'bg-white hover:bg-slate-50 text-slate-700 border border-slate-200/70 hover:border-slate-300'
                }`}
                data-space={space.slug}
              >
                <div class="flex items-center gap-2 truncate">
                  <span>{space.icon}</span>
                  <span class="truncate">{space.name}</span>
                </div>
                <span class={`text-[10px] font-mono ${idx === 0 ? 'text-blue-200' : 'text-slate-400'}`}>
                  {space.members}
                </span>
              </button>
            ))}
          </div>
        </div>

        <!-- Quick Guidelines Card -->
        <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs text-slate-600 space-y-2">
          <span class="font-bold text-slate-900 block font-mono text-[11px] uppercase">Space Conduct Rules</span>
          <p class="text-[11px] leading-relaxed">
            Zero abuse, zero crypto spam, and zero fabricated reviews. All submissions pass through real-time content moderation.
          </p>
          <a href="/docs/community-governance" class="font-bold text-blue-600 hover:underline block text-[11px]">
            Read Governance Policy &rarr;
          </a>
        </div>
      </aside>

      <!-- CENTER COLUMN: MULTI-MODE COMPOSER & POSTS STREAM (6 COLS) -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- MULTI-MODE COMPOSER CARD -->
        <div class="card-aurora p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <span class="text-xs font-mono uppercase font-bold text-slate-500">Create a Post</span>
            <div class="flex items-center gap-1 text-[11px] font-mono">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-emerald-700 font-bold">Safe Guard Active</span>
            </div>
          </div>

          <!-- Composer Mode Tabs -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-mono font-bold" id="composerTabs">
            <button type="button" class="composer-tab px-3 py-1.5 rounded-xl bg-slate-900 text-white cursor-pointer shadow-xs" data-mode="discussion">
              Discussion
            </button>
            <button type="button" class="composer-tab px-3 py-1.5 rounded-xl bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer" data-mode="project">
              🚀 Launch Project/SaaS
            </button>
            <button type="button" class="composer-tab px-3 py-1.5 rounded-xl bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer" data-mode="repo">
              📦 Promote Repo
            </button>
            <button type="button" class="composer-tab px-3 py-1.5 rounded-xl bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer" data-mode="workflow">
              ⚡ Share Workflow
            </button>
          </div>

          <!-- Real-Time Abuse Warning Alert Banner -->
          <div id="composerAbuseBanner" class="hidden p-3 rounded-xl bg-red-50 border border-red-300 text-red-900 text-xs font-sans animate-in fade-in">
            <div class="flex items-center gap-2">
              <span class="font-bold">⚠️ Content Safety Alert:</span>
              <span id="composerAbuseMessage">Profanity or harassment detected.</span>
            </div>
          </div>

          <!-- Dynamic Form -->
          <form id="communityComposerForm" class="space-y-3.5 text-xs">
            <!-- Title -->
            <div>
              <label class="block font-mono uppercase font-bold text-slate-700 mb-1">Post Title *</label>
              <input 
                type="text" 
                id="cmpTitle" 
                placeholder="e.g. How we dropped our Claude API inference costs by 68% using semantic caching"
                required 
                class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-3 text-slate-900 outline-none font-medium"
              />
            </div>

            <!-- Conditional Project Fields (Mode: Project) -->
            <div id="projectFieldsContainer" class="hidden grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-700 mb-1">Live Website URL</label>
                <input type="url" id="cmpProjectUrl" placeholder="https://mycoolai.app" class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-2.5 text-slate-900 outline-none font-medium" />
              </div>
              <div>
                <label class="block font-mono uppercase font-bold text-slate-700 mb-1">Pricing Model</label>
                <select id="cmpProjectPricing" class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-2.5 text-slate-900 outline-none font-bold">
                  <option value="Free">100% Free / Beta</option>
                  <option value="Freemium" selected>Freemium Sandbox</option>
                  <option value="Paid">Paid Subscription</option>
                </select>
              </div>
            </div>

            <!-- Conditional Repo Fields (Mode: Repo) -->
            <div id="repoFieldsContainer" class="hidden grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-700 mb-1">GitHub Repo URL</label>
                <input type="url" id="cmpRepoUrl" placeholder="https://github.com/org/repo" class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-2.5 text-slate-900 outline-none font-medium" />
              </div>
              <div>
                <label class="block font-mono uppercase font-bold text-slate-700 mb-1">License & VRAM</label>
                <input type="text" id="cmpRepoLicense" placeholder="MIT • 8GB VRAM" class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-2.5 text-slate-900 outline-none font-medium" />
              </div>
            </div>

            <!-- Target Space Selector & Author -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-700 mb-1">Post to Space *</label>
                <select id="cmpTargetSpace" class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-2.5 text-slate-900 outline-none font-bold cursor-pointer">
                  {COMMUNITY_SPACES.filter(s => s.id !== 'all').map(space => (
                    <option value={space.slug}>{space.name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="block font-mono uppercase font-bold text-slate-700 mb-1">Author Name / Handle *</label>
                <input type="text" id="cmpAuthor" placeholder="e.g. harshil_builder" required class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-2.5 text-slate-900 outline-none font-medium" />
              </div>
            </div>

            <!-- Post Content -->
            <div>
              <label class="block font-mono uppercase font-bold text-slate-700 mb-1">Content / Architecture Details *</label>
              <textarea 
                id="cmpContent" 
                rows="4" 
                placeholder="Share your implementation steps, code snippets, hardware metrics, or architecture insights..." 
                required 
                class="w-full bg-white border border-slate-200 focus:border-blue-600 rounded-xl p-3 text-slate-900 outline-none resize-none font-sans leading-relaxed"
              ></textarea>
            </div>

            <!-- Submit Button Row -->
            <div class="flex items-center justify-between pt-2">
              <span class="text-[11px] font-mono text-slate-400">Posts are strictly verified against hate speech and spam.</span>
              <button 
                type="submit" 
                id="submitPostBtn" 
                class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs cursor-pointer shadow-sm transition-all"
              >
                Publish to Space &rarr;
              </button>
            </div>
          </form>
        </div>

        <!-- POSTS STREAM -->
        <div class="space-y-4" id="communityPostsStream">
          {COMMUNITY_POSTS.map(post => (
            <article 
              class="community-post-card bg-white border border-slate-200 hover:border-blue-400 rounded-2xl p-6 shadow-xs hover:shadow-md transition-all space-y-4"
              data-space="all"
              data-type={post.type}
              data-tags={post.tags.join(',').toLowerCase()}
            >
              <div class="flex items-start gap-4">
                <!-- Upvote Button -->
                <button 
                  type="button"
                  class="upvote-btn flex flex-col items-center justify-center w-11 py-2.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-blue-600 hover:text-blue-600 transition-colors cursor-pointer shrink-0"
                >
                  <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
                  </svg>
                  <span class="text-xs font-mono font-bold text-slate-900 mt-1 vote-count">{post.upvotes}</span>
                </button>

                <!-- Post Main -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2 flex-wrap text-xs">
                    <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 uppercase">
                      {post.type}
                    </span>
                    <span class="font-bold text-slate-900">{post.author}</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">{post.authorRole}</span>
                    <span class="text-slate-400 font-mono text-[11px]">&bull; {post.publishedAt}</span>
                  </div>

                  <h2 class="text-base font-black text-slate-900 mb-2 leading-snug hover:text-blue-600 transition-colors cursor-pointer">
                    {post.title}
                  </h2>

                  <p class="text-xs text-slate-600 leading-relaxed mb-4">
                    {post.content}
                  </p>

                  <div class="flex items-center justify-between gap-2 flex-wrap pt-3 border-t border-slate-100">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      {post.tags.map(tag => (
                        <span class="text-[11px] text-slate-600 bg-slate-50 px-2.5 py-0.5 rounded-md border border-slate-200 font-mono">
                          #{tag}
                        </span>
                      ))}
                    </div>

                    <!-- Replies Toggle Button -->
                    <button 
                      type="button" 
                      class="toggle-replies-btn flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-blue-600 transition-colors cursor-pointer px-3 py-1 rounded-lg hover:bg-blue-50"
                      data-post-id={post.id}
                    >
                      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.502 49.188 49.188 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                      </svg>
                      <span class="font-mono">{post.comments.length} replies</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Replies Drawer -->
              <div class="replies-drawer hidden pt-4 border-t border-slate-100 space-y-3" id={`replies-${post.id}`}>
                <div class="text-[11px] font-mono font-bold text-slate-400 uppercase">
                  Replies Thread ({post.comments.length})
                </div>
                <div class="space-y-2.5">
                  {post.comments.map(c => (
                    <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-1">
                      <div class="flex items-center justify-between text-[11px] font-mono">
                        <span class="font-bold text-slate-900">{c.author}</span>
                        <span class="text-slate-400">{c.publishedAt}</span>
                      </div>
                      <p class="text-slate-600">{c.content}</p>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>

      </div>

      <!-- RIGHT COLUMN: LEADERBOARD & REPUTATION (3 COLS) -->
      <aside class="lg:col-span-3 space-y-6">
        
        <!-- Leaderboard Card -->
        <div class="card-aurora p-5 space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-slate-200">
            <span class="text-xs font-mono uppercase font-bold text-slate-500">Builder Leaderboard</span>
            <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">Top Rep</span>
          </div>

          <div class="space-y-3 text-xs">
            {COMMUNITY_LEADERBOARD.map((user, idx) => (
              <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-slate-200/80">
                <div class="flex items-center gap-2 truncate">
                  <span class="w-5 h-5 rounded-full bg-slate-100 font-mono font-bold text-[10px] flex items-center justify-center text-slate-600">
                    {idx + 1}
                  </span>
                  <div class="truncate">
                    <span class="font-bold text-slate-900 block truncate">{user.name}</span>
                    <span class="text-[10px] text-slate-400 font-mono truncate">{user.role}</span>
                  </div>
                </div>
                <span class="font-mono font-bold text-blue-600 shrink-0">{user.points} pts</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Reputation Rules Card -->
        <div class="card-aurora p-5 space-y-3">
          <span class="text-xs font-mono uppercase font-bold text-slate-500 block pb-2 border-b border-slate-200">
            How to Earn Reputation
          </span>
          <div class="space-y-2 text-xs">
            {REPUTATION_RULES.map(rule => (
              <div class="flex items-center justify-between text-slate-600">
                <span>{rule.action}</span>
                <span class="font-mono font-bold text-emerald-700">+{rule.points} pts</span>
              </div>
            ))}
          </div>
        </div>

      </aside>

    </div>

    <!-- CREATE SPACE MODAL -->
    <div id="createSpaceModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs items-center justify-center p-4">
      <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <h3 class="text-lg font-black text-slate-900">Create a Community Space</h3>
          <button type="button" id="closeCreateSpaceModalBtn" class="text-slate-400 hover:text-slate-900 cursor-pointer text-sm font-bold">&times;</button>
        </div>
        <div class="space-y-3 text-xs">
          <div>
            <label class="block font-mono font-bold text-slate-700 mb-1">Space Name (e.g. c/Quantization)</label>
            <input type="text" id="newSpaceName" placeholder="c/Quantization" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 outline-none font-bold" />
          </div>
          <div>
            <label class="block font-mono font-bold text-slate-700 mb-1">Topic & Description</label>
            <textarea id="newSpaceDesc" rows="3" placeholder="Discussions on GGUF, AWQ, and EXL2 compression..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 outline-none resize-none"></textarea>
          </div>
          <button type="button" id="confirmCreateSpaceBtn" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs cursor-pointer shadow-sm">
            Launch Community Space &rarr;
          </button>
        </div>
      </div>
    </div>

    <!-- INVITE PEOPLE MODAL -->
    <div id="inviteModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs items-center justify-center p-4">
      <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <h3 class="text-lg font-black text-slate-900">Invite Builders to AIO AI</h3>
          <button type="button" id="closeInviteModalBtn" class="text-slate-400 hover:text-slate-900 cursor-pointer text-sm font-bold">&times;</button>
        </div>
        <div class="space-y-3 text-xs">
          <p class="text-slate-600 leading-relaxed">
            Share this invite link with your engineering team or community to collaborate on AI stacks and benchmarks.
          </p>
          <div class="p-3 rounded-xl bg-slate-100 font-mono text-xs text-slate-800 break-all select-all flex items-center justify-between">
            <span id="inviteLinkText">https://aio-ai.dev/community?invite=aio_builder_vip</span>
            <button type="button" id="copyInviteLinkBtn" class="text-blue-600 font-bold hover:underline ml-2 shrink-0 cursor-pointer">
              Copy
            </button>
          </div>
        </div>
      </div>
    </div>

  </main>

  <Footer />
</Layout>

<script>
  import { validateContentSafety } from '../../utils/moderationFilter';
  import { supabase } from '../../lib/supabase';

  document.addEventListener('DOMContentLoaded', async () => {
    const composerTabs = document.querySelectorAll<HTMLButtonElement>('.composer-tab');
    const projectFields = document.getElementById('projectFieldsContainer');
    const repoFields = document.getElementById('repoFieldsContainer');
    const composerForm = document.getElementById('communityComposerForm');
    const titleInput = document.getElementById('cmpTitle') as HTMLInputElement | null;
    const contentInput = document.getElementById('cmpContent') as HTMLTextAreaElement | null;
    const abuseBanner = document.getElementById('composerAbuseBanner');
    const abuseMessage = document.getElementById('composerAbuseMessage');
    const spaceButtons = document.querySelectorAll<HTMLButtonElement>('.space-tab-btn');
    const postStream = document.getElementById('communityPostsStream');

    // Modals
    const createSpaceModal = document.getElementById('createSpaceModal');
    const inviteModal = document.getElementById('inviteModal');
    const openCreateSpaceBtn = document.getElementById('openCreateSpaceModalBtn');
    const closeCreateSpaceBtn = document.getElementById('closeCreateSpaceModalBtn');
    const openInviteBtn = document.getElementById('openInviteModalBtn');
    const closeInviteBtn = document.getElementById('closeInviteModalBtn');
    const copyInviteBtn = document.getElementById('copyInviteLinkBtn');

    // Hydrate User
    let currentUser: any = null;
    try {
      const stored = localStorage.getItem('aio_user');
      if (stored) currentUser = JSON.parse(stored);
    } catch(e) {}

    // Hydrate Custom Spaces from localStorage
    try {
      const customSpaces = JSON.parse(localStorage.getItem('aio_custom_spaces') || '[]');
      const spaceNav = document.getElementById('spacesListNav');
      if (spaceNav && customSpaces.length > 0) {
        customSpaces.forEach((sp: any) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'space-tab-btn w-full flex items-center justify-between p-2.5 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 hover:bg-slate-50 cursor-pointer';
          btn.setAttribute('data-space', sp.slug);
          btn.innerHTML = `<span class="truncate">c/${sp.slug}</span><span class="text-[10px] font-mono text-slate-400">0</span>`;
          btn.addEventListener('click', () => filterBySpace(sp.slug, btn));
          spaceNav.appendChild(btn);
        });
      }
    } catch(e) {}

    // Hydrate Persisted Posts from localStorage
    try {
      const persistedPosts = JSON.parse(localStorage.getItem('aio_community_posts') || '[]');
      if (postStream && persistedPosts.length > 0) {
        persistedPosts.forEach((p: any) => {
          renderPostInDom(p, false);
        });
      }
    } catch(e) {}

    // Handle space invite link on load (?space=...&invite=true)
    const urlParams = new URLSearchParams(window.location.search);
    const inviteSpace = urlParams.get('space');
    const isInvite = urlParams.get('invite') === 'true';

    if (inviteSpace) {
      const matchedBtn = document.querySelector<HTMLButtonElement>(`[data-space="${inviteSpace}"]`);
      if (matchedBtn) {
        filterBySpace(inviteSpace, matchedBtn);
      }
      if (isInvite) {
        const welcomeBanner = document.createElement('div');
        welcomeBanner.className = 'p-3 rounded-xl bg-blue-600 text-white font-mono text-xs font-bold mb-4 flex items-center justify-between shadow-md';
        welcomeBanner.innerHTML = `<span>👋 You were invited to join c/${inviteSpace}! Welcome to the workspace.</span><button onclick="this.parentElement.remove()" class="text-white hover:text-blue-200 cursor-pointer">&times;</button>`;
        postStream?.parentElement?.insertBefore(welcomeBanner, postStream);
      }
    }

    // 1. Composer Mode Tabs
    let activeMode = 'discussion';
    composerTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        composerTabs.forEach(t => {
          t.className = 'composer-tab px-3 py-1.5 rounded-xl bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer';
        });
        tab.className = 'composer-tab px-3 py-1.5 rounded-xl bg-slate-900 text-white cursor-pointer shadow-xs';
        activeMode = tab.getAttribute('data-mode') || 'discussion';

        if (activeMode === 'project') {
          projectFields?.classList.remove('hidden');
          projectFields?.classList.add('grid');
          repoFields?.classList.add('hidden');
        } else if (activeMode === 'repo') {
          repoFields?.classList.remove('hidden');
          repoFields?.classList.add('grid');
          projectFields?.classList.add('hidden');
        } else {
          projectFields?.classList.add('hidden');
          repoFields?.classList.add('hidden');
        }
      });
    });

    // 2. Real-Time Content Safety Check on Input
    function checkSafety() {
      const title = titleInput?.value || '';
      const body = contentInput?.value || '';
      const fullText = `${title} ${body}`;

      const res = validateContentSafety(fullText);
      if (!res.isSafe && abuseBanner && abuseMessage) {
        abuseBanner.classList.remove('hidden');
        abuseMessage.textContent = `Flagged violation: ${res.reason} (${res.suggestion || 'Remove flagged terms'})`;
        return false;
      } else if (abuseBanner) {
        abuseBanner.classList.add('hidden');
        return true;
      }
      return true;
    }

    titleInput?.addEventListener('input', checkSafety);
    contentInput?.addEventListener('input', checkSafety);

    function renderPostInDom(post: any, isPrepend = true) {
      if (!postStream) return;
      const article = document.createElement('article');
      article.className = 'community-post-card bg-white border border-slate-200 hover:border-blue-400 rounded-2xl p-6 shadow-xs hover:shadow-md transition-all space-y-4';
      article.setAttribute('data-space', post.space || 'all');
      article.setAttribute('data-type', post.type || 'discussion');

      article.innerHTML = `
        <div class="flex items-start gap-4">
          <button type="button" class="upvote-btn flex flex-col items-center justify-center w-11 py-2.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-blue-600 hover:text-blue-600 transition-colors cursor-pointer shrink-0">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
            </svg>
            <span class="text-xs font-mono font-bold text-slate-900 mt-1 vote-count">${post.upvotes || 1}</span>
          </button>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2 flex-wrap text-xs">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 uppercase">${post.type || 'Discussion'}</span>
              <span class="font-bold text-slate-900">${post.author}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">${post.authorRole || 'Practitioner'}</span>
              <span class="text-slate-400 font-mono text-[11px]">&bull; ${post.publishedAt || 'Just now'}</span>
            </div>
            <h2 class="text-base font-black text-slate-900 mb-2 leading-snug hover:text-blue-600 transition-colors cursor-pointer">${post.title}</h2>
            <p class="text-xs text-slate-600 leading-relaxed mb-4 whitespace-pre-wrap">${post.content}</p>
            <div class="flex items-center justify-between gap-2 flex-wrap pt-3 border-t border-slate-100">
              <span class="text-[11px] text-slate-600 bg-slate-50 px-2.5 py-0.5 rounded-md border border-slate-200 font-mono">#${post.space || 'general'}</span>
              <span class="text-xs font-mono text-slate-400">0 replies</span>
            </div>
          </div>
        </div>
      `;

      if (isPrepend && postStream.firstChild) {
        postStream.insertBefore(article, postStream.firstChild);
      } else {
        postStream.appendChild(article);
      }
    }

    // 3. Form Submit with Real Persistence (Supabase + localStorage)
    composerForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!checkSafety()) {
        alert('Cannot publish post: Please remove flagged terms indicated in the warning banner.');
        return;
      }

      const title = titleInput?.value.trim() || '';
      const content = contentInput?.value.trim() || '';
      if (!title || !content) return;

      const activeSpaceEl = document.querySelector('.space-tab-btn.bg-slate-900');
      const currentSpace = activeSpaceEl ? activeSpaceEl.getAttribute('data-space') || 'general' : 'general';

      const postObj = {
        id: 'post_' + Date.now(),
        author: currentUser?.name || currentUser?.email?.split('@')[0] || 'Community Builder',
        authorRole: currentUser?.role || 'Practitioner',
        space: currentSpace,
        type: activeMode,
        title: title,
        content: content,
        upvotes: 1,
        publishedAt: 'Just now',
        tags: [currentSpace]
      };

      // 1. Persist to Supabase if session available
      try {
        await supabase.from('community_posts').insert([{
          title: title,
          content: content,
          space: currentSpace,
          author: postObj.author
        }]);
      } catch(err) {
        console.warn('Supabase community_posts insertion fallback:', err);
      }

      // 2. Persist to localStorage
      try {
        const stored = JSON.parse(localStorage.getItem('aio_community_posts') || '[]');
        stored.unshift(postObj);
        localStorage.setItem('aio_community_posts', JSON.stringify(stored));
      } catch(err) {}

      // 3. Render immediately in DOM
      renderPostInDom(postObj, true);

      // 4. Reset form & show toast
      composerForm.reset();
      if (abuseBanner) abuseBanner.classList.add('hidden');
      alert('✓ Post successfully published and persisted to c/' + currentSpace + '!');
    });

    // Space filtering function
    function filterBySpace(slug: string, activeBtn: HTMLButtonElement) {
      document.querySelectorAll<HTMLButtonElement>('.space-tab-btn').forEach(b => {
        b.className = 'space-tab-btn w-full flex items-center justify-between p-2.5 rounded-xl text-xs font-bold transition-all text-slate-600 hover:text-slate-900 hover:bg-slate-50 cursor-pointer';
      });
      activeBtn.className = 'space-tab-btn w-full flex items-center justify-between p-2.5 rounded-xl text-xs font-bold transition-all bg-slate-900 text-white shadow-xs cursor-pointer';

      const allCards = document.querySelectorAll<HTMLElement>('.community-post-card');
      allCards.forEach(card => {
        const cardSpace = card.getAttribute('data-space') || 'all';
        if (slug === 'all' || cardSpace === slug || cardSpace === 'all') {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    spaceButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-space') || 'all';
        filterBySpace(slug, btn);
      });
    });

    // 4. Replies Drawer Toggle
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>('.toggle-replies-btn');
      if (btn) {
        const id = btn.getAttribute('data-post-id');
        const drawer = document.getElementById(`replies-${id}`);
        if (drawer) drawer.classList.toggle('hidden');
      }
    });

    // 5. Upvote Toggle (1 vote per user)
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>('.upvote-btn');
      if (btn) {
        const countEl = btn.querySelector('.vote-count');
        if (countEl) {
          const current = parseInt(countEl.textContent || '0', 10);
          countEl.textContent = String(current + 1);
          btn.classList.add('text-blue-600', 'border-blue-400');
        }
      }
    });

    // 6. Modal Controls
    openCreateSpaceBtn?.addEventListener('click', () => {
      createSpaceModal?.classList.remove('hidden');
      createSpaceModal?.classList.add('flex');
    });
    closeCreateSpaceBtn?.addEventListener('click', () => {
      createSpaceModal?.classList.add('hidden');
      createSpaceModal?.classList.remove('flex');
    });

    openInviteBtn?.addEventListener('click', () => {
      inviteModal?.classList.remove('hidden');
      inviteModal?.classList.add('flex');
    });
    closeInviteBtn?.addEventListener('click', () => {
      inviteModal?.classList.add('hidden');
      inviteModal?.classList.remove('flex');
    });

    copyInviteBtn?.addEventListener('click', () => {
      const link = document.getElementById('inviteLinkText')?.textContent || window.location.href;
      navigator.clipboard.writeText(link);
      copyInviteBtn.textContent = 'Copied!';
      setTimeout(() => { copyInviteBtn.textContent = 'Copy'; }, 1800);
    });

    // Real Custom Space Persistence
    document.getElementById('confirmCreateSpaceBtn')?.addEventListener('click', () => {
      const nameInput = document.getElementById('newSpaceName') as HTMLInputElement | null;
      const name = nameInput?.value.trim();
      if (!name) return;

      const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const newSpace = { name, slug, count: 0 };

      try {
        const stored = JSON.parse(localStorage.getItem('aio_custom_spaces') || '[]');
        stored.push(newSpace);
        localStorage.setItem('aio_custom_spaces', JSON.stringify(stored));
      } catch(e) {}

      // Prepend to spaces list
      const spaceNav = document.getElementById('spacesListNav');
      if (spaceNav) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'space-tab-btn w-full flex items-center justify-between p-2.5 rounded-xl text-xs font-bold transition-all bg-slate-900 text-white shadow-xs cursor-pointer';
        btn.setAttribute('data-space', slug);
        btn.innerHTML = `<span class="truncate">c/${slug}</span><span class="text-[10px] font-mono text-slate-400">0</span>`;
        btn.addEventListener('click', () => filterBySpace(slug, btn));
        spaceNav.appendChild(btn);
        filterBySpace(slug, btn);
      }

      createSpaceModal?.classList.add('hidden');
      createSpaceModal?.classList.remove('flex');
      if (nameInput) nameInput.value = '';
      alert(`✓ Community space c/${slug} created and persisted!`);
    });
  });
</script>
