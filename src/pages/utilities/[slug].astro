          '<td class="p-2.5 text-slate-500">' + r.provider + '</td>' +
          '<td class="p-2.5 text-slate-700">' + r.ctxPercent + '%</td>' +
          '<td class="p-2.5 font-bold text-slate-800">' + currencySymbol + (r.costPerCall * mult).toFixed(4) + '</td>' +
          '<td class="p-2.5 text-blue-600 font-bold">' + currencySymbol + (r.daily * mult).toFixed(2) + '</td>' +
          '<td class="p-2.5 text-purple-600 font-black">' + currencySymbol + (r.monthly * mult).toFixed(2) + '</td>' +
        '</tr>';
