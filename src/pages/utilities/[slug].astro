    // =========================================================================
    // 6. RAG CHUNKING VISUALIZER ENGINE
    // =========================================================================
    var ragInput = document.getElementById('ragTextInput');
    var ragSize = document.getElementById('ragSizeSlider');
    var ragOverlap = document.getElementById('ragOverlapSlider');
    var ragContainer = document.getElementById('ragChunksContainer');

    function updateRagVisualizer() {
      var text = ragInput ? ragInput.value : '';
      var chunkSize = parseInt(ragSize ? ragSize.value : '120', 10);
      var overlap = parseInt(ragOverlap ? ragOverlap.value : '30', 10);

      document.getElementById('ragSizeVal') && (document.getElementById('ragSizeVal').textContent = chunkSize + ' chars');
      document.getElementById('ragOverlapVal') && (document.getElementById('ragOverlapVal').textContent = overlap + ' chars overlap');

      if (!ragContainer) return;
      var chunks = [];
      var start = 0;
      while (start < text.length) {
        var end = Math.min(start + chunkSize, text.length);
        chunks.push(text.slice(start, end));
        if (end === text.length) break;
        start += (chunkSize - overlap);
      }

      document.getElementById('ragChunkCount') && (document.getElementById('ragChunkCount').textContent = chunks.length + ' Chunks');
      var avgChars = chunks.length ? Math.round(text.length / chunks.length) : 0;
      document.getElementById('ragAvgChars') && (document.getElementById('ragAvgChars').textContent = avgChars + ' chars');

      ragContainer.innerHTML = chunks.map(function(c, idx) {
        var colorClass = idx % 3 === 0 ? "bg-blue-50 border-blue-200 text-blue-900" : idx % 3 === 1 ? "bg-purple-50 border-purple-200 text-purple-900" : "bg-emerald-50 border-emerald-200 text-emerald-900";
        return '<div class="p-3.5 rounded-xl border ' + colorClass + ' space-y-1">' +
          '<div class="flex items-center justify-between text-[10px] font-bold uppercase opacity-70">' +
            '<span>Chunk #' + (idx + 1) + '</span>' +
            '<span>' + c.length + ' chars</span>' +
          '</div>' +
          '<p class="leading-relaxed whitespace-pre-wrap">"' + c + '"</p>' +
        '</div>';
      }).join('');
    }

    ragInput?.addEventListener('input', updateRagVisualizer);
    ragSize?.addEventListener('input', updateRagVisualizer);
    ragOverlap?.addEventListener('input', updateRagVisualizer);
