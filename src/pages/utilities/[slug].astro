    function updatePromptArchitect() {
      if (!paOutput) return;
      var role = paRole ? paRole.value : '';
      var task = paTask ? paTask.value : '';
      var model = paModel ? paModel.value : 'Claude 3.5 Sonnet';
      var thinking = paThinking ? paThinking.value : 'cot';
