    // =========================================================================
    // 3. VRAM HARDWARE ADVISOR ENGINE
    // =========================================================================
    var vramPreset = document.getElementById('vramPreset');
    var vramParam = document.getElementById('vramParam');
    var vramQuant = document.getElementById('vramQuant');
    var vramContext = document.getElementById('vramContext');

    function updateVramAdvisor() {
      var gpuVram = parseFloat(vramPreset ? vramPreset.value : '12');
      if (isNaN(gpuVram)) gpuVram = 12;
      var params = parseFloat(vramParam ? vramParam.value : '8');
      var quant = parseFloat(vramQuant ? vramQuant.value : '4.5');
      var ctxLen = parseFloat(vramContext ? vramContext.value : '8');

      // Math: Weights GB = (params * quant) / 8 * 1.15 (overhead multiplier)
      var weightsGb = (params * quant) / 8 * 1.15;
      if (params === 671) weightsGb = (671 * 0.15 * quant) / 8 * 1.2; // MoE active weights
      
      var kvGb = (ctxLen / 8) * (params >= 32 ? 2.5 : 1.0);
      var overheadGb = 1.0;
      var totalNeeded = weightsGb + kvGb + overheadGb;

      var barWeights = document.getElementById('vramBarWeights');
      var barKv = document.getElementById('vramBarKv');
      var barCuda = document.getElementById('vramBarCuda');
      var totalText = document.getElementById('vramTotalNeededText');
      var statusText = document.getElementById('vramVerdictStatus');
      var speedText = document.getElementById('vramTokensSpeed');
      var recText = document.getElementById('vramRecommendationText');
      var cmdEl = document.getElementById('vramRunnerCmd');

      if (totalText) totalText.textContent = totalNeeded.toFixed(1) + " GB / " + gpuVram + " GB GPU Capacity";
      if (document.getElementById('vramWeightsVal')) document.getElementById('vramWeightsVal').textContent = weightsGb.toFixed(1) + " GB";
      if (document.getElementById('vramKvVal')) document.getElementById('vramKvVal').textContent = kvGb.toFixed(1) + " GB";
      if (document.getElementById('vramCudaVal')) document.getElementById('vramCudaVal').textContent = overheadGb.toFixed(1) + " GB";

      var freeMem = Math.max(0, gpuVram - totalNeeded);
      if (document.getElementById('vramFreeVal')) document.getElementById('vramFreeVal').textContent = freeMem.toFixed(1) + " GB";

      var scale = Math.max(gpuVram, totalNeeded);
      if (barWeights) barWeights.style.width = ((weightsGb / scale) * 100) + "%";
      if (barKv) barKv.style.width = ((kvGb / scale) * 100) + "%";
      if (barCuda) barCuda.style.width = ((overheadGb / scale) * 100) + "%";

      var isFitting = gpuVram >= totalNeeded;
      if (statusText) {
        statusText.textContent = isFitting ? "✓ Smooth Local Execution (Fits inside GPU)" : "✗ Insufficient VRAM (CPU Offload Required)";
        statusText.className = isFitting ? "text-xs font-mono font-bold uppercase text-emerald-400" : "text-xs font-mono font-bold uppercase text-red-400";
      }
      if (speedText) {
        speedText.textContent = isFitting ? "~45–70 tokens/sec" : "~2–5 tokens/sec (Slow CPU Offload)";
      }
      if (recText) {
        recText.textContent = isFitting 
          ? "Hardware has ample headroom. Run locally with zero latency or cloud dependency."
          : "Total requirements (" + totalNeeded.toFixed(1) + "GB) exceed your GPU memory (" + gpuVram + "GB). Upgrade to a larger VRAM preset or quantize to Q3_K_M.";
      }
      if (cmdEl) {
        cmdEl.textContent = "ollama run " + (params === 8 ? "deepseek-r1:8b" : params === 70 ? "llama3.3:70b" : "qwen2.5-coder:" + params + "b");
      }
    }

