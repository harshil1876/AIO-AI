    // =========================================================================
    // 7. AI ROI CALCULATOR ENGINE (12-MONTH VISUAL ACCUMULATION)
    // =========================================================================
    var roiTeam = document.getElementById('roiTeamSize');
    var roiWage = document.getElementById('roiHourlyWage');
    var roiHours = document.getElementById('roiHoursTask');
    var roiEff = document.getElementById('roiEfficiency');
    var roiSpend = document.getElementById('roiToolCost');
    var roiBars = document.getElementById('roiBarsContainer');

    function updateRoiCalculator() {
      var team = parseInt(roiTeam ? roiTeam.value : '8', 10) || 1;
      var wage = parseFloat(roiWage ? roiWage.value : '65') || 10;
      var taskHours = parseFloat(roiHours ? roiHours.value : '12') || 1;
      var eff = (parseFloat(roiEff ? roiEff.value : '45') || 10) / 100;
      var spend = parseFloat(roiSpend ? roiSpend.value : '30') || 0;

      // Hours preserved per month = team * (taskHours * eff * 4.33 weeks)
      var monthlyHours = team * (taskHours * eff * 4.33);
      var grossMonthlySavings = monthlyHours * wage;
      var monthlyCost = team * spend;
      var netMonthlySavings = grossMonthlySavings - monthlyCost;
      var annualNet = netMonthlySavings * 12;
      var roiMultiplier = monthlyCost > 0 ? (grossMonthlySavings / monthlyCost).toFixed(1) : '99.9';
      var paybackDays = (monthlyCost / (grossMonthlySavings / 30)).toFixed(1);

      document.getElementById('roiMonthlyHours') && (document.getElementById('roiMonthlyHours').textContent = monthlyHours.toFixed(1) + " hrs");
      document.getElementById('roiMonthlyNet') && (document.getElementById('roiMonthlyNet').textContent = "$" + Math.round(netMonthlySavings).toLocaleString() + " / mo");
      document.getElementById('roiAnnualRoi') && (document.getElementById('roiAnnualRoi').textContent = roiMultiplier + "x ROI");
      document.getElementById('roiPaybackDays') && (document.getElementById('roiPaybackDays').textContent = "~" + paybackDays + " Days");

      if (roiBars) {
        var html = "";
        for (var m = 1; m <= 12; m++) {
          var cumulative = netMonthlySavings * m;
          var heightPercent = Math.min(100, Math.max(10, Math.round((m / 12) * 100)));
          html += '<div class="flex-1 flex flex-col items-center justify-end h-full group">' +
            '<div class="w-full bg-blue-600 group-hover:bg-blue-500 rounded-t-lg transition-all" style="height: ' + heightPercent + '%;" title="Month ' + m + ': $' + Math.round(cumulative).toLocaleString() + '"></div>' +
            '<span class="text-[9px] font-mono text-slate-400 mt-1">M' + m + '</span>' +
          '</div>';
        }
        roiBars.innerHTML = html;
      }
    }

    [roiTeam, roiWage, roiHours, roiEff, roiSpend].forEach(function(el) {
      el?.addEventListener('input', updateRoiCalculator);
    });
    updateRoiCalculator();


    // =========================================================================
    // 8. REGEX & <THINK> STRIPPER ENGINE
    // =========================================================================
    var ropInput = document.getElementById('ropInput');
    var ropOutput = document.getElementById('ropOutput');
    var ropStripThink = document.getElementById('ropStripThink');
    var ropExtractJson = document.getElementById('ropExtractJson');
    var ropExtractCode = document.getElementById('ropExtractCode');
    var ropExtractUrls = document.getElementById('ropExtractUrls');

    function updateRegexParser() {
      if (!ropOutput) return;
      var raw = ropInput ? ropInput.value : '';
      var processed = raw;

      if (ropStripThink?.checked) {
        processed = processed.replace(/<think>[\s\S]*?<\/think>/gi, '').trim();
      }

      if (ropExtractJson?.checked) {
        var jsonMatch = processed.match(/```(?:json)?\s*([\s\S]*?)```/i);
        if (jsonMatch && jsonMatch[1]) {
          try {
            var parsed = JSON.parse(jsonMatch[1]);
            processed = JSON.stringify(parsed, null, 2);
          } catch(e) {
            processed = jsonMatch[1].trim();
          }
        }
      } else if (ropExtractCode?.checked) {
        var codeBlocks = [];
        var regex = /```(?:\w+)?\s*([\s\S]*?)```/gi;
        var match;
        while ((match = regex.exec(processed)) !== null) {
          codeBlocks.push(match[1].trim());
        }
        if (codeBlocks.length) processed = codeBlocks.join('\n\n// -----\n\n');
      } else if (ropExtractUrls?.checked) {
        var urls = processed.match(/https?:\/\/[^\s"'<>]+/gi) || [];
        processed = urls.join('\n');
      }

      ropOutput.textContent = processed;
    }

    ropInput?.addEventListener('input', updateRegexParser);
    [ropStripThink, ropExtractJson, ropExtractCode, ropExtractUrls].forEach(function(c) {
      c?.addEventListener('change', updateRegexParser);
    });
    updateRegexParser();


    // =========================================================================
    // 9. README & SKILL.MD STUDIO ENGINE
    // =========================================================================
    var rsgName = document.getElementById('rsgName');
    var rsgPitch = document.getElementById('rsgPitch');
    var rsgStack = document.getElementById('rsgStack');
    var rsgInstall = document.getElementById('rsgInstall');
    var rsgLicense = document.getElementById('rsgLicense');
    var rsgOutput = document.getElementById('rsgOutput');
    var currentRsgMode = 'readme';

    function updateRsgStudio() {
      if (!rsgOutput) return;
      var name = rsgName ? rsgName.value : 'my-agent';
      var pitch = rsgPitch ? rsgPitch.value : 'Autonomous pair-programming agent.';
      var stack = rsgStack ? rsgStack.value : 'TypeScript, Astro, Tailwind';
      var install = rsgInstall ? rsgInstall.value : 'npm install && npm run build';
      var license = rsgLicense ? rsgLicense.value : 'MIT';

      var text = "";
      if (currentRsgMode === 'readme') {
        text += "# " + name + "\n\n";
        text += "[![License: " + license + "](https://img.shields.io/badge/License-" + license + "-blue.svg)](LICENSE)\n";
        text += "[![AIO AI Verified](https://img.shields.io/badge/AIO_AI-Verified_Stack-emerald)](https://aio-ai.dev)\n\n";
        text += "> " + pitch + "\n\n";
        text += "## Features & Stack\nBuilt with: **" + stack + "**.\n\n";
        text += "## Quickstart\n```bash\n" + install + "\n```\n\n";
        text += "## Architecture Flow\n```mermaid\nflowchart LR\n  A[User Prompt] --> B[" + name + " Engine]\n  B --> C[Verified Output]\n```\n";
      } else {
        text += "---\nname: " + name.toLowerCase().replace(/[^a-z0-9]+/g, '-') + "\n";
        text += "description: " + pitch + "\n";
        text += "tools:\n";
        stack.split(',').forEach(function(s) {
          text += "  - " + s.trim().toLowerCase().replace(/[^a-z0-9]+/g, '_') + "\n";
        });
        text += "---\n\n# " + name + " Skill Guidelines\n\n";
        text += "## Mission Objective\n" + pitch + "\n\n";
        text += "## Execution Instructions\n1. Run `" + install + "`.\n2. Maintain strict safety boundaries.\n";
      }

      rsgOutput.textContent = text;
    }

    document.querySelectorAll('.rsg-mode-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.rsg-mode-btn').forEach(function(b) {
          b.className = 'rsg-mode-btn px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer';
        });
        btn.className = 'rsg-mode-btn px-2.5 py-1 rounded-lg bg-slate-900 text-white shadow-xs cursor-pointer';
        currentRsgMode = btn.id === 'rsgModeReadme' ? 'readme' : 'skill';
        updateRsgStudio();
      });
    });

    [rsgName, rsgPitch, rsgStack, rsgInstall, rsgLicense].forEach(function(el) {
      el?.addEventListener('input', updateRsgStudio);
    });
    updateRsgStudio();

  });
</script>
