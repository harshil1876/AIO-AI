    function updateTokenSimulator() {
      if (!tcsTableBody) return;
      var text = tcsInput ? tcsInput.value : '';
      var chars = text.length;
      var words = text.trim() ? text.trim().split(/\s+/).length : 0;
      var inTokens = Math.max(1, Math.ceil(chars / 4));
      var outTokens = parseInt(tcsOutSlider ? tcsOutSlider.value : '1200', 10);
      var reqs = parseInt(tcsReqSlider ? tcsReqSlider.value : '5000', 10);
      var cacheHit = parseInt(tcsCacheSlider ? tcsCacheSlider.value : '50', 10) / 100;

      document.getElementById('tcsCharCount') && (document.getElementById('tcsCharCount').textContent = String(chars));
      document.getElementById('tcsWordCount') && (document.getElementById('tcsWordCount').textContent = String(words));
      document.getElementById('tcsTokCount') && (document.getElementById('tcsTokCount').textContent = String(inTokens));
      document.getElementById('tcsOutVal') && (document.getElementById('tcsOutVal').textContent = outTokens.toLocaleString());
      document.getElementById('tcsReqVal') && (document.getElementById('tcsReqVal').textContent = reqs.toLocaleString());
      document.getElementById('tcsCacheVal') && (document.getElementById('tcsCacheVal').textContent = (cacheHit * 100) + '%');

      var effectiveIn = inTokens * (1 - cacheHit * 0.5); // 50% discount on cache hits

      var ranked = RAW_MODELS.map(function(m) {
        var costPerCall = (effectiveIn / 1000000 * m.inPrice) + (outTokens / 1000000 * m.outPrice);
        var daily = costPerCall * reqs;
        var monthly = daily * 30;
        var ctxPercent = ((inTokens + outTokens) / m.ctx * 100).toFixed(1);
        return {
          name: m.name,
          provider: m.provider,
          ctxPercent: ctxPercent,
          costPerCall: costPerCall,
          daily: daily,
          monthly: monthly
        };
      }).sort(function(a, b) { return a.monthly - b.monthly; });

      var currencySymbol = isTcsInr ? '₹' : '$';
      var mult = isTcsInr ? USD_INR_RATE : 1;

      tcsTableBody.innerHTML = ranked.map(function(r) {
        return '<tr class="hover:bg-slate-50 transition-colors">' +
