    // =========================================================================
    // 4. JSON SCHEMA BUILDER (4-TAB CODE OUTPUT ENGINE)
    // =========================================================================
    var jsbOutput = document.getElementById('jsbOutput');
    var jsbRoot = document.getElementById('jsbRootName');
    var currentJsbTab = 'json';

    function updateJsonSchema() {
      if (!jsbOutput) return;
      var root = jsbRoot ? jsbRoot.value : 'Schema';
      var rows = document.querySelectorAll('.jsb-row');
      var fields = [];
      rows.forEach(function(row) {
        var name = (row.querySelector('.jsb-name') as HTMLInputElement)?.value;
        var type = (row.querySelector('.jsb-type') as HTMLSelectElement)?.value;
        var desc = (row.querySelector('.jsb-desc') as HTMLInputElement)?.value;
        var req = (row.querySelector('.jsb-req') as HTMLInputElement)?.checked;
        if (name) fields.push({ name: name, type: type, desc: desc, req: req });
      });

      var code = "";
      if (currentJsbTab === 'json') {
        var properties = {};
        var requiredList = [];
        fields.forEach(function(f) {
          if (f.req) requiredList.push(f.name);
          if (f.type === 'array') {
            properties[f.name] = { type: "array", items: { type: "string" }, description: f.desc };
          } else {
            properties[f.name] = { type: f.type, description: f.desc };
          }
        });
        code = JSON.stringify({
          name: root,
          strict: true,
          schema: {
            type: "object",
            properties: properties,
            required: requiredList,
            additionalProperties: false
          }
        }, null, 2);
      } else if (currentJsbTab === 'ts') {
        code = "export interface " + root + " {\n";
        fields.forEach(function(f) {
          var t = f.type === 'array' ? 'string[]' : f.type;
          code += "  /** " + f.desc + " */\n";
          code += "  " + f.name + (f.req ? "" : "?") + ": " + t + ";\n";
        });
        code += "}";
      } else if (currentJsbTab === 'zod') {
        code = "import { z } from 'zod';\n\n";
        code += "export const " + root + "Schema = z.object({\n";
        fields.forEach(function(f) {
          var zType = f.type === 'array' ? "z.array(z.string())" : "z." + f.type + "()";
          if (!f.req) zType += ".optional()";
          code += "  " + f.name + ": " + zType + ".describe('" + f.desc + "'),\n";
        });
        code += "});";
      } else {
        code = "from pydantic import BaseModel, Field\nfrom typing import List, Optional\n\n";
        code += "class " + root + "(BaseModel):\n";
        fields.forEach(function(f) {
          var pType = f.type === 'array' ? "List[str]" : f.type === 'number' ? "float" : f.type;
          code += "  " + f.name + ": " + (f.req ? pType : "Optional[" + pType + "] = None") + " = Field(..., description='" + f.desc + "')\n";
        });
      }

      jsbOutput.textContent = code;
    }

    document.querySelectorAll('.jsb-code-tab').forEach(function(btn) {
