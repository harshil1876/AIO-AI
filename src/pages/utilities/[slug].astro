---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OFFICIAL_MODELS } from '../../data/modelsData';

export function getStaticPaths() {
  const UTILITIES = [
    {
      slug: 'prompt-architect',
      name: 'Prompt Architect & Meta-Prompt Studio',
      category: 'Prompt Engineering',
      tagline: 'Engineer production system prompts with strict constraints, few-shot examples, and output formatting.',
      icon: '⚡'
    },
    {
      slug: 'token-cost-simulator',
      name: 'Token Cost Simulator & Context Benchmarker',
      category: 'Token Economics',
      tagline: 'Simulate prompt input/output costs across 26 official frontier models with USD/INR toggles.',
      icon: '💰'
    },
    {
      slug: 'vram-hardware-advisor',
      name: 'VRAM & Hardware Compatibility Advisor',
      category: 'Local Inference',
      tagline: 'Calculate exact GPU VRAM requirement for 7B-70B models across FP16, Q8, Q4_K_M quantizations.',
      icon: '🖥️'
    },
    {
      slug: 'json-schema-builder',
      name: 'JSON Schema & Structured Output Studio',
      category: 'Agent Tooling',
      tagline: 'Visually generate strict JSON Schemas compatible with OpenAI Structured Outputs and Anthropic Tool Use.',
      icon: '🧩'
    },
    {
      slug: 'youtube-script-studio',
      name: 'YouTube Script & Shorts Retention Studio',
      category: 'Creator Engineering',
      tagline: 'Craft high-retention 60-second vertical video scripts with psychological hooks and visual cues.',
      icon: '🎬'
    },
    {
      slug: 'rag-chunking-visualizer',
      name: 'RAG Chunking & Overlap Visualizer',
      category: 'Vector Retrieval',
      tagline: 'Visualize how text documents are sliced into chunks with variable size, overlap, and separators.',
      icon: '📑'
    },
    {
      slug: 'ai-roi-calculator',
      name: 'AI ROI & Engineering Spend Calculator',
      category: 'Enterprise Strategy',
      tagline: 'Quantify team productivity gains, developer hours preserved, and net monthly ROI from AI tooling.',
      icon: '📈'
    },
    {
      slug: 'regex-output-parser',
      name: 'LLM Output Parser & Tag Stripper',
      category: 'Data Processing',
      tagline: 'Clean reasoning tags (<think>), extract markdown code blocks, and parse structured JSON completions.',
      icon: '🔍'
    },
    {
      slug: 'readme-skill-generator',
      name: 'SKILL.md & Agent README Generator',
      category: 'Agent Systems',
      tagline: 'Generate production-grade SKILL.md definitions with YAML frontmatter and execution conditions.',
      icon: '🤖'
    }
  ];

  return UTILITIES.map(util => ({
    params: { slug: util.slug },
    props: { util, allUtilities: UTILITIES }
  }));
}

const { util, allUtilities } = Astro.props;
---

<Layout 
  title={`${util.name} | Utility Studio | AIO AI`}
  description={util.tagline}
>
  <Header currentPath="/utilities" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    
    <!-- Top Breadcrumbs & Nav Strip -->
    <div class="flex items-center justify-between text-xs font-mono text-slate-500">
      <div class="flex items-center gap-2">
        <a href="/utilities" class="hover:text-blue-600 transition-colors">Utility Studio</a>
        <span>/</span>
        <span class="text-slate-800 font-bold">{util.name}</span>
      </div>
      <a href="/utilities" class="text-blue-600 hover:underline font-bold">
        &larr; All 9 Utilities
      </a>
    </div>

    <!-- Hero Header -->
    <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-400/30 bg-blue-500/10 text-[11px] font-mono font-bold text-blue-300">
            <span>{util.icon}</span>
            <span>{util.category.toUpperCase()} • 100% CLIENT-SIDE IN-BROWSER</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            {util.name}
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            {util.tagline} Zero server telemetry; all calculations execute safely in your browser.
          </p>
        </div>

        <div class="flex items-center gap-2 bg-slate-900/80 p-2 rounded-2xl border border-slate-700 text-xs font-mono shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-slate-300 font-bold">Local Execution Sandbox Active</span>
        </div>
      </div>
    </section>

    <!-- WORKSPACE CONTAINER (DYNAMIC BY SLUG) -->
    <div class="space-y-8" id="utilityWorkspace">
      
      <!-- 1. PROMPT ARCHITECT -->
      {util.slug === 'prompt-architect' && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 card-aurora p-6 sm:p-8 space-y-5">
            <h2 class="text-lg font-black text-slate-900">System Prompt Construction Fields</h2>
            
            <div class="space-y-4 text-xs">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Role & Persona Definition:</label>
                <input type="text" id="paRole" value="Principal Full-Stack Security Engineer" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none focus:border-blue-600 font-medium" />
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Target Task / Mission:</label>
                <textarea id="paTask" rows="2" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none focus:border-blue-600 font-medium resize-none">Conduct automated security, performance, and architecture audits on incoming git pull request diffs.</textarea>
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Negative Constraints (What NOT to do):</label>
                <input type="text" id="paConstraints" value="Never hallucinate missing context; do not comment on trivial formatting or whitespace." class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none focus:border-blue-600 font-medium" />
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Output Schema / Tone:</label>
                <select id="paFormat" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none focus:border-blue-600 font-medium cursor-pointer">
                  <option value="markdown">Structured GitHub Markdown with Diff Codeblocks</option>
                  <option value="json">Strict JSON Schema Object with Error Array</option>
                  <option value="xml">Anthropic Claude XML Tagged Reasoning Format</option>
                </select>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 card-aurora p-6 sm:p-8 space-y-4 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                <span class="text-xs font-mono font-bold uppercase text-slate-500">Synthesized Prompt</span>
                <button type="button" id="copyPaBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">Copy Prompt</button>
              </div>
              <div class="mt-4 p-4 rounded-xl bg-slate-900 text-slate-100 font-mono text-xs h-96 overflow-y-auto leading-relaxed whitespace-pre-wrap" id="paOutput">
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- 2. TOKEN COST SIMULATOR -->
      {util.slug === 'token-cost-simulator' && (
        <section class="card-aurora p-6 sm:p-8 space-y-8">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Select Target Model:</label>
              <select id="tcsModelSelect" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs outline-none focus:border-blue-600 font-bold cursor-pointer">
                {OFFICIAL_MODELS.map(m => (
                  <option value={m.id} data-in={m.inputCostPer1M} data-out={m.outputCostPer1M} data-ctx={m.contextWindow}>
                    {m.name} (${m.inputCostPer1M}/1M)
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Input Tokens (Per Request):</label>
              <input type="number" id="tcsInputTok" value="4000" step="500" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono font-bold outline-none focus:border-blue-600" />
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Output Tokens (Per Request):</label>
              <input type="number" id="tcsOutputTok" value="1200" step="100" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono font-bold outline-none focus:border-blue-600" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-200 text-xs">
            <div class="p-4 rounded-2xl bg-white border border-slate-200">
              <span class="text-slate-400 font-mono block mb-1">Cost Per Query</span>
              <div class="text-2xl font-black font-mono text-slate-900" id="tcsCostPerQuery">$0.0300</div>
              <span class="text-[11px] text-slate-400 font-mono" id="tcsCostPerQueryInr">₹2.60 INR</span>
            </div>
            <div class="p-4 rounded-2xl bg-white border border-slate-200">
              <span class="text-slate-400 font-mono block mb-1">10,000 Queries / mo</span>
              <div class="text-2xl font-black font-mono text-blue-600" id="tcsCost10k">$300.00</div>
              <span class="text-[11px] text-slate-400 font-mono" id="tcsCost10kInr">₹25,950 INR</span>
            </div>
            <div class="p-4 rounded-2xl bg-white border border-slate-200">
              <span class="text-slate-400 font-mono block mb-1">100,000 Queries / mo</span>
              <div class="text-2xl font-black font-mono text-purple-600" id="tcsCost100k">$3,000.00</div>
              <span class="text-[11px] text-slate-400 font-mono" id="tcsCost100kInr">₹2,59,500 INR</span>
            </div>
            <div class="p-4 rounded-2xl bg-white border border-slate-200">
              <span class="text-slate-400 font-mono block mb-1">Context Window Utilized</span>
              <div class="text-2xl font-black font-mono text-emerald-600" id="tcsContextUtil">2.6%</div>
              <span class="text-[11px] text-slate-400 font-mono">5,200 / 200,000</span>
            </div>
          </div>
        </section>
      )}

      <!-- 3. VRAM HARDWARE ADVISOR -->
      {util.slug === 'vram-hardware-advisor' && (
        <section class="card-aurora p-6 sm:p-8 space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Model Parameters:</label>
              <select id="vramParam" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs outline-none focus:border-blue-600 font-bold cursor-pointer">
                <option value="7">7B Parameters (Mistral / Qwen)</option>
                <option value="8" selected>8B Parameters (Llama 3 / DeepSeek-R1-8B)</option>
                <option value="14">14B Parameters (Qwen 2.5 14B)</option>
                <option value="32">32B Parameters (Qwen 2.5 Coder 32B)</option>
                <option value="70">70B Parameters (Llama 3.3 70B)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Quantization Precision:</label>
              <select id="vramQuant" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs outline-none focus:border-blue-600 font-bold cursor-pointer">
                <option value="16">FP16 (Uncompressed 16-bit)</option>
                <option value="8">Q8_0 (8-bit High Fidelity)</option>
                <option value="4.5" selected>Q4_K_M (4-bit Recommended)</option>
                <option value="3.5">Q3_K_M (3-bit Aggressive)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Context Window Buffer:</label>
              <select id="vramContext" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs outline-none focus:border-blue-600 font-bold cursor-pointer">
                <option value="4">4K Tokens (+0.5GB)</option>
                <option value="8" selected>8K Tokens (+1.0GB)</option>
                <option value="32">32K Tokens (+3.5GB)</option>
                <option value="128">128K Tokens (+12GB)</option>
              </select>
            </div>
          </div>

          <!-- VRAM Calculation Verdict Card -->
          <div class="p-6 rounded-2xl bg-white border-2 border-blue-200 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6">
            <div>
              <span class="text-xs font-mono font-bold uppercase text-blue-600">Minimum GPU VRAM Required</span>
              <div class="text-4xl font-black font-mono text-slate-900 mt-1" id="vramResultDisplay">6.8 GB VRAM</div>
              <p class="text-xs text-slate-500 mt-1" id="vramRecommendation">Comfortable fit for NVIDIA RTX 3060 (12GB) or Apple M1/M2/M3 with 16GB Unified Memory.</p>
            </div>

            <div class="text-right">
              <span class="text-xs font-mono font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-xl block mb-2">
                Fast Inference Guaranteed
              </span>
              <code class="text-xs font-mono bg-slate-900 text-slate-100 p-2 rounded-lg block" id="vramOllamaCmd">
                ollama run deepseek-r1:8b
              </code>
            </div>
          </div>
        </section>
      )}

      <!-- 4. JSON SCHEMA BUILDER -->
      {util.slug === 'json-schema-builder' && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-6 card-aurora p-6 sm:p-8 space-y-5">
            <h2 class="text-base font-black text-slate-900">Define Schema Properties</h2>
            <div class="space-y-3 text-xs">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Root Object Name:</label>
                <input type="text" id="jsbRootName" value="ExtractCompanyInfo" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold" />
              </div>
              <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-2">
                <span class="font-bold text-slate-800">Fields to extract:</span>
                <div class="flex items-center gap-2">
                  <input type="text" value="company_name" class="flex-1 bg-slate-50 border border-slate-200 rounded-lg p-2 font-mono text-xs" />
                  <span class="text-slate-400 font-mono text-[11px]">string (required)</span>
                </div>
                <div class="flex items-center gap-2">
                  <input type="text" value="founded_year" class="flex-1 bg-slate-50 border border-slate-200 rounded-lg p-2 font-mono text-xs" />
                  <span class="text-slate-400 font-mono text-[11px]">integer</span>
                </div>
                <div class="flex items-center gap-2">
                  <input type="text" value="competitors" class="flex-1 bg-slate-50 border border-slate-200 rounded-lg p-2 font-mono text-xs" />
                  <span class="text-slate-400 font-mono text-[11px]">array [string]</span>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-6 card-aurora p-6 sm:p-8 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <span class="text-xs font-mono font-bold uppercase text-slate-500">OpenAI Structured Output JSON Schema</span>
              <button type="button" id="copyJsonSchemaBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">Copy Schema</button>
            </div>
            <pre class="p-4 rounded-xl bg-slate-900 text-emerald-400 font-mono text-xs h-80 overflow-y-auto leading-relaxed" id="jsonSchemaOutput">{`{
  "name": "ExtractCompanyInfo",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "company_name": { "type": "string" },
      "founded_year": { "type": "integer" },
      "competitors": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["company_name", "founded_year", "competitors"],
    "additionalProperties": false
  }
}`}</pre>
          </div>
        </section>
      )}

      <!-- 5. YOUTUBE SCRIPT STUDIO -->
      {util.slug === 'youtube-script-studio' && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-5 card-aurora p-6 sm:p-8 space-y-5">
            <h2 class="text-base font-black text-slate-900">Shorts Retention Architecture</h2>
            <div class="space-y-4 text-xs">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Core Subject / Hook:</label>
                <input type="text" id="ytTopic" value="Why DeepSeek-R1 cost $6M instead of $100M" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none font-bold" />
              </div>
              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Hook Style:</label>
                <select id="ytStyle" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none font-bold cursor-pointer">
                  <option value="curiosity">Contrarian Curiosity ("Everything you were told is wrong")</option>
                  <option value="data">Surprising Numbers &amp; Metrics</option>
                  <option value="story">Mini Hero Arc Story</option>
                </select>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 card-aurora p-6 sm:p-8 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <span class="text-xs font-mono font-bold uppercase text-slate-500">60-Second Beat Sheet</span>
              <button type="button" id="copyYtBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">Copy Script</button>
            </div>
            <div class="p-4 rounded-xl bg-slate-900 text-slate-100 font-mono text-xs h-96 overflow-y-auto leading-relaxed whitespace-pre-wrap" id="ytOutput">
[00:00 - 00:05] HOOK (Visual: Red cross over $100M badge)
"Everyone assumed training a world-class AI model required 50,000 GPUs and a hundred million dollars. They were wrong."

[00:06 - 00:20] THE TENSION (Visual: Fast code scroll & GPU cluster)
"In January 2025, DeepSeek released R1. It matched OpenAI's reasoning benchmarks, but cost under six million dollars to train. How?"

[00:21 - 00:42] THE SECRET SAUCE (Visual: 3 Key bullet points)
"1. Multi-Head Latent Attention — slashing memory usage by 70%.
2. Native reinforcement learning without human labeling bottlenecks.
3. Open-source weights that anyone can run on their own laptop."

[00:43 - 00:60] CALL TO ACTION
"The monopoly on intelligence is broken. Link in bio to run this model on your own PC today."
            </div>
          </div>
        </section>
      )}

      <!-- 6. RAG CHUNKING VISUALIZER -->
      {util.slug === 'rag-chunking-visualizer' && (
        <section class="card-aurora p-6 sm:p-8 space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-1">Chunk Size (Characters):</label>
              <input type="range" id="chunkSize" min="50" max="300" value="120" class="w-full cursor-pointer" />
              <span class="text-xs font-mono font-bold text-blue-600" id="chunkSizeVal">120 chars</span>
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-1">Overlap (Characters):</label>
              <input type="range" id="chunkOverlap" min="0" max="80" value="25" class="w-full cursor-pointer" />
              <span class="text-xs font-mono font-bold text-purple-600" id="chunkOverlapVal">25 chars overlap</span>
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-1">Strategy:</label>
              <select class="w-full bg-white border border-slate-200 rounded-xl p-2.5 text-xs font-bold outline-none cursor-pointer">
                <option>Recursive Character Splitting</option>
                <option>Sentence Boundary Splitting</option>
                <option>Markdown Header Chunking</option>
              </select>
            </div>
          </div>

          <div class="space-y-3">
            <span class="text-xs font-mono font-bold uppercase text-slate-500">Visualized Document Chunks:</span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono text-xs" id="chunkVisualContainer">
              <div class="p-3 rounded-xl bg-blue-50 border border-blue-200 text-blue-900">
                <span class="text-[10px] uppercase font-bold text-blue-600 block mb-1">Chunk #1</span>
                "AIO AI is an open architecture directory and engineering platform for generative intelligence tools."
              </div>
              <div class="p-3 rounded-xl bg-purple-50 border border-purple-200 text-purple-900">
                <span class="text-[10px] uppercase font-bold text-purple-600 block mb-1">Chunk #2 (Overlap)</span>
                "generative intelligence tools. It catalogs 113 verified platforms, 88 open-source repositories, and 103 educators."
              </div>
              <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900">
                <span class="text-[10px] uppercase font-bold text-emerald-600 block mb-1">Chunk #3 (Overlap)</span>
                "and 103 educators with 100% data transparency and auditable 5-factor scoring."
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- 7. AI ROI CALCULATOR -->
      {util.slug === 'ai-roi-calculator' && (
        <section class="card-aurora p-6 sm:p-8 space-y-8">
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Team Members (Engineers):</label>
              <input type="number" id="roiTeamSize" value="5" min="1" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono font-bold outline-none" />
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Avg Hourly Wage ($/hr):</label>
              <input type="number" id="roiHourlyWage" value="65" min="10" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono font-bold outline-none" />
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Hours Saved / Week / Dev:</label>
              <input type="number" id="roiHoursSaved" value="4.5" step="0.5" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono font-bold outline-none" />
            </div>

            <div>
              <label class="block text-xs font-mono uppercase font-bold text-slate-600 mb-2">Tool Cost / Dev / Month:</label>
              <input type="number" id="roiToolCost" value="20" min="0" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono font-bold outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 border-t border-slate-200 text-xs">
            <div class="p-5 rounded-2xl bg-white border border-slate-200">
              <span class="text-slate-400 font-mono block mb-1">Monthly Hours Preserved</span>
              <div class="text-3xl font-black font-mono text-slate-900" id="roiMonthlyHours">90 Hours</div>
              <span class="text-slate-500 font-sans mt-1 block">5 engineers &times; 18 hrs/mo</span>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200">
              <span class="text-slate-400 font-mono block mb-1">Net Monthly Value Generated</span>
              <div class="text-3xl font-black font-mono text-emerald-600" id="roiMonthlyNet">$5,750 / mo</div>
              <span class="text-slate-500 font-sans mt-1 block">Value minus $100 tool licenses</span>
            </div>

            <div class="p-5 rounded-2xl bg-white border-2 border-emerald-300">
              <span class="text-emerald-800 font-mono font-bold block mb-1">Net Annual ROI Multiplier</span>
              <div class="text-3xl font-black font-mono text-emerald-700" id="roiAnnualRoi">58.5&times; ROI</div>
              <span class="text-emerald-900 font-sans mt-1 block">$69,000 annual net gain</span>
            </div>
          </div>
        </section>
      )}

      <!-- 8. REGEX OUTPUT PARSER -->
      {util.slug === 'regex-output-parser' && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-6 card-aurora p-6 sm:p-8 space-y-4">
            <h2 class="text-base font-black text-slate-900">Raw LLM Output (With Reasoning Tags)</h2>
            <textarea id="rawLlmText" rows="10" placeholder="Paste raw LLM text with reasoning tags..." class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono outline-none resize-none leading-relaxed"></textarea>
            <div class="flex gap-2">
              <button type="button" id="stripThinkBtn" class="px-3.5 py-1.5 rounded-xl bg-blue-600 text-white font-bold text-xs cursor-pointer">
                Strip &lt;think&gt; Tags
              </button>
              <button type="button" id="extractCodeBtn" class="px-3.5 py-1.5 rounded-xl bg-slate-900 text-white font-bold text-xs cursor-pointer">
                Extract Code Only
              </button>
            </div>
          </div>

          <div class="lg:col-span-6 card-aurora p-6 sm:p-8 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <span class="text-xs font-mono font-bold uppercase text-slate-500">Sanitized Parsed Output</span>
              <button type="button" id="copyParsedBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">Copy</button>
            </div>
            <pre class="p-4 rounded-xl bg-slate-900 text-slate-100 font-mono text-xs h-80 overflow-y-auto leading-relaxed whitespace-pre-wrap" id="parsedOutput"></pre>
          </div>
        </section>
      )}

      <!-- 9. README SKILL GENERATOR -->
      {util.slug === 'readme-skill-generator' && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-5 card-aurora p-6 sm:p-8 space-y-5">
            <h2 class="text-base font-black text-slate-900">Agent Specification Inputs</h2>
            <div class="space-y-4 text-xs">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Agent Skill Name:</label>
                <input type="text" id="skillName" value="code-review-sentinel" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none font-bold" />
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Description:</label>
                <input type="text" id="skillDesc" value="Autonomous pull request security and architectural compliance auditor." class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none font-medium" />
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Tools Allowed:</label>
                <input type="text" id="skillTools" value="read_file, run_command, git_diff" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none font-mono" />
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 card-aurora p-6 sm:p-8 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <span class="text-xs font-mono font-bold uppercase text-slate-500">Generated SKILL.md</span>
              <button type="button" id="copySkillBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">Copy SKILL.md</button>
            </div>
            <pre class="p-4 rounded-xl bg-slate-900 text-emerald-400 font-mono text-xs h-96 overflow-y-auto leading-relaxed whitespace-pre-wrap" id="skillOutput">{`---
name: code-review-sentinel
description: Autonomous pull request security and architectural compliance auditor.
version: 1.0.0
tools:
  - read_file
  - run_command
  - git_diff
---

# Code Review Sentinel Skill

## Role & Objectives
You are an autonomous engineering auditor responsible for validating code changes against security standards, test coverage, and documentation integrity.

## Execution Rules
1. Examine incoming git diffs for memory leaks and injection points.
2. Verify all TypeScript types are strictly declared without 'any'.
3. Output markdown annotations with exact line references.`}</pre>
          </div>
        </section>
      )}

    </div>

    <!-- Bottom Carousel of the other 8 utilities -->
    <section class="card-aurora p-6 sm:p-8 space-y-4">
      <h2 class="text-base font-black text-slate-900">Explore Other Dedicated Utilities</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {allUtilities.filter(u => u.slug !== util.slug).slice(0, 4).map(other => (
          <a href={`/utilities/${other.slug}`} class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-blue-500 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span>{other.icon}</span>
                <span class="text-[10px] font-mono uppercase font-bold text-slate-400">{other.category}</span>
              </div>
              <h3 class="text-sm font-black text-slate-900 mb-1">{other.name}</h3>
              <p class="text-[11px] text-slate-500 line-clamp-2">{other.tagline}</p>
            </div>
            <span class="text-xs font-bold text-blue-600 mt-3 block">Launch Studio &rarr;</span>
          </a>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Prompt Architect Logic
    var paRole = document.getElementById('paRole');
    var paTask = document.getElementById('paTask');
    var paConstraints = document.getElementById('paConstraints');
    var paFormat = document.getElementById('paFormat');
    var paOutput = document.getElementById('paOutput');

    function updatePa() {
      if (!paOutput) return;
      var role = paRole ? paRole.value : '';
      var task = paTask ? paTask.value : '';
      var constraints = paConstraints ? paConstraints.value : '';
      var format = paFormat ? paFormat.value : 'markdown';

      var text = "# SYSTEM PROMPT\n\n";
      text += "## ROLE & IDENTITY\n" + role + "\n\n";
      text += "## MISSION OBJECTIVE\n" + task + "\n\n";
      text += "## STRICT CONSTRAINTS\n- " + constraints + "\n\n";
      text += "## OUTPUT FORMAT\nAdhere strictly to " + format.toUpperCase() + " structure with zero meta-commentary.";

      paOutput.textContent = text;
    }

    [paRole, paTask, paConstraints, paFormat].forEach(function(el) {
      el?.addEventListener('input', updatePa);
      el?.addEventListener('change', updatePa);
    });
    updatePa();

    document.getElementById('copyPaBtn')?.addEventListener('click', function() {
      if (paOutput) {
        navigator.clipboard.writeText(paOutput.textContent || '');
        this.textContent = 'Copied!';
        var self = this;
        setTimeout(function() { self.textContent = 'Copy Prompt'; }, 1500);
      }
    });

    // 2. Token Cost Simulator Logic
    var tcsSelect = document.getElementById('tcsModelSelect');
    var tcsIn = document.getElementById('tcsInputTok');
    var tcsOut = document.getElementById('tcsOutputTok');

    function updateTcs() {
      if (!tcsSelect) return;
      var opt = tcsSelect.options[tcsSelect.selectedIndex];
      var inCost = parseFloat(opt.getAttribute('data-in') || '3.0');
      var outCost = parseFloat(opt.getAttribute('data-out') || '15.0');
      var ctx = parseFloat(opt.getAttribute('data-ctx') || '200000');

      var inTok = parseFloat(tcsIn?.value || '4000');
      var outTok = parseFloat(tcsOut?.value || '1200');

      var costPer = ((inTok / 1000000) * inCost) + ((outTok / 1000000) * outCost);
      var cost10k = costPer * 10000;
      var cost100k = costPer * 100000;
      var utilPct = (((inTok + outTok) / ctx) * 100).toFixed(1);

      var elCostPer = document.getElementById('tcsCostPerQuery');
      var elCostPerInr = document.getElementById('tcsCostPerQueryInr');
      var el10k = document.getElementById('tcsCost10k');
      var el10kInr = document.getElementById('tcsCost10kInr');
      var el100k = document.getElementById('tcsCost100k');
      var el100kInr = document.getElementById('tcsCost100kInr');
      var elUtil = document.getElementById('tcsContextUtil');

      if (elCostPer) elCostPer.textContent = '$' + costPer.toFixed(4);
      if (elCostPerInr) elCostPerInr.textContent = '₹' + (costPer * 86.5).toFixed(2) + ' INR';
      if (el10k) el10k.textContent = '$' + cost10k.toFixed(2);
      if (el10kInr) el10kInr.textContent = '₹' + (cost10k * 86.5).toLocaleString() + ' INR';
      if (el100k) el100k.textContent = '$' + cost100k.toFixed(2);
      if (el100kInr) el100kInr.textContent = '₹' + (cost100k * 86.5).toLocaleString() + ' INR';
      if (elUtil) elUtil.textContent = utilPct + '%';
    }

    [tcsSelect, tcsIn, tcsOut].forEach(function(el) {
      el?.addEventListener('input', updateTcs);
      el?.addEventListener('change', updateTcs);
    });
    updateTcs();

    // 3. VRAM Hardware Advisor Logic
    var vramP = document.getElementById('vramParam');
    var vramQ = document.getElementById('vramQuant');
    var vramC = document.getElementById('vramContext');

    function updateVram() {
      if (!vramP) return;
      var p = parseFloat(vramP.value);
      var q = parseFloat(vramQ.value);
      var c = parseFloat(vramC.value);

      // Model weight memory = (parameters in billions * bits per weight) / 8 bytes
      var weightGb = (p * q) / 8;
      // Context buffer overhead
      var ctxGb = c * 0.12;
      var total = (weightGb + ctxGb + 1.2).toFixed(1);

      var resDisplay = document.getElementById('vramResultDisplay');
      var recDisplay = document.getElementById('vramRecommendation');

      if (resDisplay) resDisplay.textContent = total + ' GB VRAM';
      if (recDisplay) {
        if (parseFloat(total) <= 8) {
          recDisplay.textContent = 'Runs smoothly on RTX 3060/4060 (8GB) or Mac M1/M2/M3 with 16GB RAM.';
        } else if (parseFloat(total) <= 16) {
          recDisplay.textContent = 'Requires RTX 4080 (16GB) or Mac with 24GB Unified Memory.';
        } else if (parseFloat(total) <= 24) {
          recDisplay.textContent = 'Requires RTX 3090 / 4090 (24GB VRAM) or Apple M3 Max.';
        } else {
          recDisplay.textContent = 'Requires Multi-GPU setup (e.g. 2x RTX 3090) or Mac Studio 64GB+.';
        }
      }
    }

    [vramP, vramQ, vramC].forEach(function(el) {
      el?.addEventListener('change', updateVram);
    });
    updateVram();

    // 7. AI ROI Calculator Logic
    var roiTeam = document.getElementById('roiTeamSize');
    var roiWage = document.getElementById('roiHourlyWage');
    var roiHours = document.getElementById('roiHoursSaved');
    var roiCost = document.getElementById('roiToolCost');

    function updateRoi() {
      if (!roiTeam) return;
      var team = parseFloat(roiTeam.value || '5');
      var wage = parseFloat(roiWage.value || '65');
      var hoursPerWeek = parseFloat(roiHours.value || '4.5');
      var toolCost = parseFloat(roiCost.value || '20');

      var monthlyHours = team * (hoursPerWeek * 4);
      var grossMonthlyValue = monthlyHours * wage;
      var totalToolCost = team * toolCost;
      var netMonthly = grossMonthlyValue - totalToolCost;
      var annualNet = netMonthly * 12;
      var multiplier = totalToolCost > 0 ? (grossMonthlyValue / totalToolCost).toFixed(1) : '100+';

      var elHours = document.getElementById('roiMonthlyHours');
      var elNet = document.getElementById('roiMonthlyNet');
      var elRoi = document.getElementById('roiAnnualRoi');

      if (elHours) elHours.textContent = monthlyHours + ' Hours';
      if (elNet) elNet.textContent = '$' + netMonthly.toLocaleString() + ' / mo';
      if (elRoi) elRoi.textContent = multiplier + '× ROI';
    }

    [roiTeam, roiWage, roiHours, roiCost].forEach(function(el) {
      el?.addEventListener('input', updateRoi);
    });
    updateRoi();

    // 8. Regex Parser Logic
    var rawText = document.getElementById('rawLlmText');
    var parsedText = document.getElementById('parsedOutput');

    function parseRaw() {
      if (!rawText || !parsedText) return;
      var val = rawText.value;
      // Strip <think>...</think>
      var clean = val.replace(/<think>[\s\S]*?<\/think>/gi, '').trim();
      parsedText.textContent = clean;
    }

    document.getElementById('stripThinkBtn')?.addEventListener('click', parseRaw);
    document.getElementById('extractCodeBtn')?.addEventListener('click', function() {
      if (!rawText || !parsedText) return;
      var val = rawText.value;
      var match = val.match(/```(?:\w+)?\s*([\s\S]*?)```/);
      parsedText.textContent = match ? match[1].trim() : 'No markdown code block found.';
    });

    if (rawText && !rawText.value) {
      rawText.value = "<think>\nUser is asking for an optimized sorting algorithm in TypeScript.\nI should provide quicksort with in-place partition.\n</think>\n```typescript\nfunction quickSort(arr: number[]): number[] {\n  if (arr.length <= 1) return arr;\n  const pivot = arr[arr.length - 1];\n  const left = arr.filter((x, i) => x <= pivot && i < arr.length - 1);\n  const right = arr.filter(x => x > pivot);\n  return [...quickSort(left), pivot, ...quickSort(right)];\n}\n```";
    }

    parseRaw();
  });
</script>
