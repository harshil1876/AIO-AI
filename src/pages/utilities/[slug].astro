      var score = 50;
      if (role.length > 10) score += 15;
      if (task.length > 20) score += 15;
      if (g1 && g2 && g3) score += 10;
      if (document.querySelectorAll('.pa-ex-in').length >= 1) score += 10;
      if (paQuality) {
        paQuality.textContent = score + "/100 • " + (score >= 80 ? "Production Ready" : "Draft");
      }

      var text = "";
      if (currentPaMode === 'prompt') {
        text += "# SYSTEM PROMPT — " + model + "\n\n";
