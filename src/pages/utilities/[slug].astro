        text += "## 2. PRIMARY OBJECTIVE\n" + task + "\n\n";
        text += "## 3. STRICT GUARDRAILS\n";
        if (g1) text += "- Zero hallucination: verify all file paths and cite exact line numbers.\n";
        if (g2) text += "- Strict typing: enforce explicit TypeScript interfaces with no 'any'.\n";
        if (g3) text += "- No conversational pleasantries or conversational filler.\n";
        if (g4) text += "- Maintain documentation integrity: preserve existing comments and docstrings.\n\n";
        text += "## 4. OUTPUT SCHEMA\nAdhere strictly to " + format.toUpperCase() + " specifications.\n\n";
        if (thinking === 'cot') text += "## 5. REASONING PROCESS\nAlways open with `<think>` tags and verify edge cases before outputting final solution.\n";
      } else if (currentPaMode === 'cursor') {
        text += "# .cursorrules for " + role + "\n\n";
        text += "target_model: " + model + "\n";
        text += "execution_mode: autonomous\n\n";
        text += "## Core Rules\n";
        text += "- Task: " + task + "\n";
        if (g1) text += "- Rule: Never assume file contents without reading.\n";
        if (g2) text += "- Rule: Strictly type all return signatures.\n";
        if (g3) text += "- Rule: Skip intro/outro pleasantries.\n";
      } else {
        text += "---\nname: " + role.toLowerCase().replace(/[^a-z0-9]+/g, '-') + "\n";
        text += "description: " + task + "\n";
        text += "target_model: " + model + "\n";
        text += "---\n\n# Skill Instructions\n\n";
        text += "1. Inspect project context.\n2. Execute " + task + ".\n3. Output formatted " + format + ".\n";
      }

      paOutput.textContent = text;
