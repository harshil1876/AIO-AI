---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OFFICIAL_MODELS } from '../../data/modelsData';

export function getStaticPaths() {
  const UTILITIES = [
    {
      slug: 'prompt-architect',
      name: 'Prompt Architect & Meta-Prompt Studio',
      category: 'Prompt Engineering',
      tagline: 'Engineer production system prompts with strict constraints, few-shot examples, and output formatting.',
      icon: '⚡'
    },
    {
      slug: 'token-cost-simulator',
      name: 'Token Cost Simulator & Context Benchmarker',
      category: 'Token Economics',
      tagline: 'Simulate prompt input/output costs across 26 official frontier models with USD/INR toggles.',
      icon: '💰'
    },
    {
      slug: 'vram-hardware-advisor',
      name: 'VRAM & Hardware Compatibility Advisor',
      category: 'Local Inference',
      tagline: 'Calculate exact GPU VRAM requirement for 7B-70B models across FP16, Q8, Q4_K_M quantizations.',
      icon: '🖥️'
    },
    {
      slug: 'json-schema-builder',
      name: 'JSON Schema & Structured Output Studio',
      category: 'Agent Tooling',
      tagline: 'Visually generate strict JSON Schemas compatible with OpenAI Structured Outputs and Anthropic Tool Use.',
      icon: '🧩'
    },
    {
      slug: 'youtube-script-studio',
      name: 'YouTube Script & Shorts Retention Studio',
      category: 'Creator Engineering',
      tagline: 'Craft high-retention 60-second vertical video scripts with psychological hooks and visual cues.',
      icon: '🎬'
    },
    {
      slug: 'rag-chunking-visualizer',
      name: 'RAG Chunking & Overlap Visualizer',
      category: 'Vector Retrieval',
      tagline: 'Visualize how text documents are sliced into chunks with variable size, overlap, and separators.',
      icon: '📑'
    },
    {
      slug: 'ai-roi-calculator',
      name: 'AI ROI & Engineering Spend Calculator',
      category: 'Enterprise Strategy',
      tagline: 'Quantify team productivity gains, developer hours preserved, and net monthly ROI from AI tooling.',
      icon: '📈'
    },
    {
      slug: 'regex-output-parser',
      name: 'LLM Output Parser & Tag Stripper',
      category: 'Data Processing',
      tagline: 'Clean reasoning tags (<think>), extract markdown code blocks, and parse structured JSON completions.',
      icon: '🔍'
    },
    {
      slug: 'readme-skill-generator',
      name: 'SKILL.md & Agent README Generator',
      category: 'Agent Systems',
      tagline: 'Generate production-grade SKILL.md definitions with YAML frontmatter and execution conditions.',
      icon: '🤖'
    }
  ];

  return UTILITIES.map(util => ({
    params: { slug: util.slug },
    props: { util, allUtilities: UTILITIES }
  }));
}

const { util, allUtilities } = Astro.props;
---

<Layout 
  title={`${util.name} | Utility Studio | AIO AI`}
  description={util.tagline}
>
  <Header currentPath="/utilities" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    
    <!-- Top Breadcrumbs & Nav Strip -->
    <div class="flex items-center justify-between text-xs font-mono text-slate-500">
      <div class="flex items-center gap-2">
        <a href="/utilities" class="hover:text-blue-600 transition-colors">Utility Studio</a>
        <span>/</span>
        <span class="text-slate-800 font-bold">{util.name}</span>
      </div>
      <a href="/utilities" class="text-blue-600 hover:underline font-bold">
        &larr; All 9 Utilities
      </a>
    </div>

    <!-- Hero Header -->
    <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-400/30 bg-blue-500/10 text-[11px] font-mono font-bold text-blue-300">
            <span>{util.icon}</span>
            <span>{util.category.toUpperCase()} • 100% CLIENT-SIDE IN-BROWSER</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            {util.name}
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
            {util.tagline} Zero server telemetry; all calculations and code generations execute safely in your browser.
          </p>
        </div>

        <div class="flex items-center gap-2 bg-slate-900/80 p-2 rounded-2xl border border-slate-700 text-xs font-mono shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-slate-300 font-bold">Local Execution Sandbox Active</span>
        </div>
      </div>
    </section>

    <!-- WORKSPACE CONTAINER (DYNAMIC BY SLUG) -->
    <div class="space-y-8" id="utilityWorkspace">
      
      <!-- 1. PROMPT ARCHITECT -->
      {util.slug === 'prompt-architect' && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 card-aurora p-6 sm:p-8 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <h2 class="text-base font-black text-slate-900">System Prompt &amp; Rule Specifications</h2>
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono text-slate-400 font-bold">Quality Score:</span>
                <span id="paQualityBadge" class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                  92/100 • Production Ready
                </span>
              </div>
            </div>
            
            <div class="space-y-4 text-xs">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Target Model:</label>
                  <select id="paTargetModel" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold cursor-pointer">
                    {OFFICIAL_MODELS.map(m => (
                      <option value={m.name}>{m.name} ({m.provider})</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Thinking Mode:</label>
                  <select id="paThinkingMode" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold cursor-pointer">
                    <option value="cot">Chain-of-Thought (&lt;think&gt; reasoning first)</option>
                    <option value="direct">Direct &amp; Succinct (No meta-commentary)</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Role &amp; Persona Definition:</label>
                <input type="text" id="paRole" value="Principal Full-Stack Security Engineer" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none focus:border-blue-600 font-medium" />
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Primary Mission / Task:</label>
                <textarea id="paTask" rows="2" class="w-full bg-white border border-slate-200 rounded-xl p-3 outline-none focus:border-blue-600 font-medium resize-none">Conduct automated security, performance, and architecture audits on incoming git pull request diffs.</textarea>
              </div>

              <!-- Guardrails Checklist -->
              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1.5">Active Guardrails &amp; Constraints:</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 p-3 rounded-xl bg-white border border-slate-200 font-sans">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="paG1" checked class="rounded border-slate-300 text-blue-600" />
                    <span>Zero hallucination: cite exact line numbers</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="paG2" checked class="rounded border-slate-300 text-blue-600" />
                    <span>Strict typing: no "any" allowed</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="paG3" checked class="rounded border-slate-300 text-blue-600" />
                    <span>No conversational filler or polite banter</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="paG4" checked class="rounded border-slate-300 text-blue-600" />
                    <span>Preserve all existing docstrings &amp; comments</span>
                  </label>
                </div>
              </div>

              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Output Schema Structure:</label>
                <select id="paFormat" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none focus:border-blue-600 font-bold cursor-pointer">
                  <option value="markdown">Structured GitHub Markdown with Diff Annotations</option>
                  <option value="json">Strict JSON Schema Object with Errors Array</option>
                  <option value="typescript">TypeScript Module with Type Definitions</option>
                </select>
              </div>

              <!-- Dynamic Few-Shot Examples -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="font-mono uppercase font-bold text-slate-600">Few-Shot Examples:</label>
                  <button type="button" id="paAddExampleBtn" class="text-blue-600 font-bold hover:underline cursor-pointer">+ Add Example Pair</button>
                </div>
                <div id="paExamplesContainer" class="space-y-2">
                  <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
                    <input type="text" class="pa-ex-in w-full bg-white border border-slate-200 rounded-lg p-1.5 font-mono text-[11px]" value="Input: const total = price + tax;" />
                    <input type="text" class="pa-ex-out w-full bg-white border border-slate-200 rounded-lg p-1.5 font-mono text-[11px]" value="Output: [Issue L12]: Implicit any type on tax; coerce explicitly to number." />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 card-aurora p-6 sm:p-8 space-y-4 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                <!-- 3 Mode Switcher Tabs -->
                <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-mono font-bold">
                  <button type="button" id="paTabPrompt" class="pa-mode-btn px-2.5 py-1 rounded-lg bg-slate-900 text-white shadow-xs cursor-pointer">Prompt</button>
                  <button type="button" id="paTabCursor" class="pa-mode-btn px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer">.cursorrules</button>
                  <button type="button" id="paTabSkill" class="pa-mode-btn px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 cursor-pointer">SKILL.md</button>
                </div>

                <div class="flex items-center gap-2">
                  <button type="button" id="copyPaBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">Copy</button>
                  <button type="button" id="downloadPaBtn" class="text-xs font-mono font-bold text-slate-700 bg-white border border-slate-200 px-2 py-1 rounded-lg hover:bg-slate-50 cursor-pointer">Download</button>
                </div>
              </div>

              <div class="mt-4 p-4 rounded-xl bg-slate-900 text-emerald-300 font-mono text-xs h-96 overflow-y-auto leading-relaxed whitespace-pre-wrap select-all" id="paOutput"></div>
            </div>
          </div>
        </section>
      )}

      <!-- 2. TOKEN COST SIMULATOR -->
      {util.slug === 'token-cost-simulator' && (
        <section class="card-aurora p-6 sm:p-8 space-y-8">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <label class="text-xs font-mono uppercase font-bold text-slate-700">Live Prompt / Document Textarea:</label>
              <div class="flex items-center gap-3 font-mono text-xs text-slate-500">
                <span>Chars: <strong id="tcsCharCount" class="text-slate-900">420</strong></span>
                <span>•</span>
                <span>Words: <strong id="tcsWordCount" class="text-slate-900">65</strong></span>
                <span>•</span>
                <span>Tokens (~BPE): <strong id="tcsTokCount" class="text-blue-600">105</strong></span>
              </div>
            </div>
            <textarea id="tcsTextInput" rows="4" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-mono outline-none focus:border-blue-600 leading-relaxed">AIO AI is an open architecture AI discovery directory and intent engineering platform for frontier tools, autonomous agents, open-source weights, and verified creators. It calculates deterministic 5-factor quality scores, context windows, and real hardware compatibility.</textarea>
          </div>

          <!-- Controls Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-6 text-xs">
            <div>
              <div class="flex justify-between font-mono mb-1.5 font-bold">
                <span class="text-slate-600">Output Tokens:</span>
                <span id="tcsOutVal" class="text-blue-600">1,200</span>
              </div>
              <input type="range" id="tcsOutputSlider" min="100" max="16000" step="100" value="1200" class="w-full cursor-pointer" />
            </div>

            <div>
              <div class="flex justify-between font-mono mb-1.5 font-bold">
                <span class="text-slate-600">Requests / Day:</span>
                <span id="tcsReqVal" class="text-blue-600">5,000</span>
              </div>
              <input type="range" id="tcsReqSlider" min="100" max="50000" step="500" value="5000" class="w-full cursor-pointer" />
            </div>

            <div>
              <div class="flex justify-between font-mono mb-1.5 font-bold">
                <span class="text-slate-600">Cache Hit Rate:</span>
                <span id="tcsCacheVal" class="text-emerald-600">50%</span>
              </div>
              <input type="range" id="tcsCacheSlider" min="0" max="90" step="5" value="50" class="w-full cursor-pointer" />
            </div>

            <div>
              <div class="font-mono mb-1.5 font-bold text-slate-600">Display Currency:</div>
              <button type="button" id="tcsCurrencyToggle" class="w-full py-2.5 rounded-xl border border-slate-200 bg-white font-mono font-bold text-slate-800 hover:bg-slate-50 cursor-pointer shadow-xs">
                USD ($) / INR (₹) Toggle
              </button>
            </div>
          </div>

          <!-- Dynamic 26-Model Benchmark Table -->
          <div class="space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <h3 class="text-xs font-mono font-bold uppercase text-slate-700">26 Official Frontier Models (Ranked by Total Cost)</h3>
              <button type="button" id="tcsExportCsvBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">Export Benchmark CSV</button>
            </div>
            <div class="overflow-x-auto max-h-96 scrollbar-thin">
              <table class="w-full text-xs text-left" id="tcsTable">
                <thead class="text-[11px] font-mono text-slate-400 uppercase bg-slate-50 border-b border-slate-200">
                  <tr>
                    <th class="p-2.5">Model</th>
                    <th class="p-2.5">Provider</th>
                    <th class="p-2.5">Context Used</th>
                    <th class="p-2.5">Cost / Call</th>
                    <th class="p-2.5">Daily Cost</th>
                    <th class="p-2.5">Monthly Cost (30d)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-mono" id="tcsTableBody">
                  <!-- Dynamically populated -->
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )}

      <!-- 3. VRAM HARDWARE ADVISOR -->
      {util.slug === 'vram-hardware-advisor' && (
        <section class="card-aurora p-6 sm:p-8 space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-6 text-xs">
            <div>
              <label class="block font-mono uppercase font-bold text-slate-600 mb-2">GPU Hardware Preset:</label>
              <select id="vramPreset" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold cursor-pointer">
                <option value="12" selected>RTX 3060 / 4070 (12GB VRAM)</option>
                <option value="16">RTX 4080 (16GB VRAM)</option>
                <option value="24">RTX 4090 / 3090 (24GB VRAM)</option>
                <option value="36">Apple Mac M3 Max (36GB Unified)</option>
                <option value="48">Dual RTX 3090 (48GB VRAM)</option>
                <option value="64">Apple Mac Studio (64GB Unified)</option>
                <option value="80">Nvidia A100 / H100 (80GB VRAM)</option>
                <option value="custom">Custom VRAM Slider</option>
              </select>
            </div>

            <div>
              <label class="block font-mono uppercase font-bold text-slate-600 mb-2">Model Parameters:</label>
              <select id="vramParam" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold cursor-pointer">
                <option value="1.5">1.5B (Qwen 2.5 / DeepSeek Small)</option>
                <option value="3">3B (Llama 3.2 3B)</option>
                <option value="7">7B (Mistral 7B)</option>
                <option value="8" selected>8B (Llama 3.1 / DeepSeek-R1-8B)</option>
                <option value="14">14B (Qwen 2.5 14B)</option>
                <option value="32">32B (Qwen 2.5 Coder 32B)</option>
                <option value="70">70B (Llama 3.3 70B)</option>
                <option value="671">671B MoE (DeepSeek-V3 / R1 Full)</option>
              </select>
            </div>

            <div>
              <label class="block font-mono uppercase font-bold text-slate-600 mb-2">Quantization Precision:</label>
              <select id="vramQuant" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold cursor-pointer">
                <option value="16">FP16 (Uncompressed 16-bit)</option>
                <option value="8">Q8_0 (8-bit High Fidelity)</option>
                <option value="6">Q6_K (6-bit Balanced)</option>
                <option value="4.5" selected>Q4_K_M (4-bit Recommended)</option>
                <option value="3.5">IQ3_XS (3-bit Aggressive)</option>
              </select>
            </div>

            <div>
              <label class="block font-mono uppercase font-bold text-slate-600 mb-2">Target Context Length:</label>
              <select id="vramContext" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold cursor-pointer">
                <option value="4">4K Tokens (+0.5GB KV)</option>
                <option value="8" selected>8K Tokens (+1.0GB KV)</option>
                <option value="32">32K Tokens (+4.0GB KV)</option>
                <option value="128">128K Tokens (+16.0GB KV)</option>
              </select>
            </div>
          </div>

          <!-- Stacked-Bar Visualizer -->
          <div class="space-y-2 p-5 rounded-2xl bg-white border border-slate-200">
            <div class="flex items-center justify-between text-xs font-mono font-bold">
              <span>VRAM Allocation Breakdown:</span>
              <span id="vramTotalNeededText" class="text-blue-600">6.8 GB / 12 GB Total Capacity</span>
            </div>

            <div class="w-full h-7 bg-slate-100 rounded-xl overflow-hidden flex border border-slate-200 shadow-inner" id="vramBarContainer">
              <div id="vramBarWeights" class="bg-blue-600 h-full transition-all duration-300" style="width: 40%;" title="Model Weights"></div>
              <div id="vramBarKv" class="bg-indigo-500 h-full transition-all duration-300" style="width: 10%;" title="KV Cache"></div>
              <div id="vramBarCuda" class="bg-amber-500 h-full transition-all duration-300" style="width: 8%;" title="CUDA / Metal Overhead"></div>
            </div>

            <div class="flex flex-wrap items-center gap-4 text-[11px] font-mono text-slate-500 pt-1">
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-blue-600"></span> Weights: <strong id="vramWeightsVal">4.8 GB</strong></span>
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-indigo-500"></span> KV Cache: <strong id="vramKvVal">1.0 GB</strong></span>
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-amber-500"></span> Overhead: <strong id="vramCudaVal">1.0 GB</strong></span>
              <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-slate-200"></span> Free GPU Memory: <strong id="vramFreeVal">5.2 GB</strong></span>
            </div>
          </div>

          <!-- Hardware Verdict Card -->
          <div class="p-6 rounded-2xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md">
            <div>
              <span class="text-xs font-mono font-bold uppercase text-emerald-400" id="vramVerdictStatus">✓ Smooth Local Execution</span>
              <div class="text-3xl font-black font-mono text-white mt-1" id="vramTokensSpeed">~45–60 tokens/sec</div>
              <p class="text-xs text-slate-300 mt-1" id="vramRecommendationText">Fits comfortably within GPU VRAM with zero disk swapping.</p>
            </div>

            <div class="text-right w-full sm:w-auto">
              <span class="text-[10px] font-mono uppercase text-slate-400 block mb-1">Recommended Runner Command:</span>
              <code class="text-xs font-mono bg-slate-800 text-emerald-300 px-3 py-2 rounded-xl border border-slate-700 block select-all" id="vramRunnerCmd">
                ollama run deepseek-r1:8b
              </code>
            </div>
          </div>
        </section>
      )}

      <!-- 4. JSON SCHEMA BUILDER -->
      {util.slug === 'json-schema-builder' && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-6 card-aurora p-6 sm:p-8 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <h2 class="text-base font-black text-slate-900">Visual Schema Field Table</h2>
              <button type="button" id="jsbAddFieldBtn" class="text-xs font-mono font-bold text-blue-600 hover:underline cursor-pointer">+ Add Field</button>
            </div>

            <div class="space-y-3 text-xs">
              <div>
                <label class="block font-mono uppercase font-bold text-slate-600 mb-1">Root Schema Name:</label>
                <input type="text" id="jsbRootName" value="ExtractCompanyInfo" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 outline-none font-bold" />
              </div>

              <!-- Field Rows Container -->
              <div id="jsbFieldRows" class="space-y-2 max-h-80 overflow-y-auto pr-1">
                <div class="jsb-row p-3 rounded-xl bg-white border border-slate-200 space-y-2">
                  <div class="flex items-center gap-2">
                    <input type="text" class="jsb-name flex-1 bg-slate-50 border border-slate-200 rounded-lg p-1.5 font-mono text-xs font-bold" value="company_name" placeholder="field_name" />
                    <select class="jsb-type bg-slate-50 border border-slate-200 rounded-lg p-1.5 font-mono text-xs cursor-pointer">
                      <option value="string" selected>string</option>
                      <option value="number">number</option>
                      <option value="boolean">boolean</option>
                      <option value="array">array [string]</option>
                      <option value="enum">enum</option>
                    </select>
                    <label class="flex items-center gap-1 font-mono text-[11px] text-slate-500">
                      <input type="checkbox" class="jsb-req" checked /> req
                    </label>
                  </div>
                  <input type="text" class="jsb-desc w-full bg-slate-50 border border-slate-200 rounded-lg p-1.5 font-sans text-[11px]" value="Official legal entity name of the company." placeholder="Description" />
                </div>

                <div class="jsb-row p-3 rounded-xl bg-white border border-slate-200 space-y-2">
                  <div class="flex items-center gap-2">
