---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="Built-in AI & Creator Utilities | AI Discovery"
  description="Client-side utilities: Prompt Improver, YouTube Hook Generator, Image Resizer & WebP Converter, QR Generator, and Token Calculator."
>
  <Header currentPath="/utilities" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-12 md:py-16 text-center">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-medium text-mute mb-4">
          <svg class="w-3.5 h-3.5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.67 2.67 0 0 0 21 17.25l-5.83-5.83M3 3l6.59 6.59m0 0L7.5 12l2.25 2.25 2.41-2.09 5.84 5.84a2 2 0 0 0 2.83-2.83l-5.84-5.84 2.09-2.41L12 7.5 9.59 9.59Z" />
          </svg>
          <span>Free Client-Side Tools &bull; Zero Server Uploads</span>
        </div>

        <h1 class="text-3xl md:text-5xl font-semibold text-ink tracking-tight mb-4" style="letter-spacing: -1.4px;">
          Built-in Creator Utilities
        </h1>
        <p class="text-body text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
          High-performance browser utilities running 100% locally on your device. Craft structured prompts, generate viral hooks, compress images, and calculate LLM costs.
        </p>

        <!-- Feature Banner for Token Calculator -->
        <div class="mt-8 p-4 rounded-lg bg-hairline-soft border border-hairline max-w-2xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-left">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-md bg-ink text-on-primary flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18m-7.5-12h12a1.5 1.5 0 0 1 1.5 1.5v13.5a1.5 1.5 0 0 1-1.5 1.5h-12a1.5 1.5 0 0 1-1.5-1.5V7.5A1.5 1.5 0 0 1 6 6Z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-semibold text-ink">Official LLM Token Calculator Suite</h3>
              <p class="text-[11px] text-mute">Live real-time token counter & cross-provider pricing matrix across 13 frontier models.</p>
            </div>
          </div>
          <a 
            href="/token-calculator"
            class="px-3.5 py-1.5 rounded bg-ink text-on-primary text-xs font-medium hover:bg-neutral-800 transition-colors shrink-0 shadow-xs"
          >
            Open Calculator &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Interactive Utilities Workspace -->
    <div class="w-full max-w-5xl mx-auto px-6 py-12 flex-1 flex flex-col gap-12">

      <!-- Utility 1: Structured Prompt Improver -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs" id="prompt-improver">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
          <div>
            <span class="text-[10px] font-mono text-mute uppercase tracking-wider block">Utility #1</span>
            <h2 class="text-base font-semibold text-ink tracking-tight">Structured Prompt Improver & System Prompt Generator</h2>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-canvas border border-hairline text-body">Client-Side</span>
        </div>

        <p class="text-xs text-mute mb-5">
          Converts raw conversational prompts into structured XML/Markdown system prompts with role definition, explicit boundary constraints, and step-by-step reasoning triggers.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-ink mb-1">Your Raw Prompt or Goal:</label>
              <textarea 
                id="rawPromptInput" 
                rows="5"
                placeholder="e.g. Write an article about DeepSeek R1 and why open source models matter for startups" 
                class="w-full p-3 rounded-md text-xs bg-canvas border border-hairline text-ink placeholder:text-mute focus:outline-none focus:border-ink transition-colors resize-none font-mono"
              ></textarea>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-medium text-mute mb-1">Target Persona:</label>
                <select id="promptPersona" class="w-full p-2 rounded bg-canvas border border-hairline text-xs text-ink focus:outline-none">
                  <option value="Senior Staff Software Engineer">Senior Staff Engineer</option>
                  <option value="Direct-Response Copywriter">Direct-Response Copywriter</option>
                  <option value="Executive Venture Capitalist">Executive VC / Investor</option>
                  <option value="Academic Researcher">Academic Researcher</option>
                </select>
              </div>

              <div>
                <label class="block text-[11px] font-medium text-mute mb-1">Reasoning Style:</label>
                <select id="promptReasoning" class="w-full p-2 rounded bg-canvas border border-hairline text-xs text-ink focus:outline-none">
                  <option value="Chain of Thought (Step-by-step)">Chain of Thought</option>
                  <option value="Zero Fluff / Concise Direct">Concise Direct</option>
                  <option value="Extreme Skeptic / Red Team">Red Team / Critical</option>
                </select>
              </div>
            </div>

            <button 
              type="button" 
              id="improvePromptBtn" 
              class="w-full py-2 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors cursor-pointer shadow-xs"
            >
              Generate Optimized System Prompt
            </button>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-xs font-medium text-ink">Optimized Production Prompt:</label>
              <button 
                type="button" 
                id="copyImprovedPrompt" 
                class="text-[11px] text-mute hover:text-ink cursor-pointer"
              >
                Copy Output
              </button>
            </div>
            <textarea 
              id="improvedPromptOutput" 
              rows="9"
              readonly
              class="w-full p-3 rounded-md text-xs bg-canvas border border-hairline text-ink font-mono select-all resize-none"
              placeholder="Structured prompt will generate here..."
            ></textarea>
          </div>
        </div>
      </section>

      <!-- Utility 2: YouTube Title, Hook & Shorts Script Structurer -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs" id="hook-generator">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
          <div>
            <span class="text-[10px] font-mono text-mute uppercase tracking-wider block">Utility #2</span>
            <h2 class="text-base font-semibold text-ink tracking-tight">YouTube Title & 3-Second Viral Hook Structurer</h2>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-canvas border border-hairline text-body">Formula-Based</span>
        </div>

        <p class="text-xs text-mute mb-5">
          Uses proven psychological engagement frameworks (Negativity Bias, Curiosity Gap, Outcome vs Barrier) to generate high-CTR titles and first-frame retention hooks.
        </p>

        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              type="text" 
              id="hookTopicInput" 
              placeholder="Enter your video core topic (e.g. Cursor AI vs GitHub Copilot)" 
              class="flex-1 p-2.5 rounded-md text-xs bg-canvas border border-hairline text-ink placeholder:text-mute focus:outline-none focus:border-ink transition-colors"
            />
            <button 
              type="button" 
              id="generateHooksBtn" 
              class="px-5 py-2.5 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors cursor-pointer shrink-0"
            >
              Generate Hooks & Titles
            </button>
          </div>

          <div id="hookResultsContainer" class="hidden space-y-4 pt-2">
            <div>
              <span class="text-[11px] font-semibold text-ink uppercase tracking-wider block mb-2">High-CTR Title Formats:</span>
              <ul class="space-y-1.5 text-xs text-body font-mono bg-canvas p-3 rounded border border-hairline" id="titlesList">
              </ul>
            </div>

            <div>
              <span class="text-[11px] font-semibold text-ink uppercase tracking-wider block mb-2">3-Second Visual & Spoken Pattern Interrupt Hooks:</span>
              <ul class="space-y-1.5 text-xs text-body bg-canvas p-3 rounded border border-hairline" id="hooksList">
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Utility 3: Client-Side Image Resizer & WebP Converter -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs" id="image-resizer">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
          <div>
            <span class="text-[10px] font-mono text-mute uppercase tracking-wider block">Utility #3</span>
            <h2 class="text-base font-semibold text-ink tracking-tight">Client-Side Image Resizer, Compressor & WebP Converter</h2>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-canvas border border-hairline text-emerald-600 dark:text-emerald-400">100% In-Browser</span>
        </div>

        <p class="text-xs text-mute mb-5">
          Compresses images and converts PNG/JPG to WebP using HTML5 Canvas. Your photos never leave your device or touch a server.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
          <div class="space-y-4">
            <div class="border-2 border-dashed border-hairline rounded-lg p-6 text-center hover:border-faint transition-colors cursor-pointer bg-canvas relative">
              <input type="file" id="imageFileInput" accept="image/png, image/jpeg, image/webp" class="absolute inset-0 opacity-0 cursor-pointer" />
              <div class="text-xs text-mute pointer-events-none">
                <svg class="w-8 h-8 text-faint mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
                <span class="font-medium text-ink block">Click or drag image file here</span>
                <span class="text-[11px] text-faint">Supports PNG, JPG, WebP</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-medium text-mute mb-1">Max Width (px):</label>
                <input type="number" id="imgMaxWidth" value="1200" class="w-full p-2 rounded bg-canvas border border-hairline text-xs text-ink font-mono" />
              </div>
              <div>
                <label class="block text-[11px] font-medium text-mute mb-1">Quality (%):</label>
                <input type="number" id="imgQuality" value="85" min="10" max="100" class="w-full p-2 rounded bg-canvas border border-hairline text-xs text-ink font-mono" />
              </div>
            </div>

            <button 
              type="button" 
              id="processImageBtn" 
              class="w-full py-2 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors cursor-pointer shadow-xs"
            >
              Convert to Optimized WebP
            </button>
          </div>

          <div id="imagePreviewBox" class="p-4 rounded-lg bg-canvas border border-hairline text-center text-xs text-mute flex flex-col items-center justify-center min-h-[220px]">
            <span id="imageEmptyText">No image converted yet. Upload a file to preview.</span>
            <div id="imageResult" class="hidden w-full flex flex-col items-center">
              <img id="convertedPreviewImg" class="max-h-48 rounded border border-hairline object-contain mb-3" />
              <div class="text-[11px] font-mono text-mute mb-3" id="imageStatsText"></div>
              <a 
                id="downloadWebpLink" 
                download="optimized.webp"
                class="px-4 py-2 rounded bg-emerald-600 text-white text-xs font-medium hover:bg-emerald-700 transition-colors inline-flex items-center gap-1.5 shadow-xs"
              >
                Download WebP File
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Utility 4: Clean QR Code Generator -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs" id="qr-generator">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
          <div>
            <span class="text-[10px] font-mono text-mute uppercase tracking-wider block">Utility #4</span>
            <h2 class="text-base font-semibold text-ink tracking-tight">Clean High-Resolution QR Code Generator</h2>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-canvas border border-hairline text-body">Instant SVG</span>
        </div>

        <p class="text-xs text-mute mb-5">
          Generate clean, tracking-free QR codes for tool documentation, presentations, and product links.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-medium text-ink mb-1">Target URL or Text:</label>
              <input 
                type="text" 
                id="qrTextInput" 
                value="https://github.com/harshil1876/AIO-AI" 
                placeholder="https://yourwebsite.com" 
                class="w-full p-2.5 rounded-md text-xs bg-canvas border border-hairline text-ink font-mono focus:outline-none focus:border-ink"
              />
            </div>

            <button 
              type="button" 
              id="generateQrBtn" 
              class="w-full py-2 rounded-md bg-ink text-on-primary hover:bg-neutral-800 text-xs font-medium transition-colors cursor-pointer shadow-xs"
            >
              Update QR Code
            </button>
          </div>

          <div class="flex flex-col items-center justify-center p-6 bg-canvas border border-hairline rounded-lg">
            <div id="qrDisplayBox" class="p-3 bg-white rounded border border-hairline shadow-xs mb-3">
              <!-- Inline QR Image Canvas Container -->
              <img id="qrImageTag" src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https://github.com/harshil1876/AIO-AI" alt="QR Code" class="w-36 h-36" />
            </div>
            <a 
              id="downloadQrBtn" 
              href="https://api.qrserver.com/v1/create-qr-code/?size=500x500&data=https://github.com/harshil1876/AIO-AI" 
              target="_blank" 
              download="qrcode.png"
              class="text-xs font-medium text-ink hover:underline"
            >
              Download Full-Res PNG &rarr;
            </a>
          </div>
        </div>
      </section>

      <!-- Utility 5: Word, Sentence & Reading Time Counter -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs" id="word-counter">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
          <div>
            <span class="text-[10px] font-mono text-mute uppercase tracking-wider block">Utility #5</span>
            <h2 class="text-base font-semibold text-ink tracking-tight">Word, Character, Sentence & Reading-Time Counter</h2>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-canvas border border-hairline text-body">Live Telemetry</span>
        </div>

        <textarea 
          id="counterTextArea" 
          rows="4" 
          placeholder="Paste or type text here to inspect word count, character count, sentence length, and estimated reading time..." 
          class="w-full p-3 rounded-md text-xs bg-canvas border border-hairline text-ink placeholder:text-mute focus:outline-none focus:border-ink transition-colors resize-none mb-4 font-sans"
        ></textarea>

        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-center">
          <div class="p-3 rounded border border-hairline bg-canvas">
            <span class="text-[10px] uppercase font-mono text-mute block mb-0.5">Words</span>
            <span id="countWords" class="text-base font-bold text-ink font-mono">0</span>
          </div>
          <div class="p-3 rounded border border-hairline bg-canvas">
            <span class="text-[10px] uppercase font-mono text-mute block mb-0.5">Characters</span>
            <span id="countChars" class="text-base font-bold text-ink font-mono">0</span>
          </div>
          <div class="p-3 rounded border border-hairline bg-canvas">
            <span class="text-[10px] uppercase font-mono text-mute block mb-0.5">No Spaces</span>
            <span id="countCharsNoSpace" class="text-base font-bold text-ink font-mono">0</span>
          </div>
          <div class="p-3 rounded border border-hairline bg-canvas">
            <span class="text-[10px] uppercase font-mono text-mute block mb-0.5">Sentences</span>
            <span id="countSentences" class="text-base font-bold text-ink font-mono">0</span>
          </div>
          <div class="p-3 rounded border border-hairline bg-canvas col-span-2 sm:col-span-1">
            <span class="text-[10px] uppercase font-mono text-mute block mb-0.5">Read Time</span>
            <span id="countReadTime" class="text-base font-bold text-emerald-600 dark:text-emerald-400 font-mono">0 min</span>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Utility 1: Prompt Improver Script
  const rawInput = document.getElementById('rawPromptInput') as HTMLTextAreaElement | null;
  const personaSelect = document.getElementById('promptPersona') as HTMLSelectElement | null;
  const reasoningSelect = document.getElementById('promptReasoning') as HTMLSelectElement | null;
  const improveBtn = document.getElementById('improvePromptBtn');
  const improvedOutput = document.getElementById('improvedPromptOutput') as HTMLTextAreaElement | null;
  const copyImprovedBtn = document.getElementById('copyImprovedPrompt');

  improveBtn?.addEventListener('click', () => {
    const raw = rawInput?.value.trim() || 'Provide a comprehensive breakdown of the core subject matter.';
    const persona = personaSelect?.value || 'Senior Staff Software Engineer';
    const reasoning = reasoningSelect?.value || 'Chain of Thought';

    const optimized = `<system_instruction>
You are an expert ${persona}.
Your task is to execute the user's objective with extreme precision, verifiable depth, and zero filler prose.

<operational_rules>
1. Adopt the perspective of a seasoned ${persona}.
2. Reasoning Protocol: Use ${reasoning}.
3. Prioritize empirical evidence, concrete architectural trade-offs, and actionable steps.
4. If code or commands are provided, make them production-ready and error-handled.
</operational_rules>

<user_task>
${raw}
</user_task>
</system_instruction>`;

    if (improvedOutput) improvedOutput.value = optimized;
  });

  copyImprovedBtn?.addEventListener('click', () => {
    if (improvedOutput && improvedOutput.value) {
      navigator.clipboard.writeText(improvedOutput.value);
      copyImprovedBtn.textContent = 'Copied!';
      setTimeout(() => { copyImprovedBtn.textContent = 'Copy Output'; }, 2000);
    }
  });

  // Utility 2: Hook Generator Script
  const hookTopicInput = document.getElementById('hookTopicInput') as HTMLInputElement | null;
  const generateHooksBtn = document.getElementById('generateHooksBtn');
  const hookResultsContainer = document.getElementById('hookResultsContainer');
  const titlesList = document.getElementById('titlesList');
  const hooksList = document.getElementById('hooksList');

  generateHooksBtn?.addEventListener('click', () => {
    const topic = hookTopicInput?.value.trim() || 'Modern AI Tools';

    const sampleTitles = [
      `Why 99% of Developers Are Using ${topic} Completely Wrong in 2026`,
      `I Tested ${topic} for 30 Days: The Honest Brutal Truth`,
      `Stop Using Legacy Tools: How ${topic} Replaced My Whole Team Stack`,
      `${topic}: The Hidden Setting Nobody Tells You About`,
      `How to Master ${topic} in 15 Minutes (Step-by-Step)`
    ];

    const sampleHooks = [
      `"Most people think ${topic} is overrated. But after running 100 tests, here is the one flaw everyone missed..."`,
      `[Visual: Show screen side-by-side comparison] "If you are still doing this manually, you are wasting 4 hours every single day."`,
      `"I gave ${topic} the hardest possible edge-case test. What happened next surprised our entire engineering team."`
    ];

    if (titlesList) {
      titlesList.innerHTML = sampleTitles.map(t => `<li class="py-1 border-b border-hairline/60 last:border-0">&bull; ${t}</li>`).join('');
    }

    if (hooksList) {
      hooksList.innerHTML = sampleHooks.map(h => `<li class="py-1 border-b border-hairline/60 last:border-0">${h}</li>`).join('');
    }

    if (hookResultsContainer) {
      hookResultsContainer.classList.remove('hidden');
    }
  });

  // Utility 3: In-Browser Image Resizer Script
  const imageInput = document.getElementById('imageFileInput') as HTMLInputElement | null;
  const processImageBtn = document.getElementById('processImageBtn');
  const imageEmptyText = document.getElementById('imageEmptyText');
  const imageResult = document.getElementById('imageResult');
  const previewImg = document.getElementById('convertedPreviewImg') as HTMLImageElement | null;
  const imageStatsText = document.getElementById('imageStatsText');
  const downloadWebpLink = document.getElementById('downloadWebpLink') as HTMLAnchorElement | null;

  let loadedImageFile: File | null = null;

  imageInput?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files[0]) {
      loadedImageFile = files[0];
      if (imageEmptyText) imageEmptyText.textContent = `Selected: ${files[0].name} (${(files[0].size / 1024).toFixed(1)} KB). Click Convert.`;
    }
  });

  processImageBtn?.addEventListener('click', () => {
    if (!loadedImageFile) return;

    const maxWidth = parseInt((document.getElementById('imgMaxWidth') as HTMLInputElement).value) || 1200;
    const quality = (parseInt((document.getElementById('imgQuality') as HTMLInputElement).value) || 85) / 100;

    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        let width = img.width;
        let height = img.height;

        if (width > maxWidth) {
          height = Math.round((height * maxWidth) / width);
          width = maxWidth;
        }

        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, width, height);
          const webpDataUrl = canvas.toDataURL('image/webp', quality);

          if (previewImg) previewImg.src = webpDataUrl;
          if (downloadWebpLink) downloadWebpLink.href = webpDataUrl;

          // Estimate size reduction
          const originalKb = (loadedImageFile!.size / 1024).toFixed(1);
          const estimatedWebpKb = (webpDataUrl.length * (3/4) / 1024).toFixed(1);

          if (imageStatsText) {
            imageStatsText.textContent = `Original: ${originalKb} KB → Converted WebP: ~${estimatedWebpKb} KB (${width}x${height}px)`;
          }

          if (imageEmptyText) imageEmptyText.classList.add('hidden');
          if (imageResult) imageResult.classList.remove('hidden');
        }
      };
      img.src = event.target?.result as string;
    };
    reader.readAsDataURL(loadedImageFile);
  });

  // Utility 4: QR Generator Script
  const qrTextInput = document.getElementById('qrTextInput') as HTMLInputElement | null;
  const generateQrBtn = document.getElementById('generateQrBtn');
  const qrImageTag = document.getElementById('qrImageTag') as HTMLImageElement | null;
  const downloadQrBtn = document.getElementById('downloadQrBtn') as HTMLAnchorElement | null;

  generateQrBtn?.addEventListener('click', () => {
    const text = encodeURIComponent(qrTextInput?.value.trim() || 'https://github.com/harshil1876/AIO-AI');
    const newSrc = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${text}`;
    const highRes = `https://api.qrserver.com/v1/create-qr-code/?size=600x600&data=${text}`;

    if (qrImageTag) qrImageTag.src = newSrc;
    if (downloadQrBtn) downloadQrBtn.href = highRes;
  });

  // Utility 5: Word & Char Counter
  const counterArea = document.getElementById('counterTextArea') as HTMLTextAreaElement | null;
  const countWords = document.getElementById('countWords');
  const countChars = document.getElementById('countChars');
  const countCharsNoSpace = document.getElementById('countCharsNoSpace');
  const countSentences = document.getElementById('countSentences');
  const countReadTime = document.getElementById('countReadTime');

  counterArea?.addEventListener('input', () => {
    const text = counterArea.value;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    const chars = text.length;
    const noSpaces = text.replace(/\s/g, '').length;
    const sentences = text.trim() ? (text.match(/[.!?]+(\s|$)/g) || []).length : 0;
    const minutes = Math.ceil(words / 220);

    if (countWords) countWords.textContent = words.toLocaleString();
    if (countChars) countChars.textContent = chars.toLocaleString();
    if (countCharsNoSpace) countCharsNoSpace.textContent = noSpaces.toLocaleString();
    if (countSentences) countSentences.textContent = sentences.toString();
    if (countReadTime) countReadTime.textContent = `${minutes} min`;
  });
</script>
