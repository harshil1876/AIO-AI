---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="8-in-1 AI & Creator Utilities Suite | 100% Client-Side"
  description="High-performance client-side browser utilities: Prompt Architect, YouTube Hook Generator, Social Thread Formatter, Image Resizer & WebP Converter, JSON-to-TypeScript, QR Generator, Text Analyzer, and Token Calculator."
>
  <Header currentPath="/utilities" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-4 sm:px-6 py-12 md:py-16 text-center">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-300 bg-emerald-50 text-xs font-mono font-bold text-emerald-800 mb-4 shadow-xs">
          <span>ZERO SERVER UPLOADS &bull; 100% PRIVATE IN-BROWSER</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-ink tracking-tight mb-4" style="letter-spacing: -1.4px;">
          Creator & Developer Utilities Suite
        </h1>
        <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Eight essential client-side utilities engineered for prompt architects, content creators, and AI engineers. Complete with presets, instant copies, and zero data leaving your browser.
        </p>

        <!-- Quick Jump Bar -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-6 font-mono text-xs">
          <a href="#token-calculator" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">1. Token Calculator</a>
          <a href="#prompt-improver" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">2. Prompt Architect</a>
          <a href="#hook-generator" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">3. YouTube Viral Hooks</a>
          <a href="#social-formatter" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">4. Social Threader</a>
          <a href="#image-resizer" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">5. Image Resizer & WebP</a>
          <a href="#json-formatter" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">6. JSON-to-TypeScript</a>
          <a href="#qr-generator" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">7. QR Code Studio</a>
          <a href="#text-analyzer" class="px-2.5 py-1 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold shadow-2xs">8. Text & Speaking Time</a>
        </div>
      </div>
    </section>

    <!-- 8 Utilities Interactive Feed -->
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-12 flex-1 flex flex-col gap-14">

      <!-- UTILITY 1: OFFICIAL LLM TOKEN CALCULATOR SPOTLIGHT -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="token-calculator">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-[#2563EB]"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">1. Official LLM Token & Cost Calculator</h2>
          </div>
          <a href="/token-calculator" class="text-xs font-bold text-[#2563EB] hover:underline font-mono">
            Open Full 13-Model Suite &rarr;
          </a>
        </div>

        <p class="text-xs text-slate-600 mb-6">Estimate token volume and official API invocation cost across frontier providers in real-time.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-mono font-bold text-slate-700 mb-2">Input Sample Text or Prompt:</label>
            <textarea id="tokenCalcTextarea" rows="4" placeholder="Paste your system prompt, document text, or API payload here..." class="w-full bg-[#F8FAFF] border-2 border-[#E2E8F0] rounded-lg p-3 text-xs text-ink outline-none focus:border-[#2563EB] font-mono mb-3">Explain the core trade-offs between dense transformer models and mixture-of-experts architectures in modern enterprise inference.</textarea>
            
            <div class="flex items-center justify-between text-xs font-mono">
              <span id="charCountDisplay" class="text-slate-500">147 characters</span>
              <span class="font-bold text-[#2563EB]">~<span id="tokenEstDisplay">37</span> Tokens</span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#F8FAFF] border-2 border-[#E2E8F0] flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono uppercase font-bold text-slate-500 mb-2">Cost Comparison for 100K Invocations:</div>
              <div class="space-y-2 text-xs font-mono">
                <div class="flex items-center justify-between p-2 rounded bg-white border border-[#E2E8F0]">
                  <span class="font-bold text-ink">DeepSeek-V3</span>
                  <span class="text-emerald-700 font-bold">$0.027</span>
                </div>
                <div class="flex items-center justify-between p-2 rounded bg-white border border-[#E2E8F0]">
                  <span class="font-bold text-ink">Gemini 2.0 Flash</span>
                  <span class="text-emerald-700 font-bold">$0.037</span>
                </div>
                <div class="flex items-center justify-between p-2 rounded bg-white border border-[#E2E8F0]">
                  <span class="font-bold text-ink">Claude 3.5 Sonnet</span>
                  <span class="text-slate-700 font-bold">$1.110</span>
                </div>
              </div>
            </div>

            <a href="/token-calculator/compare" class="mt-4 text-xs font-bold text-[#2563EB] hover:underline font-mono">
              Compare All 13 Models in Interactive Matrix &rarr;
            </a>
          </div>
        </div>
      </section>

      <!-- UTILITY 2: STRUCTURED PROMPT ARCHITECT -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="prompt-improver">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-[#2563EB]"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">2. Structured Prompt Architect (CO-STAR Framework)</h2>
          </div>
          <span class="text-xs font-mono text-slate-500 font-bold">CO-STAR Standard</span>
        </div>

        <p class="text-xs text-slate-600 mb-4">Transforms basic raw prompts into industrial-strength system instructions with clear Role, Context, Constraints, and Output format.</p>

        <!-- Presets -->
        <div class="flex flex-wrap gap-2 mb-4 font-mono text-xs">
          <span class="text-slate-500 font-bold mr-1">Presets:</span>
          <button type="button" class="prompt-preset-btn px-2.5 py-1 rounded bg-[#F8FAFF] hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold cursor-pointer" data-role="Senior React & Astro Architect" data-task="Refactor component for zero-bundle JS and accessibility." data-constraint="No external npm dependencies. Use semantic HTML.">
            Coding Architect
          </button>
          <button type="button" class="prompt-preset-btn px-2.5 py-1 rounded bg-[#F8FAFF] hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold cursor-pointer" data-role="Direct-Response Copywriter" data-task="Write a high-converting B2B landing page hero." data-constraint="No corporate jargon. Maximum 30 words for headline.">
            Copywriter
          </button>
          <button type="button" class="prompt-preset-btn px-2.5 py-1 rounded bg-[#F8FAFF] hover:bg-[#EFF6FF] border border-[#E2E8F0] text-slate-700 hover:text-[#2563EB] font-bold cursor-pointer" data-role="Biomedical Data Researcher" data-task="Synthesize key findings from clinical trials." data-constraint="Cite sample sizes. Highlight negative results.">
            Research Analyst
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <div>
              <label class="block text-[11px] font-mono uppercase font-bold text-slate-700 mb-1">Target Persona / Role:</label>
              <input type="text" id="piRole" value="Principal AI Engineer" class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded p-2 text-xs text-ink outline-none font-mono" />
            </div>
            <div>
              <label class="block text-[11px] font-mono uppercase font-bold text-slate-700 mb-1">Core Task & Context:</label>
              <textarea id="piTask" rows="2" class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded p-2 text-xs text-ink outline-none font-mono">Evaluate multi-agent orchestration frameworks for customer support.</textarea>
            </div>
            <div>
              <label class="block text-[11px] font-mono uppercase font-bold text-slate-700 mb-1">Strict Negative Constraints:</label>
              <input type="text" id="piConstraints" value="Never use generic filler words. Provide concrete benchmark numbers." class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded p-2 text-xs text-ink outline-none font-mono" />
            </div>
            <button type="button" id="buildPromptBtn" class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-mono font-bold py-2 px-4 rounded-lg shadow-xs cursor-pointer">
              Generate Structured System Prompt &rarr;
            </button>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase font-bold text-slate-600">Generated System Prompt:</span>
              <button type="button" id="copyPiOutputBtn" class="text-xs font-mono text-[#2563EB] hover:underline font-bold cursor-pointer">Copy</button>
            </div>
            <pre id="piOutput" class="p-4 rounded-lg bg-[#09090B] text-white font-mono text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed h-52 border border-[#09090B]">Click "Generate Structured System Prompt" to construct industrial prompt.</pre>
          </div>
        </div>
      </section>

      <!-- UTILITY 3: YOUTUBE TITLE & VIRAL HOOK GENERATOR -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="hook-generator">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-red-600"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">3. YouTube Title, Viral Hook & Shorts Script Generator</h2>
          </div>
          <span class="text-xs font-mono text-red-600 font-bold">High CTR Patterns</span>
        </div>

        <p class="text-xs text-slate-600 mb-4">Generate 5 psychological curiosity-gap titles, 0-5s retention hooks, and structured visual/audio tables.</p>

        <div class="flex gap-2 mb-4">
          <input type="text" id="hookTopicInput" placeholder="Enter your video topic (e.g. Running DeepSeek locally for free)..." value="How to run local AI with Ollama for free" class="flex-1 bg-[#F8FAFF] border-2 border-[#E2E8F0] rounded-lg px-3 py-2 text-xs text-ink outline-none focus:border-red-600 font-mono" />
          <button type="button" id="generateHooksBtn" class="bg-red-600 hover:bg-red-700 text-white font-mono text-xs font-bold px-4 py-2 rounded-lg cursor-pointer">
            Generate Hooks
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="hooksResults">
          <div class="p-4 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <h3 class="text-xs font-mono uppercase font-bold text-red-700 mb-2">High-CTR Titles:</h3>
            <ul class="text-xs space-y-1.5 font-medium text-ink" id="hookTitlesList">
              <li>1. Stop Paying for ChatGPT: The 5-Minute Local Setup</li>
              <li>2. I Tested 5 Local AI Models So You Don't Have To</li>
              <li>3. Why Software Engineers Are Abandoning Cloud AI in 2025</li>
            </ul>
          </div>
          <div class="p-4 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <h3 class="text-xs font-mono uppercase font-bold text-slate-700 mb-2">0-5s First Impression Hooks:</h3>
            <ul class="text-xs space-y-1.5 text-slate-700" id="hookBodyList">
              <li>&bull; "90% of developers are overpaying for cloud AI tokens when their laptop can do this..."</li>
              <li>&bull; "Look at this terminal command. In 60 seconds, you have a private reasoning model..."</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- UTILITY 4: SOCIAL MEDIA & LINKEDIN THREAD FORMATTER -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="social-formatter">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-[#2563EB]"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">4. Social Media & LinkedIn Thread Formatter</h2>
          </div>
          <span class="text-xs font-mono text-slate-500 font-bold">X & LinkedIn</span>
        </div>

        <p class="text-xs text-slate-600 mb-4">Converts raw technical articles or notes into clean, high-engagement X threads and formatted LinkedIn posts with whitespace optimization.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <textarea id="rawNotesInput" rows="5" class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded-lg p-3 text-xs text-ink outline-none font-mono mb-2" placeholder="Paste your raw thoughts, article draft, or bullet points here...">We migrated our support queue to an AI agent. Response times dropped from 4 hours to 45 seconds. Deflection rate is 42%. We used n8n, Claude 3.5 Haiku, and Supabase vector store.</textarea>
            <button type="button" id="formatThreadBtn" class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-mono font-bold py-2 px-4 rounded-lg cursor-pointer">
              Format into Viral Social Post &rarr;
            </button>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase font-bold text-slate-600">Formatted Output:</span>
              <button type="button" id="copySocialOutput" class="text-xs font-mono text-[#2563EB] hover:underline font-bold cursor-pointer">Copy</button>
            </div>
            <pre id="socialOutput" class="p-4 rounded-lg bg-[#09090B] text-white font-mono text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed h-44 border border-[#09090B]">Click "Format into Viral Social Post" to format.</pre>
          </div>
        </div>
      </section>

      <!-- UTILITY 5: CLIENT-SIDE IMAGE RESIZER & WEBP CONVERTER -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="image-resizer">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-emerald-600"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">5. Client-Side Image Resizer, Compressor & WebP Converter</h2>
          </div>
          <span class="text-xs font-mono text-emerald-700 font-bold">HTML5 Canvas</span>
        </div>

        <p class="text-xs text-slate-600 mb-4">Compress large JPG/PNG images and convert to modern WebP format right in your browser. Zero bytes uploaded to any server.</p>

        <div class="p-6 border-2 border-dashed border-[#09090B] rounded-xl bg-[#F8FAFF] text-center mb-4">
          <input type="file" id="imageFileInput" accept="image/*" class="hidden" />
          <button type="button" onclick="document.getElementById('imageFileInput').click()" class="bg-[#09090B] text-white font-mono text-xs font-bold px-5 py-2.5 rounded-lg hover:bg-neutral-800 cursor-pointer shadow-xs">
            Select or Drag Image Here
          </button>
          <div id="imageFileFeedback" class="text-xs font-mono text-slate-500 mt-2">Supports JPG, PNG, WebP up to 25MB</div>
        </div>

        <div id="imageControls" class="hidden space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
            <div>
              <label class="block text-slate-600 font-bold mb-1">Max Width (px):</label>
              <input type="number" id="imgMaxWidth" value="1200" class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded p-2 text-ink" />
            </div>
            <div>
              <label class="block text-slate-600 font-bold mb-1">Quality (1-100%):</label>
              <input type="range" id="imgQuality" min="10" max="100" value="85" class="w-full" />
              <span id="qualityVal" class="text-slate-500">85%</span>
            </div>
            <div>
              <label class="block text-slate-600 font-bold mb-1">Target Format:</label>
              <select id="imgFormat" class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded p-2 text-ink">
                <option value="image/webp">WebP (Smallest file size)</option>
                <option value="image/jpeg">JPEG</option>
                <option value="image/png">PNG</option>
              </select>
            </div>
          </div>

          <div class="p-4 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] flex items-center justify-between text-xs font-mono">
            <div>
              <span>Original: <strong id="origSize">-</strong></span>
              <span class="mx-2">&bull;</span>
              <span>Compressed: <strong id="compSize" class="text-emerald-700">-</strong></span>
            </div>
            <button type="button" id="downloadImgBtn" class="bg-emerald-600 hover:bg-emerald-700 text-white font-mono text-xs font-bold px-4 py-2 rounded-lg cursor-pointer">
              Download Optimized Image
            </button>
          </div>
        </div>
      </section>

      <!-- UTILITY 6: JSON FORMATTER & SCHEMA-TO-TYPESCRIPT GENERATOR -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="json-formatter">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-[#2563EB]"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">6. JSON Formatter, Validator & TypeScript Interface Generator</h2>
          </div>
          <span class="text-xs font-mono text-slate-500 font-bold">Dev Tooling</span>
        </div>

        <p class="text-xs text-slate-600 mb-4">Validate JSON from LLM structured outputs and automatically generate strict TypeScript interfaces.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <textarea id="rawJsonInput" rows="6" class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded-lg p-3 text-xs text-ink outline-none font-mono mb-2" placeholder="Paste JSON here...">{`{"tool":"Claude 3.7","score":95,"features":["hybrid reasoning","200k context"],"verified":true}`}</textarea>
            <div class="flex items-center gap-2">
              <button type="button" id="formatJsonBtn" class="bg-[#09090B] text-white text-xs font-mono font-bold py-2 px-3 rounded-lg cursor-pointer">
                Beautify JSON
              </button>
              <button type="button" id="jsonToTsBtn" class="bg-[#2563EB] text-white text-xs font-mono font-bold py-2 px-3 rounded-lg cursor-pointer">
                Generate TypeScript
              </button>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase font-bold text-slate-600">TypeScript Interface:</span>
              <button type="button" id="copyTsOutput" class="text-xs font-mono text-[#2563EB] hover:underline font-bold cursor-pointer">Copy</button>
            </div>
            <pre id="tsOutput" class="p-4 rounded-lg bg-[#09090B] text-white font-mono text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed h-44 border border-[#09090B]">Click "Generate TypeScript" to infer interface.</pre>
          </div>
        </div>
      </section>

      <!-- UTILITY 7: CUSTOMIZABLE QR CODE GENERATOR -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="qr-generator">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-[#09090B]"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">7. Instant Offline QR Code Generator</h2>
          </div>
          <span class="text-xs font-mono text-slate-500 font-bold">Vector SVG</span>
        </div>

        <p class="text-xs text-slate-600 mb-4">Create clean QR codes for links, Wi-Fi credentials, or product packaging with instant download.</p>

        <div class="flex flex-col sm:flex-row items-center gap-6">
          <div class="flex-1 space-y-3 w-full">
            <div>
              <label class="block text-xs font-mono font-bold text-slate-700 mb-1">Destination URL or Text:</label>
              <input type="text" id="qrText" value="https://aio-ai.pages.dev" class="w-full bg-[#F8FAFF] border-2 border-[#E2E8F0] rounded-lg p-2.5 text-xs text-ink font-mono outline-none focus:border-[#2563EB]" />
            </div>
            <button type="button" id="genQrBtn" class="bg-[#09090B] hover:bg-neutral-800 text-white font-mono text-xs font-bold px-4 py-2 rounded-lg cursor-pointer">
              Render QR Code
            </button>
          </div>

          <div class="p-4 rounded-xl bg-[#F8FAFF] border-2 border-[#09090B] flex flex-col items-center justify-center shrink-0">
            <img id="qrImg" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://aio-ai.pages.dev" alt="QR Code" class="w-32 h-32 rounded bg-white p-1" />
            <a id="downloadQrLink" href="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=https://aio-ai.pages.dev" download="qrcode.png" target="_blank" class="mt-2 text-[11px] font-mono text-[#2563EB] hover:underline font-bold">
              Download PNG
            </a>
          </div>
        </div>
      </section>

      <!-- UTILITY 8: DEEP TEXT ANALYZER & SPEAKING TIME ESTIMATOR -->
      <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]" id="text-analyzer">
        <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 bg-[#2563EB]"></span>
            <h2 class="text-base sm:text-lg font-bold text-ink uppercase font-mono">8. Deep Text Analyzer & YouTube Speaking Time Estimator</h2>
          </div>
          <span class="text-xs font-mono text-slate-500 font-bold">Speech Timing</span>
        </div>

        <p class="text-xs text-slate-600 mb-4">Calculate exact YouTube voiceover duration at 130, 150, and 170 words per minute to hit 50-second Shorts pacing.</p>

        <textarea id="textAnalyzerInput" rows="4" placeholder="Paste script or article here to analyze word cadence and reading time..." class="w-full bg-[#F8FAFF] border border-[#E2E8F0] rounded-lg p-3 text-xs text-ink outline-none font-mono mb-4">Artificial intelligence is shifting from static prompt-and-response chatbots into autonomous multi-agent systems capable of running tests, browsing dynamic web pages, and synthesizing complex market research.</textarea>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono text-center">
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-ink" id="statWords">27</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">Words</div>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-[#2563EB]" id="statChars">197</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">Characters</div>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-emerald-700" id="statReadTime">7 sec</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">Reading (200 WPM)</div>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0]">
            <div class="text-xl font-black text-red-600" id="statSpeechTime">11 sec</div>
            <div class="text-[10px] text-slate-500 uppercase font-bold">Shorts Voice (150 WPM)</div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  function setupUtilities() {
    // 1. Token calculator preview
    const tokenArea = document.getElementById('tokenCalcTextarea') as HTMLTextAreaElement;
    const charDisplay = document.getElementById('charCountDisplay');
    const tokenDisplay = document.getElementById('tokenEstDisplay');

    if (tokenArea) {
      tokenArea.addEventListener('input', () => {
        const len = tokenArea.value.length;
        const tokens = Math.max(1, Math.round(len / 4));
        if (charDisplay) charDisplay.textContent = `${len} characters`;
        if (tokenDisplay) tokenDisplay.textContent = String(tokens);
      });
    }

    // 2. Prompt Improver
    const piRole = document.getElementById('piRole') as HTMLInputElement;
    const piTask = document.getElementById('piTask') as HTMLTextAreaElement;
    const piConstraints = document.getElementById('piConstraints') as HTMLInputElement;
    const piOutput = document.getElementById('piOutput');
    const buildPromptBtn = document.getElementById('buildPromptBtn');
    const copyPiBtn = document.getElementById('copyPiOutputBtn');

    function buildPrompt() {
      const role = piRole?.value || 'Principal Engineer';
      const task = piTask?.value || '';
      const constraints = piConstraints?.value || '';

      const structured = `You are a ${role}.

# CONTEXT & GOAL
${task}

# OPERATIONAL CONSTRAINTS
- Strict Rule 1: ${constraints}
- Strict Rule 2: Always return actionable, production-ready outputs with zero conversational filler.
- Strict Rule 3: If facts or credentials are missing, explicitly document them rather than assuming.

# OUTPUT SPECIFICATION
Structure your response with clear markdown headings, bullet points, and code blocks.`;

      if (piOutput) piOutput.textContent = structured;
    }

    if (buildPromptBtn) buildPromptBtn.addEventListener('click', buildPrompt);

    document.querySelectorAll('.prompt-preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (piRole) piRole.value = btn.getAttribute('data-role') || '';
        if (piTask) piTask.value = btn.getAttribute('data-task') || '';
        if (piConstraints) piConstraints.value = btn.getAttribute('data-constraint') || '';
        buildPrompt();
      });
    });

    if (copyPiBtn) {
      copyPiBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(piOutput?.textContent || '').then(() => {
          copyPiBtn.textContent = 'Copied!';
          setTimeout(() => { copyPiBtn.textContent = 'Copy'; }, 1500);
        });
      });
    }

    // 3. YouTube Hooks
    const genHooksBtn = document.getElementById('generateHooksBtn');
    const hookTopic = document.getElementById('hookTopicInput') as HTMLInputElement;
    const hookTitlesList = document.getElementById('hookTitlesList');
    const hookBodyList = document.getElementById('hookBodyList');

    if (genHooksBtn) {
      genHooksBtn.addEventListener('click', () => {
        const topic = hookTopic?.value || 'AI Tools';
        if (hookTitlesList) {
          hookTitlesList.innerHTML = `
            <li>1. Stop Paying for SaaS: The Free ${topic} Alternative</li>
            <li>2. I Tested 10 ${topic} Workflows So You Don't Have To</li>
            <li>3. Why 90% of Engineers Are Doing ${topic} Wrong</li>
            <li>4. The Unspoken Truth About ${topic} in 2025</li>
            <li>5. How I Automated My Entire Pipeline with ${topic}</li>
          `;
        }
        if (hookBodyList) {
          hookBodyList.innerHTML = `
            <li>&bull; "90% of people trying ${topic} make this exact rookie mistake..."</li>
            <li>&bull; "Before you spend $100 on ${topic}, look at what happened when I tested this free workflow..."</li>
            <li>&bull; "In the next 45 seconds, I'm going to show you the exact system we used to scale..."</li>
          `;
        }
      });
    }

    // 4. Social Formatter
    const rawNotes = document.getElementById('rawNotesInput') as HTMLTextAreaElement;
    const formatBtn = document.getElementById('formatThreadBtn');
    const socialOut = document.getElementById('socialOutput');
    const copySocialBtn = document.getElementById('copySocialOutput');

    if (formatBtn) {
      formatBtn.addEventListener('click', () => {
        const val = rawNotes?.value || '';
        const formatted = `1/ We tested this so you don't have to:\n\n${val}\n\nHere are the 3 major lessons learned:\n\n&bull; Lesson 1: Pacing beats raw token power.\n&bull; Lesson 2: Keep human-in-the-loop gates on financial flows.\n&bull; Lesson 3: Self-host local models for privacy.\n\nRetweet if useful &rarr; Follow @AIO_AI for daily blueprints.`;
        if (socialOut) socialOut.textContent = formatted;
      });
    }

    if (copySocialBtn) {
      copySocialBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(socialOut?.textContent || '').then(() => {
          copySocialBtn.textContent = 'Copied!';
          setTimeout(() => { copySocialBtn.textContent = 'Copy'; }, 1500);
        });
      });
    }

    // 6. JSON to TS
    const jsonIn = document.getElementById('rawJsonInput') as HTMLTextAreaElement;
    const formatJsonBtn = document.getElementById('formatJsonBtn');
    const jsonToTsBtn = document.getElementById('jsonToTsBtn');
    const tsOut = document.getElementById('tsOutput');
    const copyTsBtn = document.getElementById('copyTsOutput');

    if (formatJsonBtn) {
      formatJsonBtn.addEventListener('click', () => {
        try {
          const parsed = JSON.parse(jsonIn.value);
          jsonIn.value = JSON.stringify(parsed, null, 2);
        } catch (e) {
          alert('Invalid JSON syntax: ' + (e as Error).message);
        }
      });
    }

    if (jsonToTsBtn) {
      jsonToTsBtn.addEventListener('click', () => {
        try {
          const obj = JSON.parse(jsonIn.value);
          let ts = 'export interface InferredType {\n';
          for (const key of Object.keys(obj)) {
            const val = obj[key];
            const type = Array.isArray(val) ? (typeof val[0] || 'any') + '[]' : typeof val;
            ts += `  ${key}: ${type};\n`;
          }
          ts += '}';
          if (tsOut) tsOut.textContent = ts;
        } catch (e) {
          if (tsOut) tsOut.textContent = 'Error parsing JSON: ' + (e as Error).message;
        }
      });
    }

    if (copyTsBtn) {
      copyTsBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(tsOut?.textContent || '').then(() => {
          copyTsBtn.textContent = 'Copied!';
          setTimeout(() => { copyTsBtn.textContent = 'Copy'; }, 1500);
        });
      });
    }

    // 7. QR Generator
    const qrText = document.getElementById('qrText') as HTMLInputElement;
    const qrImg = document.getElementById('qrImg') as HTMLImageElement;
    const genQrBtn = document.getElementById('genQrBtn');
    const dlLink = document.getElementById('downloadQrLink') as HTMLAnchorElement;

    if (genQrBtn) {
      genQrBtn.addEventListener('click', () => {
        const url = encodeURIComponent(qrText.value || 'https://aio-ai.pages.dev');
        const src = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${url}`;
        if (qrImg) qrImg.src = src;
        if (dlLink) dlLink.href = `https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${url}`;
      });
    }

    // 8. Text Analyzer
    const textInput = document.getElementById('textAnalyzerInput') as HTMLTextAreaElement;
    const wSpan = document.getElementById('statWords');
    const cSpan = document.getElementById('statChars');
    const rSpan = document.getElementById('statReadTime');
    const sSpan = document.getElementById('statSpeechTime');

    if (textInput) {
      textInput.addEventListener('input', () => {
        const val = textInput.value.trim();
        const words = val ? val.split(/\s+/).length : 0;
        const chars = val.length;
        const readSec = Math.ceil((words / 200) * 60);
        const speechSec = Math.ceil((words / 150) * 60);

        if (wSpan) wSpan.textContent = String(words);
        if (cSpan) cSpan.textContent = String(chars);
        if (rSpan) rSpan.textContent = `${readSec} sec`;
        if (sSpan) sSpan.textContent = `${speechSec} sec`;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupUtilities);
  } else {
    setupUtilities();
  }
</script>
