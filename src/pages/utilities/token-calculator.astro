---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="LLM Token & API Cost Calculator | AI Discovery Utilities"
  description="Calculate and compare real-world API expenses across OpenAI GPT-4o, Claude 3.5 Sonnet, DeepSeek R1, and local open-source models."
>
  <Header currentPath="/utilities" />

  <main class="w-full flex flex-col min-h-screen">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-12 md:py-16 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas text-xs font-medium text-mute mb-4">
          <svg class="w-3.5 h-3.5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span>Built-in Utility #1</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-semibold text-ink tracking-tight mb-4" style="letter-spacing: -1.4px;">
          LLM Token & API Cost Calculator
        </h1>
        <p class="text-body text-base md:text-lg max-w-xl mx-auto leading-relaxed">
          Forecast your production AI expenses before writing code. Compare proprietary frontier models against disruptive open-weights alternatives.
        </p>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <div class="w-full max-w-5xl mx-auto px-6 py-12 flex-1">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        <!-- Configuration Controls -->
        <div class="lg:col-span-1 bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs flex flex-col gap-5">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-mute border-b border-hairline pb-2">
            Usage Parameters
          </h2>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <label class="font-medium text-body">Requests per Day</label>
              <span id="requestsCountLabel" class="font-mono font-bold text-ink">5,000</span>
            </div>
            <input type="range" id="requestsSlider" min="100" max="100000" step="500" value="5000" class="w-full accent-ink cursor-pointer" />
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <label class="font-medium text-body">Avg Input Tokens</label>
              <span id="inputTokensLabel" class="font-mono font-bold text-ink">1,000</span>
            </div>
            <input type="range" id="inputTokensSlider" min="100" max="10000" step="100" value="1000" class="w-full accent-ink cursor-pointer" />
            <span class="text-[10px] text-mute block mt-0.5">~750 English words per prompt</span>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <label class="font-medium text-body">Avg Output Tokens</label>
              <span id="outputTokensLabel" class="font-mono font-bold text-ink">500</span>
            </div>
            <input type="range" id="outputTokensSlider" min="50" max="4000" step="50" value="500" class="w-full accent-ink cursor-pointer" />
            <span class="text-[10px] text-mute block mt-0.5">~375 English words generated</span>
          </div>

          <div class="p-3.5 rounded-md border border-hairline bg-canvas text-xs text-mute font-mono">
            <div>Monthly Total Tokens:</div>
            <div id="totalMonthlyTokens" class="text-ink font-bold text-sm mt-1">225 Million</div>
          </div>
        </div>

        <!-- Real-Time Cost Comparison Cards -->
        <div class="lg:col-span-2 space-y-3.5" id="modelsCostList">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Prompt Optimizer Utility Section -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs">
        <div class="flex items-center justify-between mb-4 border-b border-hairline pb-3">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-mute">Built-in Utility #2</span>
            <h2 class="text-xl font-semibold text-ink tracking-tight mt-0.5">Production System Prompt Optimizer</h2>
          </div>
        </div>

        <p class="text-xs text-body mb-4">
          Paste your casual instruction below. We will structure it into an industry-standard XML-tagged prompt proven to reduce hallucinations and token waste across Claude, GPT-4o, and DeepSeek.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-body mb-1">Raw Instruction</label>
            <textarea id="rawPromptInput" rows="5" placeholder="e.g. You are a customer support agent. Answer questions about refunds politely and never give out personal data." class="w-full bg-canvas border border-hairline rounded-sm p-3 text-xs text-ink outline-none resize-none focus:border-ink"></textarea>
            <button id="optimizeBtn" class="mt-2 bg-ink text-on-primary text-xs font-medium px-4 py-2 rounded-pill hover:bg-black transition-colors cursor-pointer">
              Structure & Optimize Prompt →
            </button>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-xs font-medium text-body">Optimized Production Prompt</label>
              <button id="copyPromptBtn" class="text-xs text-link hover:underline font-medium cursor-pointer">Copy</button>
            </div>
            <pre id="optimizedOutput" class="w-full h-32 bg-canvas border border-hairline rounded-sm p-3 text-xs text-body font-mono overflow-auto whitespace-pre-wrap">Click "Structure & Optimize Prompt" to generate standard XML schema.</pre>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const MODELS = [
    {
      name: 'DeepSeek-V3 / R1',
      inputPer1M: 0.14,
      outputPer1M: 0.28,
      badge: '95% Cost Savings',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200'
    },
    {
      name: 'OpenAI GPT-4o',
      inputPer1M: 2.50,
      outputPer1M: 10.00,
      badge: 'Proprietary Benchmark',
      badgeClass: 'bg-hairline-soft text-ink border-hairline'
    },
    {
      name: 'Claude 3.5 Sonnet',
      inputPer1M: 3.00,
      outputPer1M: 15.00,
      badge: 'Coding Gold Standard',
      badgeClass: 'bg-blue-50 text-blue-700 border-blue-200'
    },
    {
      name: 'Llama 3 70B (Together / Groq)',
      inputPer1M: 0.88,
      outputPer1M: 0.88,
      badge: 'Open Weights Hosted',
      badgeClass: 'bg-purple-50 text-purple-700 border-purple-200'
    },
    {
      name: 'Self-Hosted (Ollama / Local GPU)',
      inputPer1M: 0.00,
      outputPer1M: 0.00,
      badge: '100% Free Inference',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200'
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const reqSlider = document.getElementById('requestsSlider');
    const inputSlider = document.getElementById('inputTokensSlider');
    const outputSlider = document.getElementById('outputTokensSlider');

    const reqLabel = document.getElementById('requestsCountLabel');
    const inputLabel = document.getElementById('inputTokensLabel');
    const outputLabel = document.getElementById('outputTokensLabel');
    const totalTokensLabel = document.getElementById('totalMonthlyTokens');
    const modelsList = document.getElementById('modelsCostList');

    function calculate() {
      const requests = parseInt(reqSlider?.value || '5000');
      const inTokens = parseInt(inputSlider?.value || '1000');
      const outTokens = parseInt(outputSlider?.value || '500');

      if (reqLabel) reqLabel.textContent = requests.toLocaleString();
      if (inputLabel) inputLabel.textContent = inTokens.toLocaleString();
      if (outputLabel) outputLabel.textContent = outTokens.toLocaleString();

      const monthlyRequests = requests * 30;
      const totalInM = (monthlyRequests * inTokens) / 1000000;
      const totalOutM = (monthlyRequests * outTokens) / 1000000;
      const totalTokensM = totalInM + totalOutM;

      if (totalTokensLabel) totalTokensLabel.textContent = `${totalTokensM.toFixed(1)} Million Tokens / mo`;

      if (modelsList) {
        modelsList.innerHTML = MODELS.map(m => {
          const monthlyCost = (totalInM * m.inputPer1M) + (totalOutM * m.outputPer1M);
          return `
            <div class="p-4 rounded-md border border-hairline bg-canvas-elevated flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-semibold text-ink text-sm">${m.name}</span>
                  <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded-full border ${m.badgeClass}">${m.badge}</span>
                </div>
                <div class="text-xs text-mute font-mono">
                  Input: $${m.inputPer1M.toFixed(2)}/1M • Output: $${m.outputPer1M.toFixed(2)}/1M
                </div>
              </div>
              <div class="text-right shrink-0">
                <span class="text-lg font-bold font-mono text-ink">$${monthlyCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                <span class="text-xs text-mute block font-mono">/ month</span>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    reqSlider?.addEventListener('input', calculate);
    inputSlider?.addEventListener('input', calculate);
    outputSlider?.addEventListener('input', calculate);

    calculate();

    // Prompt Optimizer Logic
    const rawInput = document.getElementById('rawPromptInput');
    const optimizeBtn = document.getElementById('optimizeBtn');
    const optimizedOutput = document.getElementById('optimizedOutput');
    const copyPromptBtn = document.getElementById('copyPromptBtn');

    optimizeBtn?.addEventListener('click', () => {
      const text = rawInput?.value.trim();
      if (!text) return;

      const optimized = `<system_instruction>
  <role>Senior Domain Specialist</role>
  <objective>
    ${text}
  </objective>
  <constraints>
    - Adhere strictly to user privacy; never leak confidential parameters.
    - Provide concise, actionable outputs without conversational filler.
    - If uncertainty exists, explicitly state the limitation.
  </constraints>
  <response_format>
    Return structured Markdown with high signal-to-noise ratio.
  </response_format>
</system_instruction>`;

      if (optimizedOutput) optimizedOutput.textContent = optimized;
    });

    copyPromptBtn?.addEventListener('click', () => {
      const text = optimizedOutput?.textContent || '';
      navigator.clipboard?.writeText(text);
      copyPromptBtn.textContent = 'Copied! ✓';
      setTimeout(() => copyPromptBtn.textContent = 'Copy', 1500);
    });
  });
</script>
