---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Developer Workspace & Profile | AIO AI" 
  description="Manage your verified builder profile, 365-day contribution activity heatmap, saved custom stacks, joined community spaces, and promotion campaigns."
>
  <Header currentPath="/profile" />

  <main class="w-full flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    
    <!-- Unauthenticated State -->
    <div id="unauthView" class="hidden text-center py-20 card-aurora p-8 sm:p-12 shadow-sm max-w-xl mx-auto space-y-5">
      <div class="w-16 h-16 rounded-3xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Sign In to Your Workspace Profile</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-2 max-w-md mx-auto leading-relaxed">
          Access your saved AI stacks, custom agent workflows, community spaces, 365-day contribution heatmap, and builder reputation.
        </p>
      </div>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a href="/login" class="w-full sm:w-auto bg-slate-900 hover:bg-blue-600 text-white text-xs font-bold px-6 py-3 rounded-xl transition-all shadow-sm">
          Sign In to Workspace &rarr;
        </a>
        <a href="/signup" class="w-full sm:w-auto bg-white border border-slate-200 hover:border-slate-400 text-slate-700 text-xs font-bold px-6 py-3 rounded-xl transition-colors">
          Create Account
        </a>
      </div>
    </div>

    <!-- Authenticated State: Comprehensive 6-Tab Developer Profile -->
    <div id="authView" class="hidden flex-col gap-8">
      
      <!-- HERO COVER BANNER (DEEP INDIGO-VIOLET GRADIENT) -->
      <section class="rounded-3xl midnight-hero p-8 sm:p-10 text-white relative overflow-hidden shadow-xl border border-slate-800">
        <div class="absolute -right-20 -top-20 w-96 h-96 bg-purple-600/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-20 -bottom-20 w-96 h-96 bg-blue-600/25 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <!-- User Details -->
          <div class="flex items-center gap-5">
            <div class="w-20 h-20 rounded-3xl bg-gradient-to-tr from-blue-600 to-indigo-500 border-2 border-white/20 text-white font-black text-3xl flex items-center justify-center font-mono shrink-0 shadow-lg">
              <span id="userAvatarText">H</span>
            </div>
            <div class="space-y-1.5">
              <div class="flex items-center gap-2.5 flex-wrap">
                <h1 id="userEmail" class="text-xl sm:text-2xl font-black text-white tracking-tight">harshilpival@gmail.com</h1>
                <span id="userPlanBadge" class="text-[11px] bg-blue-500/20 text-blue-300 border border-blue-400/30 px-3 py-0.5 rounded-full font-mono font-bold">
                  Builder Pro Tier
                </span>
                <span class="text-[11px] bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 px-2.5 py-0.5 rounded-full font-mono font-bold flex items-center gap-1">
                  <span>✓</span> Verified Builder
                </span>
              </div>
              <div class="flex items-center gap-3 text-xs text-slate-300 font-mono flex-wrap">
                <span id="userId">ID: usr-live...</span>
                <span>&bull;</span>
                <span id="userRole">Role: Core Engineer</span>
                <span>&bull;</span>
                <span id="reputationPointsText" class="text-emerald-400 font-bold">120 Reputation Pts</span>
              </div>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex items-center gap-2.5 self-start md:self-auto shrink-0">
            <a 
              href="/pricing"
              class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition-all shadow-sm"
            >
              Manage Plan
            </a>
            <button 
              type="button"
              id="logoutBtn"
              class="bg-slate-800 hover:bg-red-900/60 hover:text-red-200 border border-slate-700 text-slate-300 text-xs font-bold px-4 py-2.5 rounded-xl transition-colors cursor-pointer"
            >
              Sign Out
            </button>
          </div>
        </div>

        <!-- Builder Badges Strip -->
        <div class="relative z-10 grid grid-cols-2 sm:grid-cols-5 gap-3 mt-8 pt-6 border-t border-slate-800/80 text-xs">
          <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800 flex items-center gap-2">
            <span class="text-base">🛡️</span>
            <div>
              <span class="font-bold text-white block text-[11px]">Verified Practitioner</span>
              <span class="text-[10px] text-slate-400 font-mono">KYC / OAuth Sync</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800 flex items-center gap-2">
            <span class="text-base">🏗️</span>
            <div>
              <span class="font-bold text-white block text-[11px]">Stack Architect</span>
              <span class="text-[10px] text-slate-400 font-mono">Custom 5-Layer Stacks</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800 flex items-center gap-2">
            <span class="text-base">📦</span>
            <div>
              <span class="font-bold text-white block text-[11px]">Open-Source Ally</span>
              <span class="text-[10px] text-slate-400 font-mono">Self-Hostable VRAM</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800 flex items-center gap-2">
            <span class="text-base">⚡</span>
            <div>
              <span class="font-bold text-white block text-[11px]">Workflow Pioneer</span>
              <span class="text-[10px] text-slate-400 font-mono">SKILL.md Exports</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800 flex items-center gap-2">
            <span class="text-base">🇮🇳</span>
            <div>
              <span class="font-bold text-white block text-[11px]">India AI Champion</span>
              <span class="text-[10px] text-slate-400 font-mono">22 Indic Languages</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 6-TAB WORKSPACE NAVIGATION BAR -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1" id="profileTabsBar">
        <button type="button" class="profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-900 text-white cursor-pointer shadow-xs whitespace-nowrap" data-tab="overview">
          Overview &amp; Heatmap
        </button>
        <button type="button" class="profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer whitespace-nowrap" data-tab="communities">
          Communities &amp; Invites (<span id="spacesCountBadge">3</span>)
        </button>
        <button type="button" class="profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer whitespace-nowrap" data-tab="launches">
          Launches &amp; Promotions (<span id="launchesCountBadge">1</span>)
        </button>
        <button type="button" class="profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer whitespace-nowrap" data-tab="stacks">
          Saved Stacks &amp; Workflows (<span id="stacksCountBadge">0</span>)
        </button>
        <button type="button" class="profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer whitespace-nowrap" data-tab="bookmarks">
          Bookmarked Resources (<span id="bookmarkCountBadge">0</span>)
        </button>
        <button type="button" class="profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer whitespace-nowrap" data-tab="settings">
          Settings &amp; Billing
        </button>
      </div>

      <!-- TAB 1: OVERVIEW & 365-DAY HEATMAP -->
      <div class="tab-panel space-y-6" id="panel-overview">
        <!-- 365-Day Contribution Activity Heatmap -->
        <div class="card-aurora p-6 sm:p-8 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div>
              <span class="text-[10px] font-mono uppercase font-bold text-slate-400 block">Workspace Telemetry</span>
              <h2 class="text-base font-black text-slate-900">365-Day Builder Activity Heatmap</h2>
            </div>
            <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg">
              184 Contributions in 2025–2026
            </span>
          </div>

          <!-- Heatmap Visual Grid (52 Weeks x 7 Days) -->
          <div class="overflow-x-auto p-4 rounded-2xl bg-white border border-slate-200">
            <div class="min-w-[700px] space-y-1.5">
              <div class="flex justify-between text-[10px] font-mono text-slate-400 mb-1 px-1">
                <span>Apr</span>
                <span>Jun</span>
                <span>Aug</span>
                <span>Oct</span>
                <span>Dec</span>
                <span>Feb</span>
                <span>Apr (Active)</span>
              </div>
              <!-- Generated Heatmap Cells -->
              <div class="grid grid-flow-col grid-rows-7 gap-1" id="heatmapGrid">
                <!-- 52 columns x 7 rows generated by inline script -->
              </div>
            </div>
            <div class="flex items-center justify-end gap-2 text-[10px] font-mono text-slate-400 mt-3">
              <span>Less</span>
              <span class="w-2.5 h-2.5 rounded-xs bg-slate-100"></span>
              <span class="w-2.5 h-2.5 rounded-xs bg-emerald-200"></span>
              <span class="w-2.5 h-2.5 rounded-xs bg-emerald-400"></span>
              <span class="w-2.5 h-2.5 rounded-xs bg-emerald-600"></span>
              <span class="w-2.5 h-2.5 rounded-xs bg-emerald-800"></span>
              <span>More</span>
            </div>
          </div>
        </div>

        <!-- Account Specs Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div class="card-aurora p-5 space-y-1">
            <span class="text-slate-400 font-mono text-[11px] block uppercase font-bold">Active Role</span>
            <span class="text-lg font-black text-slate-900">Senior Architect</span>
            <span class="text-xs text-slate-500 block">Full write permissions on custom stacks</span>
          </div>
          <div class="card-aurora p-5 space-y-1">
            <span class="text-slate-400 font-mono text-[11px] block uppercase font-bold">Reputation Status</span>
            <span class="text-lg font-black text-emerald-600">120 Verified Pts</span>
            <span class="text-xs text-slate-500 block">Top 5% platform contributor</span>
          </div>
          <div class="card-aurora p-5 space-y-1">
            <span class="text-slate-400 font-mono text-[11px] block uppercase font-bold">Database Auth Sync</span>
            <span class="text-lg font-black text-blue-600">PostgreSQL Active</span>
            <span class="text-xs text-slate-500 block">Synchronized with auth.users triggers</span>
          </div>
        </div>
      </div>

      <!-- TAB 2: COMMUNITIES & INVITES -->
      <div class="tab-panel hidden space-y-6" id="panel-communities">
        <div class="card-aurora p-6 sm:p-8 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div>
              <h2 class="text-base font-black text-slate-900">Your Joined Spaces &amp; Discussion Hubs</h2>
              <p class="text-xs text-slate-500">Communities where you have discussion and voting privileges.</p>
            </div>
            <a href="/community" class="text-xs font-bold text-blue-600 hover:underline">
              Browse All Spaces &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="p-4 rounded-2xl bg-white border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-900">c/AIEngineering</span>
                <span class="font-mono text-slate-400">4.8k members</span>
              </div>
              <p class="text-slate-500 text-[11px]">Prompt systems and enterprise LLM inference scaling.</p>
              <a href="/community" class="font-bold text-blue-600 hover:underline block pt-1">Open Space &rarr;</a>
            </div>

            <div class="p-4 rounded-2xl bg-white border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-900">c/OpenSourceHub</span>
                <span class="font-mono text-slate-400">3.9k members</span>
              </div>
              <p class="text-slate-500 text-[11px]">Self-hostable weights, Ollama, ComfyUI, and vLLM recipes.</p>
              <a href="/community" class="font-bold text-blue-600 hover:underline block pt-1">Open Space &rarr;</a>
            </div>

            <div class="p-4 rounded-2xl bg-white border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-900">c/LocalLLMs</span>
                <span class="font-mono text-slate-400">4.1k members</span>
              </div>
              <p class="text-slate-500 text-[11px]">DeepSeek-R1, Llama 3.3, and GGUF quantization tuning.</p>
              <a href="/community" class="font-bold text-blue-600 hover:underline block pt-1">Open Space &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Personal Invite Generator Card -->
        <div class="card-aurora p-6 space-y-4">
          <h3 class="text-sm font-black text-slate-900">Your Personal Builder Invite Link</h3>
          <p class="text-xs text-slate-600">
            Invite fellow developers and receive +25 reputation points when they publish their first verified stack or workflow.
          </p>
          <div class="p-3 rounded-xl bg-white border border-slate-200 font-mono text-xs flex items-center justify-between">
            <span id="personalInviteUrl">https://aio-ai.dev/community?ref=harshil_architect</span>
            <button type="button" id="copyPersonalInviteBtn" class="text-blue-600 font-bold hover:underline cursor-pointer">
              Copy Link
            </button>
          </div>
        </div>
      </div>

      <!-- TAB 3: LAUNCHES & PROMOTIONS -->
      <div class="tab-panel hidden space-y-6" id="panel-launches">
        <div class="card-aurora p-6 sm:p-8 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div>
              <h2 class="text-base font-black text-slate-900">Active Launches &amp; Promotional Campaigns</h2>
              <p class="text-xs text-slate-500">Track impressions, CTR, and moderation approvals for your submitted tools.</p>
            </div>
            <a href="/pricing" class="text-xs font-bold text-blue-600 hover:underline">
              + Launch Pay-Per-Boost
            </a>
          </div>

          <div class="space-y-3 text-xs">
            <div class="p-4 rounded-2xl bg-white border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 font-bold font-mono text-[10px]">Active Boost</span>
                  <span class="font-bold text-slate-900 text-sm">Git PR Sentinel Agent</span>
                </div>
                <span class="text-slate-500">7-Day Tool Directory Spotlight • Ends in 4 days</span>
              </div>
              <div class="flex items-center gap-4 font-mono text-xs">
                <div>
                  <span class="text-slate-400 block text-[10px]">Impressions</span>
                  <span class="font-bold text-slate-900">1,420</span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">Clicks</span>
                  <span class="font-bold text-blue-600">89 (6.2%)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 4: SAVED STACKS & WORKFLOWS -->
      <div class="tab-panel hidden space-y-6" id="panel-stacks">
        <div class="card-aurora p-6 sm:p-8 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div>
              <h2 class="text-base font-black text-slate-900">Custom Stacks &amp; Workflows</h2>
              <p class="text-xs text-slate-500">Your engineered 5-layer architectures and multi-node recipes.</p>
            </div>
            <a href="/stack-builder" class="text-xs font-bold text-blue-600 hover:underline">
              + Open Stack Architect
            </a>
          </div>

          <div id="stacksListContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="p-4 rounded-2xl bg-white border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-900">Private Enterprise RAG Stack</span>
                <span class="text-[10px] font-mono text-slate-400">Saved Today</span>
              </div>
              <p class="text-slate-500">Ollama + DeepSeek-R1 + ChromaDB + n8n automation pipeline.</p>
              <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
                <span class="font-mono text-emerald-700 font-bold">$0 / mo (100% Free)</span>
                <a href="/stack-builder" class="text-blue-600 font-bold hover:underline">Load Stack &rarr;</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 5: BOOKMARKED RESOURCES -->
      <div class="tab-panel hidden space-y-6" id="panel-bookmarks">
        <div class="card-aurora p-6 sm:p-8 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <div>
              <h2 class="text-base font-black text-slate-900">Pinned Bookmarks</h2>
              <p class="text-xs text-slate-500">Quick-access saved tools, repositories, and educators.</p>
            </div>
            <a href="/tools" class="text-xs font-bold text-blue-600 hover:underline">
              Browse Directory
            </a>
          </div>

          <div id="bookmarksGrid" class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <a href="/tools/cursor" class="p-3.5 rounded-xl bg-white border border-slate-200 hover:border-blue-500 transition-all flex items-center justify-between">
              <div>
                <span class="font-bold text-slate-900 block">Cursor</span>
                <span class="text-[10px] text-slate-400 font-mono">Code Assistant</span>
              </div>
              <span class="text-blue-600 font-bold">&rarr;</span>
            </a>
            <a href="/open-source/ollama" class="p-3.5 rounded-xl bg-white border border-slate-200 hover:border-blue-500 transition-all flex items-center justify-between">
              <div>
                <span class="font-bold text-slate-900 block">Ollama</span>
                <span class="text-[10px] text-slate-400 font-mono">Local Inference</span>
              </div>
              <span class="text-blue-600 font-bold">&rarr;</span>
            </a>
            <a href="/tools/sarvam-ai" class="p-3.5 rounded-xl bg-white border border-slate-200 hover:border-blue-500 transition-all flex items-center justify-between">
              <div>
                <span class="font-bold text-slate-900 block">Sarvam AI</span>
                <span class="text-[10px] text-slate-400 font-mono">Sovereign India AI</span>
              </div>
              <span class="text-blue-600 font-bold">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- TAB 6: SETTINGS & BILLING -->
      <div class="tab-panel hidden space-y-6" id="panel-settings">
        <div class="card-aurora p-6 sm:p-8 space-y-5">
          <h2 class="text-base font-black text-slate-900 pb-3 border-b border-slate-200">
            Workspace Preferences &amp; Invoices
          </h2>

          <div class="space-y-4 text-xs max-w-xl">
            <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-slate-200">
              <div>
                <span class="font-bold text-slate-900 block">Current Plan</span>
                <span class="text-slate-500 text-[11px]">Builder Pro Subscription (Annual)</span>
              </div>
              <a href="/pricing" class="font-bold text-blue-600 hover:underline">Change Plan &rarr;</a>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-slate-200">
              <div>
                <span class="font-bold text-slate-900 block">Default Currency</span>
                <span class="text-slate-500 text-[11px]">USD ($) / INR (₹) switcher</span>
              </div>
              <span class="font-mono font-bold text-slate-700">Dynamic</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-slate-200">
              <div>
                <span class="font-bold text-slate-900 block">Session Management</span>
                <span class="text-slate-500 text-[11px]">Connected via Supabase Auth JWT</span>
              </div>
              <button type="button" id="settingsSignOutBtn" class="text-red-600 font-bold hover:underline cursor-pointer">
                Sign Out Everywhere
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>

  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  document.addEventListener('DOMContentLoaded', async () => {
    const unauthView = document.getElementById('unauthView');
    const authView = document.getElementById('authView');
    const userEmail = document.getElementById('userEmail');
    const userAvatarText = document.getElementById('userAvatarText');
    const tabBtns = document.querySelectorAll('.profile-tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    const logoutBtn = document.getElementById('logoutBtn');
    const settingsSignOutBtn = document.getElementById('settingsSignOutBtn');
    const copyPersonalInviteBtn = document.getElementById('copyPersonalInviteBtn');

    // 1. Generate 365-Day Heatmap SVG
    const heatmapGrid = document.getElementById('heatmapGrid');
    if (heatmapGrid) {
      // 52 cols x 7 rows = 364 cells
      for (let i = 0; i < 364; i++) {
        const cell = document.createElement('div');
        // Seed realistic deterministic activity pattern
        const rand = (i * 17 + 23) % 100;
        let colorClass = 'bg-slate-100';
        if (rand > 85) colorClass = 'bg-emerald-600';
        else if (rand > 65) colorClass = 'bg-emerald-400';
        else if (rand > 40) colorClass = 'bg-emerald-200';
        
        cell.className = `w-2.5 h-2.5 rounded-xs ${colorClass} transition-colors hover:ring-1 hover:ring-slate-900 cursor-pointer`;
        heatmapGrid.appendChild(cell);
      }
    }

    // 2. Tab Navigation
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => {
          b.className = 'profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 cursor-pointer whitespace-nowrap';
        });
        btn.className = 'profile-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-900 text-white cursor-pointer shadow-xs whitespace-nowrap';

        const target = btn.getAttribute('data-tab');
        panels.forEach(p => {
          if (p.id === `panel-${target}`) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // 3. User Hydration
    let activeUser: any = null;
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session && session.user) {
        activeUser = session.user;
      }
    } catch(e) {}

    if (!activeUser) {
      const localStr = localStorage.getItem('aio_user');
      if (localStr) {
        try { activeUser = JSON.parse(localStr); } catch(e) {}
      }
    }

    if (!activeUser) {
      unauthView?.classList.remove('hidden');
      authView?.classList.add('hidden');
      return;
    }

    unauthView?.classList.add('hidden');
    authView?.classList.remove('hidden');
    authView?.classList.add('flex');

    const email = activeUser.email || 'Verified Builder';
    if (userEmail) userEmail.textContent = email;
    if (userAvatarText) userAvatarText.textContent = email.charAt(0).toUpperCase();

    // 4. Copy Invite Link
    copyPersonalInviteBtn?.addEventListener('click', () => {
      const url = document.getElementById('personalInviteUrl')?.textContent || '';
      navigator.clipboard.writeText(url);
      copyPersonalInviteBtn.textContent = 'Copied!';
      setTimeout(() => { copyPersonalInviteBtn.textContent = 'Copy Link'; }, 1800);
    });

    // 5. Logout
    const doLogout = async () => {
      try { await supabase.auth.signOut(); } catch(e) {}
      localStorage.removeItem('aio_user');
      localStorage.removeItem('aio_admin_unlocked');
      localStorage.removeItem('supabase.auth.token');
      for (var i = localStorage.length - 1; i >= 0; i--) {
        var k = localStorage.key(i);
        if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1) {
          localStorage.removeItem(k);
        }
      }
      window.location.href = '/';
    };

    logoutBtn?.addEventListener('click', doLogout);
    settingsSignOutBtn?.addEventListener('click', doLogout);
  });
</script>
