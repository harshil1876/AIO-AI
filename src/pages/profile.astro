---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="User Profile & Saved Tools | AIO AI" description="Manage your saved AI tools, custom stacks, and account settings.">
  <Header currentPath="/profile" />

  <main class="w-full flex-1 max-w-5xl mx-auto px-6 py-12 bg-canvas min-h-screen">
    <!-- Unauthenticated State -->
    <div id="unauthView" class="hidden text-center py-20 bg-white border border-[#E2E8F0] rounded-2xl p-8 shadow-xs">
      <div class="w-14 h-14 rounded-2xl bg-blue-50 border border-blue-200 flex items-center justify-center mx-auto mb-4 text-primary">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </div>
      <h1 class="text-2xl md:text-3xl font-black text-ink tracking-tight mb-2">Sign In to Your Workspace</h1>
      <p class="text-xs md:text-sm text-neutral-600 max-w-md mx-auto mb-6">
        Sync your bookmarked AI tools, save custom multi-step stacks, and earn reputation for verified reviews.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
        <button 
          id="demoLoginProfileBtn"
          type="button"
          class="w-full sm:w-auto bg-primary text-white text-xs font-bold px-6 py-2.5 rounded-xl hover:bg-blue-700 transition-colors shadow-xs cursor-pointer flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
          </svg>
          <span>Instant Demo Session</span>
        </button>
        <a href="/login" class="w-full sm:w-auto bg-white border border-[#E2E8F0] hover:border-ink text-ink text-xs font-semibold px-5 py-2.5 rounded-xl transition-colors">
          Supabase Login
        </a>
        <a href="/signup" class="w-full sm:w-auto bg-surface border border-[#E2E8F0] hover:border-ink text-ink text-xs font-semibold px-5 py-2.5 rounded-xl transition-colors">
          Sign Up
        </a>
      </div>
    </div>

    <!-- Authenticated State -->
    <div id="authView" class="hidden flex-col gap-8">
      <!-- Profile Summary Card -->
      <div class="bg-white border border-[#E2E8F0] rounded-2xl p-6 md:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-xs">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-ink text-white font-black text-xl flex items-center justify-center font-mono">
            <span id="userAvatarText">U</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 id="userEmail" class="text-xl font-black text-ink tracking-tight">user@example.com</h1>
              <span class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full font-mono font-medium">
                Verified Member
              </span>
            </div>
            <p id="userId" class="text-xs text-neutral-400 font-mono mt-1">ID: ...</p>
          </div>
        </div>

        <button 
          id="logoutBtn"
          class="bg-surface border border-[#E2E8F0] hover:border-red-400 hover:text-red-600 text-neutral-700 text-xs font-semibold px-4 py-2 rounded-xl transition-colors cursor-pointer self-start sm:self-auto"
        >
          Sign Out
        </button>
      </div>

      <!-- Saved Bookmarks Section -->
      <section class="bg-white border border-[#E2E8F0] rounded-2xl p-6 md:p-8 shadow-xs">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-4 mb-6">
          <div>
            <h2 class="text-lg font-black text-ink tracking-tight">Saved Tools & Bookmarks</h2>
            <p class="text-xs text-neutral-500 mt-0.5">Quick access to tools you've pinned for your engineering stack.</p>
          </div>
          <span id="bookmarkCount" class="text-xs font-mono font-bold text-primary bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-lg">
            0 tools
          </span>
        </div>

        <div id="bookmarksList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Populated by script -->
        </div>

        <div id="emptyBookmarks" class="hidden text-center py-12 text-neutral-500 text-xs">
          You haven't bookmarked any AI tools yet. <a href="/tools" class="text-primary font-bold hover:underline">Browse the catalog</a> to save tools.
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function initProfile() {
    const unauthView = document.getElementById('unauthView');
    const authView = document.getElementById('authView');
    const userEmail = document.getElementById('userEmail');
    const userId = document.getElementById('userId');
    const userAvatarText = document.getElementById('userAvatarText');
    const logoutBtn = document.getElementById('logoutBtn');
    const bookmarksList = document.getElementById('bookmarksList');
    const emptyBookmarks = document.getElementById('emptyBookmarks');
    const bookmarkCount = document.getElementById('bookmarkCount');
    const demoLoginProfileBtn = document.getElementById('demoLoginProfileBtn');

    let activeUser: any = null;

    // Check Supabase first
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session && session.user) {
        activeUser = session.user;
      }
    } catch(e) {}

    // Fall back to localStorage demo user
    if (!activeUser) {
      const localStr = localStorage.getItem('aio_user');
      if (localStr) {
        try {
          activeUser = JSON.parse(localStr);
        } catch(e) {}
      }
    }

    if (!activeUser) {
      unauthView?.classList.remove('hidden');
      authView?.classList.add('hidden');

      demoLoginProfileBtn?.addEventListener('click', () => {
        const demoUser = {
          id: 'demo-usr-994',
          email: 'builder@aio-ai.dev',
          role: 'member',
          created_at: new Date().toISOString()
        };
        localStorage.setItem('aio_user', JSON.stringify(demoUser));
        window.location.reload();
      });
      return;
    }

    // Authenticated
    unauthView?.classList.add('hidden');
    authView?.classList.remove('hidden');
    authView?.classList.add('flex');

    if (userEmail) userEmail.textContent = activeUser.email || 'Verified Member';
    if (userId) userId.textContent = `ID: ${(activeUser.id || 'demo-session').substring(0, 14)}...`;
    if (userAvatarText && activeUser.email) {
      userAvatarText.textContent = activeUser.email.charAt(0).toUpperCase();
    }

    // Render bookmarks
    const savedSlugs: string[] = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
    if (bookmarkCount) bookmarkCount.textContent = `${savedSlugs.length} saved`;

    if (savedSlugs.length === 0) {
      emptyBookmarks?.classList.remove('hidden');
    } else {
      emptyBookmarks?.classList.add('hidden');
      if (bookmarksList) {
        bookmarksList.innerHTML = savedSlugs.map(slug => {
          const formattedName = slug.split('-').map((s: string) => s.charAt(0).toUpperCase() + s.slice(1)).join(' ');
          return `
            <a href="/tools/${slug}" class="p-4 rounded-xl border border-[#E2E8F0] bg-surface hover:border-primary hover:bg-white transition-all flex items-center justify-between group shadow-xs">
              <div class="min-w-0 pr-2">
                <span class="font-bold text-ink text-sm group-hover:text-primary transition-colors block truncate">${formattedName}</span>
                <span class="text-xs text-neutral-400 block mt-0.5 font-mono">/tools/${slug}</span>
              </div>
              <span class="text-xs text-neutral-400 group-hover:text-primary transition-colors font-mono shrink-0">↗</span>
            </a>
          `;
        }).join('');
      }
    }

    logoutBtn?.addEventListener('click', async () => {
      try {
        await supabase.auth.signOut();
      } catch(e) {}
      localStorage.removeItem('aio_user');
      localStorage.removeItem('aio_admin_unlocked');
      window.location.href = '/';
    });
  }

  initProfile();
</script>
