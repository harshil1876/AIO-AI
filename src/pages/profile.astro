---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="User Profile & Saved Tools | AIO AI" description="Manage your saved AI tools, custom stacks, and account settings.">
  <Header currentPath="/profile" />

  <main class="w-full flex-1 max-w-5xl mx-auto px-6 py-10 bg-canvas min-h-screen">
    <!-- Unauthenticated State -->
    <div id="unauthView" class="hidden text-center py-16 bg-canvas-elevated border border-hairline rounded-lg p-8 shadow-xs">
      <div class="w-12 h-12 rounded-full bg-hairline-soft border border-hairline flex items-center justify-center mx-auto mb-3 text-ink">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </div>
      <h1 class="text-2xl font-semibold text-ink tracking-tight mb-2">Sign In to Your Workspace</h1>
      <p class="text-xs text-mute max-w-md mx-auto mb-6">
        Sync your bookmarked AI tools, save custom multi-step stacks, and track community moderation submissions.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 max-w-md mx-auto">
        <button 
          id="googleLoginProfileBtn"
          type="button"
          class="w-full sm:w-auto bg-canvas border border-hairline hover:border-faint text-ink text-xs font-medium px-4 py-2 rounded-md transition-colors shadow-xs cursor-pointer flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span>Continue with Google</span>
        </button>
        <a href="/login" class="w-full sm:w-auto bg-ink hover:bg-neutral-800 text-on-primary text-xs font-medium px-4 py-2 rounded-md transition-colors shadow-xs">
          Sign In
        </a>
        <a href="/signup" class="w-full sm:w-auto bg-canvas border border-hairline hover:border-faint text-body text-xs font-medium px-4 py-2 rounded-md transition-colors">
          Sign Up
        </a>
      </div>
    </div>

    <!-- Authenticated State -->
    <div id="authView" class="hidden flex-col gap-6">
      <!-- Profile Summary Card -->
      <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-xs">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-md bg-ink text-on-primary font-bold text-lg flex items-center justify-center font-mono">
            <span id="userAvatarText">U</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 id="userEmail" class="text-lg font-semibold text-ink tracking-tight">user@example.com</h1>
              <span class="text-xs bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2.5 py-0.5 rounded-full font-mono font-medium">
                Verified Member
              </span>
            </div>
            <p id="userId" class="text-xs text-mute font-mono mt-0.5">ID: ...</p>
          </div>
        </div>

        <div class="flex items-center gap-2.5 self-start sm:self-auto">
          <a 
            href="/submit"
            class="bg-ink hover:bg-neutral-800 text-on-primary text-xs font-medium px-3.5 py-2 rounded-md transition-colors shadow-xs"
          >
            Submit Tool / Correction &rarr;
          </a>
          <button 
            id="logoutBtn"
            class="bg-canvas border border-hairline hover:border-red-400 hover:text-red-600 text-body text-xs font-medium px-3.5 py-2 rounded-md transition-colors cursor-pointer"
          >
            Sign Out
          </button>
        </div>
      </div>

      <!-- Saved Bookmarks Section -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
        <div class="flex items-center justify-between border-b border-hairline pb-3 mb-4">
          <div>
            <h2 class="text-sm font-semibold text-ink tracking-tight">Saved Tools & Bookmarks</h2>
            <p class="text-xs text-mute mt-0.5">Quick access to tools you've pinned for your engineering stack.</p>
          </div>
          <span id="bookmarkCount" class="text-xs font-mono font-medium text-ink bg-hairline-soft px-2.5 py-1 rounded">
            0 tools
          </span>
        </div>

        <div id="bookmarksList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <!-- Populated by script -->
        </div>

        <div id="emptyBookmarks" class="hidden text-center py-8 text-mute text-xs">
          You haven't bookmarked any AI tools yet. <a href="/tools" class="text-ink font-medium hover:underline">Browse the catalog</a> to save tools.
        </div>
      </section>

      <!-- User Submissions & Moderation Tickets Section -->
      <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
        <div class="flex items-center justify-between border-b border-hairline pb-3 mb-4">
          <div>
            <h2 class="text-sm font-semibold text-ink tracking-tight">Your Submissions & Tickets</h2>
            <p class="text-xs text-mute mt-0.5">Tools, corrections, and educator suggestions you have submitted.</p>
          </div>
          <span id="submissionCount" class="text-xs font-mono font-medium text-ink bg-hairline-soft px-2.5 py-1 rounded">
            0 tickets
          </span>
        </div>

        <div id="submissionsList" class="space-y-2">
          <!-- Populated by script -->
        </div>

        <div id="emptySubmissions" class="hidden text-center py-8 text-mute text-xs">
          No moderation submissions yet. <a href="/submit" class="text-ink font-medium hover:underline">Submit a new AI tool or report outdated pricing</a>.
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function initProfile() {
    const unauthView = document.getElementById('unauthView');
    const authView = document.getElementById('authView');
    const userEmail = document.getElementById('userEmail');
    const userId = document.getElementById('userId');
    const userAvatarText = document.getElementById('userAvatarText');
    const logoutBtn = document.getElementById('logoutBtn');
    const bookmarksList = document.getElementById('bookmarksList');
    const emptyBookmarks = document.getElementById('emptyBookmarks');
    const bookmarkCount = document.getElementById('bookmarkCount');
    const submissionsList = document.getElementById('submissionsList');
    const emptySubmissions = document.getElementById('emptySubmissions');
    const submissionCount = document.getElementById('submissionCount');
    const googleLoginProfileBtn = document.getElementById('googleLoginProfileBtn');

    googleLoginProfileBtn?.addEventListener('click', async () => {
      await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: window.location.origin + '/profile'
        }
      });
    });

    let activeUser: any = null;

    // Check Supabase first
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session && session.user) {
        activeUser = session.user;
      }
    } catch(e) {}

    // Fall back to stored session if available
    if (!activeUser) {
      const localStr = localStorage.getItem('aio_user');
      if (localStr) {
        try {
          activeUser = JSON.parse(localStr);
        } catch(e) {}
      }
    }

    if (!activeUser) {
      unauthView?.classList.remove('hidden');
      authView?.classList.add('hidden');
      return;
    }

    // Authenticated
    unauthView?.classList.add('hidden');
    authView?.classList.remove('hidden');
    authView?.classList.add('flex');

    if (userEmail) userEmail.textContent = activeUser.email || 'Verified Member';
    if (userId) userId.textContent = `ID: ${(activeUser.id || 'usr-active').substring(0, 14)}...`;
    if (userAvatarText && activeUser.email) {
      userAvatarText.textContent = activeUser.email.charAt(0).toUpperCase();
    }

    // Render bookmarks
    const savedSlugs: string[] = JSON.parse(localStorage.getItem('aio_bookmarks') || '[]');
    if (bookmarkCount) bookmarkCount.textContent = `${savedSlugs.length} saved`;

    if (savedSlugs.length === 0) {
      emptyBookmarks?.classList.remove('hidden');
    } else {
      emptyBookmarks?.classList.add('hidden');
      if (bookmarksList) {
        bookmarksList.innerHTML = savedSlugs.map(slug => {
          const formattedName = slug.split('-').map((s: string) => s.charAt(0).toUpperCase() + s.slice(1)).join(' ');
          return `
            <a href="/tools/${slug}" class="p-3.5 rounded border border-hairline bg-canvas hover:border-faint transition-colors flex items-center justify-between group shadow-xs">
              <div class="min-w-0 pr-2">
                <span class="font-medium text-ink text-xs group-hover:underline block truncate">${formattedName}</span>
                <span class="text-[11px] text-mute block mt-0.5 font-mono truncate">/tools/${slug}</span>
              </div>
              <span class="text-xs text-mute font-mono shrink-0">&rarr;</span>
            </a>
          `;
        }).join('');
      }
    }

    // Render submissions
    const userSubmissions: Array<{ type: string; name: string; slug: string; date: string }> = JSON.parse(localStorage.getItem('aio_user_submissions') || '[]');
    if (submissionCount) submissionCount.textContent = `${userSubmissions.length} ticket${userSubmissions.length === 1 ? '' : 's'}`;

    if (userSubmissions.length === 0) {
      emptySubmissions?.classList.remove('hidden');
    } else {
      emptySubmissions?.classList.add('hidden');
      if (submissionsList) {
        submissionsList.innerHTML = userSubmissions.map(sub => `
          <div class="p-3 rounded border border-hairline bg-canvas flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-hairline-soft font-mono uppercase text-[10px] text-ink font-medium">${sub.type}</span>
              <span class="font-medium text-ink">${sub.name}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-[10px] text-emerald-600 font-mono bg-emerald-500/10 px-2 py-0.5 rounded">Queued (In Moderation)</span>
              <span class="text-[10px] text-mute font-mono">${new Date(sub.date).toLocaleDateString()}</span>
            </div>
          </div>
        `).join('');
      }
    }

    logoutBtn?.addEventListener('click', async () => {
      try {
        await supabase.auth.signOut();
      } catch(e) {}
      localStorage.removeItem('aio_user');
      localStorage.removeItem('aio_admin_unlocked');
      localStorage.removeItem('supabase.auth.token');
      for (var i = localStorage.length - 1; i >= 0; i--) {
        var k = localStorage.key(i);
        if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1) {
          localStorage.removeItem(k);
        }
      }
      window.location.href = '/';
    });
  }

  initProfile();
</script>