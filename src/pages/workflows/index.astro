---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { WORKFLOWS_DATA } from '../../data/workflowsData';
---

<Layout 
  title="AI Workflows & Multi-Tool Recipes | AI Discovery Platform"
  description="Proven step-by-step blueprints connecting AI models, APIs, and automation tools to solve real-world problems."
>
  <Header currentPath="/workflows" />

  <main class="w-full flex flex-col min-h-screen">
    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs text-mute uppercase font-mono tracking-wider mb-2">Blueprints</div>
        <h1 class="text-3xl md:text-4xl font-semibold text-ink tracking-tight mb-2">
          Curated AI Workflows
        </h1>
        <p class="text-sm md:text-base text-body max-w-2xl leading-relaxed">
          Step-by-step implementation blueprints showing you how to chain frontier models, automations, and APIs together.
        </p>
      </div>
    </section>

    <!-- Workflows List -->
    <div class="w-full max-w-7xl mx-auto px-6 py-12 flex flex-col gap-8">
      {WORKFLOWS_DATA.map(workflow => (
        <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 md:p-8 shadow-xs">
          <!-- Top Row: Title, Meta, Tools -->
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6 pb-6 border-b border-hairline">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-hairline-soft border border-hairline text-ink">
                  {workflow.difficulty}
                </span>
                <span class="text-xs text-mute font-mono">⏱ {workflow.time}</span>
              </div>
              <h2 class="text-2xl font-semibold text-ink tracking-tight mb-2">
                {workflow.title}
              </h2>
              <p class="text-sm text-body max-w-2xl">
                {workflow.goal}
              </p>
            </div>

            <div class="shrink-0 flex flex-col items-start md:items-end gap-1.5">
              <span class="text-xs text-mute font-medium uppercase tracking-wider">Required Tools</span>
              <div class="flex flex-wrap gap-1.5">
                {workflow.toolsUsed.map(t => (
                  <a 
                    href={`/tools/${t.slug}`} 
                    class="text-xs bg-canvas text-ink hover:text-link border border-hairline px-2.5 py-1 rounded-sm transition-colors font-medium shadow-2xs"
                  >
                    {t.name}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Step by Step -->
          <div class="mb-6">
            <h3 class="text-xs font-semibold text-mute uppercase tracking-wider mb-4">Implementation Steps</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              {workflow.steps.map((step, idx) => (
                <div class="p-4 rounded-md border border-hairline bg-canvas flex flex-col justify-between">
                  <div>
                    <span class="w-6 h-6 rounded-full bg-ink text-on-primary text-xs font-bold flex items-center justify-center mb-3">
                      {idx + 1}
                    </span>
                    <div class="text-sm font-semibold text-ink mb-1.5">{step.title}</div>
                    <p class="text-xs text-body leading-relaxed">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Final Output Box -->
          <div class="p-4 rounded-md border border-emerald-200 bg-emerald-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div class="text-emerald-950">
              <strong class="font-semibold text-emerald-900">Final Deliverable:</strong> {workflow.output}
            </div>
            <div class="flex items-center gap-2">
              <a 
                href={`/workflows/${workflow.id}`}
                class="shrink-0 bg-ink text-on-primary hover:bg-black px-4 py-1.5 rounded-pill font-medium transition-colors cursor-pointer inline-flex items-center gap-1"
              >
                <span>Interactive Map</span>
                <span>→</span>
              </a>
              <button 
                class="copy-workflow-btn shrink-0 bg-canvas-elevated border border-hairline hover:border-faint text-ink px-3.5 py-1.5 rounded-pill font-medium transition-colors cursor-pointer"
                data-title={workflow.title}
              >
                Copy
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.querySelectorAll('.copy-workflow-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title');
      navigator.clipboard?.writeText(`AI Workflow: ${title}`);
      const originalText = btn.textContent;
      btn.textContent = 'Copied! ✓';
      setTimeout(() => {
        btn.textContent = originalText;
      }, 2000);
    });
  });
</script>
