---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { WORKFLOWS_DATA } from '../../data/workflowsData';

const categories = ['All', 'Content Creation', 'Engineering & DevOps', 'Customer Support', 'Sales & Marketing', 'Enterprise & Data', 'Research & Academic', 'Design & Media'];
---

<Layout 
  title="AI Workflows & Production Automation Blueprints | AIO AI"
  description="16+ proven step-by-step blueprints connecting AI models, APIs, and automation tools to solve real-world problems. Includes node flows and Free vs Paid budget comparisons."
>
  <Header currentPath="/workflows" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Header -->
    <section class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-4 sm:px-6 py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#BFDBFE] bg-[#EFF6FF] text-xs font-semibold text-[#2563EB] mb-4 shadow-xs font-mono">
          <span>16+ PRODUCTION AUTOMATION BLUEPRINTS</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-ink tracking-tight mb-3">
          AI Workflow Blueprints
        </h1>
        <p class="text-slate-600 text-sm sm:text-base max-w-2xl leading-relaxed">
          Step-by-step implementation pipelines chaining frontier models, APIs, and webhooks together. Every workflow compares 100% Free vs Freemium vs Paid SaaS operational costs.
        </p>
      </div>
    </section>

    <!-- Workflows Grid -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-12 flex-1">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {WORKFLOWS_DATA.map((workflow) => (
          <article class="bg-white border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B] hover:shadow-[7px_7px_0px_0px_#2563EB] hover:-translate-y-0.5 transition-all flex flex-col justify-between">
            <div>
              <!-- Top Row Badges -->
              <div class="flex items-center justify-between text-xs font-mono mb-3">
                <span class="bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE] font-bold px-2 py-0.5 rounded-xs text-[10px] uppercase">
                  {workflow.category}
                </span>
                <span class="text-slate-500 font-semibold">{workflow.difficulty} &bull; {workflow.time}</span>
              </div>

              <!-- Title & Goal -->
              <h2 class="text-lg font-bold text-ink leading-snug mb-2 hover:text-[#2563EB] transition-colors">
                <a href={`/workflows/${workflow.id}`}>
                  {workflow.title}
                </a>
              </h2>

              <p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-2">
                {workflow.goal}
              </p>

              <!-- Node Pipeline Preview -->
              <div class="p-3 rounded-lg bg-[#F8FAFF] border border-[#E2E8F0] mb-4 space-y-1.5 text-[11px]">
                <div class="text-[10px] font-mono uppercase text-slate-500 font-bold">Execution Chain:</div>
                <div class="truncate text-slate-700">1. {workflow.steps[0]?.title}</div>
                <div class="truncate text-slate-700">2. {workflow.steps[1]?.title}</div>
                {workflow.steps[2] && <div class="truncate text-slate-700">3. {workflow.steps[2]?.title}</div>}
              </div>

              <!-- Required Tools Chips -->
              <div class="mb-4">
                <span class="text-[10px] font-mono uppercase text-slate-500 font-bold block mb-1.5">Tools Used:</span>
                <div class="flex flex-wrap gap-1.5">
                  {workflow.toolsUsed.map(t => (
                    <a 
                      href={`/tools/${t.slug}`} 
                      class="px-2 py-0.5 rounded bg-white hover:bg-[#EFF6FF] border border-[#E2E8F0] hover:border-[#BFDBFE] text-slate-800 text-[11px] font-medium transition-colors"
                    >
                      {t.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar -->
            <div class="pt-3 border-t border-[#E2E8F0] flex items-center justify-between text-xs">
              <span class="text-[11px] font-mono text-slate-500 truncate max-w-[150px]">
                {workflow.estimatedCost}
              </span>
              <a 
                href={`/workflows/${workflow.id}`} 
                class="font-bold text-[#2563EB] hover:underline inline-flex items-center gap-1"
              >
                Inspect Blueprint &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
