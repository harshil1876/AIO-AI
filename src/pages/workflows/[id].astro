---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { WORKFLOWS_DATA } from '../../data/workflowsData';

export function getStaticPaths() {
  return WORKFLOWS_DATA.map((wf) => ({
    params: { id: wf.id },
    props: { workflow: wf },
  }));
}

const { workflow } = Astro.props;

if (!workflow) {
  return Astro.redirect('/workflows');
}
---

<Layout 
  title={`${workflow.title} | Interactive AI Workflow Map`}
  description={workflow.goal}
>
  <Header currentPath="/workflows" />

  <main class="w-full flex flex-col min-h-screen">
    <!-- Breadcrumbs -->
    <div class="border-b border-hairline bg-canvas px-6 py-3">
      <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs text-mute">
        <a href="/" class="hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/workflows" class="hover:text-ink transition-colors">Workflows</a>
        <span>/</span>
        <span class="text-ink font-medium">{workflow.title}</span>
      </div>
    </div>

    <!-- Header -->
    <section class="border-b border-hairline bg-canvas-elevated px-6 py-10 md:py-14">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-hairline-soft border border-hairline text-ink">
              {workflow.difficulty}
            </span>
            <span class="text-xs text-mute font-mono">⏱ {workflow.time}</span>
            <span class="text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full font-mono">
              💰 {workflow.estimatedCost}
            </span>
          </div>

          <h1 class="text-3xl md:text-4xl font-semibold text-ink tracking-tight mb-3">
            {workflow.title}
          </h1>
          <p class="text-sm md:text-base text-body max-w-3xl leading-relaxed">
            {workflow.goal}
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <button 
            id="exportJsonBtn"
            class="bg-canvas-elevated border border-hairline hover:border-faint text-ink text-xs font-medium px-4 py-2.5 rounded-pill transition-colors cursor-pointer shadow-xs"
          >
            Export Blueprint (JSON)
          </button>
        </div>
      </div>
    </section>

    <!-- Interactive Pipeline Canvas -->
    <div class="w-full max-w-7xl mx-auto px-6 py-10">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-mute">
          Interactive Node Pipeline (Click any step to inspect)
        </h2>
        <span class="text-xs text-mute">← Scroll horizontally on mobile →</span>
      </div>

      <!-- Horizontal Visual Node Flow -->
      <div class="overflow-x-auto pb-4 mb-8">
        <div class="flex items-center gap-3 min-w-[700px]">
          {workflow.steps.map((step, idx) => (
            <div class="flex items-center gap-3">
              <button 
                class="step-node bg-canvas-elevated border border-hairline hover:border-ink rounded-md p-4 text-left w-52 shrink-0 transition-all shadow-xs cursor-pointer focus:border-ink focus:ring-1 focus:ring-ink"
                data-step-index={idx}
                data-title={step.title}
                data-desc={step.desc}
                data-type={step.type}
                data-tool={step.toolName || 'Webhook / Trigger'}
                data-tool-slug={step.toolSlug || ''}
                data-prompt={step.promptTemplate || 'Standard API / Webhook payload'}
              >
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded-xs bg-hairline-soft text-mute">
                    {step.type}
                  </span>
                  <span class="w-5 h-5 rounded-full bg-ink text-on-primary text-[10px] font-bold flex items-center justify-center">
                    {idx + 1}
                  </span>
                </div>
                <div class="font-semibold text-ink text-xs mb-1 line-clamp-1">{step.title}</div>
                <div class="text-[11px] text-mute font-mono">{step.toolName || 'Trigger'}</div>
              </button>

              {idx < workflow.steps.length - 1 && (
                <div class="text-mute font-bold text-lg shrink-0">→</div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Step Inspector Panel -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Inspector Content -->
        <div class="lg:col-span-2 bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs" id="inspectorPanel">
          <div class="flex items-center justify-between border-b border-hairline pb-4 mb-5">
            <div>
              <span id="inspectType" class="text-xs font-mono uppercase tracking-wider text-link font-semibold">
                {workflow.steps[0].type}
              </span>
              <h3 id="inspectTitle" class="text-xl font-semibold text-ink tracking-tight mt-1">
                {workflow.steps[0].title}
              </h3>
            </div>
            <div id="inspectToolBadge">
              {workflow.steps[0].toolSlug ? (
                <a href={`/tools/${workflow.steps[0].toolSlug}`} class="text-xs font-medium text-ink bg-hairline-soft px-3 py-1.5 rounded-full border border-hairline hover:text-link transition-colors">
                  View {workflow.steps[0].toolName} →
                </a>
              ) : (
                <span class="text-xs text-mute font-mono">External Trigger</span>
              )}
            </div>
          </div>

          <div class="mb-6">
            <h4 class="text-xs font-semibold text-mute uppercase tracking-wider mb-2">Step Objective</h4>
            <p id="inspectDesc" class="text-sm text-body leading-relaxed">
              {workflow.steps[0].desc}
            </p>
          </div>

          <!-- Executable Prompt Template -->
          <div class="border border-hairline rounded-md bg-canvas p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-medium text-mute">Prompt / Configuration Snippet</span>
              <button 
                id="copySnippetBtn"
                class="text-xs text-ink hover:text-link font-medium cursor-pointer transition-colors"
              >
                Copy Snippet
              </button>
            </div>
            <pre id="inspectSnippet" class="text-xs font-mono text-body bg-canvas-elevated border border-hairline p-3 rounded-sm overflow-x-auto whitespace-pre-wrap">{workflow.steps[0].promptTemplate || 'Standard API / Webhook payload'}</pre>
          </div>
        </div>

        <!-- Right Side: Pipeline Details & Tools -->
        <div class="flex flex-col gap-6">
          <div class="bg-canvas-elevated border border-hairline rounded-md p-6 shadow-xs">
            <h3 class="font-semibold text-ink text-sm uppercase tracking-wider mb-4 border-b border-hairline pb-2">
              Pipeline Stack ({workflow.toolsUsed.length})
            </h3>
            <div class="space-y-3">
              {workflow.toolsUsed.map(tool => (
                <a 
                  href={`/tools/${tool.slug}`}
                  class="flex items-center justify-between p-2.5 rounded-md border border-hairline hover:bg-hairline-soft transition-colors"
                >
                  <span class="font-medium text-xs text-ink">{tool.name}</span>
                  <span class="text-xs text-link font-medium">Specs ↗</span>
                </a>
              ))}
            </div>
          </div>

          <div class="bg-canvas-elevated border border-hairline rounded-md p-6 shadow-xs">
            <h3 class="font-semibold text-ink text-sm uppercase tracking-wider mb-3 border-b border-hairline pb-2">
              Deliverable Output
            </h3>
            <p class="text-xs text-body leading-relaxed mb-4">
              {workflow.output}
            </p>
            <a 
              href="/workflows" 
              class="block text-center text-xs text-link hover:underline font-medium"
            >
              ← Back to all workflows
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ workflow }}>
  document.addEventListener('DOMContentLoaded', () => {
    const nodes = document.querySelectorAll('.step-node');
    const inspectType = document.getElementById('inspectType');
    const inspectTitle = document.getElementById('inspectTitle');
    const inspectDesc = document.getElementById('inspectDesc');
    const inspectSnippet = document.getElementById('inspectSnippet');
    const inspectToolBadge = document.getElementById('inspectToolBadge');
    const copySnippetBtn = document.getElementById('copySnippetBtn');
    const exportJsonBtn = document.getElementById('exportJsonBtn');

    // Default select first node
    if (nodes.length > 0) {
      nodes[0].classList.add('border-ink', 'ring-1', 'ring-ink');
    }

    nodes.forEach(node => {
      node.addEventListener('click', () => {
        nodes.forEach(n => n.classList.remove('border-ink', 'ring-1', 'ring-ink'));
        node.classList.add('border-ink', 'ring-1', 'ring-ink');

        const type = node.getAttribute('data-type');
        const title = node.getAttribute('data-title');
        const desc = node.getAttribute('data-desc');
        const tool = node.getAttribute('data-tool');
        const toolSlug = node.getAttribute('data-tool-slug');
        const prompt = node.getAttribute('data-prompt');

        if (inspectType) inspectType.textContent = type;
        if (inspectTitle) inspectTitle.textContent = title;
        if (inspectDesc) inspectDesc.textContent = desc;
        if (inspectSnippet) inspectSnippet.textContent = prompt;

        if (inspectToolBadge) {
          if (toolSlug) {
            inspectToolBadge.innerHTML = `<a href="/tools/${toolSlug}" class="text-xs font-medium text-ink bg-hairline-soft px-3 py-1.5 rounded-full border border-hairline hover:text-link transition-colors">View ${tool} →</a>`;
          } else {
            inspectToolBadge.innerHTML = `<span class="text-xs text-mute font-mono">External Trigger</span>`;
          }
        }
      });
    });

    copySnippetBtn?.addEventListener('click', () => {
      const text = inspectSnippet?.textContent || '';
      navigator.clipboard?.writeText(text);
      const prev = copySnippetBtn.textContent;
      copySnippetBtn.textContent = 'Copied! ✓';
      setTimeout(() => copySnippetBtn.textContent = prev, 1500);
    });

    exportJsonBtn?.addEventListener('click', () => {
      const jsonString = JSON.stringify(workflow, null, 2);
      navigator.clipboard?.writeText(jsonString);
      alert('Full workflow configuration JSON copied to clipboard!');
    });
  });
</script>
