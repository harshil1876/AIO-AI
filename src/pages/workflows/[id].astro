---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { WORKFLOWS_DATA, type WorkflowItem } from '../../data/workflowsData';
import { CREATORS_DATA } from '../../data/creatorsData';

export function getStaticPaths() {
  return WORKFLOWS_DATA.map((wf) => ({
    params: { id: wf.id },
    props: { workflow: wf },
  }));
}

interface Props {
  workflow: WorkflowItem;
}

const { workflow } = Astro.props;

if (!workflow) {
  return Astro.redirect('/workflows');
}

// Find related creators
const relatedCreators = CREATORS_DATA.filter(c => 
  workflow.relatedCreatorSlugs?.includes(c.slug) ||
  c.inspiredWorkflowIds?.includes(workflow.id)
);

// Generate valid n8n workflow JSON for 1-click import
const n8nWorkflowExport = {
  name: workflow.title,
  nodes: workflow.steps.map((step, idx) => ({
    parameters: {
      operation: step.type,
      prompt: step.promptTemplate || '',
      tool: step.toolName || 'AI Webhook',
      inputFormat: step.inputFormat || 'JSON',
      outputFormat: step.outputFormat || 'Structured JSON'
    },
    id: `node_${idx + 1}`,
    name: step.title,
    type: `n8n-nodes-base.${step.type.toLowerCase().includes('llm') || step.type.toLowerCase().includes('prompt') ? 'openAi' : 'httpRequest'}`,
    typeVersion: 1,
    position: [280 * (idx + 1), 320]
  })),
  connections: workflow.steps.slice(0, -1).reduce((acc: any, step, idx) => {
    acc[step.title] = {
      main: [
        [
          {
            node: workflow.steps[idx + 1].title,
            type: 'main',
            index: 0
          }
        ]
      ]
    };
    return acc;
  }, {}),
  active: false,
  settings: {
    executionOrder: 'v1'
  },
  meta: {
    templateCredsSetupCompleted: false,
    generator: 'AIO AI Workflow Engine',
    source: `https://aio-ai.pages.dev/workflows/${workflow.id}`
  }
};
---

<Layout 
  title={`${workflow.title} | Production Workflow Blueprint & n8n Template`}
  description={workflow.goal}
>
  <Header currentPath="/workflows" />

  <main class="w-full flex flex-col min-h-screen bg-canvas">
    <!-- Breadcrumbs -->
    <div class="border-b border-hairline bg-canvas px-4 sm:px-6 py-3">
      <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs font-mono text-mute">
        <a href="/" class="hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/workflows" class="hover:text-ink transition-colors">Workflows</a>
        <span>/</span>
        <span class="text-ink font-medium uppercase truncate">{workflow.title}</span>
      </div>
    </div>

    <!-- Header & Action Row -->
    <section class="border-b border-hairline bg-canvas-elevated px-4 sm:px-6 py-10 md:py-14">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="text-[11px] font-mono uppercase font-semibold px-2.5 py-0.5 rounded-full bg-hairline-soft text-ink border border-hairline">
              {workflow.category}
            </span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-canvas border border-hairline text-body">
              {workflow.difficulty}
            </span>
            <span class="text-xs text-mute font-mono">
              Setup: {workflow.time}
            </span>
            <span class="text-xs text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full font-mono font-semibold">
              Est: {workflow.estimatedCost}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-semibold text-ink tracking-tight mb-3">
            {workflow.title}
          </h1>
          <p class="text-sm sm:text-base text-body max-w-3xl leading-relaxed">
            {workflow.goal}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <!-- 1-Click Valid n8n JSON Copy (Competitor Blueprint Feature) -->
          <button 
            type="button"
            id="copyN8nJsonBtn"
            class="bg-ink hover:bg-neutral-800 text-on-primary font-medium text-xs px-4 py-2.5 rounded-md shadow-xs transition-colors cursor-pointer inline-flex items-center gap-1.5"
            data-n8n={JSON.stringify(n8nWorkflowExport)}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
            </svg>
            <span id="n8nBtnLabel">Copy Valid n8n JSON</span>
          </button>

          <a
            href={`/stack-builder?tools=${workflow.toolsUsed.map(t => t.slug).join(',')}`}
            class="bg-canvas hover:bg-hairline-soft border border-hairline text-ink font-medium text-xs px-4 py-2.5 rounded-md shadow-xs transition-colors inline-flex items-center gap-1.5"
          >
            <span>Load in Stack Builder</span>
            <span>&rarr;</span>
          </a>

          <button 
            type="button"
            id="exportJsonBtn"
            class="bg-canvas border border-hairline hover:bg-hairline-soft text-body hover:text-ink font-medium text-xs px-3.5 py-2.5 rounded-md shadow-xs transition-all cursor-pointer inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span>Download .json</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-10 flex-1 space-y-10">
      
      <!-- Section 1: Horizontal Visual Node Pipeline -->
      <div>
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-ink">
            Interactive Node Pipeline Architecture (Click node to inspect variables):
          </h2>
          <span class="text-xs text-mute font-mono">Execution flow &rarr;</span>
        </div>

        <div class="overflow-x-auto pb-4 mb-6">
          <div class="flex items-center gap-3 min-w-[700px]">
            {workflow.steps.map((step, idx) => (
              <div class="flex items-center gap-3">
                <button 
                  type="button"
                  class={`step-node bg-canvas-elevated border ${idx === 0 ? 'border-ink ring-2 ring-hairline' : 'border-hairline'} hover:border-ink rounded-lg p-4 text-left w-60 shrink-0 transition-all shadow-xs cursor-pointer`}
                  data-step-index={idx}
                  data-title={step.title}
                  data-desc={step.desc}
                  data-type={step.type}
                  data-tool={step.toolName || 'Webhook Trigger'}
                  data-tool-slug={step.toolSlug || ''}
                  data-prompt={step.promptTemplate || 'Standard API / Webhook payload'}
                  data-input={step.inputFormat || 'Trigger Event'}
                  data-output={step.outputFormat || 'Structured JSON'}
                >
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-hairline-soft text-ink font-semibold border border-hairline">
                      {step.type}
                    </span>
                    <span class="w-5 h-5 rounded bg-canvas text-ink text-[10px] font-bold flex items-center justify-center font-mono border border-hairline">
                      {idx + 1}
                    </span>
                  </div>
                  <div class="font-semibold text-ink text-xs mb-1 line-clamp-1">{step.title}</div>
                  <div class="text-[11px] text-mute font-mono">{step.toolName || 'Automated Webhook'}</div>
                </button>

                {idx < workflow.steps.length - 1 && (
                  <div class="text-faint font-bold text-lg shrink-0">&rarr;</div>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Step Inspector Drawer Panel -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs">
            <div class="flex items-center justify-between border-b border-hairline pb-3 mb-4">
              <div>
                <span id="inspectType" class="text-xs font-mono uppercase font-semibold text-mute">
                  {workflow.steps[0].type}
                </span>
                <h3 id="inspectTitle" class="text-lg font-semibold text-ink mt-0.5">
                  {workflow.steps[0].title}
                </h3>
              </div>
              <div id="inspectToolBadge">
                {workflow.steps[0].toolSlug ? (
                  <a href={`/tools/${workflow.steps[0].toolSlug}`} class="text-xs font-medium text-ink bg-canvas px-3 py-1.5 rounded border border-hairline hover:border-faint transition-colors shadow-xs">
                    View {workflow.steps[0].toolName} &rarr;
                  </a>
                ) : (
                  <span class="text-xs text-mute font-mono">Webhook Trigger</span>
                )}
              </div>
            </div>

            <p id="inspectDesc" class="text-xs md:text-sm text-body leading-relaxed mb-4">
              {workflow.steps[0].desc}
            </p>

            <div class="grid grid-cols-2 gap-3 mb-4 text-xs font-mono">
              <div class="p-3 rounded bg-canvas border border-hairline">
                <span class="text-mute block text-[10px] uppercase font-semibold mb-0.5">Input Variables:</span>
                <span id="inspectInput" class="text-ink font-semibold">{workflow.steps[0].inputFormat || 'Webhook Event'}</span>
              </div>
              <div class="p-3 rounded bg-canvas border border-hairline">
                <span class="text-mute block text-[10px] uppercase font-semibold mb-0.5">Output Payload:</span>
                <span id="inspectOutput" class="text-ink font-semibold">{workflow.steps[0].outputFormat || 'Structured JSON'}</span>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono uppercase font-semibold text-mute">Prompt / API Payload Schema:</span>
                <button type="button" id="copyPromptBtn" class="text-xs font-mono text-ink hover:underline font-semibold cursor-pointer">
                  Copy Payload
                </button>
              </div>
              <pre id="inspectPrompt" class="p-4 rounded bg-canvas border border-hairline text-ink font-mono text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed selection:bg-ink selection:text-on-primary">{workflow.steps[0].promptTemplate || 'Standard Webhook trigger payload.'}</pre>
            </div>
          </div>

          <!-- Tools Used Summary Box -->
          <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 shadow-xs flex flex-col justify-between">
            <div>
              <h3 class="text-xs font-mono uppercase font-semibold tracking-wider text-ink mb-4">
                Connected Tools in This Blueprint
              </h3>
              <div class="space-y-2">
                {workflow.toolsUsed.map(tool => (
                  <a 
                    href={`/tools/${tool.slug}`}
                    class="flex items-center justify-between p-3 rounded border border-hairline hover:border-faint bg-canvas transition-colors group"
                  >
                    <span class="font-medium text-ink text-xs group-hover:underline">{tool.name}</span>
                    <span class="text-mute text-xs">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-hairline mt-4">
              <div class="text-[11px] font-mono text-mute mb-2 font-semibold uppercase">Prerequisites & API Keys:</div>
              <ul class="text-xs text-body space-y-1 list-disc list-inside">
                {workflow.credentialsNeeded?.map(cred => (
                  <li>{cred}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: 3-Tier Budget Variants Comparison Table -->
      {workflow.budgetVariants && (
        <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 sm:p-8 shadow-xs">
          <div class="mb-6">
            <span class="text-[10px] font-mono uppercase font-semibold text-mute bg-hairline-soft px-2.5 py-0.5 rounded border border-hairline">
              Cost Comparison Matrix
            </span>
            <h2 class="text-xl sm:text-2xl font-semibold text-ink mt-2">
              Budget Variants Comparison (USD & INR)
            </h2>
            <p class="text-xs sm:text-sm text-body">Compare what this automation costs to run across Free, Freemium, and Enterprise tiers.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <!-- 1. Free Variant -->
            <div class="p-5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 flex flex-col justify-between shadow-xs">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono uppercase font-semibold px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                    100% Free / Self-Hosted
                  </span>
                </div>
                <div class="text-2xl font-semibold text-emerald-700 dark:text-emerald-400 mb-1">{workflow.budgetVariants.free.costUsd}</div>
                <div class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400 mb-3">{workflow.budgetVariants.free.costInr}</div>
                <p class="text-xs text-body mb-4 leading-relaxed">{workflow.budgetVariants.free.summary}</p>
                <div class="text-xs font-mono text-mute space-y-1 mb-4">
                  <strong class="text-ink font-semibold block text-[10px] uppercase">Stack:</strong>
                  {workflow.budgetVariants.free.stack.map(s => (
                    <div class="truncate">&bull; {s}</div>
                  ))}
                </div>
              </div>
              <div class="text-[11px] text-mute pt-3 border-t border-emerald-500/20">
                <strong class="text-ink">Pros:</strong> {workflow.budgetVariants.free.pros}
              </div>
            </div>

            <!-- 2. Freemium Variant -->
            <div class="p-5 rounded-lg border border-hairline bg-canvas flex flex-col justify-between shadow-xs hover:border-faint transition-colors">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono uppercase font-semibold px-2.5 py-0.5 rounded bg-hairline-soft text-ink border border-hairline">
                    Recommended Freemium
                  </span>
                </div>
                <div class="text-2xl font-semibold text-ink mb-1">{workflow.budgetVariants.freemium.costUsd}</div>
                <div class="text-xs font-mono font-semibold text-mute mb-3">{workflow.budgetVariants.freemium.costInr}</div>
                <p class="text-xs text-body mb-4 leading-relaxed">{workflow.budgetVariants.freemium.summary}</p>
                <div class="text-xs font-mono text-mute space-y-1 mb-4">
                  <strong class="text-ink font-semibold block text-[10px] uppercase">Stack:</strong>
                  {workflow.budgetVariants.freemium.stack.map(s => (
                    <div class="truncate">&bull; {s}</div>
                  ))}
                </div>
              </div>
              <div class="text-[11px] text-mute pt-3 border-t border-hairline">
                <strong class="text-ink">Pros:</strong> {workflow.budgetVariants.freemium.pros}
              </div>
            </div>

            <!-- 3. Paid Production SaaS Variant -->
            <div class="p-5 rounded-lg border border-hairline bg-canvas flex flex-col justify-between shadow-xs">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono uppercase font-semibold px-2.5 py-0.5 rounded bg-hairline-soft text-body border border-hairline">
                    Paid Production SaaS
                  </span>
                </div>
                <div class="text-2xl font-semibold text-ink mb-1">{workflow.budgetVariants.paid.costUsd}</div>
                <div class="text-xs font-mono font-semibold text-mute mb-3">{workflow.budgetVariants.paid.costInr}</div>
                <p class="text-xs text-body mb-4 leading-relaxed">{workflow.budgetVariants.paid.summary}</p>
                <div class="text-xs font-mono text-mute space-y-1 mb-4">
                  <strong class="text-ink font-semibold block text-[10px] uppercase">Stack:</strong>
                  {workflow.budgetVariants.paid.stack.map(s => (
                    <div class="truncate">&bull; {s}</div>
                  ))}
                </div>
              </div>
              <div class="text-[11px] text-mute pt-3 border-t border-hairline">
                <strong class="text-ink">Pros:</strong> {workflow.budgetVariants.paid.pros}
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Section 3: Troubleshooting Guide & Pitfalls -->
      {workflow.troubleshootingTips && workflow.troubleshootingTips.length > 0 && (
        <section class="p-6 sm:p-7 rounded-lg bg-canvas-elevated border border-hairline shadow-xs">
          <h2 class="text-base font-semibold text-ink mb-3 font-mono uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>Troubleshooting & Production Pitfalls:</span>
          </h2>
          <ul class="space-y-2 text-xs sm:text-sm text-body list-disc list-inside">
            {workflow.troubleshootingTips.map(tip => (
              <li class="leading-relaxed">{tip}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Section 4: Related YouTube Creators who Teach this Automation -->
      {relatedCreators.length > 0 && (
        <section class="bg-canvas-elevated border border-hairline rounded-lg p-6 sm:p-7 shadow-xs">
          <h2 class="text-base font-semibold text-ink mb-4 font-mono uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-600"></span>
            <span>Creators Who Teach This Architecture:</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {relatedCreators.map(creator => (
              <a 
                href={`/creators/${creator.slug}`}
                class="p-4 rounded-lg border border-hairline hover:border-faint bg-canvas shadow-xs transition-colors flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono text-mute mb-1">
                    <span class="text-ink font-semibold uppercase">{creator.primaryCategory}</span>
                    <span>{creator.subscribersEstimate}</span>
                  </div>
                  <h4 class="font-semibold text-ink text-sm mb-1">{creator.channelName}</h4>
                  <p class="text-xs text-body line-clamp-2 leading-relaxed">{creator.description}</p>
                </div>
                <div class="mt-3 text-xs font-medium text-ink hover:underline">
                  View Masterclass Tutorials &rarr;
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ workflowData: workflow }}>
  function setupStepInspector() {
    const nodes = document.querySelectorAll('.step-node');
    const typeLabel = document.getElementById('inspectType');
    const titleLabel = document.getElementById('inspectTitle');
    const descLabel = document.getElementById('inspectDesc');
    const toolBadge = document.getElementById('inspectToolBadge');
    const promptPre = document.getElementById('inspectPrompt');
    const inputLabel = document.getElementById('inspectInput');
    const outputLabel = document.getElementById('inspectOutput');
    const copyBtn = document.getElementById('copyPromptBtn');
    const exportBtn = document.getElementById('exportJsonBtn');
    const copyN8nBtn = document.getElementById('copyN8nJsonBtn');
    const n8nBtnLabel = document.getElementById('n8nBtnLabel');

    nodes.forEach(btn => {
      btn.addEventListener('click', () => {
        nodes.forEach(n => {
          n.classList.remove('border-ink', 'ring-2', 'ring-hairline');
          n.classList.add('border-hairline');
        });
        btn.classList.remove('border-hairline');
        btn.classList.add('border-ink', 'ring-2', 'ring-hairline');

        const title = btn.getAttribute('data-title');
        const desc = btn.getAttribute('data-desc');
        const type = btn.getAttribute('data-type');
        const tool = btn.getAttribute('data-tool');
        const toolSlug = btn.getAttribute('data-tool-slug');
        const prompt = btn.getAttribute('data-prompt');
        const input = btn.getAttribute('data-input');
        const output = btn.getAttribute('data-output');

        if (titleLabel) titleLabel.textContent = title;
        if (descLabel) descLabel.textContent = desc;
        if (typeLabel) typeLabel.textContent = type;
        if (promptPre) promptPre.textContent = prompt;
        if (inputLabel) inputLabel.textContent = input;
        if (outputLabel) outputLabel.textContent = output;

        if (toolBadge) {
          if (toolSlug) {
            toolBadge.innerHTML = `<a href="/tools/${toolSlug}" class="text-xs font-medium text-ink bg-canvas px-3 py-1.5 rounded border border-hairline hover:border-faint transition-colors shadow-xs">View ${tool} &rarr;</a>`;
          } else {
            toolBadge.innerHTML = `<span class="text-xs text-mute font-mono">${tool}</span>`;
          }
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = promptPre?.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = 'Copy Payload'; }, 1500);
        });
      });
    }

    if (copyN8nBtn) {
      copyN8nBtn.addEventListener('click', () => {
        const rawJson = copyN8nBtn.getAttribute('data-n8n');
        if (rawJson) {
          navigator.clipboard.writeText(rawJson).then(() => {
            if (n8nBtnLabel) n8nBtnLabel.textContent = '✓ n8n JSON Copied to Clipboard!';
            setTimeout(() => {
              if (n8nBtnLabel) n8nBtnLabel.textContent = 'Copy Valid n8n JSON';
            }, 2500);
          });
        }
      });
    }

    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const jsonStr = JSON.stringify(workflowData, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${workflowData.id}-blueprint.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupStepInspector);
  } else {
    setupStepInspector();
  }
</script>
