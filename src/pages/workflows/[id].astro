---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { WORKFLOWS_DATA, type WorkflowItem } from '../../data/workflowsData';
import { CREATORS_DATA } from '../../data/creatorsData';

export function getStaticPaths() {
  return WORKFLOWS_DATA.map((wf) => ({
    params: { id: wf.id },
    props: { workflow: wf },
  }));
}

interface Props {
  workflow: WorkflowItem;
}

const { workflow } = Astro.props;

if (!workflow) {
  return Astro.redirect('/workflows');
}

// Find related creators
const relatedCreators = CREATORS_DATA.filter(c => 
  workflow.relatedCreatorSlugs?.includes(c.slug) ||
  c.inspiredWorkflowIds?.includes(workflow.id)
);
---

<Layout 
  title={`${workflow.title} | Production Workflow Blueprint`}
  description={workflow.goal}
>
  <Header currentPath="/workflows" />

  <main class="w-full flex flex-col min-h-screen bg-[#FFFFFF]">
    <!-- Breadcrumbs -->
    <div class="border-b border-[#E2E8F0] bg-[#F8FAFF] px-4 sm:px-6 py-3">
      <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs font-mono text-slate-500">
        <a href="/" class="hover:text-ink transition-colors">HOME</a>
        <span>/</span>
        <a href="/workflows" class="hover:text-ink transition-colors">WORKFLOWS</a>
        <span>/</span>
        <span class="text-ink font-bold uppercase truncate">{workflow.title}</span>
      </div>
    </div>

    <!-- Header & Action Row -->
    <section class="border-b-2 border-[#09090B] bg-white px-4 sm:px-6 py-10 md:py-14">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="text-[11px] font-mono uppercase font-bold px-2.5 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]">
              {workflow.category}
            </span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-slate-100 border border-slate-300 text-slate-700">
              {workflow.difficulty}
            </span>
            <span class="text-xs text-slate-500 font-mono">
              Setup: {workflow.time}
            </span>
            <span class="text-xs text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded font-mono font-semibold">
              Est: {workflow.estimatedCost}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-black text-ink tracking-tight mb-3">
            {workflow.title}
          </h1>
          <p class="text-sm sm:text-base text-slate-600 max-w-3xl leading-relaxed">
            {workflow.goal}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href={`/stack-builder?tools=${workflow.toolsUsed.map(t => t.slug).join(',')}`}
            class="bg-white hover:bg-slate-50 border-2 border-[#09090B] text-ink font-bold text-xs px-4 py-2.5 rounded-lg shadow-[3px_3px_0px_0px_#09090B] transition-all inline-flex items-center gap-1.5 font-mono"
          >
            <span>Load in Stack Builder</span>
            <span>&rarr;</span>
          </a>

          <button 
            type="button"
            id="exportJsonBtn"
            data-auth-required="Export Workflow JSON Blueprint"
            class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white border-2 border-[#09090B] font-bold text-xs px-4 py-2.5 rounded-lg shadow-[3px_3px_0px_0px_#09090B] transition-all cursor-pointer font-mono inline-flex items-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span>Export JSON Blueprint</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-10 flex-1 space-y-12">
      
      <!-- Section 1: Horizontal Visual Node Pipeline -->
      <div>
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-700">
            Interactive Node Pipeline Architecture (Click any step to inspect):
          </h2>
          <span class="text-xs text-slate-400 font-mono">Horizontal execution flow &rarr;</span>
        </div>

        <div class="overflow-x-auto pb-4 mb-6">
          <div class="flex items-center gap-3 min-w-[700px]">
            {workflow.steps.map((step, idx) => (
              <div class="flex items-center gap-3">
                <button 
                  type="button"
                  class="step-node bg-white border-2 border-[#09090B] hover:border-[#2563EB] rounded-xl p-4 text-left w-56 shrink-0 transition-all shadow-[3px_3px_0px_0px_#09090B] hover:shadow-[5px_5px_0px_0px_#2563EB] cursor-pointer focus:border-[#2563EB]"
                  data-step-index={idx}
                  data-title={step.title}
                  data-desc={step.desc}
                  data-type={step.type}
                  data-tool={step.toolName || 'Webhook Trigger'}
                  data-tool-slug={step.toolSlug || ''}
                  data-prompt={step.promptTemplate || 'Standard API / Webhook payload'}
                  data-input={step.inputFormat || 'Trigger Event'}
                  data-output={step.outputFormat || 'Structured JSON'}
                >
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-xs bg-[#EFF6FF] text-[#2563EB] font-bold border border-[#BFDBFE]">
                      {step.type}
                    </span>
                    <span class="w-5 h-5 rounded-md bg-[#09090B] text-white text-[10px] font-bold flex items-center justify-center font-mono">
                      {idx + 1}
                    </span>
                  </div>
                  <div class="font-bold text-ink text-xs mb-1 line-clamp-1">{step.title}</div>
                  <div class="text-[11px] text-slate-500 font-mono">{step.toolName || 'Automated Webhook'}</div>
                </button>

                {idx < workflow.steps.length - 1 && (
                  <div class="text-[#2563EB] font-black text-xl shrink-0">&rarr;</div>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Step Inspector Panel -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 bg-[#F8FAFF] border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3 mb-4">
              <div>
                <span id="inspectType" class="text-xs font-mono uppercase font-bold text-[#2563EB]">
                  {workflow.steps[0].type}
                </span>
                <h3 id="inspectTitle" class="text-xl font-bold text-ink mt-0.5">
                  {workflow.steps[0].title}
                </h3>
              </div>
              <div id="inspectToolBadge">
                {workflow.steps[0].toolSlug ? (
                  <a href={`/tools/${workflow.steps[0].toolSlug}`} class="text-xs font-bold text-[#2563EB] bg-white px-3 py-1.5 rounded-md border border-[#BFDBFE] hover:underline shadow-2xs">
                    View {workflow.steps[0].toolName} &rarr;
                  </a>
                ) : (
                  <span class="text-xs text-slate-500 font-mono">Webhook Trigger</span>
                )}
              </div>
            </div>

            <p id="inspectDesc" class="text-sm text-slate-700 leading-relaxed mb-4">
              {workflow.steps[0].desc}
            </p>

            <div class="grid grid-cols-2 gap-3 mb-4 text-xs font-mono">
              <div class="p-2.5 rounded bg-white border border-[#E2E8F0]">
                <span class="text-slate-500 block text-[10px] uppercase font-bold">Data Input:</span>
                <span id="inspectInput" class="text-ink font-semibold">{workflow.steps[0].inputFormat || 'Webhook Event'}</span>
              </div>
              <div class="p-2.5 rounded bg-white border border-[#E2E8F0]">
                <span class="text-slate-500 block text-[10px] uppercase font-bold">Data Output:</span>
                <span id="inspectOutput" class="text-ink font-semibold">{workflow.steps[0].outputFormat || 'Structured JSON'}</span>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono uppercase font-bold text-slate-600">Prompt / Payload Specification:</span>
                <button type="button" id="copyPromptBtn" class="text-[11px] font-mono text-[#2563EB] hover:underline font-bold cursor-pointer">
                  Copy Prompt
                </button>
              </div>
              <pre id="inspectPrompt" class="p-4 rounded-lg bg-[#09090B] text-white font-mono text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed border border-[#09090B]">{workflow.steps[0].promptTemplate || 'Standard Webhook trigger payload.'}</pre>
            </div>
          </div>

          <!-- Tools Used Summary Box -->
          <div class="bg-white border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B] flex flex-col justify-between">
            <div>
              <h3 class="text-xs font-mono uppercase font-bold tracking-wider text-ink mb-4">
                Connected Tools in This Blueprint
              </h3>
              <div class="space-y-3">
                {workflow.toolsUsed.map(tool => (
                  <a 
                    href={`/tools/${tool.slug}`}
                    class="flex items-center justify-between p-3 rounded-lg border border-[#E2E8F0] hover:border-[#2563EB] hover:bg-[#F8FAFF] transition-all group"
                  >
                    <span class="font-bold text-ink text-xs group-hover:text-[#2563EB]">{tool.name}</span>
                    <span class="text-slate-400 group-hover:text-[#2563EB] text-xs">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-[#E2E8F0] mt-4">
              <div class="text-[11px] font-mono text-slate-500 mb-2">Prerequisites:</div>
              <ul class="text-xs text-slate-600 space-y-1 list-disc list-inside">
                {workflow.credentialsNeeded?.map(cred => (
                  <li>{cred}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: 3-Tier Budget Variants Comparison Table -->
      {workflow.budgetVariants && (
        <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#09090B]">
          <div class="mb-6">
            <span class="text-[10px] font-mono uppercase font-bold text-[#2563EB] bg-[#EFF6FF] px-2 py-0.5 rounded border border-[#BFDBFE]">
              COST COMPARISON MATRIX
            </span>
            <h2 class="text-xl sm:text-2xl font-black text-ink mt-2">
              Budget Variants Comparison (USD & INR)
            </h2>
            <p class="text-xs sm:text-sm text-slate-600">Compare what this automation costs to run across Free, Freemium, and Enterprise tiers.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <!-- 1. Free Variant -->
            <div class="p-5 rounded-xl border-2 border-emerald-500 bg-emerald-50/30 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono uppercase font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                    100% Free / Self-Hosted
                  </span>
                </div>
                <div class="text-2xl font-black text-emerald-800 mb-1">{workflow.budgetVariants.free.costUsd}</div>
                <div class="text-xs font-mono font-bold text-emerald-700 mb-3">{workflow.budgetVariants.free.costInr}</div>
                <p class="text-xs text-slate-700 mb-4">{workflow.budgetVariants.free.summary}</p>
                <div class="text-xs font-mono text-slate-600 space-y-1 mb-4">
                  <strong class="text-ink font-bold block text-[10px] uppercase">Stack:</strong>
                  {workflow.budgetVariants.free.stack.map(s => (
                    <div class="truncate">&bull; {s}</div>
                  ))}
                </div>
              </div>
              <div class="text-[11px] text-slate-600 pt-3 border-t border-emerald-200">
                <strong>Pros:</strong> {workflow.budgetVariants.free.pros}
              </div>
            </div>

            <!-- 2. Freemium Variant -->
            <div class="p-5 rounded-xl border-2 border-[#2563EB] bg-[#EFF6FF]/40 flex flex-col justify-between shadow-[3px_3px_0px_0px_#2563EB]">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono uppercase font-bold px-2 py-0.5 rounded bg-[#EFF6FF] text-[#2563EB] border border-[#BFDBFE]">
                    Recommended Freemium
                  </span>
                </div>
                <div class="text-2xl font-black text-[#2563EB] mb-1">{workflow.budgetVariants.freemium.costUsd}</div>
                <div class="text-xs font-mono font-bold text-slate-700 mb-3">{workflow.budgetVariants.freemium.costInr}</div>
                <p class="text-xs text-slate-700 mb-4">{workflow.budgetVariants.freemium.summary}</p>
                <div class="text-xs font-mono text-slate-600 space-y-1 mb-4">
                  <strong class="text-ink font-bold block text-[10px] uppercase">Stack:</strong>
                  {workflow.budgetVariants.freemium.stack.map(s => (
                    <div class="truncate">&bull; {s}</div>
                  ))}
                </div>
              </div>
              <div class="text-[11px] text-slate-600 pt-3 border-t border-blue-200">
                <strong>Pros:</strong> {workflow.budgetVariants.freemium.pros}
              </div>
            </div>

            <!-- 3. Paid Production SaaS Variant -->
            <div class="p-5 rounded-xl border-2 border-[#09090B] bg-slate-50 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono uppercase font-bold px-2 py-0.5 rounded bg-slate-200 text-slate-800">
                    Paid Production SaaS
                  </span>
                </div>
                <div class="text-2xl font-black text-ink mb-1">{workflow.budgetVariants.paid.costUsd}</div>
                <div class="text-xs font-mono font-bold text-slate-600 mb-3">{workflow.budgetVariants.paid.costInr}</div>
                <p class="text-xs text-slate-700 mb-4">{workflow.budgetVariants.paid.summary}</p>
                <div class="text-xs font-mono text-slate-600 space-y-1 mb-4">
                  <strong class="text-ink font-bold block text-[10px] uppercase">Stack:</strong>
                  {workflow.budgetVariants.paid.stack.map(s => (
                    <div class="truncate">&bull; {s}</div>
                  ))}
                </div>
              </div>
              <div class="text-[11px] text-slate-600 pt-3 border-t border-slate-300">
                <strong>Pros:</strong> {workflow.budgetVariants.paid.pros}
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Section 3: Troubleshooting Guide & Pitfalls -->
      {workflow.troubleshootingTips && workflow.troubleshootingTips.length > 0 && (
        <section class="p-6 rounded-xl bg-[#F8FAFF] border-2 border-[#09090B] shadow-[5px_5px_0px_0px_#09090B]">
          <h2 class="text-base font-black text-ink mb-3 font-mono uppercase flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-amber-500"></span>
            <span>Troubleshooting & Production Pitfalls:</span>
          </h2>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-700 list-disc list-inside">
            {workflow.troubleshootingTips.map(tip => (
              <li class="leading-relaxed">{tip}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Section 4: Related YouTube Creators who Teach this Automation -->
      {relatedCreators.length > 0 && (
        <section class="bg-white border-2 border-[#09090B] rounded-xl p-6 shadow-[5px_5px_0px_0px_#09090B]">
          <h2 class="text-base font-black text-ink mb-4 font-mono uppercase flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-red-600"></span>
            <span>Creators Who Teach This Architecture:</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {relatedCreators.map(creator => (
              <a 
                href={`/creators/${creator.slug}`}
                class="p-4 rounded-xl border-2 border-[#09090B] hover:border-[#2563EB] hover:shadow-[3px_3px_0px_0px_#2563EB] transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 mb-1">
                    <span class="text-red-700 font-bold uppercase">{creator.primaryCategory}</span>
                    <span>{creator.subscribersEstimate}</span>
                  </div>
                  <h4 class="font-bold text-ink text-sm mb-1">{creator.channelName}</h4>
                  <p class="text-xs text-slate-600 line-clamp-2">{creator.description}</p>
                </div>
                <div class="mt-3 text-xs font-bold text-[#2563EB] hover:underline">
                  View Masterclass Tutorials &rarr;
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ workflowData: workflow }}>
  function setupStepInspector() {
    const nodes = document.querySelectorAll('.step-node');
    const typeLabel = document.getElementById('inspectType');
    const titleLabel = document.getElementById('inspectTitle');
    const descLabel = document.getElementById('inspectDesc');
    const toolBadge = document.getElementById('inspectToolBadge');
    const promptPre = document.getElementById('inspectPrompt');
    const inputLabel = document.getElementById('inspectInput');
    const outputLabel = document.getElementById('inspectOutput');
    const copyBtn = document.getElementById('copyPromptBtn');
    const exportBtn = document.getElementById('exportJsonBtn');

    nodes.forEach(btn => {
      btn.addEventListener('click', () => {
        nodes.forEach(n => {
          n.classList.remove('border-[#2563EB]', 'ring-2', 'ring-[#2563EB]');
          n.classList.add('border-[#09090B]');
        });
        btn.classList.remove('border-[#09090B]');
        btn.classList.add('border-[#2563EB]', 'ring-2', 'ring-[#2563EB]');

        const title = btn.getAttribute('data-title');
        const desc = btn.getAttribute('data-desc');
        const type = btn.getAttribute('data-type');
        const tool = btn.getAttribute('data-tool');
        const toolSlug = btn.getAttribute('data-tool-slug');
        const prompt = btn.getAttribute('data-prompt');
        const input = btn.getAttribute('data-input');
        const output = btn.getAttribute('data-output');

        if (titleLabel) titleLabel.textContent = title;
        if (descLabel) descLabel.textContent = desc;
        if (typeLabel) typeLabel.textContent = type;
        if (promptPre) promptPre.textContent = prompt;
        if (inputLabel) inputLabel.textContent = input;
        if (outputLabel) outputLabel.textContent = output;

        if (toolBadge) {
          if (toolSlug) {
            toolBadge.innerHTML = `<a href="/tools/${toolSlug}" class="text-xs font-bold text-[#2563EB] bg-white px-3 py-1.5 rounded-md border border-[#BFDBFE] hover:underline shadow-2xs">View ${tool} &rarr;</a>`;
          } else {
            toolBadge.innerHTML = `<span class="text-xs text-slate-500 font-mono">${tool}</span>`;
          }
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = promptPre?.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = 'Copy Prompt'; }, 1500);
        });
      });
    }

    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const jsonContent = JSON.stringify(workflowData, null, 2);
        const blob = new Blob([jsonContent], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${workflowData.id}-blueprint.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupStepInspector);
  } else {
    setupStepInspector();
  }
</script>
